{#- Motor documental · template único; o modelo escolhe a variação (classe no body). Texto já vem escapado e com marcação mínima. -#}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>{{ d.titulo }}</title>
<meta name="author" content="{{ m.autor_institucional }}">
<style>
{{ fontes_css }}
:root { {% for k, v in tokens.items() %}{{ k }}: {{ v }}; {% endfor %} }
{{ css }}
</style>
</head>
<body class="{{ classe }} modelo-{{ modelo }}">
{%- if m.marca_dagua %}<div class="dagua" aria-hidden="true">{{ m.marca_dagua }}</div>{% endif %}

{%- macro bloco(b) -%}
{%- if b.t == 'secao' -%}<h2 class="barra" data-sumario="1">{{ b.titulo }}</h2>
{%- elif b.t == 'subsecao' -%}<h3>{{ b.titulo }}</h3>
{%- elif b.t == 'p' -%}<p>{{ b.texto }}</p>
{%- elif b.t == 'item' -%}<div class="item"><span class="n">{{ b.n }}</span><p>{{ b.texto }}</p></div>
{%- elif b.t == 'alinea' -%}<div class="alinea"><span class="n">{{ b.m }}</span><p>{{ b.texto }}</p></div>
{%- elif b.t == 'lista' -%}<{{ 'ol' if b.ordenada else 'ul' }} class="lista">{% for i in b.itens %}<li>{{ i }}</li>{% endfor %}</{{ 'ol' if b.ordenada else 'ul' }}>
{%- elif b.t == 'citacao' -%}<blockquote><p>{{ b.texto }}</p></blockquote>
{%- elif b.t == 'nota' -%}<p class="nota">{{ b.texto }}</p>
{%- elif b.t == 'destaque' -%}<div class="destaque">{% if b.titulo %}<div class="dt">{{ b.titulo }}</div>{% endif %}<p>{{ b.texto }}</p></div>
{%- elif b.t == 'kpis' -%}<div class="kpis" style="--kpis: {{ b.itens|length }}">{% for k in b.itens %}<div class="kpi"><div class="v">{{ k.valor }}</div><div class="r">{{ k.rotulo }}</div></div>{% endfor %}</div>
{%- elif b.t == 'campos' -%}<table class="campos">{% for r in b.itens %}<tr><th scope="row">{{ r[0] }}</th><td>{{ r[1] }}</td></tr>{% endfor %}</table>
{%- elif b.t == 'tabela' -%}
<div class="quadro{% if b.longa %} longo{% endif %}">{% if b.nome %}<div class="legenda">{{ b.nome }}</div>{% endif %}
<table class="t{% if b.densa %} densa{% endif %}"><thead><tr>{% for c in b.cab %}<th scope="col">{{ c }}</th>{% endfor %}</tr></thead><tbody>
{% for l in b.linhas %}<tr{% if b.total and loop.last %} class="total"{% endif %}>{% for c in l %}<td{% if loop.index0 in (b.esq or []) %} class="esq"{% endif %}>{{ c }}</td>{% endfor %}</tr>
{% endfor %}</tbody></table></div>
{%- endif -%}
{%- endmacro -%}

{%- macro blocos(lista) -%}
{%- for g in lista -%}
{%- if g.preso -%}<div class="preso">{% for b in g.preso %}{{ bloco(b) }}{% endfor %}</div>
{%- else -%}{{ bloco(g) }}{%- endif %}
{% endfor -%}
{%- endmacro -%}

{%- if modelo == 'certificado' %}
<div class="cert"><div class="moldura"></div><div class="corpo">
{% if logo %}<img class="logo" src="{{ logo }}" alt="{{ m.nome }}">{% else %}<div class="a"><strong>{{ m.nome }}</strong></div>{% endif %}
<h1>{{ d.titulo }}</h1>
<p class="a">{{ d.certificado.preambulo }}</p>
<p class="nome">{{ d.certificado.concedido_a }}</p>
<p class="texto">{{ d.certificado.texto }}</p>
<p class="a">{{ d.local }}, {{ data_extenso }}.</p>
<div class="rodape-cert">{% for p in d.assinaturas.partes %}<div class="col"><div class="linha"><div><strong>{{ p.nome }}</strong></div><div>{{ p.cargo }}</div></div></div>{% endfor %}</div>
</div></div>
{%- else %}

{%- if modelo == 'oficio' %}
<div class="oficio">
<div class="ref"><span><strong>{{ d.referencia }}</strong></span><span>{{ d.local }}, {{ data_extenso }}.</span></div>
<div class="dest"><p>{{ d.destinatario.tratamento }}</p><p><strong>{{ d.destinatario.nome }}</strong><br>{{ d.destinatario.cargo }}<br>{{ d.destinatario.orgao }}</p></div>
<p class="assunto"><strong>Assunto:</strong> {{ d.assunto }}</p>
{{ blocos(d.blocos) }}
</div>
{%- else %}
<h1 class="titulo-doc">{{ d.titulo }}</h1>
{%- if d.campos %}<table class="campos">{% for r in d.campos %}<tr><th scope="row">{{ r[0] }}</th><td>{{ r[1] }}</td></tr>{% endfor %}</table>{% endif %}
{%- if sumario %}
<nav class="sumario" aria-label="Sumário"><h2 class="barra">Sumário</h2><ol>
{% for s in sumario %}<li><span class="tx">{{ s.titulo }}</span><span class="pt"></span><span class="pg">{{ s.pagina }}</span></li>
{% endfor %}</ol></nav>
{%- endif %}
{{ blocos(d.blocos) }}
{%- endif %}

{%- if d.assinaturas %}
<div class="fecho">
{%- if modelo != 'oficio' %}<p class="local">{{ d.local }}, {{ data_extenso }}.</p>{% endif %}
<div class="ass{% if d.assinaturas.partes|length == 1 %} uma{% endif %}">
{% for p in d.assinaturas.partes %}<div class="col">{% if p.papel %}<div class="papel">{{ p.papel }}</div>{% else %}<div class="papel">&nbsp;</div>{% endif %}
<div class="linha">{% if p.razao %}<div class="razao">{{ p.razao }}</div>{% endif %}<div>{{ p.nome }}</div>{% if p.cargo %}<div>{{ p.cargo }}</div>{% endif %}{% if p.cpf %}<div>CPF: {{ p.cpf }}</div>{% endif %}</div>
{% if p.ancora %}<div class="ancora">{{ p.ancora }}</div>{% endif %}</div>
{% endfor %}
{% for i in range(d.assinaturas.testemunhas or 0) %}<div class="col"><div class="papel">TESTEMUNHA {{ i + 1 }}</div><div class="linha"><div style="text-align:left">Nome:</div><div style="text-align:left">CPF:</div></div><div class="ancora">/ass_T{{ i + 1 }}/</div></div>
{% endfor %}
</div>
{%- if d.assinaturas.nota %}<p class="nota">{{ d.assinaturas.nota }}</p>{% endif %}
</div>
{%- endif %}

{%- for a in d.anexos or [] %}
<section class="anexo"><div class="cab-anexo" data-sumario="1" data-sumario-titulo="Anexo {{ a.numero }} – {{ a.titulo_simples }}"><h2 style="font-size:12pt">ANEXO {{ a.numero }}</h2><div>{{ a.titulo }}</div></div>
{{ blocos(a.blocos) }}
</section>
{%- endfor %}

{%- if d.parte_final %}
<section class="parte-final">
{%- if d.parte_final.glossario %}<div class="preso"><h2 class="barra" data-sumario="1">Glossário</h2></div>
{% for g in d.parte_final.glossario %}<p><strong>{{ g[0] }}:</strong> {{ g[1] }}</p>{% endfor %}{% endif %}
{%- if d.parte_final.legenda %}<div class="preso"><h2 class="barra" data-sumario="1">Legenda</h2></div>
{% for g in d.parte_final.legenda %}<p><strong>{{ g[0] }}:</strong> {{ g[1] }}</p>{% endfor %}{% endif %}
{%- if d.parte_final.referencias %}<div class="preso"><h2 class="barra" data-sumario="1">Referências normativas</h2></div>
{% for r in d.parte_final.referencias %}<p>{{ r.norma }}. Disponível em: {{ r.fonte }}. Verificado em {{ r.verificado_em }}.</p>{% endfor %}{% endif %}
</section>
{%- endif %}
{%- endif %}
</body>
</html>
