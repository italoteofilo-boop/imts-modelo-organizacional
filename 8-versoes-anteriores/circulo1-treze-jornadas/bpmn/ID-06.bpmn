<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ID06" targetNamespace="urn:imts:modelo:identidade" exporter="Ecossistema IMTS - fonte única do Círculo 1" exporterVersion="2026-10-01">
  <bpmn:category id="Category_ID06">
    <bpmn:categoryValue id="CV_ID06_E1" value="1. Preparar o ritual" />
    <bpmn:categoryValue id="CV_ID06_E2" value="2. Avaliar as indicações de reconhecimento" />
    <bpmn:categoryValue id="CV_ID06_E3" value="3. Realizar o ritual" />
    <bpmn:categoryValue id="CV_ID06_E4" value="4. Comunicar e registrar" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID06">
    <bpmn:participant id="Participant_ID06" name="ID-06 · Realizar os rituais de cultura e o reconhecimento de pessoas e equipes" processRef="Process_ID06" />
    <bpmn:group id="Group_ID06_E1" categoryValueRef="CV_ID06_E1" />
    <bpmn:group id="Group_ID06_E2" categoryValueRef="CV_ID06_E2" />
    <bpmn:group id="Group_ID06_E3" categoryValueRef="CV_ID06_E3" />
    <bpmn:group id="Group_ID06_E4" categoryValueRef="CV_ID06_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ID06" name="Realizar os rituais de cultura e o reconhecimento de pessoas e equipes" isExecutable="false">
    <bpmn:documentation>Reforçar, com cadência fixa, os comportamentos que os valores pedem, com reconhecimento baseado em evidência.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID06">
      <bpmn:lane id="Lane_ID06_LID" name="Líder da equipe">
        <bpmn:flowNodeRef>ID06_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID06_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID06_GES" name="Gestão">
        <bpmn:flowNodeRef>ID06_E2_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID06_IDP" name="Identidade · pessoa">
        <bpmn:flowNodeRef>ID06_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID06_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID06_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID06_IDA" name="Identidade · agente">
        <bpmn:flowNodeRef>ID06_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID06_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID06_E4_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID06_IDR" name="Identidade · automação">
        <bpmn:flowNodeRef>ID06_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID06_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID06_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID06_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ID06_S1" name="Prazo de preparação do ritual chegou"><bpmn:outgoing>ID06_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="ID06_S1_def" /></bpmn:startEvent>
    <bpmn:scriptTask id="ID06_E1_T1" name="Abrir a preparação e colher as indicações"><bpmn:documentation>Etapa 1: Preparar o ritual. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID06_Flow1</bpmn:incoming><bpmn:outgoing>ID06_Flow2</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="ID06_E1_T2" name="Montar o roteiro e o material do ritual"><bpmn:documentation>Etapa 1: Preparar o ritual. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID06_Flow2</bpmn:incoming><bpmn:outgoing>ID06_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ID06_E2_T1" name="Conferir cada indicação com os critérios"><bpmn:documentation>Etapa 2: Avaliar as indicações de reconhecimento. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID06_Flow3</bpmn:incoming><bpmn:outgoing>ID06_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID06_E2_T2" name="Decidir os reconhecimentos com os líderes"><bpmn:documentation>Etapa 2: Avaliar as indicações de reconhecimento. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID06_Flow4</bpmn:incoming><bpmn:outgoing>ID06_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID06_E2_G1" name="Algum reconhecimento envolve recompensa financeira?"><bpmn:incoming>ID06_Flow5</bpmn:incoming><bpmn:outgoing>ID06_Flow6</bpmn:outgoing><bpmn:outgoing>ID06_Flow7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="ID06_E2_T3" name="Aprovar e processar a recompensa"><bpmn:documentation>Etapa 2: Avaliar as indicações de reconhecimento. Executor: Outro círculo (Gestão). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID06_Flow7</bpmn:incoming><bpmn:outgoing>ID06_Flow8</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="ID06_M1"><bpmn:incoming>ID06_Flow6</bpmn:incoming><bpmn:incoming>ID06_Flow8</bpmn:incoming><bpmn:outgoing>ID06_Flow13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="ID06_E3_T1" name="Conduzir o ritual"><bpmn:documentation>Etapa 3: Realizar o ritual. Executor: Pessoa de fora do círculo (Líder da equipe). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>ID06_Flow13</bpmn:incoming><bpmn:outgoing>ID06_Flow9</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="ID06_E3_T2" name="Apoiar a condução e registrar as histórias"><bpmn:documentation>Etapa 3: Realizar o ritual. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>ID06_Flow9</bpmn:incoming><bpmn:outgoing>ID06_Flow10</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="ID06_E4_T1" name="Selecionar as histórias e os reconhecimentos a comunicar"><bpmn:documentation>Etapa 4: Comunicar e registrar. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID06_Flow10</bpmn:incoming><bpmn:outgoing>ID06_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="ID06_E4_T2" name="Registrar participação e reconhecimentos"><bpmn:documentation>Etapa 4: Comunicar e registrar. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID06_Flow11</bpmn:incoming><bpmn:outgoing>ID06_Flow12</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="ID06_F1" name="Ritual realizado e registrado"><bpmn:incoming>ID06_Flow12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="ID06_Flow1" sourceRef="ID06_S1" targetRef="ID06_E1_T1" />
    <bpmn:sequenceFlow id="ID06_Flow2" sourceRef="ID06_E1_T1" targetRef="ID06_E1_T2" />
    <bpmn:sequenceFlow id="ID06_Flow3" sourceRef="ID06_E1_T2" targetRef="ID06_E2_T1" />
    <bpmn:sequenceFlow id="ID06_Flow4" sourceRef="ID06_E2_T1" targetRef="ID06_E2_T2" />
    <bpmn:sequenceFlow id="ID06_Flow5" sourceRef="ID06_E2_T2" targetRef="ID06_E2_G1" />
    <bpmn:sequenceFlow id="ID06_Flow6" name="Não" sourceRef="ID06_E2_G1" targetRef="ID06_M1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ID06_Flow7" name="Sim" sourceRef="ID06_E2_G1" targetRef="ID06_E2_T3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="ID06_Flow8" sourceRef="ID06_E2_T3" targetRef="ID06_M1" />
    <bpmn:sequenceFlow id="ID06_Flow9" sourceRef="ID06_E3_T1" targetRef="ID06_E3_T2" />
    <bpmn:sequenceFlow id="ID06_Flow10" sourceRef="ID06_E3_T2" targetRef="ID06_E4_T1" />
    <bpmn:sequenceFlow id="ID06_Flow11" sourceRef="ID06_E4_T1" targetRef="ID06_E4_T2" />
    <bpmn:sequenceFlow id="ID06_Flow12" sourceRef="ID06_E4_T2" targetRef="ID06_F1" />
    <bpmn:sequenceFlow id="ID06_Flow13" sourceRef="ID06_M1" targetRef="ID06_E3_T1" />
  </bpmn:process>
