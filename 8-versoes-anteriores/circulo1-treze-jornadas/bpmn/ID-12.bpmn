<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ID12" targetNamespace="urn:imts:modelo:identidade" exporter="Ecossistema IMTS - fonte única do Círculo 1" exporterVersion="2026-10-01">
  <bpmn:category id="Category_ID12">
    <bpmn:categoryValue id="CV_ID12_E1" value="1. Planejar o diagnóstico" />
    <bpmn:categoryValue id="CV_ID12_E2" value="2. Coletar a visão dos sócios, a cultura vivida e a imagem externa" />
    <bpmn:categoryValue id="CV_ID12_E3" value="3. Analisar as lacunas entre visão, cultura e imagem" />
    <bpmn:categoryValue id="CV_ID12_E4" value="4. Definir o plano de correção com os donos" />
    <bpmn:categoryValue id="CV_ID12_E5" value="5. Incluir o plano nos alvos e distribuir" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID12">
    <bpmn:participant id="Participant_ID12" name="ID-12 · Medir o alinhamento entre identidade, cultura e imagem e planejar a correção das lacunas" processRef="Process_ID12" />
    <bpmn:group id="Group_ID12_E1" categoryValueRef="CV_ID12_E1" />
    <bpmn:group id="Group_ID12_E2" categoryValueRef="CV_ID12_E2" />
    <bpmn:group id="Group_ID12_E3" categoryValueRef="CV_ID12_E3" />
    <bpmn:group id="Group_ID12_E4" categoryValueRef="CV_ID12_E4" />
    <bpmn:group id="Group_ID12_E5" categoryValueRef="CV_ID12_E5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ID12" name="Medir o alinhamento entre identidade, cultura e imagem e planejar a correção das lacunas" isExecutable="false">
    <bpmn:documentation>Saber com dados onde o que declaramos, o que vivemos e como somos vistos não batem, e ter um plano com dono e alvo para cada lacuna. A execução do plano é acompanhada nos alvos da Estratégia e medida no ciclo seguinte.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID12">
      <bpmn:lane id="Lane_ID12_EST" name="Estratégia">
        <bpmn:flowNodeRef>ID12_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E5_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID12_INT" name="Inteligência">
        <bpmn:flowNodeRef>ID12_E1_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID12_REL" name="Relações">
        <bpmn:flowNodeRef>ID12_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID12_IDP" name="Identidade · pessoa">
        <bpmn:flowNodeRef>ID12_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E2_PJ1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E4_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID12_IDA" name="Identidade · agente">
        <bpmn:flowNodeRef>ID12_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E5_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID12_IDR" name="Identidade · automação">
        <bpmn:flowNodeRef>ID12_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E2_PS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E4_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_E5_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID12_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ID12_S1" name="Crise, incorporação ou troca de liderança ocorrida"><bpmn:outgoing>ID12_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ID12_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ID12_S2" name="Ciclo de diagnóstico iniciado"><bpmn:outgoing>ID12_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="ID12_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="ID12_M1"><bpmn:incoming>ID12_Flow1</bpmn:incoming><bpmn:incoming>ID12_Flow2</bpmn:incoming><bpmn:outgoing>ID12_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID12_E1_T1" name="Propor públicos, instrumentos e amostra"><bpmn:documentation>Etapa 1: Planejar o diagnóstico. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID12_Flow25</bpmn:incoming><bpmn:outgoing>ID12_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="ID12_E1_T2" name="Conferir o método e a amostra"><bpmn:documentation>Etapa 1: Planejar o diagnóstico. Executor: Outro círculo (Inteligência). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID12_Flow3</bpmn:incoming><bpmn:outgoing>ID12_Flow4</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="ID12_E1_T3" name="Aprovar o plano do diagnóstico"><bpmn:documentation>Etapa 1: Planejar o diagnóstico. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID12_Flow4</bpmn:incoming><bpmn:outgoing>ID12_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="ID12_E2_PS1"><bpmn:incoming>ID12_Flow5</bpmn:incoming><bpmn:outgoing>ID12_Flow6</bpmn:outgoing><bpmn:outgoing>ID12_Flow8</bpmn:outgoing><bpmn:outgoing>ID12_Flow10</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:scriptTask id="ID12_E2_T1" name="Aplicar a pesquisa de cultura com as pessoas"><bpmn:documentation>Etapa 2: Coletar a visão dos sócios, a cultura vivida e a imagem externa. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID12_Flow6</bpmn:incoming><bpmn:outgoing>ID12_Flow7</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="ID12_E2_T2" name="Colher a percepção dos públicos externos"><bpmn:documentation>Etapa 2: Coletar a visão dos sócios, a cultura vivida e a imagem externa. Executor: Outro círculo (Relações). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID12_Flow8</bpmn:incoming><bpmn:outgoing>ID12_Flow9</bpmn:outgoing></bpmn:task>
    <bpmn:manualTask id="ID12_E2_T3" name="Ouvir sócios e executivos sobre a visão"><bpmn:documentation>Etapa 2: Coletar a visão dos sócios, a cultura vivida e a imagem externa. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID12_Flow10</bpmn:incoming><bpmn:outgoing>ID12_Flow11</bpmn:outgoing></bpmn:manualTask>
    <bpmn:parallelGateway id="ID12_E2_PJ1"><bpmn:incoming>ID12_Flow7</bpmn:incoming><bpmn:incoming>ID12_Flow9</bpmn:incoming><bpmn:incoming>ID12_Flow11</bpmn:incoming><bpmn:outgoing>ID12_Flow12</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="ID12_E2_T4" name="Consolidar os dados das três leituras"><bpmn:documentation>Etapa 2: Coletar a visão dos sócios, a cultura vivida e a imagem externa. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID12_Flow12</bpmn:incoming><bpmn:outgoing>ID12_Flow13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ID12_E3_T1" name="Calcular as lacunas entre visão, cultura e imagem"><bpmn:documentation>Etapa 3: Analisar as lacunas entre visão, cultura e imagem. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID12_Flow13</bpmn:incoming><bpmn:outgoing>ID12_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID12_E3_T2" name="Interpretar e priorizar as lacunas"><bpmn:documentation>Etapa 3: Analisar as lacunas entre visão, cultura e imagem. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID12_Flow14</bpmn:incoming><bpmn:outgoing>ID12_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="ID12_E4_T1" name="Combinar ações, donos e alvos com líderes e executivos"><bpmn:documentation>Etapa 4: Definir o plano de correção com os donos. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID12_Flow15</bpmn:incoming><bpmn:outgoing>ID12_Flow16</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ID12_E4_G1" name="Que revisão a lacuna principal pede?"><bpmn:incoming>ID12_Flow16</bpmn:incoming><bpmn:outgoing>ID12_Flow17</bpmn:outgoing><bpmn:outgoing>ID12_Flow18</bpmn:outgoing><bpmn:outgoing>ID12_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID12_E4_T2" name="Abrir a revisão da declaração"><bpmn:documentation>Etapa 4: Definir o plano de correção com os donos. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID12_Flow18</bpmn:incoming><bpmn:outgoing>ID12_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="ID12_E4_T3" name="Abrir a revisão do posicionamento"><bpmn:documentation>Etapa 4: Definir o plano de correção com os donos. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID12_Flow20</bpmn:incoming><bpmn:outgoing>ID12_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ID12_M2"><bpmn:incoming>ID12_Flow17</bpmn:incoming><bpmn:incoming>ID12_Flow19</bpmn:incoming><bpmn:incoming>ID12_Flow21</bpmn:incoming><bpmn:outgoing>ID12_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="ID12_E5_T1" name="Incluir as ações nos alvos e no orçamento do ciclo"><bpmn:documentation>Etapa 5: Incluir o plano nos alvos e distribuir. Executor: Outro círculo (Estratégia). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID12_Flow26</bpmn:incoming><bpmn:outgoing>ID12_Flow22</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="ID12_E5_T2" name="Calcular os indicadores de marca, cultura e reputação"><bpmn:documentation>Etapa 5: Incluir o plano nos alvos e distribuir. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID12_Flow22</bpmn:incoming><bpmn:outgoing>ID12_Flow23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="ID12_E5_T3" name="Distribuir o plano e publicar os indicadores"><bpmn:documentation>Etapa 5: Incluir o plano nos alvos e distribuir. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID12_Flow23</bpmn:incoming><bpmn:outgoing>ID12_Flow24</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="ID12_F1" name="Plano de correção aprovado e distribuído"><bpmn:incoming>ID12_Flow24</bpmn:incoming></bpmn:endEvent>
