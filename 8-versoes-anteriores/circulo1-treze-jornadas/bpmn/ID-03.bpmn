        <bpmn:flowNodeRef>ID03_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID03_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID03_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID03_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID03_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID03_E5_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID03_E6_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID03_IDA" name="Identidade · agente">
