    <bpmn:startEvent id="ID03_S1" name="Pedido de marca recebido"><bpmn:outgoing>ID03_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ID03_S1_def" /></bpmn:startEvent>
    <bpmn:userTask id="ID03_E1_T1" name="Fechar o briefing com quem pediu"><bpmn:documentation>Etapa 1: Entender o pedido e pesquisar público, concorrentes e marcas. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID03_Flow1</bpmn:incoming><bpmn:outgoing>ID03_Flow2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="ID03_E1_T2" name="Pesquisar público, concorrentes e marcas do portfólio"><bpmn:documentation>Etapa 1: Entender o pedido e pesquisar público, concorrentes e marcas. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID03_Flow2</bpmn:incoming><bpmn:outgoing>ID03_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ID03_E2_T1" name="Aplicar os critérios de escolha entre marca existente e marca própria e recomendar"><bpmn:documentation>Etapa 2: Decidir se o negócio usa marca existente ou ganha marca própria. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID03_Flow3</bpmn:incoming><bpmn:outgoing>ID03_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="ID03_E2_T2" name="Avaliar a recomendação à luz do portfólio"><bpmn:documentation>Etapa 2: Decidir se o negócio usa marca existente ou ganha marca própria. Executor: Outro círculo (Estratégia). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID03_Flow4</bpmn:incoming><bpmn:outgoing>ID03_Flow5</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="ID03_E2_T3" name="Decidir com o executivo o papel da marca"><bpmn:documentation>Etapa 2: Decidir se o negócio usa marca existente ou ganha marca própria. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID03_Flow5</bpmn:incoming><bpmn:outgoing>ID03_Flow6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID03_E2_G1" name="Que marca o negócio terá?"><bpmn:incoming>ID03_Flow6</bpmn:incoming><bpmn:outgoing>ID03_Flow7</bpmn:outgoing><bpmn:outgoing>ID03_Flow8</bpmn:outgoing><bpmn:outgoing>ID03_Flow9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ID03_M1"><bpmn:incoming>ID03_Flow7</bpmn:incoming><bpmn:incoming>ID03_Flow16</bpmn:incoming><bpmn:outgoing>ID03_Flow31</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID03_E3_T1" name="Gerar a essência da marca e nomes candidatos"><bpmn:documentation>Etapa 3: Definir a essência da marca e o nome. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID03_Flow31</bpmn:incoming><bpmn:outgoing>ID03_Flow10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ID03_E3_T2" name="Verificar no INPI se já existe marca igual ou parecida e se os domínios estão livres"><bpmn:documentation>Etapa 3: Definir a essência da marca e o nome. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID03_Flow10</bpmn:incoming><bpmn:outgoing>ID03_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="ID03_E3_T3" name="Avaliar o risco de registro dos nomes"><bpmn:documentation>Etapa 3: Definir a essência da marca e o nome. Executor: Assessoria externa (Assessoria externa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID03_Flow11</bpmn:incoming><bpmn:outgoing>ID03_Flow12</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="ID03_E3_T4" name="Escolher o nome com o executivo"><bpmn:documentation>Etapa 3: Definir a essência da marca e o nome. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID03_Flow12</bpmn:incoming><bpmn:outgoing>ID03_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID03_E3_G1" name="Nome livre e aprovado?"><bpmn:incoming>ID03_Flow13</bpmn:incoming><bpmn:outgoing>ID03_Flow14</bpmn:outgoing><bpmn:outgoing>ID03_Flow16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID03_E3_T5" name="Reservar os domínios do nome aprovado"><bpmn:documentation>Etapa 3: Definir a essência da marca e o nome. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID03_Flow14</bpmn:incoming><bpmn:outgoing>ID03_Flow15</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ID03_M2"><bpmn:incoming>ID03_Flow9</bpmn:incoming><bpmn:incoming>ID03_Flow15</bpmn:incoming><bpmn:incoming>ID03_Flow21</bpmn:incoming><bpmn:outgoing>ID03_Flow32</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID03_E4_T1" name="Gerar alternativas de identidade visual e verbal"><bpmn:documentation>Etapa 4: Desenhar a identidade visual e verbal. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID03_Flow32</bpmn:incoming><bpmn:outgoing>ID03_Flow17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID03_E4_T2" name="Refinar as alternativas"><bpmn:documentation>Etapa 4: Desenhar a identidade visual e verbal. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID03_Flow17</bpmn:incoming><bpmn:outgoing>ID03_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="ID03_E4_T3" name="Escolher a identidade"><bpmn:documentation>Etapa 4: Desenhar a identidade visual e verbal. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID03_Flow18</bpmn:incoming><bpmn:outgoing>ID03_Flow19</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID03_E4_G1" name="Identidade aprovada?"><bpmn:incoming>ID03_Flow19</bpmn:incoming><bpmn:outgoing>ID03_Flow20</bpmn:outgoing><bpmn:outgoing>ID03_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ID03_E5_T1" name="Decidir o que proteger: tipo de marca, classes e domínios"><bpmn:documentation>Etapa 5: Proteger a marca. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID03_Flow20</bpmn:incoming><bpmn:outgoing>ID03_Flow22</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="ID03_E5_T2" name="Registrar os perfis da marca"><bpmn:documentation>Etapa 5: Proteger a marca. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID03_Flow22</bpmn:incoming><bpmn:outgoing>ID03_Flow23</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="ID03_E5_T3" name="Depositar o pedido de registro no INPI"><bpmn:documentation>Etapa 5: Proteger a marca. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID03_Flow23</bpmn:incoming><bpmn:outgoing>ID03_Flow24</bpmn:outgoing></bpmn:task>
    <bpmn:task id="ID03_E5_T4" name="Assumir os prazos de acompanhamento e renovação"><bpmn:documentation>Etapa 5: Proteger a marca. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID03_Flow24</bpmn:incoming><bpmn:outgoing>ID03_Flow25</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="ID03_M3"><bpmn:incoming>ID03_Flow8</bpmn:incoming><bpmn:incoming>ID03_Flow25</bpmn:incoming><bpmn:outgoing>ID03_Flow33</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID03_E6_T1" name="Montar manual, modelos e arquivos para pessoas e agentes"><bpmn:documentation>Etapa 6: Montar o pacote de marca. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID03_Flow33</bpmn:incoming><bpmn:outgoing>ID03_Flow26</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:businessRuleTask id="ID03_E6_T2" name="Conferir o pacote contra o padrão"><bpmn:documentation>Etapa 6: Montar o pacote de marca. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID03_Flow26</bpmn:incoming><bpmn:outgoing>ID03_Flow27</bpmn:outgoing></bpmn:businessRuleTask>
