    <bpmn:group id="Group_ID03_E7" categoryValueRef="CV_ID03_E7" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ID03" name="Criar ou rever e registrar a marca de uma empresa, oferta ou projeto" isExecutable="false">
    <bpmn:documentation>Decidir se o negócio novo usa uma marca existente ou ganha marca própria e, quando ganha, entregá-la criada, protegida e pronta para uso por pessoas e agentes. Vale também para a revisão de uma marca existente.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID03">
      <bpmn:lane id="Lane_ID03_SOL" name="Solicitante">
        <bpmn:flowNodeRef>ID03_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID03_EST" name="Estratégia">
        <bpmn:flowNodeRef>ID03_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID03_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>ID03_E4_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID03_E4_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID03_ASS" name="Assessoria externa">
        <bpmn:flowNodeRef>ID03_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID03_GOV" name="Governança">
        <bpmn:flowNodeRef>ID03_E5_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID03_E5_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID03_IDP" name="Identidade · pessoa">
