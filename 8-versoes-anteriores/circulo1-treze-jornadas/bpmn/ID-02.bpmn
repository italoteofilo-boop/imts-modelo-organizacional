    <bpmn:manualTask id="ID02_E3_T3" name="Aprovar os critérios e os limites novos"><bpmn:documentation>Etapa 3: Testar os padrões em casos reais. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID02_Flow24</bpmn:incoming><bpmn:outgoing>ID02_Flow25</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ID02_M3"><bpmn:incoming>ID02_Flow23</bpmn:incoming><bpmn:incoming>ID02_Flow25</bpmn:incoming><bpmn:outgoing>ID02_Flow33</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID02_E4_T1" name="Versionar os padrões no catálogo"><bpmn:documentation>Etapa 4: Publicar e implantar. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID02_Flow33</bpmn:incoming><bpmn:outgoing>ID02_Flow26</bpmn:outgoing></bpmn:scriptTask>
