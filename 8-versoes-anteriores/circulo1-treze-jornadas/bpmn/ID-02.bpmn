        <bpmn:flowNodeRef>ID02_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID02_E2_T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID02_E4_T2</bpmn:flowNodeRef>
