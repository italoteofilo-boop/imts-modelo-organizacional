    <bpmn:serviceTask id="ID02_E3_T1" name="Aplicar os padrões a uma amostra de casos passados"><bpmn:documentation>Etapa 3: Testar os padrões em casos reais. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID02_Flow18</bpmn:incoming><bpmn:outgoing>ID02_Flow19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID02_E3_T2" name="Julgar os casos de fronteira nos testes"><bpmn:documentation>Etapa 3: Testar os padrões em casos reais. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID02_Flow19</bpmn:incoming><bpmn:outgoing>ID02_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID02_E3_G1" name="Os padrões separam o certo do errado?"><bpmn:incoming>ID02_Flow20</bpmn:incoming><bpmn:outgoing>ID02_Flow21</bpmn:outgoing><bpmn:outgoing>ID02_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
