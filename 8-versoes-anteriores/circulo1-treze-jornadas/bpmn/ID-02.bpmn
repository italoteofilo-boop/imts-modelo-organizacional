  <bpmn:category id="Category_ID02">
    <bpmn:categoryValue id="CV_ID02_E1" value="1. Delimitar o que precisa de padrão" />
    <bpmn:categoryValue id="CV_ID02_E2" value="2. Escrever os padrões em três frentes paralelas" />
    <bpmn:categoryValue id="CV_ID02_E3" value="3. Testar os padrões em casos reais" />
    <bpmn:categoryValue id="CV_ID02_E4" value="4. Publicar e implantar" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID02">
    <bpmn:participant id="Participant_ID02" name="ID-02 · Transformar a identidade em regras práticas para pessoas e agentes" processRef="Process_ID02" />
    <bpmn:group id="Group_ID02_E1" categoryValueRef="CV_ID02_E1" />
