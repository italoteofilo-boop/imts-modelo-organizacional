    <bpmn:startEvent id="ID02_S1" name="Padrão pedido para agente ou canal novo"><bpmn:outgoing>ID02_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ID02_S1_def" /></bpmn:startEvent>
