  </bpmn:collaboration>
  <bpmn:process id="Process_ID02" name="Transformar a identidade em regras práticas para pessoas e agentes" isExecutable="false">
    <bpmn:documentation>Converter a declaração em padrões que qualquer pessoa ou agente aplica sem consultar o fundador: critérios de decisão, comportamentos por valor, perfil de pessoa, rituais, protocolo de crise, guia de voz, persona dos agentes e casos de teste.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID02">
      <bpmn:lane id="Lane_ID02_SOC" name="Sócios">
        <bpmn:flowNodeRef>ID02_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
