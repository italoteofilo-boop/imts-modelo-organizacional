<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ID07" targetNamespace="urn:imts:modelo:identidade" exporter="Ecossistema IMTS - fonte única do Círculo 1" exporterVersion="2026-10-01">
  <bpmn:category id="Category_ID07">
    <bpmn:categoryValue id="CV_ID07_E1" value="1. Convidar a pessoa" />
    <bpmn:categoryValue id="CV_ID07_E2" value="2. Descobrir o propósito pessoal" />
    <bpmn:categoryValue id="CV_ID07_E3" value="3. Ligar o propósito ao papel" />
    <bpmn:categoryValue id="CV_ID07_E4" value="4. Montar o plano de ações ligado ao propósito" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID07">
    <bpmn:participant id="Participant_ID07" name="ID-07 · Ajudar cada pessoa a ligar o seu propósito ao seu papel" processRef="Process_ID07" />
    <bpmn:group id="Group_ID07_E1" categoryValueRef="CV_ID07_E1" />
    <bpmn:group id="Group_ID07_E2" categoryValueRef="CV_ID07_E2" />
    <bpmn:group id="Group_ID07_E3" categoryValueRef="CV_ID07_E3" />
    <bpmn:group id="Group_ID07_E4" categoryValueRef="CV_ID07_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ID07" name="Ajudar cada pessoa a ligar o seu propósito ao seu papel" isExecutable="false">
    <bpmn:documentation>Dar a cada pessoa que quiser um propósito pessoal declarado, ligado ao seu papel e a um plano de desenvolvimento. A participação é voluntária, a declaração fica com a pessoa e ela escolhe o que compartilha.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID07">
      <bpmn:lane id="Lane_ID07_GES" name="Gestão">
        <bpmn:flowNodeRef>ID07_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID07_PES" name="Pessoa">
        <bpmn:flowNodeRef>ID07_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_E4_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID07_IDA" name="Identidade · agente">
        <bpmn:flowNodeRef>ID07_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_E4_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID07_IDR" name="Identidade · automação">
        <bpmn:flowNodeRef>ID07_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_E4_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID07_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ID07_S1" name="Ciclo de desenvolvimento aberto"><bpmn:outgoing>ID07_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ID07_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ID07_S2" name="Pessoa integrada à cultura"><bpmn:outgoing>ID07_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="ID07_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="ID07_M1"><bpmn:incoming>ID07_Flow1</bpmn:incoming><bpmn:incoming>ID07_Flow2</bpmn:incoming><bpmn:outgoing>ID07_Flow16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID07_E1_T1" name="Convidar a pessoa e explicar que a participação é voluntária"><bpmn:documentation>Etapa 1: Convidar a pessoa. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID07_Flow16</bpmn:incoming><bpmn:outgoing>ID07_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="ID07_E1_T2" name="Aceitar ou recusar o convite"><bpmn:documentation>Etapa 1: Convidar a pessoa. Executor: Pessoa de fora do círculo (Pessoa). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID07_Flow3</bpmn:incoming><bpmn:outgoing>ID07_Flow4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID07_E1_G1" name="Pessoa quer participar?"><bpmn:incoming>ID07_Flow4</bpmn:incoming><bpmn:outgoing>ID07_Flow5</bpmn:outgoing><bpmn:outgoing>ID07_Flow6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="ID07_F2" name="Pessoa optou por não participar"><bpmn:incoming>ID07_Flow6</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="ID07_E2_T1" name="Guiar a reflexão sobre histórias, valores e forças"><bpmn:documentation>Etapa 2: Descobrir o propósito pessoal. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID07_Flow5</bpmn:incoming><bpmn:outgoing>ID07_Flow7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID07_E2_T2" name="Escrever a declaração de propósito pessoal"><bpmn:documentation>Etapa 2: Descobrir o propósito pessoal. Executor: Pessoa de fora do círculo (Pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID07_Flow7</bpmn:incoming><bpmn:outgoing>ID07_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="ID07_E3_T1" name="Conversar com o líder sobre propósito e papel"><bpmn:documentation>Etapa 3: Ligar o propósito ao papel. Executor: Pessoa de fora do círculo (Pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID07_Flow8</bpmn:incoming><bpmn:outgoing>ID07_Flow9</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ID07_E3_G1" name="Pessoa e líder concordam que o papel serve ao propósito?"><bpmn:incoming>ID07_Flow9</bpmn:incoming><bpmn:outgoing>ID07_Flow10</bpmn:outgoing><bpmn:outgoing>ID07_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="ID07_E3_T2" name="Avaliar ajuste de papel, com o acordo da pessoa"><bpmn:documentation>Etapa 3: Ligar o propósito ao papel. Executor: Outro círculo (Gestão). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID07_Flow11</bpmn:incoming><bpmn:outgoing>ID07_Flow12</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="ID07_M2"><bpmn:incoming>ID07_Flow10</bpmn:incoming><bpmn:incoming>ID07_Flow12</bpmn:incoming><bpmn:outgoing>ID07_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID07_E4_T1" name="Propor ações e desenvolvimento a partir do propósito"><bpmn:documentation>Etapa 4: Montar o plano de ações ligado ao propósito. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID07_Flow17</bpmn:incoming><bpmn:outgoing>ID07_Flow13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID07_E4_T2" name="Fechar o plano com o líder"><bpmn:documentation>Etapa 4: Montar o plano de ações ligado ao propósito. Executor: Pessoa de fora do círculo (Pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID07_Flow13</bpmn:incoming><bpmn:outgoing>ID07_Flow14</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="ID07_E4_T3" name="Registrar o plano no ciclo de desenvolvimento"><bpmn:documentation>Etapa 4: Montar o plano de ações ligado ao propósito. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID07_Flow14</bpmn:incoming><bpmn:outgoing>ID07_Flow15</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="ID07_F1" name="Plano de propósito registrado"><bpmn:incoming>ID07_Flow15</bpmn:incoming></bpmn:endEvent>
