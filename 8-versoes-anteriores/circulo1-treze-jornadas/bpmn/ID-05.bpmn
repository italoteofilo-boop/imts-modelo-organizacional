<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ID05" targetNamespace="urn:imts:modelo:identidade" exporter="Ecossistema IMTS - fonte única do Círculo 1" exporterVersion="2026-10-01">
  <bpmn:category id="Category_ID05">
    <bpmn:categoryValue id="CV_ID05_E1" value="1. Preparar a trilha de integração" />
    <bpmn:categoryValue id="CV_ID05_E2" value="2. Apresentar propósito, valores e comportamentos" />
    <bpmn:categoryValue id="CV_ID05_E3" value="3. Conectar a pessoa à comunidade" />
    <bpmn:categoryValue id="CV_ID05_E4" value="4. Verificar a integração" />
    <bpmn:categoryValue id="CV_ID05_E5" value="5. Registrar a conclusão e avisar a Gestão e o líder" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID05">
    <bpmn:participant id="Participant_ID05" name="ID-05 · Integrar pessoas novas à cultura" processRef="Process_ID05" />
    <bpmn:group id="Group_ID05_E1" categoryValueRef="CV_ID05_E1" />
    <bpmn:group id="Group_ID05_E2" categoryValueRef="CV_ID05_E2" />
    <bpmn:group id="Group_ID05_E3" categoryValueRef="CV_ID05_E3" />
    <bpmn:group id="Group_ID05_E4" categoryValueRef="CV_ID05_E4" />
    <bpmn:group id="Group_ID05_E5" categoryValueRef="CV_ID05_E5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ID05" name="Integrar pessoas novas à cultura" isExecutable="false">
    <bpmn:documentation>Fazer cada pessoa nova entender o propósito, os valores e os comportamentos esperados, e sentir-se parte, antes de responder sozinha pelo seu papel.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID05">
      <bpmn:lane id="Lane_ID05_EST" name="Estratégia">
        <bpmn:flowNodeRef>ID05_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID05_GES" name="Gestão">
        <bpmn:flowNodeRef>ID05_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID05_LID" name="Líder da equipe">
        <bpmn:flowNodeRef>ID05_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E4_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID05_PES" name="Pessoa">
        <bpmn:flowNodeRef>ID05_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID05_IDP" name="Identidade · pessoa">
        <bpmn:flowNodeRef>ID05_E4_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID05_IDA" name="Identidade · agente">
        <bpmn:flowNodeRef>ID05_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E4_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID05_IDR" name="Identidade · automação">
        <bpmn:flowNodeRef>ID05_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E4_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E5_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_E5_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID05_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ID05_S1" name="Pessoa contratada ou que mudou de papel"><bpmn:outgoing>ID05_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ID05_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ID05_S2" name="Empresa incorporada com pessoas a integrar"><bpmn:outgoing>ID05_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="ID05_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="ID05_M1"><bpmn:incoming>ID05_Flow1</bpmn:incoming><bpmn:incoming>ID05_Flow2</bpmn:incoming><bpmn:outgoing>ID05_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID05_E1_T1" name="Abrir a integração e agendar os marcos"><bpmn:documentation>Etapa 1: Preparar a trilha de integração. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow19</bpmn:incoming><bpmn:outgoing>ID05_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="ID05_E1_T2" name="Montar a trilha conforme o papel"><bpmn:documentation>Etapa 1: Preparar a trilha de integração. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow3</bpmn:incoming><bpmn:outgoing>ID05_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ID05_M2"><bpmn:incoming>ID05_Flow4</bpmn:incoming><bpmn:incoming>ID05_Flow14</bpmn:incoming><bpmn:outgoing>ID05_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID05_E2_T1" name="Conduzir a trilha e tirar dúvidas"><bpmn:documentation>Etapa 2: Apresentar propósito, valores e comportamentos. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow20</bpmn:incoming><bpmn:outgoing>ID05_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="ID05_E2_T2" name="Conversar sobre como os valores aparecem no dia a dia da função"><bpmn:documentation>Etapa 2: Apresentar propósito, valores e comportamentos. Executor: Pessoa de fora do círculo (Líder da equipe). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow5</bpmn:incoming><bpmn:outgoing>ID05_Flow6</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="ID05_E2_T3" name="Concluir a trilha"><bpmn:documentation>Etapa 2: Apresentar propósito, valores e comportamentos. Executor: Pessoa de fora do círculo (Pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow6</bpmn:incoming><bpmn:outgoing>ID05_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="ID05_E3_T1" name="Indicar um padrinho ou uma madrinha"><bpmn:documentation>Etapa 3: Conectar a pessoa à comunidade. Executor: Pessoa de fora do círculo (Líder da equipe). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow7</bpmn:incoming><bpmn:outgoing>ID05_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="ID05_E3_T2" name="Participar do primeiro ritual"><bpmn:documentation>Etapa 3: Conectar a pessoa à comunidade. Executor: Pessoa de fora do círculo (Pessoa). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow8</bpmn:incoming><bpmn:outgoing>ID05_Flow9</bpmn:outgoing></bpmn:manualTask>
    <bpmn:serviceTask id="ID05_E4_T1" name="Aplicar a verificação de entendimento e de pertencimento"><bpmn:documentation>Etapa 4: Verificar a integração. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow9</bpmn:incoming><bpmn:outgoing>ID05_Flow10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID05_E4_T2" name="Confirmar os comportamentos observados"><bpmn:documentation>Etapa 4: Verificar a integração. Executor: Pessoa de fora do círculo (Líder da equipe). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow10</bpmn:incoming><bpmn:outgoing>ID05_Flow11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID05_E4_G1" name="Pessoa integrada?"><bpmn:incoming>ID05_Flow11</bpmn:incoming><bpmn:outgoing>ID05_Flow12</bpmn:outgoing><bpmn:outgoing>ID05_Flow13</bpmn:outgoing><bpmn:outgoing>ID05_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ID05_E4_T3" name="Combinar o reforço com o líder"><bpmn:documentation>Etapa 4: Verificar a integração. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow13</bpmn:incoming><bpmn:outgoing>ID05_Flow14</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="ID05_E4_T4" name="Avisar a Gestão de que a pessoa não se integrou"><bpmn:documentation>Etapa 4: Verificar a integração. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow15</bpmn:incoming><bpmn:outgoing>ID05_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="ID05_F2" name="Pessoa não integrada: caso devolvido à Gestão"><bpmn:incoming>ID05_Flow16</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="ID05_E5_T1" name="Registrar a conclusão e avisar Gestão e líder"><bpmn:documentation>Etapa 5: Registrar a conclusão e avisar a Gestão e o líder. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow12</bpmn:incoming><bpmn:outgoing>ID05_Flow17</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="ID05_E5_T2" name="Enviar os dados agregados ao diagnóstico"><bpmn:documentation>Etapa 5: Registrar a conclusão e avisar a Gestão e o líder. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow17</bpmn:incoming><bpmn:outgoing>ID05_Flow18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="ID05_F1" name="Pessoa integrada à cultura"><bpmn:incoming>ID05_Flow18</bpmn:incoming></bpmn:endEvent>
