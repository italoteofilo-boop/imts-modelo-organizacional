        <bpmn:flowNodeRef>ID11_E5_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID11_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ID11_S1" name="Reclamação de incoerência recebida"><bpmn:outgoing>ID11_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ID11_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ID11_S2" name="Ciclo de auditoria iniciado"><bpmn:outgoing>ID11_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="ID11_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="ID11_M1"><bpmn:incoming>ID11_Flow1</bpmn:incoming><bpmn:incoming>ID11_Flow2</bpmn:incoming><bpmn:outgoing>ID11_Flow27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID11_E1_T1" name="Sortear a amostra e incluir os itens reclamados"><bpmn:documentation>Etapa 1: Sortear a amostra. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow27</bpmn:incoming><bpmn:outgoing>ID11_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="ID11_E2_T1" name="Aplicar os padrões e os casos de teste a cada item"><bpmn:documentation>Etapa 2: Comparar com os padrões. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow3</bpmn:incoming><bpmn:outgoing>ID11_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:businessRuleTask id="ID11_E2_T2" name="Separar conformes, desvios e casos de fronteira"><bpmn:documentation>Etapa 2: Comparar com os padrões. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow4</bpmn:incoming><bpmn:outgoing>ID11_Flow5</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="ID11_E2_G1" name="Há desvio ou caso de fronteira?"><bpmn:incoming>ID11_Flow5</bpmn:incoming><bpmn:outgoing>ID11_Flow6</bpmn:outgoing><bpmn:outgoing>ID11_Flow7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ID11_E3_T1" name="Julgar os casos de fronteira"><bpmn:documentation>Etapa 3: Julgar os casos e achar a causa. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID11_Flow6</bpmn:incoming><bpmn:outgoing>ID11_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID11_E3_G1" name="Há desvio confirmado?"><bpmn:incoming>ID11_Flow8</bpmn:incoming><bpmn:outgoing>ID11_Flow9</bpmn:outgoing><bpmn:outgoing>ID11_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID11_E3_T2" name="Agrupar os desvios e apontar a causa provável"><bpmn:documentation>Etapa 3: Julgar os casos e achar a causa. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID11_Flow10</bpmn:incoming><bpmn:outgoing>ID11_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID11_E3_T3" name="Confirmar a causa de cada grupo"><bpmn:documentation>Etapa 3: Julgar os casos e achar a causa. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID11_Flow11</bpmn:incoming><bpmn:outgoing>ID11_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="ID11_E4_T1" name="Pedir a correção ou a retirada do item ao dono da entrega"><bpmn:documentation>Etapa 4: Encaminhar e acompanhar a correção. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow12</bpmn:incoming><bpmn:outgoing>ID11_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ID11_E4_G1" name="Qual é a causa do grupo de desvios?"><bpmn:incoming>ID11_Flow13</bpmn:incoming><bpmn:outgoing>ID11_Flow14</bpmn:outgoing><bpmn:outgoing>ID11_Flow15</bpmn:outgoing><bpmn:outgoing>ID11_Flow16</bpmn:outgoing><bpmn:outgoing>ID11_Flow17</bpmn:outgoing><bpmn:outgoing>ID11_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="ID11_E4_T2" name="Corrigir o agente"><bpmn:documentation>Etapa 4: Encaminhar e acompanhar a correção. Executor: Outro círculo (Integração). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow14</bpmn:incoming><bpmn:outgoing>ID11_Flow19</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="ID11_E4_T3" name="Reforçar o preparo da pessoa"><bpmn:documentation>Etapa 4: Encaminhar e acompanhar a correção. Executor: Pessoa de fora do círculo (Líder da equipe). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow15</bpmn:incoming><bpmn:outgoing>ID11_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:callActivity id="ID11_E4_T4" name="Tratar o indício de conduta"><bpmn:documentation>Etapa 4: Encaminhar e acompanhar a correção. Executor: Outro círculo (Governança). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow16</bpmn:incoming><bpmn:outgoing>ID11_Flow21</bpmn:outgoing></bpmn:callActivity>
    <bpmn:userTask id="ID11_E4_T5" name="Abrir a revisão do padrão"><bpmn:documentation>Etapa 4: Encaminhar e acompanhar a correção. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow17</bpmn:incoming><bpmn:outgoing>ID11_Flow22</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="ID11_E4_T6" name="Tratar a causa não prevista"><bpmn:documentation>Etapa 4: Encaminhar e acompanhar a correção. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow18</bpmn:incoming><bpmn:outgoing>ID11_Flow23</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID11_M2"><bpmn:incoming>ID11_Flow19</bpmn:incoming><bpmn:incoming>ID11_Flow20</bpmn:incoming><bpmn:incoming>ID11_Flow21</bpmn:incoming><bpmn:incoming>ID11_Flow22</bpmn:incoming><bpmn:incoming>ID11_Flow23</bpmn:incoming><bpmn:outgoing>ID11_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID11_E4_T7" name="Registrar o dono e o prazo de cada correção"><bpmn:documentation>Etapa 4: Encaminhar e acompanhar a correção. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID11_Flow28</bpmn:incoming><bpmn:outgoing>ID11_Flow24</bpmn:outgoing></bpmn:scriptTask>
