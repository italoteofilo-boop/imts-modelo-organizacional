        <bpmn:flowNodeRef>ID11_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID11_E5_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID11_IDR" name="Identidade · automação">
        <bpmn:flowNodeRef>ID11_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID11_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID11_E1_T1</bpmn:flowNodeRef>
