  <bpmn:process id="Process_ID11" name="Auditar se as entregas de pessoas e agentes seguem a identidade" isExecutable="false">
    <bpmn:documentation>Medir por amostra se o que sai (propostas, mensagens, conteúdos e decisões) respeita critérios, voz e marca, e corrigir a causa dos desvios.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID11">
      <bpmn:lane id="Lane_ID11_REL" name="Relações">
        <bpmn:flowNodeRef>ID11_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID11_ITG" name="Integração">
        <bpmn:flowNodeRef>ID11_E4_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID11_LID" name="Líder da equipe">
        <bpmn:flowNodeRef>ID11_E4_T3</bpmn:flowNodeRef>
      </bpmn:lane>
