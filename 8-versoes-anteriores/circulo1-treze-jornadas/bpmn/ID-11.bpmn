    <bpmn:categoryValue id="CV_ID11_E1" value="1. Sortear a amostra" />
    <bpmn:categoryValue id="CV_ID11_E2" value="2. Comparar com os padrões" />
    <bpmn:categoryValue id="CV_ID11_E3" value="3. Julgar os casos e achar a causa" />
    <bpmn:categoryValue id="CV_ID11_E4" value="4. Encaminhar e acompanhar a correção" />
    <bpmn:categoryValue id="CV_ID11_E5" value="5. Publicar o índice e as lições" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID11">
    <bpmn:participant id="Participant_ID11" name="ID-11 · Auditar se as entregas de pessoas e agentes seguem a identidade" processRef="Process_ID11" />
