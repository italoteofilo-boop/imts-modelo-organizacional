  <bpmn:category id="Category_ID08">
    <bpmn:categoryValue id="CV_ID08_E1" value="1. Levantar os insumos" />
    <bpmn:categoryValue id="CV_ID08_E2" value="2. Formular o posicionamento e a promessa por público" />
    <bpmn:categoryValue id="CV_ID08_E3" value="3. Validar o posicionamento com Estratégia, Relações, Gestão e executivos" />
    <bpmn:categoryValue id="CV_ID08_E4" value="4. Montar as mensagens principais e a narrativa por público" />
    <bpmn:categoryValue id="CV_ID08_E5" value="5. Publicar e preparar os porta-vozes" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID08">
    <bpmn:participant id="Participant_ID08" name="ID-08 · Definir o posicionamento institucional e as mensagens para cada público" processRef="Process_ID08" />
    <bpmn:group id="Group_ID08_E1" categoryValueRef="CV_ID08_E1" />
    <bpmn:group id="Group_ID08_E2" categoryValueRef="CV_ID08_E2" />
    <bpmn:group id="Group_ID08_E3" categoryValueRef="CV_ID08_E3" />
