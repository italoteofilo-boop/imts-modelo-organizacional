    <bpmn:group id="Group_ID08_E5" categoryValueRef="CV_ID08_E5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ID08" name="Definir o posicionamento institucional e as mensagens para cada público" isExecutable="false">
    <bpmn:documentation>Definir uma promessa clara e as mensagens principais para cada público, no nível do Ecossistema e de cada empresa, para uso de pessoas e agentes.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID08">
      <bpmn:lane id="Lane_ID08_EST" name="Estratégia">
        <bpmn:flowNodeRef>ID08_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E3_PS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID08_REL" name="Relações">
        <bpmn:flowNodeRef>ID08_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID08_GES" name="Gestão">
        <bpmn:flowNodeRef>ID08_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E3_PJ1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID08_ITG" name="Integração">
        <bpmn:flowNodeRef>ID08_E5_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID08_IDP" name="Identidade · pessoa">
        <bpmn:flowNodeRef>ID08_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E5_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID08_IDA" name="Identidade · agente">
        <bpmn:flowNodeRef>ID08_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E4_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID08_IDR" name="Identidade · automação">
        <bpmn:flowNodeRef>ID08_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_E5_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID08_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ID08_S1" name="Direção estratégica do ciclo aprovada"><bpmn:outgoing>ID08_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ID08_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ID08_S2" name="Lacuna de imagem apontada"><bpmn:outgoing>ID08_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="ID08_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ID08_S3" name="Nova versão da declaração publicada"><bpmn:outgoing>ID08_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="ID08_S3_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="ID08_M1"><bpmn:incoming>ID08_Flow1</bpmn:incoming><bpmn:incoming>ID08_Flow2</bpmn:incoming><bpmn:incoming>ID08_Flow3</bpmn:incoming><bpmn:outgoing>ID08_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID08_E1_T1" name="Reunir e resumir os insumos"><bpmn:documentation>Etapa 1: Levantar os insumos. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID08_Flow24</bpmn:incoming><bpmn:outgoing>ID08_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID08_E1_T2" name="Definir os públicos e as perguntas a responder"><bpmn:documentation>Etapa 1: Levantar os insumos. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID08_Flow4</bpmn:incoming><bpmn:outgoing>ID08_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID08_M2"><bpmn:incoming>ID08_Flow5</bpmn:incoming><bpmn:incoming>ID08_Flow18</bpmn:incoming><bpmn:outgoing>ID08_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID08_E2_T1" name="Propor posicionamento e promessa para cada público"><bpmn:documentation>Etapa 2: Formular o posicionamento e a promessa por público. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID08_Flow25</bpmn:incoming><bpmn:outgoing>ID08_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID08_E2_T2" name="Separar o que é do Ecossistema e o que é de cada empresa"><bpmn:documentation>Etapa 2: Formular o posicionamento e a promessa por público. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID08_Flow6</bpmn:incoming><bpmn:outgoing>ID08_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="ID08_E2_T3" name="Escolher e ajustar a proposta"><bpmn:documentation>Etapa 2: Formular o posicionamento e a promessa por público. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID08_Flow7</bpmn:incoming><bpmn:outgoing>ID08_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="ID08_E3_PS1"><bpmn:incoming>ID08_Flow8</bpmn:incoming><bpmn:outgoing>ID08_Flow9</bpmn:outgoing><bpmn:outgoing>ID08_Flow11</bpmn:outgoing><bpmn:outgoing>ID08_Flow13</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="ID08_E3_T1" name="Conferir a coerência com a estratégia"><bpmn:documentation>Etapa 3: Validar o posicionamento com Estratégia, Relações, Gestão e executivos. Executor: Outro círculo (Estratégia). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID08_Flow9</bpmn:incoming><bpmn:outgoing>ID08_Flow10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="ID08_E3_T2" name="Conferir o uso em marketing e relacionamento"><bpmn:documentation>Etapa 3: Validar o posicionamento com Estratégia, Relações, Gestão e executivos. Executor: Outro círculo (Relações). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID08_Flow11</bpmn:incoming><bpmn:outgoing>ID08_Flow12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="ID08_E3_T3" name="Conferir a promessa para pessoas"><bpmn:documentation>Etapa 3: Validar o posicionamento com Estratégia, Relações, Gestão e executivos. Executor: Outro círculo (Gestão). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID08_Flow13</bpmn:incoming><bpmn:outgoing>ID08_Flow14</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="ID08_E3_PJ1"><bpmn:incoming>ID08_Flow10</bpmn:incoming><bpmn:incoming>ID08_Flow12</bpmn:incoming><bpmn:incoming>ID08_Flow14</bpmn:incoming><bpmn:outgoing>ID08_Flow15</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:manualTask id="ID08_E3_T4" name="Fechar o posicionamento com os executivos"><bpmn:documentation>Etapa 3: Validar o posicionamento com Estratégia, Relações, Gestão e executivos. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID08_Flow15</bpmn:incoming><bpmn:outgoing>ID08_Flow16</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ID08_E3_G1" name="Posicionamento aprovado?"><bpmn:incoming>ID08_Flow16</bpmn:incoming><bpmn:outgoing>ID08_Flow17</bpmn:outgoing><bpmn:outgoing>ID08_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID08_E4_T1" name="Redigir mensagens-chave, provas e narrativa por público"><bpmn:documentation>Etapa 4: Montar as mensagens principais e a narrativa por público. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID08_Flow17</bpmn:incoming><bpmn:outgoing>ID08_Flow19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID08_E4_T2" name="Revisar e aprovar as mensagens"><bpmn:documentation>Etapa 4: Montar as mensagens principais e a narrativa por público. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID08_Flow19</bpmn:incoming><bpmn:outgoing>ID08_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="ID08_E5_T1" name="Publicar no repositório e avisar os círculos"><bpmn:documentation>Etapa 5: Publicar e preparar os porta-vozes. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID08_Flow20</bpmn:incoming><bpmn:outgoing>ID08_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="ID08_E5_T2" name="Carregar as mensagens nos agentes que falam com os públicos"><bpmn:documentation>Etapa 5: Publicar e preparar os porta-vozes. Executor: Outro círculo (Integração). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID08_Flow21</bpmn:incoming><bpmn:outgoing>ID08_Flow22</bpmn:outgoing></bpmn:task>
    <bpmn:manualTask id="ID08_E5_T3" name="Preparar os porta-vozes"><bpmn:documentation>Etapa 5: Publicar e preparar os porta-vozes. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID08_Flow22</bpmn:incoming><bpmn:outgoing>ID08_Flow23</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="ID08_F1" name="Posicionamento e mensagens publicados"><bpmn:incoming>ID08_Flow23</bpmn:incoming></bpmn:endEvent>
