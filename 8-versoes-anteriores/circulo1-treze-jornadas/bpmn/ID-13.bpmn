<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ID13" targetNamespace="urn:imts:modelo:identidade" exporter="Ecossistema IMTS - fonte única do Círculo 1" exporterVersion="2026-10-01">
  <bpmn:category id="Category_ID13">
    <bpmn:categoryValue id="CV_ID13_E1" value="1. Definir os temas e os indicadores de impacto" />
    <bpmn:categoryValue id="CV_ID13_E2" value="2. Coletar os dados" />
    <bpmn:categoryValue id="CV_ID13_E3" value="3. Analisar o impacto" />
    <bpmn:categoryValue id="CV_ID13_E4" value="4. Redigir e validar o relato" />
    <bpmn:categoryValue id="CV_ID13_E5" value="5. Publicar o relato e levá-lo aos públicos" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID13">
    <bpmn:participant id="Participant_ID13" name="ID-13 · Apurar e publicar o relato anual de impacto" processRef="Process_ID13" />
    <bpmn:group id="Group_ID13_E1" categoryValueRef="CV_ID13_E1" />
    <bpmn:group id="Group_ID13_E2" categoryValueRef="CV_ID13_E2" />
    <bpmn:group id="Group_ID13_E3" categoryValueRef="CV_ID13_E3" />
    <bpmn:group id="Group_ID13_E4" categoryValueRef="CV_ID13_E4" />
    <bpmn:group id="Group_ID13_E5" categoryValueRef="CV_ID13_E5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ID13" name="Apurar e publicar o relato anual de impacto" isExecutable="false">
    <bpmn:documentation>Provar com dados o impacto gerado pelo Ecossistema na vida das pessoas e prestar contas aos públicos, incluindo o que não foi alcançado.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID13">
      <bpmn:lane id="Lane_ID13_SOC" name="Sócios">
        <bpmn:flowNodeRef>ID13_E4_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E4_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID13_GOV" name="Governança">
        <bpmn:flowNodeRef>ID13_E4_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID13_EST" name="Estratégia">
        <bpmn:flowNodeRef>ID13_E1_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID13_INT" name="Inteligência">
        <bpmn:flowNodeRef>ID13_E2_PS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E2_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID13_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>ID13_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E2_PJ1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID13_REL" name="Relações">
        <bpmn:flowNodeRef>ID13_E5_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID13_IDP" name="Identidade · pessoa">
        <bpmn:flowNodeRef>ID13_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID13_IDA" name="Identidade · agente">
        <bpmn:flowNodeRef>ID13_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E4_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID13_IDR" name="Identidade · automação">
        <bpmn:flowNodeRef>ID13_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_E5_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID13_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ID13_S1" name="Ciclo anual de relato iniciado"><bpmn:outgoing>ID13_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="ID13_S1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="ID13_E1_T1" name="Propor temas e indicadores pelas cinco dimensões de impacto"><bpmn:documentation>Etapa 1: Definir os temas e os indicadores de impacto. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID13_Flow1</bpmn:incoming><bpmn:outgoing>ID13_Flow2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="ID13_E1_T2" name="Conferir os temas com os alvos do ciclo"><bpmn:documentation>Etapa 1: Definir os temas e os indicadores de impacto. Executor: Outro círculo (Estratégia). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID13_Flow2</bpmn:incoming><bpmn:outgoing>ID13_Flow3</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="ID13_E1_T3" name="Decidir temas e indicadores"><bpmn:documentation>Etapa 1: Definir os temas e os indicadores de impacto. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID13_Flow3</bpmn:incoming><bpmn:outgoing>ID13_Flow4</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="ID13_E2_PS1"><bpmn:incoming>ID13_Flow4</bpmn:incoming><bpmn:outgoing>ID13_Flow5</bpmn:outgoing><bpmn:outgoing>ID13_Flow7</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="ID13_E2_T1" name="Fornecer os indicadores"><bpmn:documentation>Etapa 2: Coletar os dados. Executor: Outro círculo (Inteligência). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID13_Flow5</bpmn:incoming><bpmn:outgoing>ID13_Flow6</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="ID13_E2_T2" name="Fornecer evidências e casos da empresa"><bpmn:documentation>Etapa 2: Coletar os dados. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID13_Flow7</bpmn:incoming><bpmn:outgoing>ID13_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="ID13_E2_PJ1"><bpmn:incoming>ID13_Flow6</bpmn:incoming><bpmn:incoming>ID13_Flow8</bpmn:incoming><bpmn:outgoing>ID13_Flow9</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="ID13_E2_T3" name="Consolidar os dados e apontar falhas"><bpmn:documentation>Etapa 2: Coletar os dados. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID13_Flow9</bpmn:incoming><bpmn:outgoing>ID13_Flow10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ID13_E2_G1" name="Dados completos e verificáveis?"><bpmn:incoming>ID13_Flow10</bpmn:incoming><bpmn:outgoing>ID13_Flow11</bpmn:outgoing><bpmn:outgoing>ID13_Flow12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ID13_E2_T4" name="Retirar o indicador sem dado ou registrar a ressalva"><bpmn:documentation>Etapa 2: Coletar os dados. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID13_Flow12</bpmn:incoming><bpmn:outgoing>ID13_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID13_M1"><bpmn:incoming>ID13_Flow11</bpmn:incoming><bpmn:incoming>ID13_Flow13</bpmn:incoming><bpmn:outgoing>ID13_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID13_E3_T1" name="Analisar o que mudou, para quem, quanto, qual foi a nossa contribuição e qual é o risco"><bpmn:documentation>Etapa 3: Analisar o impacto. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID13_Flow23</bpmn:incoming><bpmn:outgoing>ID13_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID13_E3_T2" name="Interpretar o resultado, incluindo o que não foi alcançado"><bpmn:documentation>Etapa 3: Analisar o impacto. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID13_Flow14</bpmn:incoming><bpmn:outgoing>ID13_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID13_M2"><bpmn:incoming>ID13_Flow15</bpmn:incoming><bpmn:incoming>ID13_Flow20</bpmn:incoming><bpmn:outgoing>ID13_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID13_E4_T1" name="Redigir o relato"><bpmn:documentation>Etapa 4: Redigir e validar o relato. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID13_Flow24</bpmn:incoming><bpmn:outgoing>ID13_Flow16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="ID13_E4_T2" name="Conferir os dados e as afirmações"><bpmn:documentation>Etapa 4: Redigir e validar o relato. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID13_Flow16</bpmn:incoming><bpmn:outgoing>ID13_Flow17</bpmn:outgoing></bpmn:task>
    <bpmn:manualTask id="ID13_E4_T3" name="Aprovar a publicação"><bpmn:documentation>Etapa 4: Redigir e validar o relato. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>ID13_Flow17</bpmn:incoming><bpmn:outgoing>ID13_Flow18</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ID13_E4_G1" name="Relato aprovado?"><bpmn:incoming>ID13_Flow18</bpmn:incoming><bpmn:outgoing>ID13_Flow19</bpmn:outgoing><bpmn:outgoing>ID13_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID13_E5_T1" name="Publicar o relato"><bpmn:documentation>Etapa 5: Publicar o relato e levá-lo aos públicos. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID13_Flow19</bpmn:incoming><bpmn:outgoing>ID13_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="ID13_E5_T2" name="Levar o relato aos públicos externos"><bpmn:documentation>Etapa 5: Publicar o relato e levá-lo aos públicos. Executor: Outro círculo (Relações). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID13_Flow21</bpmn:incoming><bpmn:outgoing>ID13_Flow22</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="ID13_F1" name="Relato de impacto publicado"><bpmn:incoming>ID13_Flow22</bpmn:incoming></bpmn:endEvent>
