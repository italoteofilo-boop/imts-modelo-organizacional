    <bpmn:startEvent id="IT08_S1" name="Ciclo de melhoria das jornadas iniciado"><bpmn:outgoing>IT08_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="IT08_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT08_S2" name="Capacidade do redesenho não criada"><bpmn:outgoing>IT08_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="IT08_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT08_S3" name="Recomendação de melhoria recebida"><bpmn:outgoing>IT08_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="IT08_S3_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT08_S4" name="Lacunas de execução apontadas recebidas"><bpmn:outgoing>IT08_Flow4</bpmn:outgoing><bpmn:messageEventDefinition id="IT08_S4_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT08_S5" name="Projeto do redesenho entregue"><bpmn:outgoing>IT08_Flow5</bpmn:outgoing><bpmn:messageEventDefinition id="IT08_S5_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="IT08_M1"><bpmn:incoming>IT08_Flow1</bpmn:incoming><bpmn:incoming>IT08_Flow2</bpmn:incoming><bpmn:incoming>IT08_Flow3</bpmn:incoming><bpmn:incoming>IT08_Flow4</bpmn:incoming><bpmn:incoming>IT08_Flow5</bpmn:incoming><bpmn:outgoing>IT08_Flow40</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT08_E1_G1" name="O que abriu o trabalho?"><bpmn:incoming>IT08_Flow40</bpmn:incoming><bpmn:outgoing>IT08_Flow6</bpmn:outgoing><bpmn:outgoing>IT08_Flow8</bpmn:outgoing><bpmn:outgoing>IT08_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT08_E1_T1" name="Retomar o redesenho com a entrega do projeto"><bpmn:documentation>Etapa 1: Medir a jornada e achar o gargalo. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow6</bpmn:incoming><bpmn:outgoing>IT08_Flow7</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT08_E1_T2" name="Suspender o projeto do redesenho e avisar o líder do círculo dono, com o motivo"><bpmn:documentation>Etapa 1: Medir a jornada e achar o gargalo. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow8</bpmn:incoming><bpmn:outgoing>IT08_Flow9</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT08_F5" name="Redesenho sem a capacidade pedida, com o motivo"><bpmn:incoming>IT08_Flow9</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="IT08_E1_T3" name="Propor as jornadas do ciclo pela recomendação, pela lacuna e pelos indicadores"><bpmn:documentation>Etapa 1: Medir a jornada e achar o gargalo. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow10</bpmn:incoming><bpmn:outgoing>IT08_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="IT08_E1_T4" name="Decidir as jornadas do ciclo"><bpmn:documentation>Etapa 1: Medir a jornada e achar o gargalo. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow11</bpmn:incoming><bpmn:outgoing>IT08_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT08_E1_T5" name="Medir volume, custo, qualidade, tempo e resultado da jornada"><bpmn:documentation>Etapa 1: Medir a jornada e achar o gargalo. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow12</bpmn:incoming><bpmn:outgoing>IT08_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="IT08_E1_T6" name="Analisar tempos, filas e retrabalho e apontar o gargalo, com a causa provável"><bpmn:documentation>Etapa 1: Medir a jornada e achar o gargalo. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow13</bpmn:incoming><bpmn:outgoing>IT08_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IT08_E1_G2" name="Há gargalo que justifica mudar a jornada?"><bpmn:incoming>IT08_Flow14</bpmn:incoming><bpmn:outgoing>IT08_Flow15</bpmn:outgoing><bpmn:outgoing>IT08_Flow16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT08_E1_T7" name="Registrar a medida da jornada e responder a quem recomendou"><bpmn:documentation>Etapa 1: Medir a jornada e achar o gargalo. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow16</bpmn:incoming><bpmn:outgoing>IT08_Flow17</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT08_F3" name="Jornada sem gargalo que justifique mudança"><bpmn:incoming>IT08_Flow17</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="IT08_M2"><bpmn:incoming>IT08_Flow15</bpmn:incoming><bpmn:incoming>IT08_Flow26</bpmn:incoming><bpmn:outgoing>IT08_Flow41</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT08_E2_T1" name="Propor o redesenho: etapas, tarefas, executores, entradas e saídas e o ganho esperado"><bpmn:documentation>Etapa 2: Redesenhar a jornada com o círculo dono. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT08_Flow41</bpmn:incoming><bpmn:outgoing>IT08_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="IT08_E2_T2" name="Montar o fluxo do redesenho e conferir as trocas com os outros círculos"><bpmn:documentation>Etapa 2: Redesenhar a jornada com o círculo dono. Executor: Agente da Integração (Integração · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT08_Flow18</bpmn:incoming><bpmn:outgoing>IT08_Flow19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IT08_E2_G1" name="O redesenho mexe em alçada, regra ou contrato?"><bpmn:incoming>IT08_Flow19</bpmn:incoming><bpmn:outgoing>IT08_Flow20</bpmn:outgoing><bpmn:outgoing>IT08_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="IT08_E2_T3" name="Conferir o redesenho contra as alçadas, as regras e os contratos"><bpmn:documentation>Etapa 2: Redesenhar a jornada com o círculo dono. Executor: Outro círculo (Governança). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT08_Flow20</bpmn:incoming><bpmn:outgoing>IT08_Flow22</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="IT08_M3"><bpmn:incoming>IT08_Flow21</bpmn:incoming><bpmn:incoming>IT08_Flow22</bpmn:incoming><bpmn:outgoing>IT08_Flow42</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT08_E2_T4" name="Confirmar a parte do redesenho que passa por cada círculo afetado"><bpmn:documentation>Etapa 2: Redesenhar a jornada com o círculo dono. Executor: Pessoa de fora do círculo (Líder do círculo). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT08_Flow42</bpmn:incoming><bpmn:outgoing>IT08_Flow23</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="IT08_E2_T5" name="Decidir o redesenho da jornada do seu círculo"><bpmn:documentation>Etapa 2: Redesenhar a jornada com o círculo dono. Executor: Pessoa de fora do círculo (Líder do círculo). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT08_Flow23</bpmn:incoming><bpmn:outgoing>IT08_Flow24</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IT08_E2_G2" name="O líder do círculo dono aprovou o redesenho?"><bpmn:incoming>IT08_Flow24</bpmn:incoming><bpmn:outgoing>IT08_Flow25</bpmn:outgoing><bpmn:outgoing>IT08_Flow26</bpmn:outgoing><bpmn:outgoing>IT08_Flow27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT08_E2_T6" name="Registrar o motivo e responder a quem recomendou"><bpmn:documentation>Etapa 2: Redesenhar a jornada com o círculo dono. Executor: Automação da Integração (Integração · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT08_Flow27</bpmn:incoming><bpmn:outgoing>IT08_Flow28</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT08_F2" name="Redesenho não aprovado, com o motivo"><bpmn:incoming>IT08_Flow28</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="IT08_M4"><bpmn:incoming>IT08_Flow7</bpmn:incoming><bpmn:incoming>IT08_Flow25</bpmn:incoming><bpmn:outgoing>IT08_Flow43</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT08_E3_G1" name="O redesenho pede capacidade, agente, sistema ou projeto ainda não entregue?"><bpmn:incoming>IT08_Flow43</bpmn:incoming><bpmn:outgoing>IT08_Flow29</bpmn:outgoing><bpmn:outgoing>IT08_Flow31</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT08_E3_T1" name="Abrir o projeto do redesenho e pedir a capacidade, o agente ou a mudança em sistema"><bpmn:documentation>Etapa 3: Implantar o redesenho e atualizar o catálogo de jornadas. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow29</bpmn:incoming><bpmn:outgoing>IT08_Flow30</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT08_F4" name="Redesenho à espera do projeto"><bpmn:incoming>IT08_Flow30</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="IT08_E3_T2" name="Versionar a jornada no catálogo e refazer as ligações com etapas, tarefas e donos"><bpmn:documentation>Etapa 3: Implantar o redesenho e atualizar o catálogo de jornadas. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow31</bpmn:incoming><bpmn:outgoing>IT08_Flow32</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT08_E3_T3" name="Avisar os círculos por onde a jornada passa"><bpmn:documentation>Etapa 3: Implantar o redesenho e atualizar o catálogo de jornadas. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow32</bpmn:incoming><bpmn:outgoing>IT08_Flow33</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="IT08_E4_T1" name="Medir a jornada depois do redesenho e comparar com o ganho esperado"><bpmn:documentation>Etapa 4: Conferir o ganho do redesenho. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow33</bpmn:incoming><bpmn:outgoing>IT08_Flow34</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="IT08_E4_T2" name="Concluir se o ganho veio e o que aprender"><bpmn:documentation>Etapa 4: Conferir o ganho do redesenho. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow34</bpmn:incoming><bpmn:outgoing>IT08_Flow35</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IT08_E4_G1" name="O ganho esperado veio?"><bpmn:incoming>IT08_Flow35</bpmn:incoming><bpmn:outgoing>IT08_Flow36</bpmn:outgoing><bpmn:outgoing>IT08_Flow38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT08_E4_T3" name="Registrar o ganho conferido"><bpmn:documentation>Etapa 4: Conferir o ganho do redesenho. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow36</bpmn:incoming><bpmn:outgoing>IT08_Flow37</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT08_E4_T4" name="Registrar a lição e levar à Inteligência"><bpmn:documentation>Etapa 4: Conferir o ganho do redesenho. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT08_Flow38</bpmn:incoming><bpmn:outgoing>IT08_Flow39</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT08_M5"><bpmn:incoming>IT08_Flow37</bpmn:incoming><bpmn:incoming>IT08_Flow39</bpmn:incoming><bpmn:outgoing>IT08_Flow44</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="IT08_F1" name="Jornada redesenhada, implantada e com o ganho conferido"><bpmn:incoming>IT08_Flow44</bpmn:incoming></bpmn:endEvent>
