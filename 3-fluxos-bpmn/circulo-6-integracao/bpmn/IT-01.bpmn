    <bpmn:sequenceFlow id="IT01_Flow4" sourceRef="IT01_S4" targetRef="IT01_M1" />
    <bpmn:sequenceFlow id="IT01_Flow5" sourceRef="IT01_E1_T1" targetRef="IT01_E1_G1" />
    <bpmn:sequenceFlow id="IT01_Flow6" name="Aposta devolvida ou encerrada, oferta encerrada, ou projeto suspenso por outra jornada" sourceRef="IT01_E1_G1" targetRef="IT01_E1_T2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Aposta devolvida ou encerrada, oferta encerrada, ou projeto suspenso por outra jornada</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IT01_Flow7" sourceRef="IT01_E1_T2" targetRef="IT01_F2" />
    <bpmn:sequenceFlow id="IT01_Flow8" name="Decisão do portão sobre aposta que já está na carteira, ou ciclo de acompanhamento" sourceRef="IT01_E1_G1" targetRef="IT01_M4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Decisão do portão sobre aposta que já está na carteira, ou ciclo de acompanhamento</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IT01_Flow9" name="Projeto novo ou reativado: iniciativa, implantação, lançamento, capacidade, redesenho ou saída" sourceRef="IT01_E1_G1" targetRef="IT01_E1_T3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Projeto novo ou reativado: iniciativa, implantação, lançamento, capacidade, redesenho ou saída</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IT01_Flow10" sourceRef="IT01_E1_T3" targetRef="IT01_E1_T4" />
    <bpmn:sequenceFlow id="IT01_Flow11" sourceRef="IT01_E1_T4" targetRef="IT01_E2_T1" />
    <bpmn:sequenceFlow id="IT01_Flow12" sourceRef="IT01_E2_T1" targetRef="IT01_E2_T2" />
