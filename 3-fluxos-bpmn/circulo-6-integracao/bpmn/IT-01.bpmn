<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IT01" targetNamespace="urn:imts:modelo:circulo6-integracao" exporter="Ecossistema IMTS - fonte única do Círculo 6" exporterVersion="2026-10-01">
  <bpmn:category id="Category_IT01">
    <bpmn:categoryValue id="CV_IT01_E1" value="1. Registrar o projeto e o que ele pede" />
    <bpmn:categoryValue id="CV_IT01_E2" value="2. Priorizar o projeto na carteira" />
    <bpmn:categoryValue id="CV_IT01_E3" value="3. Acompanhar o projeto e corrigir o desvio" />
    <bpmn:categoryValue id="CV_IT01_E4" value="4. Encerrar o projeto e registrar as lições" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_IT01">
    <bpmn:participant id="Participant_IT01" name="IT-01 · Gerir a carteira de projetos do Ecossistema e das empresas" processRef="Process_IT01" />
    <bpmn:group id="Group_IT01_E1" categoryValueRef="CV_IT01_E1" />
    <bpmn:group id="Group_IT01_E2" categoryValueRef="CV_IT01_E2" />
    <bpmn:group id="Group_IT01_E3" categoryValueRef="CV_IT01_E3" />
    <bpmn:group id="Group_IT01_E4" categoryValueRef="CV_IT01_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_IT01" name="Gerir a carteira de projetos do Ecossistema e das empresas" isExecutable="false">
    <bpmn:documentation>Fazer cada projeto, interno ou de cliente, entrar numa carteira única com objetivo, dono, prazo, custo e empresa; ser priorizado contra a capacidade; ser acompanhado com o desvio apontado a tempo; e ser encerrado com a entrega conferida e as lições registradas. O executivo decide a prioridade dos projetos da sua empresa; a Integração decide a dos projetos corporativos e o método; o conflito de capacidade entre empresas sobe à Estratégia. A Integração informa a situação da carteira à Estratégia e à Gestão.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_IT01">
      <bpmn:lane id="Lane_IT01_EST" name="Estratégia">
        <bpmn:flowNodeRef>IT01_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT01_INT" name="Inteligência">
        <bpmn:flowNodeRef>IT01_S3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT01_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>IT01_E2_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT01_ITP" name="Integração · pessoa">
        <bpmn:flowNodeRef>IT01_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E2_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E3_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E3_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E4_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT01_ITA" name="Integração · agente">
        <bpmn:flowNodeRef>IT01_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E2_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E3_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT01_ITR" name="Integração · automação">
        <bpmn:flowNodeRef>IT01_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_F4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_F3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_F5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E3_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_E4_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT01_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="IT01_S1" name="Iniciativa, decisão de portão ou de encerramento recebida"><bpmn:outgoing>IT01_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IT01_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT01_S2" name="Projeto aberto por outra jornada da Integração"><bpmn:outgoing>IT01_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="IT01_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT01_S3" name="Aposta devolvida ou encerrada avisada"><bpmn:outgoing>IT01_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="IT01_S3_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT01_S4" name="Ciclo de acompanhamento da carteira iniciado"><bpmn:outgoing>IT01_Flow4</bpmn:outgoing><bpmn:timerEventDefinition id="IT01_S4_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="IT01_M1"><bpmn:incoming>IT01_Flow1</bpmn:incoming><bpmn:incoming>IT01_Flow2</bpmn:incoming><bpmn:incoming>IT01_Flow3</bpmn:incoming><bpmn:incoming>IT01_Flow4</bpmn:incoming><bpmn:outgoing>IT01_Flow41</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT01_E1_T1" name="Registrar o que abriu o trabalho, a empresa e o projeto afetado"><bpmn:documentation>Etapa 1: Registrar o projeto e o que ele pede. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT01_Flow41</bpmn:incoming><bpmn:outgoing>IT01_Flow5</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT01_E1_G1" name="O que abriu o trabalho?"><bpmn:incoming>IT01_Flow5</bpmn:incoming><bpmn:outgoing>IT01_Flow6</bpmn:outgoing><bpmn:outgoing>IT01_Flow8</bpmn:outgoing><bpmn:outgoing>IT01_Flow9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT01_E1_T2" name="Suspender ou encerrar o projeto e avisar a Gestão dos recursos liberados"><bpmn:documentation>Etapa 1: Registrar o projeto e o que ele pede. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT01_Flow6</bpmn:incoming><bpmn:outgoing>IT01_Flow7</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT01_F2" name="Projeto suspenso ou encerrado antes da entrega, com recursos liberados"><bpmn:incoming>IT01_Flow7</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="IT01_E1_T3" name="Estimar prazo, custo, pessoas, agentes e dependências do projeto"><bpmn:documentation>Etapa 1: Registrar o projeto e o que ele pede. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT01_Flow9</bpmn:incoming><bpmn:outgoing>IT01_Flow10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="IT01_E1_T4" name="Definir o objetivo, o dono e o alvo ou o contrato a que o projeto se liga"><bpmn:documentation>Etapa 1: Registrar o projeto e o que ele pede. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT01_Flow10</bpmn:incoming><bpmn:outgoing>IT01_Flow11</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="IT01_E2_T1" name="Simular a carga da carteira com o projeto novo e apontar os conflitos de capacidade"><bpmn:documentation>Etapa 2: Priorizar o projeto na carteira. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow11</bpmn:incoming><bpmn:outgoing>IT01_Flow12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="IT01_E2_T2" name="Propor a ordem dos projetos pela regra de prioridade e pelos alvos"><bpmn:documentation>Etapa 2: Priorizar o projeto na carteira. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow12</bpmn:incoming><bpmn:outgoing>IT01_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IT01_E2_G1" name="De quem é a prioridade?"><bpmn:incoming>IT01_Flow13</bpmn:incoming><bpmn:outgoing>IT01_Flow14</bpmn:outgoing><bpmn:outgoing>IT01_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT01_E2_T3" name="Decidir a prioridade dos projetos da sua empresa"><bpmn:documentation>Etapa 2: Priorizar o projeto na carteira. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow14</bpmn:incoming><bpmn:outgoing>IT01_Flow16</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="IT01_E2_T4" name="Decidir a prioridade dos projetos corporativos, pelos alvos e pelo método de estratégia"><bpmn:documentation>Etapa 2: Priorizar o projeto na carteira. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow15</bpmn:incoming><bpmn:outgoing>IT01_Flow17</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IT01_M2"><bpmn:incoming>IT01_Flow16</bpmn:incoming><bpmn:incoming>IT01_Flow17</bpmn:incoming><bpmn:outgoing>IT01_Flow42</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT01_E2_G2" name="Há conflito de capacidade entre empresas?"><bpmn:incoming>IT01_Flow42</bpmn:incoming><bpmn:outgoing>IT01_Flow18</bpmn:outgoing><bpmn:outgoing>IT01_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="IT01_E2_T5" name="Decidir o conflito de capacidade entre empresas, pelos alvos e pela alocação"><bpmn:documentation>Etapa 2: Priorizar o projeto na carteira. Executor: Outro círculo (Estratégia). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow18</bpmn:incoming><bpmn:outgoing>IT01_Flow20</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="IT01_M3"><bpmn:incoming>IT01_Flow19</bpmn:incoming><bpmn:incoming>IT01_Flow20</bpmn:incoming><bpmn:outgoing>IT01_Flow43</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT01_E2_G3" name="O projeto entra agora?"><bpmn:incoming>IT01_Flow43</bpmn:incoming><bpmn:outgoing>IT01_Flow21</bpmn:outgoing><bpmn:outgoing>IT01_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT01_E2_T6" name="Fechar a carteira priorizada e avisar os donos dos projetos"><bpmn:documentation>Etapa 2: Priorizar o projeto na carteira. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow21</bpmn:incoming><bpmn:outgoing>IT01_Flow22</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT01_E2_T7" name="Registrar o projeto em espera, com a condição para entrar, e avisar o dono"><bpmn:documentation>Etapa 2: Priorizar o projeto na carteira. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow23</bpmn:incoming><bpmn:outgoing>IT01_Flow24</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT01_F4" name="Projeto não priorizado, em espera"><bpmn:incoming>IT01_Flow24</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="IT01_M4"><bpmn:incoming>IT01_Flow8</bpmn:incoming><bpmn:incoming>IT01_Flow22</bpmn:incoming><bpmn:incoming>IT01_Flow34</bpmn:incoming><bpmn:incoming>IT01_Flow36</bpmn:incoming><bpmn:outgoing>IT01_Flow44</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT01_E3_G1" name="O que chegou à etapa?"><bpmn:incoming>IT01_Flow44</bpmn:incoming><bpmn:outgoing>IT01_Flow25</bpmn:outgoing><bpmn:outgoing>IT01_Flow28</bpmn:outgoing><bpmn:outgoing>IT01_Flow30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IT01_E3_T1" name="Rever os projetos em espera e devolver à priorização os que já cabem"><bpmn:documentation>Etapa 3: Acompanhar o projeto e corrigir o desvio. Executor: Agente da Integração (Integração · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow25</bpmn:incoming><bpmn:outgoing>IT01_Flow26</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="IT01_E3_T2" name="Informar a situação da carteira à Estratégia, à Gestão e aos executivos"><bpmn:documentation>Etapa 3: Acompanhar o projeto e corrigir o desvio. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow26</bpmn:incoming><bpmn:outgoing>IT01_Flow27</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT01_F3" name="Situação da carteira informada"><bpmn:incoming>IT01_Flow27</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="IT01_E3_T3" name="Atualizar o projeto com a decisão do portão"><bpmn:documentation>Etapa 3: Acompanhar o projeto e corrigir o desvio. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow28</bpmn:incoming><bpmn:outgoing>IT01_Flow29</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT01_F5" name="Projeto atualizado com a decisão do portão"><bpmn:incoming>IT01_Flow29</bpmn:incoming></bpmn:endEvent>
    <bpmn:receiveTask id="IT01_E3_T4" name="Receber a situação, o marco, o desvio ou a conclusão de cada projeto"><bpmn:documentation>Etapa 3: Acompanhar o projeto e corrigir o desvio. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow30</bpmn:incoming><bpmn:outgoing>IT01_Flow31</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:serviceTask id="IT01_E3_T5" name="Comparar prazo, custo e entrega com o plano e apontar o desvio"><bpmn:documentation>Etapa 3: Acompanhar o projeto e corrigir o desvio. Executor: Agente da Integração (Integração · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow31</bpmn:incoming><bpmn:outgoing>IT01_Flow32</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IT01_E3_G2" name="Como está o projeto?"><bpmn:incoming>IT01_Flow32</bpmn:incoming><bpmn:outgoing>IT01_Flow33</bpmn:outgoing><bpmn:outgoing>IT01_Flow35</bpmn:outgoing><bpmn:outgoing>IT01_Flow37</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT01_E3_T6" name="Atualizar a situação da carteira"><bpmn:documentation>Etapa 3: Acompanhar o projeto e corrigir o desvio. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow33</bpmn:incoming><bpmn:outgoing>IT01_Flow34</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="IT01_E3_T7" name="Decidir a correção com o dono do projeto e avisar o executivo quando o desvio é dele"><bpmn:documentation>Etapa 3: Acompanhar o projeto e corrigir o desvio. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT01_Flow35</bpmn:incoming><bpmn:outgoing>IT01_Flow36</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="IT01_E4_T1" name="Conferir a entrega com o objetivo, o prazo e o custo do projeto"><bpmn:documentation>Etapa 4: Encerrar o projeto e registrar as lições. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>IT01_Flow37</bpmn:incoming><bpmn:outgoing>IT01_Flow38</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="IT01_E4_T2" name="Confirmar o aceite do dono do projeto: cliente, executivo ou líder do círculo"><bpmn:documentation>Etapa 4: Encerrar o projeto e registrar as lições. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>IT01_Flow38</bpmn:incoming><bpmn:outgoing>IT01_Flow39</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT01_E4_T3" name="Registrar o encerramento, o resultado e as lições do projeto"><bpmn:documentation>Etapa 4: Encerrar o projeto e registrar as lições. Executor: Automação da Integração (Integração · automação). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>IT01_Flow39</bpmn:incoming><bpmn:outgoing>IT01_Flow40</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT01_F1" name="Projeto encerrado, com a entrega conferida e as lições registradas"><bpmn:incoming>IT01_Flow40</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="IT01_Flow1" sourceRef="IT01_S1" targetRef="IT01_M1" />
    <bpmn:sequenceFlow id="IT01_Flow2" sourceRef="IT01_S2" targetRef="IT01_M1" />
