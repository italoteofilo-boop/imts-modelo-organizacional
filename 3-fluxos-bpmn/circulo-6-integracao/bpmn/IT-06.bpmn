<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IT06" targetNamespace="urn:imts:modelo:circulo6-integracao" exporter="Ecossistema IMTS - fonte única do Círculo 6" exporterVersion="2026-10-01">
  <bpmn:category id="Category_IT06">
    <bpmn:categoryValue id="CV_IT06_E1" value="1. Montar ou mudar o agente pela ficha" />
    <bpmn:categoryValue id="CV_IT06_E2" value="2. Testar o agente com os casos de teste" />
    <bpmn:categoryValue id="CV_IT06_E3" value="3. Liberar o agente em uso" />
    <bpmn:categoryValue id="CV_IT06_E4" value="4. Monitorar o agente em uso e tratar o desvio" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_IT06">
    <bpmn:participant id="Participant_IT06" name="IT-06 · Cuidar dos agentes e automações: montar, testar, liberar, monitorar e corrigir" processRef="Process_IT06" />
    <bpmn:group id="Group_IT06_E1" categoryValueRef="CV_IT06_E1" />
    <bpmn:group id="Group_IT06_E2" categoryValueRef="CV_IT06_E2" />
    <bpmn:group id="Group_IT06_E3" categoryValueRef="CV_IT06_E3" />
    <bpmn:group id="Group_IT06_E4" categoryValueRef="CV_IT06_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_IT06" name="Cuidar dos agentes e automações: montar, testar, liberar, monitorar e corrigir" isExecutable="false">
    <bpmn:documentation>Fazer cada agente ou automação ser montado pela ficha da capacidade, com o método, o conhecimento, os padrões de identidade e a alçada; passar nos casos de teste da Inteligência e da Identidade antes de entrar em uso; ser aceito pelo líder do círculo dono; e ser monitorado em uso, com o desvio corrigido, suspenso quando sai da alçada e retirado quando o método, a base ou a marca saem de uso. A Inteligência diz o que o agente precisa saber e mede se ele acertou; a Integração monta, testa, libera e mantém; a Governança define a alçada e audita.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_IT06">
      <bpmn:lane id="Lane_IT06_INT" name="Inteligência">
        <bpmn:flowNodeRef>IT06_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT06_IDE" name="Identidade">
        <bpmn:flowNodeRef>IT06_S3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT06_GOV" name="Governança">
        <bpmn:flowNodeRef>IT06_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT06_LCI" name="Líder do círculo">
        <bpmn:flowNodeRef>IT06_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT06_ITP" name="Integração · pessoa">
        <bpmn:flowNodeRef>IT06_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E1_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E4_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E4_T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT06_ITA" name="Integração · agente">
        <bpmn:flowNodeRef>IT06_E1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E1_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT06_ITR" name="Integração · automação">
        <bpmn:flowNodeRef>IT06_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_F4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E4_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E4_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_E4_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_F3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT06_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="IT06_S1" name="Pedido de montagem, de mudança ou de retirada de agente recebido"><bpmn:outgoing>IT06_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IT06_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT06_S2" name="Base de conhecimento ou perguntas de teste alteradas"><bpmn:outgoing>IT06_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="IT06_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT06_S3" name="Padrão, posicionamento ou marca alterados"><bpmn:outgoing>IT06_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="IT06_S3_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT06_S4" name="Falha ou desvio de agente detectado"><bpmn:outgoing>IT06_Flow4</bpmn:outgoing><bpmn:signalEventDefinition id="IT06_S4_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT06_S5" name="Ciclo de monitoramento dos agentes iniciado"><bpmn:outgoing>IT06_Flow5</bpmn:outgoing><bpmn:timerEventDefinition id="IT06_S5_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="IT06_M1"><bpmn:incoming>IT06_Flow1</bpmn:incoming><bpmn:incoming>IT06_Flow2</bpmn:incoming><bpmn:incoming>IT06_Flow3</bpmn:incoming><bpmn:incoming>IT06_Flow4</bpmn:incoming><bpmn:incoming>IT06_Flow5</bpmn:incoming><bpmn:incoming>IT06_Flow22</bpmn:incoming><bpmn:incoming>IT06_Flow27</bpmn:incoming><bpmn:incoming>IT06_Flow36</bpmn:incoming><bpmn:outgoing>IT06_Flow40</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT06_E1_T1" name="Registrar o que abriu o trabalho e os agentes afetados"><bpmn:documentation>Etapa 1: Montar ou mudar o agente pela ficha. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow40</bpmn:incoming><bpmn:outgoing>IT06_Flow6</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT06_E1_G1" name="O que abriu o trabalho?"><bpmn:incoming>IT06_Flow6</bpmn:incoming><bpmn:outgoing>IT06_Flow7</bpmn:outgoing><bpmn:outgoing>IT06_Flow9</bpmn:outgoing><bpmn:outgoing>IT06_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT06_E1_T2" name="Retirar o agente ou o conteúdo de uso e avisar o dono da capacidade"><bpmn:documentation>Etapa 1: Montar ou mudar o agente pela ficha. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow7</bpmn:incoming><bpmn:outgoing>IT06_Flow8</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT06_F2" name="Agente retirado de uso"><bpmn:incoming>IT06_Flow8</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="IT06_E1_G2" name="Há padrão de identidade para o canal ou o tipo de agente?"><bpmn:incoming>IT06_Flow10</bpmn:incoming><bpmn:outgoing>IT06_Flow11</bpmn:outgoing><bpmn:outgoing>IT06_Flow13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT06_E1_T3" name="Pedir à Identidade o padrão para o agente ou o canal novo"><bpmn:documentation>Etapa 1: Montar ou mudar o agente pela ficha. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow11</bpmn:incoming><bpmn:outgoing>IT06_Flow12</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:receiveTask id="IT06_E1_T4" name="Receber os padrões e os casos de teste da Identidade"><bpmn:documentation>Etapa 1: Montar ou mudar o agente pela ficha. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow12</bpmn:incoming><bpmn:outgoing>IT06_Flow14</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="IT06_M2"><bpmn:incoming>IT06_Flow13</bpmn:incoming><bpmn:incoming>IT06_Flow14</bpmn:incoming><bpmn:outgoing>IT06_Flow41</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT06_E1_T5" name="Decidir a arquitetura do agente: modelo, ferramentas, conhecimento e integrações"><bpmn:documentation>Etapa 1: Montar ou mudar o agente pela ficha. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow41</bpmn:incoming><bpmn:outgoing>IT06_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="IT06_E1_T6" name="Montar as instruções, o conhecimento, as ferramentas, a voz e a alçada do agente"><bpmn:documentation>Etapa 1: Montar ou mudar o agente pela ficha. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow15</bpmn:incoming><bpmn:outgoing>IT06_Flow16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="IT06_E2_T1" name="Rodar os casos de teste do método, da base e da Identidade"><bpmn:documentation>Etapa 2: Testar o agente com os casos de teste. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow16</bpmn:incoming><bpmn:outgoing>IT06_Flow17</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="IT06_E2_T2" name="Medir o acerto do conteúdo e julgar os casos de fronteira de conteúdo"><bpmn:documentation>Etapa 2: Testar o agente com os casos de teste. Executor: Outro círculo (Inteligência). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow17</bpmn:incoming><bpmn:outgoing>IT06_Flow18</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="IT06_E2_T3" name="Medir erro, tempo e custo e julgar os casos de fronteira de operação"><bpmn:documentation>Etapa 2: Testar o agente com os casos de teste. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow18</bpmn:incoming><bpmn:outgoing>IT06_Flow19</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IT06_E2_G1" name="O agente atinge o critério de sucesso?"><bpmn:incoming>IT06_Flow19</bpmn:incoming><bpmn:outgoing>IT06_Flow20</bpmn:outgoing><bpmn:outgoing>IT06_Flow21</bpmn:outgoing><bpmn:outgoing>IT06_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IT06_E2_T4" name="Apontar a falha do agente e o que corrigir"><bpmn:documentation>Etapa 2: Testar o agente com os casos de teste. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow21</bpmn:incoming><bpmn:outgoing>IT06_Flow22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="IT06_E2_T5" name="Devolver à Inteligência o resultado dos testes, com os casos que falham"><bpmn:documentation>Etapa 2: Testar o agente com os casos de teste. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow23</bpmn:incoming><bpmn:outgoing>IT06_Flow24</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT06_F4" name="Falha devolvida à Inteligência: método ou base"><bpmn:incoming>IT06_Flow24</bpmn:incoming></bpmn:endEvent>
    <bpmn:task id="IT06_E3_T1" name="Conferir a alçada e os acessos do agente"><bpmn:documentation>Etapa 3: Liberar o agente em uso. Executor: Outro círculo (Governança). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>IT06_Flow20</bpmn:incoming><bpmn:outgoing>IT06_Flow25</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="IT06_E3_T2" name="Aceitar o agente na capacidade do seu círculo"><bpmn:documentation>Etapa 3: Liberar o agente em uso. Executor: Pessoa de fora do círculo (Líder do círculo). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>IT06_Flow25</bpmn:incoming><bpmn:outgoing>IT06_Flow26</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IT06_E3_G1" name="A Governança e o líder do círculo dono aceitaram o agente?"><bpmn:incoming>IT06_Flow26</bpmn:incoming><bpmn:outgoing>IT06_Flow27</bpmn:outgoing><bpmn:outgoing>IT06_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT06_E3_T3" name="Liberar o agente em uso"><bpmn:documentation>Etapa 3: Liberar o agente em uso. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>IT06_Flow28</bpmn:incoming><bpmn:outgoing>IT06_Flow29</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT06_E3_T4" name="Registrar a versão liberada, a alçada e o dono e marcar a capacidade como em uso"><bpmn:documentation>Etapa 3: Liberar o agente em uso. Executor: Automação da Integração (Integração · automação). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>IT06_Flow29</bpmn:incoming><bpmn:outgoing>IT06_Flow30</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT06_M3"><bpmn:incoming>IT06_Flow9</bpmn:incoming><bpmn:incoming>IT06_Flow30</bpmn:incoming><bpmn:outgoing>IT06_Flow42</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT06_E4_T1" name="Monitorar erro, disponibilidade, custo e consultas e mandar a amostra à Inteligência"><bpmn:documentation>Etapa 4: Monitorar o agente em uso e tratar o desvio. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow42</bpmn:incoming><bpmn:outgoing>IT06_Flow31</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT06_E4_T2" name="Registrar as entregas dos agentes para a auditoria e para a Identidade"><bpmn:documentation>Etapa 4: Monitorar o agente em uso e tratar o desvio. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow31</bpmn:incoming><bpmn:outgoing>IT06_Flow32</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT06_E4_G1" name="O agente passou de algum limite de erro, custo ou alçada?"><bpmn:incoming>IT06_Flow32</bpmn:incoming><bpmn:outgoing>IT06_Flow33</bpmn:outgoing><bpmn:outgoing>IT06_Flow34</bpmn:outgoing><bpmn:outgoing>IT06_Flow37</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT06_E4_T3" name="Confirmar o desvio apontado e a correção a fazer"><bpmn:documentation>Etapa 4: Monitorar o agente em uso e tratar o desvio. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow34</bpmn:incoming><bpmn:outgoing>IT06_Flow35</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT06_E4_T4" name="Abrir a correção do agente"><bpmn:documentation>Etapa 4: Monitorar o agente em uso e tratar o desvio. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow35</bpmn:incoming><bpmn:outgoing>IT06_Flow36</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT06_E4_T5" name="Suspender o agente, avisar a Governança e o dono e registrar a correção pendente"><bpmn:documentation>Etapa 4: Monitorar o agente em uso e tratar o desvio. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow37</bpmn:incoming><bpmn:outgoing>IT06_Flow38</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="IT06_E4_T6" name="Confirmar a suspensão e a causa do desvio"><bpmn:documentation>Etapa 4: Monitorar o agente em uso e tratar o desvio. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT06_Flow38</bpmn:incoming><bpmn:outgoing>IT06_Flow39</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="IT06_F3" name="Agente suspenso, com a Governança e o dono avisados"><bpmn:incoming>IT06_Flow39</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="IT06_F1" name="Agente em uso, monitorado"><bpmn:incoming>IT06_Flow33</bpmn:incoming></bpmn:endEvent>
