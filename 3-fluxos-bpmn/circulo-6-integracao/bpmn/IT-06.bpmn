    <bpmn:sequenceFlow id="IT06_Flow10" name="Agente novo, mudança pedida, conteúdo alterado ou desvio a corrigir" sourceRef="IT06_E1_G1" targetRef="IT06_E1_G2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Agente novo, mudança pedida, conteúdo alterado ou desvio a corrigir</bpmn:conditionExpression></bpmn:sequenceFlow>
