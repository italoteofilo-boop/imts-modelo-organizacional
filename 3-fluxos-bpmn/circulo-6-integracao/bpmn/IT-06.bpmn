    <bpmn:sequenceFlow id="IT06_Flow13" name="Sim" sourceRef="IT06_E1_G2" targetRef="IT06_M2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IT06_Flow14" sourceRef="IT06_E1_T4" targetRef="IT06_M2" />
    <bpmn:sequenceFlow id="IT06_Flow15" sourceRef="IT06_E1_T5" targetRef="IT06_E1_T6" />
