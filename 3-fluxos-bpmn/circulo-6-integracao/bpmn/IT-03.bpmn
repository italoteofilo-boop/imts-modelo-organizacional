    <bpmn:sequenceFlow id="IT03_Flow4" sourceRef="IT03_E1_T1" targetRef="IT03_M2" />
    <bpmn:sequenceFlow id="IT03_Flow5" name="Oferta aprovada para lançamento" sourceRef="IT03_E1_G1" targetRef="IT03_E1_T2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Oferta aprovada para lançamento</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IT03_Flow6" sourceRef="IT03_E1_T2" targetRef="IT03_E1_PS1" />
