<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IT03" targetNamespace="urn:imts:modelo:circulo6-integracao" exporter="Ecossistema IMTS - fonte única do Círculo 6" exporterVersion="2026-10-01">
  <bpmn:category id="Category_IT03">
    <bpmn:categoryValue id="CV_IT03_E1" value="1. Montar o plano de lançamento com o executivo e os círculos" />
    <bpmn:categoryValue id="CV_IT03_E2" value="2. Conferir a prontidão e decidir lançar" />
    <bpmn:categoryValue id="CV_IT03_E3" value="3. Lançar e acompanhar os primeiros resultados" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_IT03">
    <bpmn:participant id="Participant_IT03" name="IT-03 · Coordenar o lançamento da oferta aprovada" processRef="Process_IT03" />
    <bpmn:group id="Group_IT03_E1" categoryValueRef="CV_IT03_E1" />
    <bpmn:group id="Group_IT03_E2" categoryValueRef="CV_IT03_E2" />
    <bpmn:group id="Group_IT03_E3" categoryValueRef="CV_IT03_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_IT03" name="Coordenar o lançamento da oferta aprovada" isExecutable="false">
    <bpmn:documentation>Fazer cada oferta aprovada no portão de lançamento chegar ao mercado com um plano único: quem faz o quê em Relações, Negócios, Operações, Gestão e Governança, com marcos e riscos, a prontidão conferida antes de lançar e os primeiros resultados acompanhados. A Integração coordena com o executivo da empresa; cada círculo executa a sua parte.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_IT03">
      <bpmn:lane id="Lane_IT03_EST" name="Estratégia">
        <bpmn:flowNodeRef>IT03_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT03_REL" name="Relações">
        <bpmn:flowNodeRef>IT03_E1_PS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E1_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT03_NEG" name="Negócios">
        <bpmn:flowNodeRef>IT03_E1_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT03_OPE" name="Operações">
        <bpmn:flowNodeRef>IT03_E1_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT03_GES" name="Gestão">
        <bpmn:flowNodeRef>IT03_E1_T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT03_GOV" name="Governança">
        <bpmn:flowNodeRef>IT03_E1_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E1_PJ1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT03_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>IT03_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E1_T8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT03_ITP" name="Integração · pessoa">
        <bpmn:flowNodeRef>IT03_E1_T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E2_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT03_ITA" name="Integração · agente">
        <bpmn:flowNodeRef>IT03_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT03_ITR" name="Integração · automação">
        <bpmn:flowNodeRef>IT03_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT03_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="IT03_S1" name="Oferta aprovada para lançamento recebida"><bpmn:outgoing>IT03_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IT03_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT03_S2" name="Lançamento retomado pelo executivo"><bpmn:outgoing>IT03_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="IT03_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="IT03_M1"><bpmn:incoming>IT03_Flow1</bpmn:incoming><bpmn:incoming>IT03_Flow2</bpmn:incoming><bpmn:outgoing>IT03_Flow31</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT03_E1_G1" name="O que abriu o trabalho?"><bpmn:incoming>IT03_Flow31</bpmn:incoming><bpmn:outgoing>IT03_Flow3</bpmn:outgoing><bpmn:outgoing>IT03_Flow5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IT03_E1_T1" name="Reativar o projeto na carteira e propor a nova data, com o que impedia resolvido"><bpmn:documentation>Etapa 1: Montar o plano de lançamento com o executivo e os círculos. Executor: Agente da Integração (Integração · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow3</bpmn:incoming><bpmn:outgoing>IT03_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="IT03_E1_T2" name="Propor o plano: marcos, a parte de cada círculo, capacidades, riscos e data"><bpmn:documentation>Etapa 1: Montar o plano de lançamento com o executivo e os círculos. Executor: Agente da Integração (Integração · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow5</bpmn:incoming><bpmn:outgoing>IT03_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="IT03_E1_PS1"><bpmn:incoming>IT03_Flow6</bpmn:incoming><bpmn:outgoing>IT03_Flow7</bpmn:outgoing><bpmn:outgoing>IT03_Flow9</bpmn:outgoing><bpmn:outgoing>IT03_Flow11</bpmn:outgoing><bpmn:outgoing>IT03_Flow13</bpmn:outgoing><bpmn:outgoing>IT03_Flow15</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="IT03_E1_T3" name="Confirmar a parte de demanda e comunicação do lançamento"><bpmn:documentation>Etapa 1: Montar o plano de lançamento com o executivo e os círculos. Executor: Outro círculo (Relações). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow7</bpmn:incoming><bpmn:outgoing>IT03_Flow8</bpmn:outgoing></bpmn:task>
    <bpmn:task id="IT03_E1_T4" name="Confirmar a tabela, o material de venda e quem vende"><bpmn:documentation>Etapa 1: Montar o plano de lançamento com o executivo e os círculos. Executor: Outro círculo (Negócios). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow9</bpmn:incoming><bpmn:outgoing>IT03_Flow10</bpmn:outgoing></bpmn:task>
    <bpmn:task id="IT03_E1_T5" name="Confirmar a capacidade de entrega e o atendimento"><bpmn:documentation>Etapa 1: Montar o plano de lançamento com o executivo e os círculos. Executor: Outro círculo (Operações). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow11</bpmn:incoming><bpmn:outgoing>IT03_Flow12</bpmn:outgoing></bpmn:task>
    <bpmn:task id="IT03_E1_T6" name="Confirmar o orçamento e a cobrança"><bpmn:documentation>Etapa 1: Montar o plano de lançamento com o executivo e os círculos. Executor: Outro círculo (Gestão). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow13</bpmn:incoming><bpmn:outgoing>IT03_Flow14</bpmn:outgoing></bpmn:task>
    <bpmn:task id="IT03_E1_T7" name="Confirmar os termos e as regras da oferta"><bpmn:documentation>Etapa 1: Montar o plano de lançamento com o executivo e os círculos. Executor: Outro círculo (Governança). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow15</bpmn:incoming><bpmn:outgoing>IT03_Flow16</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="IT03_E1_PJ1"><bpmn:incoming>IT03_Flow8</bpmn:incoming><bpmn:incoming>IT03_Flow10</bpmn:incoming><bpmn:incoming>IT03_Flow12</bpmn:incoming><bpmn:incoming>IT03_Flow14</bpmn:incoming><bpmn:incoming>IT03_Flow16</bpmn:incoming><bpmn:outgoing>IT03_Flow17</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="IT03_E1_T8" name="Opinar sobre o plano e a data de lançamento da sua empresa"><bpmn:documentation>Etapa 1: Montar o plano de lançamento com o executivo e os círculos. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow17</bpmn:incoming><bpmn:outgoing>IT03_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="IT03_E1_T9" name="Decidir o plano de lançamento, ouvido o executivo"><bpmn:documentation>Etapa 1: Montar o plano de lançamento com o executivo e os círculos. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow18</bpmn:incoming><bpmn:outgoing>IT03_Flow19</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IT03_M2"><bpmn:incoming>IT03_Flow4</bpmn:incoming><bpmn:incoming>IT03_Flow19</bpmn:incoming><bpmn:incoming>IT03_Flow25</bpmn:incoming><bpmn:outgoing>IT03_Flow32</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="IT03_E2_T1" name="Receber a prontidão de cada círculo no marco combinado"><bpmn:documentation>Etapa 2: Conferir a prontidão e decidir lançar. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow32</bpmn:incoming><bpmn:outgoing>IT03_Flow20</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:serviceTask id="IT03_E2_T2" name="Conferir a prontidão contra o plano e apontar o que falta"><bpmn:documentation>Etapa 2: Conferir a prontidão e decidir lançar. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow20</bpmn:incoming><bpmn:outgoing>IT03_Flow21</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="IT03_E2_T3" name="Conferir a prontidão com o executivo da empresa"><bpmn:documentation>Etapa 2: Conferir a prontidão e decidir lançar. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow21</bpmn:incoming><bpmn:outgoing>IT03_Flow22</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="IT03_E2_G1" name="A oferta está pronta para lançar?"><bpmn:incoming>IT03_Flow22</bpmn:incoming><bpmn:outgoing>IT03_Flow23</bpmn:outgoing><bpmn:outgoing>IT03_Flow24</bpmn:outgoing><bpmn:outgoing>IT03_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT03_E2_T4" name="Cobrar o item que falta do círculo dono, com o novo prazo"><bpmn:documentation>Etapa 2: Conferir a prontidão e decidir lançar. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow24</bpmn:incoming><bpmn:outgoing>IT03_Flow25</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT03_E2_T5" name="Levar o impedimento ao executivo e à Gestão e suspender o projeto na carteira"><bpmn:documentation>Etapa 2: Conferir a prontidão e decidir lançar. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT03_Flow26</bpmn:incoming><bpmn:outgoing>IT03_Flow27</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT03_F2" name="Lançamento suspenso, com o impedimento levado ao executivo"><bpmn:incoming>IT03_Flow27</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="IT03_E3_T1" name="Avisar os círculos e o executivo do lançamento na data"><bpmn:documentation>Etapa 3: Lançar e acompanhar os primeiros resultados. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT03_Flow23</bpmn:incoming><bpmn:outgoing>IT03_Flow28</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="IT03_E3_T2" name="Acompanhar os primeiros indicadores e apontar os problemas de entrega, venda ou demanda"><bpmn:documentation>Etapa 3: Lançar e acompanhar os primeiros resultados. Executor: Agente da Integração (Integração · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT03_Flow28</bpmn:incoming><bpmn:outgoing>IT03_Flow29</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="IT03_E3_T3" name="Mandar à carteira a entrega do lançamento, com as lições"><bpmn:documentation>Etapa 3: Lançar e acompanhar os primeiros resultados. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT03_Flow29</bpmn:incoming><bpmn:outgoing>IT03_Flow30</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT03_F1" name="Oferta lançada e primeiros resultados acompanhados"><bpmn:incoming>IT03_Flow30</bpmn:incoming></bpmn:endEvent>
