    <bpmn:sequenceFlow id="IT03_Flow24" name="Falta item com prazo de solução" sourceRef="IT03_E2_G1" targetRef="IT03_E2_T4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Falta item com prazo de solução</bpmn:conditionExpression></bpmn:sequenceFlow>
