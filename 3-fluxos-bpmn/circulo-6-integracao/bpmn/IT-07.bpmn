<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IT07" targetNamespace="urn:imts:modelo:circulo6-integracao" exporter="Ecossistema IMTS - fonte única do Círculo 6" exporterVersion="2026-10-01">
  <bpmn:category id="Category_IT07">
    <bpmn:categoryValue id="CV_IT07_E1" value="1. Receber e classificar o pedido, o incidente ou o risco" />
    <bpmn:categoryValue id="CV_IT07_E2" value="2. Resolver o item e implantar a mudança" />
    <bpmn:categoryValue id="CV_IT07_E3" value="3. Escolher e contratar fornecedor ou licença de tecnologia" />
    <bpmn:categoryValue id="CV_IT07_E4" value="4. Registrar e medir o serviço de tecnologia" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_IT07">
    <bpmn:participant id="Participant_IT07" name="IT-07 · Operar a tecnologia: pedidos, incidentes, acessos, mudanças e fornecedores" processRef="Process_IT07" />
    <bpmn:group id="Group_IT07_E1" categoryValueRef="CV_IT07_E1" />
    <bpmn:group id="Group_IT07_E2" categoryValueRef="CV_IT07_E2" />
    <bpmn:group id="Group_IT07_E3" categoryValueRef="CV_IT07_E3" />
    <bpmn:group id="Group_IT07_E4" categoryValueRef="CV_IT07_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_IT07" name="Operar a tecnologia: pedidos, incidentes, acessos, mudanças e fornecedores" isExecutable="false">
    <bpmn:documentation>Fazer cada pedido, incidente ou risco de tecnologia ser resolvido no prazo; cada acesso a dados e sistemas ser dado e retirado pela classificação do dado e pelo pedido; cada mudança em sistema ser testada, aprovada e reversível; cada incidente de segurança ou de dados pessoais ser tratado com a Governança; e cada fornecedor e licença de tecnologia ser escolhido, contratado e controlado com a Gestão e a Governança. A Integração opera e protege; a Governança define a política e verifica; a Gestão compra e paga.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_IT07">
      <bpmn:lane id="Lane_IT07_SOL" name="Solicitante">
        <bpmn:flowNodeRef>IT07_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT07_NEG" name="Negócios">
        <bpmn:flowNodeRef>IT07_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT07_GOV" name="Governança">
        <bpmn:flowNodeRef>IT07_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT07_GES" name="Gestão">
        <bpmn:flowNodeRef>IT07_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E3_T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT07_ITP" name="Integração · pessoa">
        <bpmn:flowNodeRef>IT07_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E2_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E2_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT07_ITA" name="Integração · agente">
        <bpmn:flowNodeRef>IT07_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E3_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT07_ITR" name="Integração · automação">
        <bpmn:flowNodeRef>IT07_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_S4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E3_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_M6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT07_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="IT07_S1" name="Pedido, incidente ou risco de tecnologia recebido"><bpmn:outgoing>IT07_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IT07_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT07_S2" name="Contrato de cliente encerrado"><bpmn:outgoing>IT07_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="IT07_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT07_S3" name="Renovação de licença ou de contrato de tecnologia próxima"><bpmn:outgoing>IT07_Flow3</bpmn:outgoing><bpmn:timerEventDefinition id="IT07_S3_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT07_S4" name="Pedido de acesso ou de mudança vindo de outra jornada"><bpmn:outgoing>IT07_Flow4</bpmn:outgoing><bpmn:messageEventDefinition id="IT07_S4_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="IT07_M1"><bpmn:incoming>IT07_Flow1</bpmn:incoming><bpmn:incoming>IT07_Flow2</bpmn:incoming><bpmn:incoming>IT07_Flow3</bpmn:incoming><bpmn:incoming>IT07_Flow4</bpmn:incoming><bpmn:outgoing>IT07_Flow36</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT07_E1_T1" name="Registrar o item, quem pede, o sistema e o dado afetados"><bpmn:documentation>Etapa 1: Receber e classificar o pedido, o incidente ou o risco. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT07_Flow36</bpmn:incoming><bpmn:outgoing>IT07_Flow5</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="IT07_E1_T2" name="Classificar o tipo, a urgência, o risco e o prazo"><bpmn:documentation>Etapa 1: Receber e classificar o pedido, o incidente ou o risco. Executor: Agente da Integração (Integração · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT07_Flow5</bpmn:incoming><bpmn:outgoing>IT07_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IT07_E1_G1" name="É incidente de segurança ou de dados pessoais?"><bpmn:incoming>IT07_Flow6</bpmn:incoming><bpmn:outgoing>IT07_Flow7</bpmn:outgoing><bpmn:outgoing>IT07_Flow8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="IT07_E1_T3" name="Tratar o incidente de segurança ou de dados pessoais com a Governança"><bpmn:documentation>Etapa 1: Receber e classificar o pedido, o incidente ou o risco. Executor: Outro círculo (Governança). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT07_Flow7</bpmn:incoming><bpmn:outgoing>IT07_Flow9</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="IT07_M2"><bpmn:incoming>IT07_Flow8</bpmn:incoming><bpmn:incoming>IT07_Flow9</bpmn:incoming><bpmn:outgoing>IT07_Flow37</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT07_E1_G2" name="O que o item pede?"><bpmn:incoming>IT07_Flow37</bpmn:incoming><bpmn:outgoing>IT07_Flow10</bpmn:outgoing><bpmn:outgoing>IT07_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT07_E2_G1" name="O item pede mudança em sistema?"><bpmn:incoming>IT07_Flow10</bpmn:incoming><bpmn:outgoing>IT07_Flow12</bpmn:outgoing><bpmn:outgoing>IT07_Flow13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT07_E2_T1" name="Conceder ou retirar o acesso pela classificação do dado, ou aplicar a solução conhecida"><bpmn:documentation>Etapa 2: Resolver o item e implantar a mudança. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow12</bpmn:incoming><bpmn:outgoing>IT07_Flow15</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="IT07_E2_T2" name="Preparar e testar a mudança, com o caminho de volta"><bpmn:documentation>Etapa 2: Resolver o item e implantar a mudança. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow13</bpmn:incoming><bpmn:outgoing>IT07_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="IT07_E2_T3" name="Aprovar a mudança e a janela de implantação"><bpmn:documentation>Etapa 2: Resolver o item e implantar a mudança. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow14</bpmn:incoming><bpmn:outgoing>IT07_Flow16</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IT07_M3"><bpmn:incoming>IT07_Flow15</bpmn:incoming><bpmn:incoming>IT07_Flow16</bpmn:incoming><bpmn:outgoing>IT07_Flow38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT07_E2_G2" name="A mudança mexe em dado pessoal, acesso privilegiado ou segurança?"><bpmn:incoming>IT07_Flow38</bpmn:incoming><bpmn:outgoing>IT07_Flow17</bpmn:outgoing><bpmn:outgoing>IT07_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="IT07_E2_T4" name="Conferir a mudança contra a política de segurança e de dados pessoais"><bpmn:documentation>Etapa 2: Resolver o item e implantar a mudança. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow17</bpmn:incoming><bpmn:outgoing>IT07_Flow19</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="IT07_M4"><bpmn:incoming>IT07_Flow18</bpmn:incoming><bpmn:incoming>IT07_Flow19</bpmn:incoming><bpmn:outgoing>IT07_Flow39</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT07_E2_T5" name="Resolver o caso novo que o agente não resolve"><bpmn:documentation>Etapa 2: Resolver o item e implantar a mudança. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow39</bpmn:incoming><bpmn:outgoing>IT07_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT07_E2_T6" name="Implantar a mudança ou fechar o item e avisar quem pediu"><bpmn:documentation>Etapa 2: Resolver o item e implantar a mudança. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow20</bpmn:incoming><bpmn:outgoing>IT07_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT07_E2_G3" name="O item foi resolvido?"><bpmn:incoming>IT07_Flow21</bpmn:incoming><bpmn:outgoing>IT07_Flow22</bpmn:outgoing><bpmn:outgoing>IT07_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT07_E2_T7" name="Desfazer a mudança, voltar ao estado anterior e registrar o motivo"><bpmn:documentation>Etapa 2: Resolver o item e implantar a mudança. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow23</bpmn:incoming><bpmn:outgoing>IT07_Flow24</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT07_F2" name="Mudança desfeita, com o motivo"><bpmn:incoming>IT07_Flow24</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="IT07_M5"><bpmn:incoming>IT07_Flow11</bpmn:incoming><bpmn:incoming>IT07_Flow30</bpmn:incoming><bpmn:outgoing>IT07_Flow40</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IT07_E3_T1" name="Comparar fornecedores e licenças, ou o uso da que vence: requisito, segurança, custo e saída"><bpmn:documentation>Etapa 3: Escolher e contratar fornecedor ou licença de tecnologia. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow40</bpmn:incoming><bpmn:outgoing>IT07_Flow25</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="IT07_E3_T2" name="Escolher o fornecedor ou a licença, ou decidir renovar"><bpmn:documentation>Etapa 3: Escolher e contratar fornecedor ou licença de tecnologia. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow25</bpmn:incoming><bpmn:outgoing>IT07_Flow26</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="IT07_E3_T3" name="Revisar o contrato de tecnologia, licença ou dados e a segurança"><bpmn:documentation>Etapa 3: Escolher e contratar fornecedor ou licença de tecnologia. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow26</bpmn:incoming><bpmn:outgoing>IT07_Flow27</bpmn:outgoing></bpmn:task>
    <bpmn:task id="IT07_E3_T4" name="Conferir o custo e o orçamento"><bpmn:documentation>Etapa 3: Escolher e contratar fornecedor ou licença de tecnologia. Executor: Outro círculo (Gestão). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow27</bpmn:incoming><bpmn:outgoing>IT07_Flow28</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="IT07_E3_G1" name="A contratação foi aprovada?"><bpmn:incoming>IT07_Flow28</bpmn:incoming><bpmn:outgoing>IT07_Flow29</bpmn:outgoing><bpmn:outgoing>IT07_Flow31</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IT07_E3_T5" name="Rever a escolha com o motivo da recusa"><bpmn:documentation>Etapa 3: Escolher e contratar fornecedor ou licença de tecnologia. Executor: Agente da Integração (Integração · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow29</bpmn:incoming><bpmn:outgoing>IT07_Flow30</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="IT07_E3_T6" name="Fazer a compra ou a renovação"><bpmn:documentation>Etapa 3: Escolher e contratar fornecedor ou licença de tecnologia. Executor: Outro círculo (Gestão). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow31</bpmn:incoming><bpmn:outgoing>IT07_Flow32</bpmn:outgoing></bpmn:task>
    <bpmn:scriptTask id="IT07_E3_T7" name="Registrar o fornecedor, a licença, o custo e a data de renovação"><bpmn:documentation>Etapa 3: Escolher e contratar fornecedor ou licença de tecnologia. Executor: Automação da Integração (Integração · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT07_Flow32</bpmn:incoming><bpmn:outgoing>IT07_Flow33</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT07_M6"><bpmn:incoming>IT07_Flow22</bpmn:incoming><bpmn:incoming>IT07_Flow33</bpmn:incoming><bpmn:outgoing>IT07_Flow41</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT07_E4_T1" name="Registrar o item, o tempo, a causa e o custo"><bpmn:documentation>Etapa 4: Registrar e medir o serviço de tecnologia. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT07_Flow41</bpmn:incoming><bpmn:outgoing>IT07_Flow34</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT07_E4_T2" name="Medir disponibilidade, erros, custo e prazo dos serviços de tecnologia"><bpmn:documentation>Etapa 4: Registrar e medir o serviço de tecnologia. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT07_Flow34</bpmn:incoming><bpmn:outgoing>IT07_Flow35</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT07_F1" name="Item de tecnologia resolvido ou contratado e registrado"><bpmn:incoming>IT07_Flow35</bpmn:incoming></bpmn:endEvent>
