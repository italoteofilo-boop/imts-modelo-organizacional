<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IT02" targetNamespace="urn:imts:modelo:circulo6-integracao" exporter="Ecossistema IMTS - fonte única do Círculo 6" exporterVersion="2026-10-01">
  <bpmn:category id="Category_IT02">
    <bpmn:categoryValue id="CV_IT02_E1" value="1. Planejar a implantação com o cliente e com Operações" />
    <bpmn:categoryValue id="CV_IT02_E2" value="2. Preparar o ambiente, os acessos, as pessoas e os materiais" />
    <bpmn:categoryValue id="CV_IT02_E3" value="3. Implantar e conferir o aceite do cliente" />
    <bpmn:categoryValue id="CV_IT02_E4" value="4. Passar o cliente a Operações e encerrar a implantação" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_IT02">
    <bpmn:participant id="Participant_IT02" name="IT-02 · Implantar o cliente, do contrato assinado à operação" processRef="Process_IT02" />
    <bpmn:group id="Group_IT02_E1" categoryValueRef="CV_IT02_E1" />
    <bpmn:group id="Group_IT02_E2" categoryValueRef="CV_IT02_E2" />
    <bpmn:group id="Group_IT02_E3" categoryValueRef="CV_IT02_E3" />
    <bpmn:group id="Group_IT02_E4" categoryValueRef="CV_IT02_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_IT02" name="Implantar o cliente, do contrato assinado à operação" isExecutable="false">
    <bpmn:documentation>Fazer cada contrato assinado virar um cliente implantado e aceito, com um plano combinado com o cliente e com Operações, ambiente, acessos, pessoas e materiais prontos, e passado a Operações para a entrega recorrente. A Integração coordena; Operações confirma a capacidade e assume a entrega; a Gestão compra o que falta; o cliente aceita.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_IT02">
      <bpmn:lane id="Lane_IT02_NEG" name="Negócios">
        <bpmn:flowNodeRef>IT02_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT02_CLI" name="Cliente">
        <bpmn:flowNodeRef>IT02_E1_PS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT02_OPE" name="Operações">
        <bpmn:flowNodeRef>IT02_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E1_PJ1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT02_GES" name="Gestão">
        <bpmn:flowNodeRef>IT02_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT02_IDE" name="Identidade">
        <bpmn:flowNodeRef>IT02_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT02_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>IT02_E3_T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT02_ITP" name="Integração · pessoa">
        <bpmn:flowNodeRef>IT02_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E1_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E3_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT02_ITA" name="Integração · agente">
        <bpmn:flowNodeRef>IT02_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E1_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E2_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E2_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E2_T8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT02_ITR" name="Integração · automação">
        <bpmn:flowNodeRef>IT02_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E3_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E3_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT02_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="IT02_S1" name="Contrato de cliente assinado recebido"><bpmn:outgoing>IT02_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IT02_S1_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="IT02_M1"><bpmn:incoming>IT02_Flow1</bpmn:incoming><bpmn:incoming>IT02_Flow10</bpmn:incoming><bpmn:outgoing>IT02_Flow40</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IT02_E1_T1" name="Montar o cronograma, os riscos e a lista de requisitos a partir do escopo vendido"><bpmn:documentation>Etapa 1: Planejar a implantação com o cliente e com Operações. Executor: Agente da Integração (Integração · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow40</bpmn:incoming><bpmn:outgoing>IT02_Flow2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="IT02_E1_T2" name="Combinar o plano de implantação com o cliente"><bpmn:documentation>Etapa 1: Planejar a implantação com o cliente e com Operações. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow2</bpmn:incoming><bpmn:outgoing>IT02_Flow3</bpmn:outgoing></bpmn:manualTask>
    <bpmn:parallelGateway id="IT02_E1_PS1"><bpmn:incoming>IT02_Flow3</bpmn:incoming><bpmn:outgoing>IT02_Flow4</bpmn:outgoing><bpmn:outgoing>IT02_Flow6</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="IT02_E1_T3" name="Confirmar o plano de implantação e os responsáveis do cliente"><bpmn:documentation>Etapa 1: Planejar a implantação com o cliente e com Operações. Executor: Pessoa de fora do círculo (Cliente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow4</bpmn:incoming><bpmn:outgoing>IT02_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="IT02_E1_T4" name="Confirmar a capacidade de entrega e quem assume o cliente"><bpmn:documentation>Etapa 1: Planejar a implantação com o cliente e com Operações. Executor: Outro círculo (Operações). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow6</bpmn:incoming><bpmn:outgoing>IT02_Flow7</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="IT02_E1_PJ1"><bpmn:incoming>IT02_Flow5</bpmn:incoming><bpmn:incoming>IT02_Flow7</bpmn:incoming><bpmn:outgoing>IT02_Flow8</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="IT02_E1_G1" name="Operações confirmou a capacidade?"><bpmn:incoming>IT02_Flow8</bpmn:incoming><bpmn:outgoing>IT02_Flow9</bpmn:outgoing><bpmn:outgoing>IT02_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IT02_E1_T5" name="Rever o cronograma e os recursos com Operações"><bpmn:documentation>Etapa 1: Planejar a implantação com o cliente e com Operações. Executor: Agente da Integração (Integração · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow9</bpmn:incoming><bpmn:outgoing>IT02_Flow10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="IT02_E1_T6" name="Decidir o plano de implantação e abri-lo na carteira de projetos"><bpmn:documentation>Etapa 1: Planejar a implantação com o cliente e com Operações. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow11</bpmn:incoming><bpmn:outgoing>IT02_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT02_E2_T1" name="Pedir a configuração dos agentes e os acessos do cliente"><bpmn:documentation>Etapa 2: Preparar o ambiente, os acessos, as pessoas e os materiais. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow12</bpmn:incoming><bpmn:outgoing>IT02_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="IT02_E2_T2" name="Preparar os materiais e as comunicações da implantação"><bpmn:documentation>Etapa 2: Preparar o ambiente, os acessos, as pessoas e os materiais. Executor: Agente da Integração (Integração · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow13</bpmn:incoming><bpmn:outgoing>IT02_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IT02_E2_G1" name="Os materiais estão conforme os padrões de identidade?"><bpmn:incoming>IT02_Flow14</bpmn:incoming><bpmn:outgoing>IT02_Flow15</bpmn:outgoing><bpmn:outgoing>IT02_Flow16</bpmn:outgoing><bpmn:outgoing>IT02_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT02_E2_T3" name="Corrigir os materiais no que não está conforme os padrões"><bpmn:documentation>Etapa 2: Preparar o ambiente, os acessos, as pessoas e os materiais. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow15</bpmn:incoming><bpmn:outgoing>IT02_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:callActivity id="IT02_E2_T4" name="Responder à consulta sobre os materiais de implantação não cobertos pelos padrões"><bpmn:documentation>Etapa 2: Preparar o ambiente, os acessos, as pessoas e os materiais. Executor: Outro círculo (Identidade). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow16</bpmn:incoming><bpmn:outgoing>IT02_Flow19</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="IT02_M2"><bpmn:incoming>IT02_Flow17</bpmn:incoming><bpmn:incoming>IT02_Flow18</bpmn:incoming><bpmn:incoming>IT02_Flow19</bpmn:incoming><bpmn:outgoing>IT02_Flow41</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT02_E2_G2" name="Falta pessoa, compra ou assessoria para a implantação?"><bpmn:incoming>IT02_Flow41</bpmn:incoming><bpmn:outgoing>IT02_Flow20</bpmn:outgoing><bpmn:outgoing>IT02_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="IT02_E2_T5" name="Contratar ou comprar o que falta para a implantação"><bpmn:documentation>Etapa 2: Preparar o ambiente, os acessos, as pessoas e os materiais. Executor: Outro círculo (Gestão). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow20</bpmn:incoming><bpmn:outgoing>IT02_Flow22</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="IT02_M3"><bpmn:incoming>IT02_Flow21</bpmn:incoming><bpmn:incoming>IT02_Flow22</bpmn:incoming><bpmn:outgoing>IT02_Flow42</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="IT02_E2_T6" name="Receber os agentes liberados e os acessos configurados, ou o motivo de não estarem"><bpmn:documentation>Etapa 2: Preparar o ambiente, os acessos, as pessoas e os materiais. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow42</bpmn:incoming><bpmn:outgoing>IT02_Flow23</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="IT02_E2_G3" name="Os agentes e os acessos ficaram prontos?"><bpmn:incoming>IT02_Flow23</bpmn:incoming><bpmn:outgoing>IT02_Flow24</bpmn:outgoing><bpmn:outgoing>IT02_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT02_E2_T7" name="Levar ao executivo o que impede a implantação e suspender o projeto na carteira"><bpmn:documentation>Etapa 2: Preparar o ambiente, os acessos, as pessoas e os materiais. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow24</bpmn:incoming><bpmn:outgoing>IT02_Flow25</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="IT02_E2_T8" name="Conferir a lista de requisitos atendida"><bpmn:documentation>Etapa 2: Preparar o ambiente, os acessos, as pessoas e os materiais. Executor: Agente da Integração (Integração · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow26</bpmn:incoming><bpmn:outgoing>IT02_Flow27</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IT02_M4"><bpmn:incoming>IT02_Flow27</bpmn:incoming><bpmn:incoming>IT02_Flow33</bpmn:incoming><bpmn:outgoing>IT02_Flow43</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="IT02_E3_T1" name="Implantar com Operações: configurar, migrar, treinar e testar com o cliente"><bpmn:documentation>Etapa 3: Implantar e conferir o aceite do cliente. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow43</bpmn:incoming><bpmn:outgoing>IT02_Flow28</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="IT02_E3_T2" name="Conferir a implantação com o cliente"><bpmn:documentation>Etapa 3: Implantar e conferir o aceite do cliente. Executor: Pessoa de fora do círculo (Cliente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow28</bpmn:incoming><bpmn:outgoing>IT02_Flow29</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT02_E3_T3" name="Registrar o andamento e as pendências da implantação"><bpmn:documentation>Etapa 3: Implantar e conferir o aceite do cliente. Executor: Automação da Integração (Integração · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow29</bpmn:incoming><bpmn:outgoing>IT02_Flow30</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT02_E3_G1" name="O cliente aceitou a implantação?"><bpmn:incoming>IT02_Flow30</bpmn:incoming><bpmn:outgoing>IT02_Flow31</bpmn:outgoing><bpmn:outgoing>IT02_Flow32</bpmn:outgoing><bpmn:outgoing>IT02_Flow34</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT02_E3_T4" name="Corrigir a pendência apontada pelo cliente"><bpmn:documentation>Etapa 3: Implantar e conferir o aceite do cliente. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow32</bpmn:incoming><bpmn:outgoing>IT02_Flow33</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT02_E3_T5" name="Levar o impasse ao executivo, com o que falta e as opções, e suspender o projeto na carteira"><bpmn:documentation>Etapa 3: Implantar e conferir o aceite do cliente. Executor: Automação da Integração (Integração · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow34</bpmn:incoming><bpmn:outgoing>IT02_Flow35</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="IT02_E3_T6" name="Decidir o impasse da implantação: corrigir com recurso, rever o contrato ou encerrar"><bpmn:documentation>Etapa 3: Implantar e conferir o aceite do cliente. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow35</bpmn:incoming><bpmn:outgoing>IT02_Flow36</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT02_E3_T7" name="Registrar a decisão do executivo e devolvê-la à carteira de projetos"><bpmn:documentation>Etapa 3: Implantar e conferir o aceite do cliente. Executor: Automação da Integração (Integração · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT02_Flow36</bpmn:incoming><bpmn:outgoing>IT02_Flow37</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT02_M5"><bpmn:incoming>IT02_Flow25</bpmn:incoming><bpmn:incoming>IT02_Flow37</bpmn:incoming><bpmn:outgoing>IT02_Flow44</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="IT02_F2" name="Impasse da implantação levado ao executivo"><bpmn:incoming>IT02_Flow44</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="IT02_E4_T1" name="Passar o cliente a Operações com o registro do que foi implantado"><bpmn:documentation>Etapa 4: Passar o cliente a Operações e encerrar a implantação. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT02_Flow31</bpmn:incoming><bpmn:outgoing>IT02_Flow38</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT02_E4_T2" name="Avisar a Gestão do início da entrega e mandar à carteira a entrega, com as lições"><bpmn:documentation>Etapa 4: Passar o cliente a Operações e encerrar a implantação. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT02_Flow38</bpmn:incoming><bpmn:outgoing>IT02_Flow39</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT02_F1" name="Cliente implantado, aceito e passado a Operações"><bpmn:incoming>IT02_Flow39</bpmn:incoming></bpmn:endEvent>
