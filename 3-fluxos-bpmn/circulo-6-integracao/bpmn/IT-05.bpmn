<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IT05" targetNamespace="urn:imts:modelo:circulo6-integracao" exporter="Ecossistema IMTS - fonte única do Círculo 6" exporterVersion="2026-10-01">
  <bpmn:category id="Category_IT05">
    <bpmn:categoryValue id="CV_IT05_E1" value="1. Receber o pedido e achar a capacidade" />
    <bpmn:categoryValue id="CV_IT05_E2" value="2. Desenhar a ficha da capacidade com o dono e a Inteligência" />
    <bpmn:categoryValue id="CV_IT05_E3" value="3. Publicar ou retirar a capacidade no catálogo e pedir a construção" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_IT05">
    <bpmn:participant id="Participant_IT05" name="IT-05 · Atender pedidos de capacidade e de serviço e manter o catálogo de capacidades" processRef="Process_IT05" />
    <bpmn:group id="Group_IT05_E1" categoryValueRef="CV_IT05_E1" />
    <bpmn:group id="Group_IT05_E2" categoryValueRef="CV_IT05_E2" />
    <bpmn:group id="Group_IT05_E3" categoryValueRef="CV_IT05_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_IT05" name="Atender pedidos de capacidade e de serviço e manter o catálogo de capacidades" isExecutable="false">
    <bpmn:documentation>Fazer cada pedido de serviço de uma empresa a um círculo chegar ao círculo dono da capacidade com um acordo de serviço, e cada necessidade de capacidade nova ou mudada virar uma ficha com método, conhecimento, executor (pessoa, agente, automação ou assessoria), ferramentas, acordo de serviço, indicador e alçada, aceita pelo líder do círculo dono e publicada no catálogo, ligada às jornadas e às tarefas. A Inteligência dá o método e o conhecimento; a Governança define a alçada; o líder do círculo dono aceita a capacidade.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_IT05">
      <bpmn:lane id="Lane_IT05_SOL" name="Solicitante">
        <bpmn:flowNodeRef>IT05_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT05_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>IT05_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT05_INT" name="Inteligência">
        <bpmn:flowNodeRef>IT05_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_S4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT05_GOV" name="Governança">
        <bpmn:flowNodeRef>IT05_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT05_LCI" name="Líder do círculo">
        <bpmn:flowNodeRef>IT05_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT05_ITP" name="Integração · pessoa">
        <bpmn:flowNodeRef>IT05_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E2_G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT05_ITA" name="Integração · agente">
        <bpmn:flowNodeRef>IT05_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E1_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IT05_ITR" name="Integração · automação">
        <bpmn:flowNodeRef>IT05_S5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_F5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E1_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_F4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_F6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_F3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_E3_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IT05_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="IT05_S1" name="Pedido de serviço de empresa recebido"><bpmn:outgoing>IT05_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IT05_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT05_S2" name="Necessidade de capacidade nova ou mudada recebida"><bpmn:outgoing>IT05_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="IT05_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT05_S3" name="Capacidades pedidas por oferta recebidas"><bpmn:outgoing>IT05_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="IT05_S3_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT05_S4" name="Método publicado, retirado ou recusado avisado"><bpmn:outgoing>IT05_Flow4</bpmn:outgoing><bpmn:messageEventDefinition id="IT05_S4_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IT05_S5" name="Revisão do catálogo de capacidades iniciada"><bpmn:outgoing>IT05_Flow5</bpmn:outgoing><bpmn:timerEventDefinition id="IT05_S5_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="IT05_M1"><bpmn:incoming>IT05_Flow1</bpmn:incoming><bpmn:incoming>IT05_Flow2</bpmn:incoming><bpmn:incoming>IT05_Flow3</bpmn:incoming><bpmn:incoming>IT05_Flow4</bpmn:incoming><bpmn:incoming>IT05_Flow5</bpmn:incoming><bpmn:outgoing>IT05_Flow36</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT05_E1_T1" name="Registrar o pedido, quem pede e a capacidade procurada no catálogo"><bpmn:documentation>Etapa 1: Receber o pedido e achar a capacidade. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow36</bpmn:incoming><bpmn:outgoing>IT05_Flow6</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT05_E1_G1" name="O que abriu o trabalho?"><bpmn:incoming>IT05_Flow6</bpmn:incoming><bpmn:outgoing>IT05_Flow7</bpmn:outgoing><bpmn:outgoing>IT05_Flow10</bpmn:outgoing><bpmn:outgoing>IT05_Flow12</bpmn:outgoing><bpmn:outgoing>IT05_Flow14</bpmn:outgoing><bpmn:outgoing>IT05_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IT05_E1_T2" name="Combinar o acordo de serviço com quem pediu"><bpmn:documentation>Etapa 1: Receber o pedido e achar a capacidade. Executor: Pessoa de fora do círculo (Líder do círculo). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow7</bpmn:incoming><bpmn:outgoing>IT05_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IT05_E1_T3" name="Encaminhar o pedido ao círculo dono e registrar o acordo de serviço"><bpmn:documentation>Etapa 1: Receber o pedido e achar a capacidade. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow8</bpmn:incoming><bpmn:outgoing>IT05_Flow9</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT05_F2" name="Pedido de serviço encaminhado ao círculo dono, com acordo de serviço"><bpmn:incoming>IT05_Flow9</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="IT05_E1_T4" name="Avisar quem pediu a capacidade que o método não foi publicado, com o motivo"><bpmn:documentation>Etapa 1: Receber o pedido e achar a capacidade. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow10</bpmn:incoming><bpmn:outgoing>IT05_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT05_F5" name="Necessidade sem método publicado, devolvida a quem pediu"><bpmn:incoming>IT05_Flow11</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="IT05_E1_T5" name="Marcar a capacidade a retirar e as jornadas e os agentes que a usam"><bpmn:documentation>Etapa 1: Receber o pedido e achar a capacidade. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow12</bpmn:incoming><bpmn:outgoing>IT05_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IT05_M2"><bpmn:incoming>IT05_Flow14</bpmn:incoming><bpmn:incoming>IT05_Flow15</bpmn:incoming><bpmn:outgoing>IT05_Flow37</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IT05_E1_T6" name="Estimar o ganho esperado e a prioridade da necessidade"><bpmn:documentation>Etapa 1: Receber o pedido e achar a capacidade. Executor: Agente da Integração (Integração · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow37</bpmn:incoming><bpmn:outgoing>IT05_Flow16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IT05_M3"><bpmn:incoming>IT05_Flow16</bpmn:incoming><bpmn:incoming>IT05_Flow25</bpmn:incoming><bpmn:outgoing>IT05_Flow38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT05_E2_G1" name="Há método publicado para a capacidade?"><bpmn:incoming>IT05_Flow38</bpmn:incoming><bpmn:outgoing>IT05_Flow17</bpmn:outgoing><bpmn:outgoing>IT05_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT05_E2_T1" name="Pedir à Inteligência o método para a capacidade, com a necessidade e o ganho"><bpmn:documentation>Etapa 2: Desenhar a ficha da capacidade com o dono e a Inteligência. Executor: Automação da Integração (Integração · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT05_Flow17</bpmn:incoming><bpmn:outgoing>IT05_Flow18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT05_F4" name="Capacidade sem método, à espera da Inteligência"><bpmn:incoming>IT05_Flow18</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="IT05_E2_T2" name="Propor a ficha: método, conhecimento, executor, ferramentas, acordo de serviço e indicador"><bpmn:documentation>Etapa 2: Desenhar a ficha da capacidade com o dono e a Inteligência. Executor: Agente da Integração (Integração · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT05_Flow19</bpmn:incoming><bpmn:outgoing>IT05_Flow20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="IT05_E2_T3" name="Decidir o executor da capacidade: pessoa, agente, automação ou assessoria"><bpmn:documentation>Etapa 2: Desenhar a ficha da capacidade com o dono e a Inteligência. Executor: Pessoa da Integração (Integração · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT05_Flow20</bpmn:incoming><bpmn:outgoing>IT05_Flow21</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="IT05_E2_T4" name="Definir a alçada do executor da capacidade"><bpmn:documentation>Etapa 2: Desenhar a ficha da capacidade com o dono e a Inteligência. Executor: Outro círculo (Governança). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT05_Flow21</bpmn:incoming><bpmn:outgoing>IT05_Flow22</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="IT05_E2_T5" name="Aceitar a ficha e assumir a capacidade no seu círculo"><bpmn:documentation>Etapa 2: Desenhar a ficha da capacidade com o dono e a Inteligência. Executor: Pessoa de fora do círculo (Líder do círculo). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT05_Flow22</bpmn:incoming><bpmn:outgoing>IT05_Flow23</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IT05_E2_G2" name="O líder do círculo dono aceitou a ficha?"><bpmn:incoming>IT05_Flow23</bpmn:incoming><bpmn:outgoing>IT05_Flow24</bpmn:outgoing><bpmn:outgoing>IT05_Flow25</bpmn:outgoing><bpmn:outgoing>IT05_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT05_E2_T6" name="Registrar o motivo e avisar quem pediu a capacidade"><bpmn:documentation>Etapa 2: Desenhar a ficha da capacidade com o dono e a Inteligência. Executor: Automação da Integração (Integração · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>IT05_Flow26</bpmn:incoming><bpmn:outgoing>IT05_Flow27</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT05_F6" name="Capacidade não aceita pelo líder do círculo dono, com o motivo"><bpmn:incoming>IT05_Flow27</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="IT05_M4"><bpmn:incoming>IT05_Flow13</bpmn:incoming><bpmn:incoming>IT05_Flow24</bpmn:incoming><bpmn:outgoing>IT05_Flow39</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IT05_E3_G1" name="O que a capacidade pede?"><bpmn:incoming>IT05_Flow39</bpmn:incoming><bpmn:outgoing>IT05_Flow28</bpmn:outgoing><bpmn:outgoing>IT05_Flow29</bpmn:outgoing><bpmn:outgoing>IT05_Flow30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT05_E3_T1" name="Pedir a montagem ou a mudança do agente ou da automação"><bpmn:documentation>Etapa 3: Publicar ou retirar a capacidade no catálogo e pedir a construção. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow28</bpmn:incoming><bpmn:outgoing>IT05_Flow32</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT05_E3_T2" name="Abrir na carteira o projeto de preparar pessoas ou contratar a assessoria"><bpmn:documentation>Etapa 3: Publicar ou retirar a capacidade no catálogo e pedir a construção. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow29</bpmn:incoming><bpmn:outgoing>IT05_Flow33</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT05_E3_T3" name="Retirar a capacidade do catálogo, pedir a retirada dos agentes e avisar os donos afetados"><bpmn:documentation>Etapa 3: Publicar ou retirar a capacidade no catálogo e pedir a construção. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow30</bpmn:incoming><bpmn:outgoing>IT05_Flow31</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT05_F3" name="Capacidade retirada do catálogo"><bpmn:incoming>IT05_Flow31</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="IT05_M5"><bpmn:incoming>IT05_Flow32</bpmn:incoming><bpmn:incoming>IT05_Flow33</bpmn:incoming><bpmn:outgoing>IT05_Flow40</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IT05_E3_T4" name="Versionar a ficha e ligar a capacidade às jornadas, às tarefas e aos donos"><bpmn:documentation>Etapa 3: Publicar ou retirar a capacidade no catálogo e pedir a construção. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow40</bpmn:incoming><bpmn:outgoing>IT05_Flow34</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="IT05_E3_T5" name="Publicar a capacidade no catálogo, em construção até o agente ou a pessoa estarem prontos"><bpmn:documentation>Etapa 3: Publicar ou retirar a capacidade no catálogo e pedir a construção. Executor: Automação da Integração (Integração · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>IT05_Flow34</bpmn:incoming><bpmn:outgoing>IT05_Flow35</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IT05_F1" name="Capacidade publicada no catálogo"><bpmn:incoming>IT05_Flow35</bpmn:incoming></bpmn:endEvent>
