    <bpmn:exclusiveGateway id="RE05_E1_G1" name="O que abriu o trabalho?"><bpmn:incoming>RE05_Flow58</bpmn:incoming><bpmn:outgoing>RE05_Flow9</bpmn:outgoing><bpmn:outgoing>RE05_Flow10</bpmn:outgoing><bpmn:outgoing>RE05_Flow13</bpmn:outgoing><bpmn:outgoing>RE05_Flow17</bpmn:outgoing><bpmn:outgoing>RE05_Flow19</bpmn:outgoing><bpmn:outgoing>RE05_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="RE05_E1_T1" name="Listar os clientes afetados pela oferta que será encerrada"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Automação de Relações (Relações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow10</bpmn:incoming><bpmn:outgoing>RE05_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:manualTask id="RE05_E1_T2" name="Preparar com Operações e Integração a transição, sem avisar os clientes ainda"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow11</bpmn:incoming><bpmn:outgoing>RE05_Flow12</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="RE05_F5" name="Clientes afetados listados, à espera da data de saída"><bpmn:incoming>RE05_Flow12</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="RE05_E1_T3" name="Listar os clientes afetados pela oferta ou pela empresa que sai"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Automação de Relações (Relações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow13</bpmn:incoming><bpmn:outgoing>RE05_Flow14</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:manualTask id="RE05_E1_T4" name="Combinar com Operações e Integração a transição de cada cliente"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow14</bpmn:incoming><bpmn:outgoing>RE05_Flow15</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="RE05_E1_T5" name="Avisar cada cliente da saída, na data confirmada, com a transição combinada"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow15</bpmn:incoming><bpmn:outgoing>RE05_Flow16</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="RE05_F4" name="Clientes avisados da saída e em transição"><bpmn:incoming>RE05_Flow16</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="RE05_E1_T6" name="Registrar o mandato e os clientes que ele alcança, sob sigilo e sem avisar os clientes"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Automação de Relações (Relações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow17</bpmn:incoming><bpmn:outgoing>RE05_Flow18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="RE05_F6" name="Mandato registrado, sem aviso aos clientes"><bpmn:incoming>RE05_Flow18</bpmn:incoming></bpmn:endEvent>
    <bpmn:manualTask id="RE05_E1_T7" name="Desfazer com Operações e Integração a transição preparada, quando houver, sem avisar os clientes"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow19</bpmn:incoming><bpmn:outgoing>RE05_Flow20</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="RE05_F7" name="Oferta mantida; transição desfeita, quando houver"><bpmn:incoming>RE05_Flow20</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="RE05_E1_T8" name="Conferir o que foi vendido, os resultados que o cliente espera e quem decide nele"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow21</bpmn:incoming><bpmn:outgoing>RE05_Flow22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="RE05_E1_T9" name="Combinar com o cliente o plano de sucesso: resultados, marcos e contatos"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow22</bpmn:incoming><bpmn:outgoing>RE05_Flow23</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="RE05_E1_T10" name="Confirmar o plano de sucesso e os contatos do cliente"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Pessoa de fora do círculo (Cliente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow23</bpmn:incoming><bpmn:outgoing>RE05_Flow24</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="RE05_E1_T11" name="Registrar o plano de sucesso e avisar Operações e Negócios"><bpmn:documentation>Etapa 1: Receber o cliente e combinar o plano de sucesso. Executor: Automação de Relações (Relações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow24</bpmn:incoming><bpmn:outgoing>RE05_Flow25</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="RE05_M2"><bpmn:incoming>RE05_Flow9</bpmn:incoming><bpmn:incoming>RE05_Flow25</bpmn:incoming><bpmn:outgoing>RE05_Flow59</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="RE05_E2_T1" name="Reunir uso, entregas, reclamações, pagamentos, contrato e interações do cliente"><bpmn:documentation>Etapa 2: Medir a saúde do cliente e apontar o risco de perda. Executor: Automação de Relações (Relações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>RE05_Flow59</bpmn:incoming><bpmn:outgoing>RE05_Flow26</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:businessRuleTask id="RE05_E2_T2" name="Calcular a saúde do cliente pela regra e comparar com o plano de sucesso"><bpmn:documentation>Etapa 2: Medir a saúde do cliente e apontar o risco de perda. Executor: Automação de Relações (Relações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>RE05_Flow26</bpmn:incoming><bpmn:outgoing>RE05_Flow27</bpmn:outgoing></bpmn:businessRuleTask>
