    <bpmn:exclusiveGateway id="RE05_M4"><bpmn:incoming>RE05_Flow35</bpmn:incoming><bpmn:incoming>RE05_Flow36</bpmn:incoming><bpmn:incoming>RE05_Flow37</bpmn:incoming><bpmn:outgoing>RE05_Flow61</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="RE05_E3_T5" name="Apresentar ao cliente o resultado e ouvir a avaliação dele"><bpmn:documentation>Etapa 3: Apresentar o resultado ao cliente e agir sobre o risco. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow61</bpmn:incoming><bpmn:outgoing>RE05_Flow38</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="RE05_E3_T6" name="Avaliar o resultado apresentado e dizer o que espera a seguir"><bpmn:documentation>Etapa 3: Apresentar o resultado ao cliente e agir sobre o risco. Executor: Pessoa de fora do círculo (Cliente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow38</bpmn:incoming><bpmn:outgoing>RE05_Flow39</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="RE05_E3_G2" name="Há risco de perda a tratar?"><bpmn:incoming>RE05_Flow39</bpmn:incoming><bpmn:outgoing>RE05_Flow40</bpmn:outgoing><bpmn:outgoing>RE05_Flow41</bpmn:outgoing></bpmn:exclusiveGateway>
