    <bpmn:startEvent id="RE05_S1" name="Contrato de cliente assinado"><bpmn:outgoing>RE05_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="RE05_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE05_S2" name="Empresa adquirida no portfólio"><bpmn:outgoing>RE05_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="RE05_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE05_S3" name="Ciclo de acompanhamento do cliente iniciado"><bpmn:outgoing>RE05_Flow3</bpmn:outgoing><bpmn:timerEventDefinition id="RE05_S3_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE05_S4" name="Sinal de risco do cliente detectado"><bpmn:outgoing>RE05_Flow4</bpmn:outgoing><bpmn:signalEventDefinition id="RE05_S4_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE05_S5" name="Vencimento ou resultado da renovação informado"><bpmn:outgoing>RE05_Flow5</bpmn:outgoing><bpmn:messageEventDefinition id="RE05_S5_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE05_S6" name="Encerramento de oferta ou saída de empresa decidida"><bpmn:outgoing>RE05_Flow6</bpmn:outgoing><bpmn:messageEventDefinition id="RE05_S6_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE05_S7" name="Mandato da empresa recebido"><bpmn:outgoing>RE05_Flow7</bpmn:outgoing><bpmn:messageEventDefinition id="RE05_S7_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE05_S8" name="Oferta mantida, em espera ou devolvida depois da revisão"><bpmn:outgoing>RE05_Flow8</bpmn:outgoing><bpmn:messageEventDefinition id="RE05_S8_def" /></bpmn:startEvent>
