    <bpmn:serviceTask id="RE05_E3_T1" name="Montar o relatório de resultado do cliente contra o plano de sucesso"><bpmn:documentation>Etapa 3: Apresentar o resultado ao cliente e agir sobre o risco. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow60</bpmn:incoming><bpmn:outgoing>RE05_Flow31</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="RE05_E3_T2" name="Conferir o relatório com os padrões de identidade"><bpmn:documentation>Etapa 3: Apresentar o resultado ao cliente e agir sobre o risco. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow31</bpmn:incoming><bpmn:outgoing>RE05_Flow32</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RE05_E3_G1" name="O relatório está conforme os padrões de identidade?"><bpmn:incoming>RE05_Flow32</bpmn:incoming><bpmn:outgoing>RE05_Flow33</bpmn:outgoing><bpmn:outgoing>RE05_Flow34</bpmn:outgoing><bpmn:outgoing>RE05_Flow35</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="RE05_E3_T3" name="Corrigir o relatório no que não está conforme os padrões"><bpmn:documentation>Etapa 3: Apresentar o resultado ao cliente e agir sobre o risco. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE05_Flow33</bpmn:incoming><bpmn:outgoing>RE05_Flow36</bpmn:outgoing></bpmn:userTask>
