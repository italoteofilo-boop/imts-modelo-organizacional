  <bpmn:category id="Category_RE02">
    <bpmn:categoryValue id="CV_RE02_E1" value="1. Preparar a ação: mensagem, público, canal e material" />
    <bpmn:categoryValue id="CV_RE02_E2" value="2. Executar a ação nos canais e captar os contatos" />
    <bpmn:categoryValue id="CV_RE02_E3" value="3. Medir o resultado da ação e registrar o que aprender" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_RE02">
    <bpmn:participant id="Participant_RE02" name="RE-02 · Executar as ações de demanda e medir o resultado" processRef="Process_RE02" />
    <bpmn:group id="Group_RE02_E1" categoryValueRef="CV_RE02_E1" />
    <bpmn:group id="Group_RE02_E2" categoryValueRef="CV_RE02_E2" />
    <bpmn:group id="Group_RE02_E3" categoryValueRef="CV_RE02_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_RE02" name="Executar as ações de demanda e medir o resultado" isExecutable="false">
    <bpmn:documentation>Levar cada ação do plano aos públicos certos, com material conforme os padrões de identidade e só para quem pode ser abordado, captar os contatos com a base legal e medir o resultado de cada ação contra o alvo, e não só pelo alcance; e recolher o material em circulação quando a marca sai de uso ou o material vence.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_RE02">
      <bpmn:lane id="Lane_RE02_SOL" name="Solicitante">
        <bpmn:flowNodeRef>RE02_S2</bpmn:flowNodeRef>
      </bpmn:lane>
