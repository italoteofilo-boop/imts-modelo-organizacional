  <bpmn:category id="Category_RE03">
    <bpmn:categoryValue id="CV_RE03_E1" value="1. Registrar o contato com a origem e a base legal" />
    <bpmn:categoryValue id="CV_RE03_E2" value="2. Nutrir o contato e pontuar o interesse" />
    <bpmn:categoryValue id="CV_RE03_E3" value="3. Qualificar a oportunidade com o contato" />
    <bpmn:categoryValue id="CV_RE03_E4" value="4. Entregar a oportunidade a Negócios e acompanhar o aceite" />
    <bpmn:categoryValue id="CV_RE03_E5" value="5. Executar os pedidos dos titulares e manter a base confiável" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_RE03">
    <bpmn:participant id="Participant_RE03" name="RE-03 · Qualificar os contatos e entregar a Negócios as oportunidades qualificadas" processRef="Process_RE03" />
