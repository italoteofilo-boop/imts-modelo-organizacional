    <bpmn:scriptTask id="RE07_E1_T1" name="Reunir fatos, mudanças, lançamentos, casos e pedidos de imprensa do período"><bpmn:documentation>Etapa 1: Decidir a pauta: o que comunicar, a quem e com que alvo. Executor: Automação de Relações (Relações · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>RE07_Flow36</bpmn:incoming><bpmn:outgoing>RE07_Flow4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="RE07_E1_T2" name="Propor a pauta: tema, público, canal, mensagem-chave e alvo de cada tema"><bpmn:documentation>Etapa 1: Decidir a pauta: o que comunicar, a quem e com que alvo. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>RE07_Flow4</bpmn:incoming><bpmn:outgoing>RE07_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="RE07_E1_T3" name="Opinar sobre os temas que falam em nome da empresa"><bpmn:documentation>Etapa 1: Decidir a pauta: o que comunicar, a quem e com que alvo. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>RE07_Flow5</bpmn:incoming><bpmn:outgoing>RE07_Flow6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="RE07_E1_T4" name="Decidir a pauta, ouvido o executivo"><bpmn:documentation>Etapa 1: Decidir a pauta: o que comunicar, a quem e com que alvo. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>RE07_Flow6</bpmn:incoming><bpmn:outgoing>RE07_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="RE07_E1_G1" name="Há tema a comunicar?"><bpmn:incoming>RE07_Flow7</bpmn:incoming><bpmn:outgoing>RE07_Flow8</bpmn:outgoing><bpmn:outgoing>RE07_Flow9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="RE07_E1_T5" name="Registrar a pauta sem tema e responder aos pedidos recebidos"><bpmn:documentation>Etapa 1: Decidir a pauta: o que comunicar, a quem e com que alvo. Executor: Automação de Relações (Relações · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>RE07_Flow9</bpmn:incoming><bpmn:outgoing>RE07_Flow10</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="RE07_F2" name="Pauta sem tema a comunicar"><bpmn:incoming>RE07_Flow10</bpmn:incoming></bpmn:endEvent>
