        <bpmn:flowNodeRef>RE07_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="RE07_S1" name="Ciclo de pauta iniciado"><bpmn:outgoing>RE07_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="RE07_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE07_S2" name="Fato a comunicar recebido"><bpmn:outgoing>RE07_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="RE07_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE07_S3" name="Pedido de imprensa recebido"><bpmn:outgoing>RE07_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="RE07_S3_def" /></bpmn:startEvent>
