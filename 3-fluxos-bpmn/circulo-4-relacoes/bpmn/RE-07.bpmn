    <bpmn:manualTask id="RE07_E3_T5" name="Preparar o porta-voz com as mensagens, as perguntas difíceis e os limites"><bpmn:documentation>Etapa 3: Aprovar o conteúdo e preparar os porta-vozes. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow31</bpmn:incoming><bpmn:outgoing>RE07_Flow32</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="RE07_M6"><bpmn:incoming>RE07_Flow30</bpmn:incoming><bpmn:incoming>RE07_Flow32</bpmn:incoming><bpmn:outgoing>RE07_Flow41</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="RE07_E4_T1" name="Publicar o conteúdo aprovado nos canais da empresa e enviar à imprensa, no calendário"><bpmn:documentation>Etapa 4: Publicar o conteúdo, atender a imprensa e medir o efeito. Executor: Automação de Relações (Relações · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow41</bpmn:incoming><bpmn:outgoing>RE07_Flow33</bpmn:outgoing></bpmn:scriptTask>
