    <bpmn:serviceTask id="RE07_E2_T1" name="Redigir o conteúdo de cada tema no guia de voz e com a casa de mensagens"><bpmn:documentation>Etapa 2: Produzir o conteúdo e conferir com os padrões de identidade. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow37</bpmn:incoming><bpmn:outgoing>RE07_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="RE07_E2_T2" name="Conferir o conteúdo com os padrões de identidade"><bpmn:documentation>Etapa 2: Produzir o conteúdo e conferir com os padrões de identidade. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow11</bpmn:incoming><bpmn:outgoing>RE07_Flow12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RE07_E2_G1" name="O conteúdo está conforme os padrões de identidade?"><bpmn:incoming>RE07_Flow12</bpmn:incoming><bpmn:outgoing>RE07_Flow13</bpmn:outgoing><bpmn:outgoing>RE07_Flow14</bpmn:outgoing><bpmn:outgoing>RE07_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="RE07_E2_T3" name="Corrigir o conteúdo no que não está conforme os padrões"><bpmn:documentation>Etapa 2: Produzir o conteúdo e conferir com os padrões de identidade. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow13</bpmn:incoming><bpmn:outgoing>RE07_Flow16</bpmn:outgoing></bpmn:userTask>
    <bpmn:callActivity id="RE07_E2_T4" name="Responder à consulta sobre o conteúdo não coberto pelos padrões"><bpmn:documentation>Etapa 2: Produzir o conteúdo e conferir com os padrões de identidade. Executor: Outro círculo (Identidade). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow14</bpmn:incoming><bpmn:outgoing>RE07_Flow17</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="RE07_M3"><bpmn:incoming>RE07_Flow15</bpmn:incoming><bpmn:incoming>RE07_Flow16</bpmn:incoming><bpmn:incoming>RE07_Flow17</bpmn:incoming><bpmn:outgoing>RE07_Flow38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="RE07_E2_T5" name="Revisar o conteúdo e a fonte de cada afirmação"><bpmn:documentation>Etapa 2: Produzir o conteúdo e conferir com os padrões de identidade. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow38</bpmn:incoming><bpmn:outgoing>RE07_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="RE07_E3_G1" name="O conteúdo fala em nome da empresa?"><bpmn:incoming>RE07_Flow18</bpmn:incoming><bpmn:outgoing>RE07_Flow19</bpmn:outgoing><bpmn:outgoing>RE07_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="RE07_E3_T1" name="Aprovar o que a empresa diz e quem fala por ela"><bpmn:documentation>Etapa 3: Aprovar o conteúdo e preparar os porta-vozes. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow19</bpmn:incoming><bpmn:outgoing>RE07_Flow21</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="RE07_M4"><bpmn:incoming>RE07_Flow20</bpmn:incoming><bpmn:incoming>RE07_Flow21</bpmn:incoming><bpmn:outgoing>RE07_Flow39</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="RE07_E3_G2" name="O conteúdo traz risco jurídico ou pede sigilo?"><bpmn:incoming>RE07_Flow39</bpmn:incoming><bpmn:outgoing>RE07_Flow22</bpmn:outgoing><bpmn:outgoing>RE07_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="RE07_E3_T2" name="Conferir o risco jurídico e o que pode ser dito"><bpmn:documentation>Etapa 3: Aprovar o conteúdo e preparar os porta-vozes. Executor: Outro círculo (Governança). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow22</bpmn:incoming><bpmn:outgoing>RE07_Flow24</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="RE07_M5"><bpmn:incoming>RE07_Flow23</bpmn:incoming><bpmn:incoming>RE07_Flow24</bpmn:incoming><bpmn:outgoing>RE07_Flow40</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="RE07_E3_T3" name="Aprovar o conteúdo final, com o que o executivo e a Governança disseram"><bpmn:documentation>Etapa 3: Aprovar o conteúdo e preparar os porta-vozes. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow40</bpmn:incoming><bpmn:outgoing>RE07_Flow25</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="RE07_E3_G3" name="O conteúdo está aprovado?"><bpmn:incoming>RE07_Flow25</bpmn:incoming><bpmn:outgoing>RE07_Flow26</bpmn:outgoing><bpmn:outgoing>RE07_Flow27</bpmn:outgoing><bpmn:outgoing>RE07_Flow29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="RE07_E3_T4" name="Registrar o motivo e responder a quem pediu o tema"><bpmn:documentation>Etapa 3: Aprovar o conteúdo e preparar os porta-vozes. Executor: Automação de Relações (Relações · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow27</bpmn:incoming><bpmn:outgoing>RE07_Flow28</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="RE07_F3" name="Conteúdo não publicado, com o motivo"><bpmn:incoming>RE07_Flow28</bpmn:incoming></bpmn:endEvent>
