    <bpmn:serviceTask id="RE07_E4_T3" name="Medir alcance, resultado e efeito de cada tema contra o alvo, além da exposição"><bpmn:documentation>Etapa 4: Publicar o conteúdo, atender a imprensa e medir o efeito. Executor: Agente de Relações (Relações · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE07_Flow34</bpmn:incoming><bpmn:outgoing>RE07_Flow35</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="RE07_F1" name="Conteúdo publicado e medido"><bpmn:incoming>RE07_Flow35</bpmn:incoming></bpmn:endEvent>
