<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RE07" targetNamespace="urn:imts:modelo:circulo4-relacoes" exporter="Ecossistema IMTS - fonte única do Círculo 4" exporterVersion="2026-10-01">
  <bpmn:category id="Category_RE07">
    <bpmn:categoryValue id="CV_RE07_E1" value="1. Decidir a pauta: o que comunicar, a quem e com que alvo" />
    <bpmn:categoryValue id="CV_RE07_E2" value="2. Produzir o conteúdo e conferir com os padrões de identidade" />
    <bpmn:categoryValue id="CV_RE07_E3" value="3. Aprovar o conteúdo e preparar os porta-vozes" />
    <bpmn:categoryValue id="CV_RE07_E4" value="4. Publicar o conteúdo, atender a imprensa e medir o efeito" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_RE07">
    <bpmn:participant id="Participant_RE07" name="RE-07 · Comunicar para fora: pauta, conteúdo, imprensa e porta-vozes" processRef="Process_RE07" />
    <bpmn:group id="Group_RE07_E1" categoryValueRef="CV_RE07_E1" />
    <bpmn:group id="Group_RE07_E2" categoryValueRef="CV_RE07_E2" />
    <bpmn:group id="Group_RE07_E3" categoryValueRef="CV_RE07_E3" />
    <bpmn:group id="Group_RE07_E4" categoryValueRef="CV_RE07_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_RE07" name="Comunicar para fora: pauta, conteúdo, imprensa e porta-vozes" isExecutable="false">
    <bpmn:documentation>Comunicar aos públicos externos, com uma só voz e dentro dos padrões de identidade, os fatos, as mudanças, os lançamentos e os casos que importam, preparar quem fala pela empresa e medir o efeito de cada tema contra o alvo, e não só a exposição. O executivo aprova o que se diz em nome da empresa; a Governança confere o risco jurídico. A comunicação interna é da Gestão.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_RE07">
      <bpmn:lane id="Lane_RE07_SOL" name="Solicitante">
        <bpmn:flowNodeRef>RE07_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_S3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE07_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>RE07_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE07_GOV" name="Governança">
        <bpmn:flowNodeRef>RE07_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE07_IDE" name="Identidade">
        <bpmn:flowNodeRef>RE07_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE07_REP" name="Relações · pessoa">
        <bpmn:flowNodeRef>RE07_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E3_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E3_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E3_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E3_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE07_REA" name="Relações · agente">
        <bpmn:flowNodeRef>RE07_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E4_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE07_RER" name="Relações · automação">
        <bpmn:flowNodeRef>RE07_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E1_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE07_F3</bpmn:flowNodeRef>
