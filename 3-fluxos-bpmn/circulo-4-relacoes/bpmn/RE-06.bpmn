<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RE06" targetNamespace="urn:imts:modelo:circulo4-relacoes" exporter="Ecossistema IMTS - fonte única do Círculo 4" exporterVersion="2026-10-01">
  <bpmn:category id="Category_RE06">
    <bpmn:categoryValue id="CV_RE06_E1" value="1. Registrar o pedido e avaliar o encaixe da parceria" />
    <bpmn:categoryValue id="CV_RE06_E2" value="2. Negociar e formalizar a parceria" />
    <bpmn:categoryValue id="CV_RE06_E3" value="3. Ativar a parceria" />
    <bpmn:categoryValue id="CV_RE06_E4" value="4. Acompanhar a parceria e decidir manter, mudar ou encerrar" />
    <bpmn:categoryValue id="CV_RE06_E5" value="5. Decidir e registrar o uso da marca por terceiro" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_RE06">
    <bpmn:participant id="Participant_RE06" name="RE-06 · Formar e cuidar de parcerias e relações institucionais e autorizar o uso da marca por terceiros" processRef="Process_RE06" />
    <bpmn:group id="Group_RE06_E1" categoryValueRef="CV_RE06_E1" />
    <bpmn:group id="Group_RE06_E2" categoryValueRef="CV_RE06_E2" />
    <bpmn:group id="Group_RE06_E3" categoryValueRef="CV_RE06_E3" />
