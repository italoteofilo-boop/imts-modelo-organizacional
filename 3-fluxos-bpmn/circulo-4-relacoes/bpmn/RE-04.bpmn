<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_RE04" targetNamespace="urn:imts:modelo:circulo4-relacoes" exporter="Ecossistema IMTS - fonte única do Círculo 4" exporterVersion="2026-10-01">
  <bpmn:category id="Category_RE04">
    <bpmn:categoryValue id="CV_RE04_E1" value="1. Avaliar a experiência atual dos clientes" />
    <bpmn:categoryValue id="CV_RE04_E2" value="2. Desenhar personas, mapa da jornada e padrões de experiência" />
    <bpmn:categoryValue id="CV_RE04_E3" value="3. Validar com clientes e decidir a estratégia de experiência" />
    <bpmn:categoryValue id="CV_RE04_E4" value="4. Publicar a estratégia e entregar a quem atende, vende e desenha ofertas" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_RE04">
    <bpmn:participant id="Participant_RE04" name="RE-04 · Desenhar a experiência do cliente: personas, mapa da jornada e padrões de experiência" processRef="Process_RE04" />
    <bpmn:group id="Group_RE04_E1" categoryValueRef="CV_RE04_E1" />
    <bpmn:group id="Group_RE04_E2" categoryValueRef="CV_RE04_E2" />
    <bpmn:group id="Group_RE04_E3" categoryValueRef="CV_RE04_E3" />
    <bpmn:group id="Group_RE04_E4" categoryValueRef="CV_RE04_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_RE04" name="Desenhar a experiência do cliente: personas, mapa da jornada e padrões de experiência" isExecutable="false">
    <bpmn:documentation>Ter, para cada empresa, uma estratégia de experiência do cliente escrita e validada com clientes: quem são os clientes (personas), por onde passam (mapa da jornada), o que vivem em cada ponto de contato e que padrão de experiência cada etapa tem de cumprir, coerente com os valores e o posicionamento da marca. Operações, Negócios e Integração dizem se conseguem cumprir; Relações decide, ouvidos o executivo e os clientes.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_RE04">
      <bpmn:lane id="Lane_RE04_SOL" name="Solicitante">
        <bpmn:flowNodeRef>RE04_S3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_CLI" name="Cliente">
        <bpmn:flowNodeRef>RE04_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_EST" name="Estratégia">
        <bpmn:flowNodeRef>RE04_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>RE04_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_OPE" name="Operações">
        <bpmn:flowNodeRef>RE04_E2_PS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_NEG" name="Negócios">
        <bpmn:flowNodeRef>RE04_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_ITG" name="Integração">
        <bpmn:flowNodeRef>RE04_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E2_PJ1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_IDE" name="Identidade">
        <bpmn:flowNodeRef>RE04_E2_T9</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_REP" name="Relações · pessoa">
        <bpmn:flowNodeRef>RE04_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E2_T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_REA" name="Relações · agente">
        <bpmn:flowNodeRef>RE04_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E2_G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_RE04_RER" name="Relações · automação">
        <bpmn:flowNodeRef>RE04_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E1_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_E4_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RE04_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="RE04_S1" name="Revisão da experiência iniciada"><bpmn:outgoing>RE04_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="RE04_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE04_S2" name="Oferta aprovada para lançamento recebida"><bpmn:outgoing>RE04_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="RE04_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="RE04_S3" name="Lacuna de experiência apontada"><bpmn:outgoing>RE04_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="RE04_S3_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="RE04_M1"><bpmn:incoming>RE04_Flow1</bpmn:incoming><bpmn:incoming>RE04_Flow2</bpmn:incoming><bpmn:incoming>RE04_Flow3</bpmn:incoming><bpmn:outgoing>RE04_Flow38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RE04_E1_T1" name="Reunir reclamações, saúde, percepção e indicadores por etapa da jornada do cliente"><bpmn:documentation>Etapa 1: Avaliar a experiência atual dos clientes. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow38</bpmn:incoming><bpmn:outgoing>RE04_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="RE04_E1_T2" name="Ouvir clientes sobre a experiência em cada etapa"><bpmn:documentation>Etapa 1: Avaliar a experiência atual dos clientes. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow4</bpmn:incoming><bpmn:outgoing>RE04_Flow5</bpmn:outgoing></bpmn:manualTask>
    <bpmn:serviceTask id="RE04_E1_T3" name="Apontar as lacunas de experiência e as causas prováveis de cada uma"><bpmn:documentation>Etapa 1: Avaliar a experiência atual dos clientes. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow5</bpmn:incoming><bpmn:outgoing>RE04_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="RE04_E1_T4" name="Concluir as lacunas de experiência e as causas"><bpmn:documentation>Etapa 1: Avaliar a experiência atual dos clientes. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow6</bpmn:incoming><bpmn:outgoing>RE04_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="RE04_E1_G1" name="As lacunas pedem mudar a estratégia de experiência?"><bpmn:incoming>RE04_Flow7</bpmn:incoming><bpmn:outgoing>RE04_Flow8</bpmn:outgoing><bpmn:outgoing>RE04_Flow9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="RE04_E1_T5" name="Registrar a avaliação sem mudança e avisar quem apontou a lacuna"><bpmn:documentation>Etapa 1: Avaliar a experiência atual dos clientes. Executor: Automação de Relações (Relações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow9</bpmn:incoming><bpmn:outgoing>RE04_Flow10</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="RE04_F2" name="Revisão encerrada sem mudança"><bpmn:incoming>RE04_Flow10</bpmn:incoming></bpmn:endEvent>
