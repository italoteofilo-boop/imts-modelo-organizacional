    <bpmn:serviceTask id="RE04_E2_T1" name="Propor personas e o mapa da jornada: fases, ações, modos de pensar, emoções e oportunidades"><bpmn:documentation>Etapa 2: Desenhar personas, mapa da jornada e padrões de experiência. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow39</bpmn:incoming><bpmn:outgoing>RE04_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="RE04_E2_T2" name="Desenhar com Operações os pontos de contato e o que acontece por trás deles"><bpmn:documentation>Etapa 2: Desenhar personas, mapa da jornada e padrões de experiência. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow11</bpmn:incoming><bpmn:outgoing>RE04_Flow12</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="RE04_E2_T3" name="Definir o padrão de experiência de cada etapa da jornada do cliente"><bpmn:documentation>Etapa 2: Desenhar personas, mapa da jornada e padrões de experiência. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow12</bpmn:incoming><bpmn:outgoing>RE04_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="RE04_E2_PS1"><bpmn:incoming>RE04_Flow13</bpmn:incoming><bpmn:outgoing>RE04_Flow14</bpmn:outgoing><bpmn:outgoing>RE04_Flow16</bpmn:outgoing><bpmn:outgoing>RE04_Flow18</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="RE04_E2_T4" name="Dizer se a operação consegue cumprir os padrões de experiência"><bpmn:documentation>Etapa 2: Desenhar personas, mapa da jornada e padrões de experiência. Executor: Outro círculo (Operações). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow14</bpmn:incoming><bpmn:outgoing>RE04_Flow15</bpmn:outgoing></bpmn:task>
    <bpmn:task id="RE04_E2_T5" name="Dizer se a venda e a renovação conseguem cumprir os padrões"><bpmn:documentation>Etapa 2: Desenhar personas, mapa da jornada e padrões de experiência. Executor: Outro círculo (Negócios). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow16</bpmn:incoming><bpmn:outgoing>RE04_Flow17</bpmn:outgoing></bpmn:task>
    <bpmn:task id="RE04_E2_T6" name="Apontar os sistemas e os agentes que os padrões de experiência pedem"><bpmn:documentation>Etapa 2: Desenhar personas, mapa da jornada e padrões de experiência. Executor: Outro círculo (Integração). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow18</bpmn:incoming><bpmn:outgoing>RE04_Flow19</bpmn:outgoing></bpmn:task>
