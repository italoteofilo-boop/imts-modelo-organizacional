    <bpmn:exclusiveGateway id="RE04_E2_G1" name="Operações, Negócios e Integração conseguem cumprir os padrões?"><bpmn:incoming>RE04_Flow20</bpmn:incoming><bpmn:outgoing>RE04_Flow21</bpmn:outgoing><bpmn:outgoing>RE04_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="RE04_E2_T7" name="Conferir a experiência com os valores, o posicionamento e os padrões da marca"><bpmn:documentation>Etapa 2: Desenhar personas, mapa da jornada e padrões de experiência. Executor: Agente de Relações (Relações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow22</bpmn:incoming><bpmn:outgoing>RE04_Flow23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RE04_E2_G2" name="A experiência está conforme os padrões de identidade?"><bpmn:incoming>RE04_Flow23</bpmn:incoming><bpmn:outgoing>RE04_Flow24</bpmn:outgoing><bpmn:outgoing>RE04_Flow25</bpmn:outgoing><bpmn:outgoing>RE04_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="RE04_E2_T8" name="Corrigir a experiência no que não está conforme os padrões"><bpmn:documentation>Etapa 2: Desenhar personas, mapa da jornada e padrões de experiência. Executor: Pessoa de Relações (Relações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow24</bpmn:incoming><bpmn:outgoing>RE04_Flow27</bpmn:outgoing></bpmn:userTask>
    <bpmn:callActivity id="RE04_E2_T9" name="Responder à consulta sobre a experiência não coberta pelos padrões"><bpmn:documentation>Etapa 2: Desenhar personas, mapa da jornada e padrões de experiência. Executor: Outro círculo (Identidade). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>RE04_Flow25</bpmn:incoming><bpmn:outgoing>RE04_Flow28</bpmn:outgoing></bpmn:callActivity>
