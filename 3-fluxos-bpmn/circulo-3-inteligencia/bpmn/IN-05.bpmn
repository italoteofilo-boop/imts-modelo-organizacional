        <bpmn:flowNodeRef>IN05_E2_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN05_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN05_E3_G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IN05_INA" name="Inteligência · agente">
