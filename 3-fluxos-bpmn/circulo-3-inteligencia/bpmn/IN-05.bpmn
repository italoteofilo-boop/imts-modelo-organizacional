    <bpmn:startEvent id="IN05_S1" name="Conteúdo novo apontado"><bpmn:outgoing>IN05_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IN05_S1_def" /></bpmn:startEvent>
