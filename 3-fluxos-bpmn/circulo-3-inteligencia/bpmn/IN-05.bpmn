    <bpmn:group id="Group_IN05_E5" categoryValueRef="CV_IN05_E5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_IN05" name="Curar as bases de conhecimento que pessoas e agentes consultam" isExecutable="false">
    <bpmn:documentation>Manter, para cada tema, uma base única, curada, classificada e com dono, em que pessoas e agentes encontram a resposta certa e atual, e fazer cada pergunta sem resposta virar pedido de curadoria. O que já chega aprovado, versionado e classificado por quem publica (padrão, estratégia, método, oferta) é indexado, não revalidado.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_IN05">
      <bpmn:lane id="Lane_IN05_SOL" name="Solicitante">
        <bpmn:flowNodeRef>IN05_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IN05_LCI" name="Líder do círculo">
        <bpmn:flowNodeRef>IN05_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN05_E2_T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IN05_IDE" name="Identidade">
        <bpmn:flowNodeRef>IN05_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
