<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IN05" targetNamespace="urn:imts:modelo:circulo3-inteligencia" exporter="Ecossistema IMTS - fonte única do Círculo 3" exporterVersion="2026-10-01">
  <bpmn:category id="Category_IN05">
    <bpmn:categoryValue id="CV_IN05_E1" value="1. Reunir o conteúdo e classificar por tema, dono e uso" />
    <bpmn:categoryValue id="CV_IN05_E2" value="2. Curar o conteúdo com o dono do tema e classificar o sigilo" />
    <bpmn:categoryValue id="CV_IN05_E3" value="3. Estruturar a base e testar com as perguntas de teste" />
    <bpmn:categoryValue id="CV_IN05_E4" value="4. Publicar a versão e servir a base aos agentes" />
    <bpmn:categoryValue id="CV_IN05_E5" value="5. Medir o uso e apontar lacunas e conteúdo vencido" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_IN05">
    <bpmn:participant id="Participant_IN05" name="IN-05 · Curar as bases de conhecimento que pessoas e agentes consultam" processRef="Process_IN05" />
    <bpmn:group id="Group_IN05_E1" categoryValueRef="CV_IN05_E1" />
    <bpmn:group id="Group_IN05_E2" categoryValueRef="CV_IN05_E2" />
    <bpmn:group id="Group_IN05_E3" categoryValueRef="CV_IN05_E3" />
