<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_IN06" targetNamespace="urn:imts:modelo:circulo3-inteligencia" exporter="Ecossistema IMTS - fonte única do Círculo 3" exporterVersion="2026-10-01">
  <bpmn:category id="Category_IN06">
    <bpmn:categoryValue id="CV_IN06_E1" value="1. Escolher o que vale virar método" />
    <bpmn:categoryValue id="CV_IN06_E2" value="2. Descrever o método: princípios, passos, critérios e exemplos" />
    <bpmn:categoryValue id="CV_IN06_E3" value="3. Testar o método em caso real, com quem não o descreveu" />
    <bpmn:categoryValue id="CV_IN06_E4" value="4. Testar nos agentes, publicar o método e entregar o kit" />
    <bpmn:categoryValue id="CV_IN06_E5" value="5. Avaliar e rever o método pelo resultado que ele produz" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_IN06">
    <bpmn:participant id="Participant_IN06" name="IN-06 · Criar e publicar um método testado, a partir de uma prática ou de uma necessidade" processRef="Process_IN06" />
    <bpmn:group id="Group_IN06_E1" categoryValueRef="CV_IN06_E1" />
    <bpmn:group id="Group_IN06_E2" categoryValueRef="CV_IN06_E2" />
