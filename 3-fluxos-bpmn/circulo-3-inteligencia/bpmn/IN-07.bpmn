    <bpmn:startEvent id="IN07_S1" name="Aposta aprovada no portão de entrada"><bpmn:outgoing>IN07_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IN07_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IN07_S2" name="Decisão da Estratégia sobre aposta devolvida recebida"><bpmn:outgoing>IN07_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="IN07_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IN07_S3" name="Aposta ou oferta encerrada fora do portão de lançamento"><bpmn:outgoing>IN07_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="IN07_S3_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IN07_S4" name="Mandato de venda fechada ou de encerramento de empresa recebido"><bpmn:outgoing>IN07_Flow4</bpmn:outgoing><bpmn:messageEventDefinition id="IN07_S4_def" /></bpmn:startEvent>
    <bpmn:startEvent id="IN07_S5" name="Pedido sobre oferta em uso recebido"><bpmn:outgoing>IN07_Flow5</bpmn:outgoing><bpmn:messageEventDefinition id="IN07_S5_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="IN07_M1"><bpmn:incoming>IN07_Flow1</bpmn:incoming><bpmn:incoming>IN07_Flow2</bpmn:incoming><bpmn:incoming>IN07_Flow3</bpmn:incoming><bpmn:incoming>IN07_Flow4</bpmn:incoming><bpmn:incoming>IN07_Flow5</bpmn:incoming><bpmn:incoming>IN07_Flow172</bpmn:incoming><bpmn:incoming>IN07_Flow176</bpmn:incoming><bpmn:outgoing>IN07_Flow181</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IN07_E1_T1" name="Registrar o que abriu o trabalho e o que a Estratégia, o portão ou quem pediu apontou"><bpmn:documentation>Etapa 1: Receber o trabalho e decidir por onde ele entra. Executor: Automação da Inteligência (Inteligência · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN07_Flow181</bpmn:incoming><bpmn:outgoing>IN07_Flow6</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="IN07_E1_G1" name="O que abriu o trabalho?"><bpmn:incoming>IN07_Flow6</bpmn:incoming><bpmn:outgoing>IN07_Flow7</bpmn:outgoing><bpmn:outgoing>IN07_Flow8</bpmn:outgoing><bpmn:outgoing>IN07_Flow15</bpmn:outgoing><bpmn:outgoing>IN07_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IN07_E1_T2" name="Conferir o que está em curso com clientes e combinar a ordem do encerramento"><bpmn:documentation>Etapa 1: Receber o trabalho e decidir por onde ele entra. Executor: Pessoa da Inteligência (Inteligência · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN07_Flow8</bpmn:incoming><bpmn:outgoing>IN07_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="IN07_E1_T3" name="Encerrar com os clientes as propostas e os pilotos em curso"><bpmn:documentation>Etapa 1: Receber o trabalho e decidir por onde ele entra. Executor: Outro círculo (Negócios). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN07_Flow9</bpmn:incoming><bpmn:outgoing>IN07_Flow10</bpmn:outgoing></bpmn:task>
    <bpmn:scriptTask id="IN07_E1_T4" name="Marcar a oferta no catálogo de ofertas como fechada para novas vendas"><bpmn:documentation>Etapa 1: Receber o trabalho e decidir por onde ele entra. Executor: Automação da Inteligência (Inteligência · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN07_Flow10</bpmn:incoming><bpmn:outgoing>IN07_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:receiveTask id="IN07_E1_T5" name="Receber da Estratégia a data de saída confirmada"><bpmn:documentation>Etapa 1: Receber o trabalho e decidir por onde ele entra. Executor: Automação da Inteligência (Inteligência · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN07_Flow11</bpmn:incoming><bpmn:outgoing>IN07_Flow12</bpmn:outgoing></bpmn:receiveTask>
