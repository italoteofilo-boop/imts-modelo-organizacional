    <bpmn:serviceTask id="IN02_E2_T1" name="Buscar a evidência nos dados, nos indicadores, na base de conhecimento e na leitura de mercado"><bpmn:documentation>Etapa 2: Buscar a evidência e avaliar se é confiável. Executor: Agente da Inteligência (Inteligência · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN02_Flow39</bpmn:incoming><bpmn:outgoing>IN02_Flow17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="IN02_E2_T2" name="Avaliar a confiabilidade e a relevância de cada evidência"><bpmn:documentation>Etapa 2: Buscar a evidência e avaliar se é confiável. Executor: Agente da Inteligência (Inteligência · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN02_Flow17</bpmn:incoming><bpmn:outgoing>IN02_Flow18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IN02_E2_G1" name="A evidência basta para responder?"><bpmn:incoming>IN02_Flow18</bpmn:incoming><bpmn:outgoing>IN02_Flow19</bpmn:outgoing><bpmn:outgoing>IN02_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IN02_E2_G2" name="O prazo combinado comporta buscar evidência nova?"><bpmn:incoming>IN02_Flow20</bpmn:incoming><bpmn:outgoing>IN02_Flow21</bpmn:outgoing><bpmn:outgoing>IN02_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IN02_E2_T3" name="Combinar com quem perguntou: novo prazo ou resposta com a lacuna declarada"><bpmn:documentation>Etapa 2: Buscar a evidência e avaliar se é confiável. Executor: Pessoa da Inteligência (Inteligência · pessoa). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN02_Flow21</bpmn:incoming><bpmn:outgoing>IN02_Flow23</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IN02_M3"><bpmn:incoming>IN02_Flow22</bpmn:incoming><bpmn:incoming>IN02_Flow23</bpmn:incoming><bpmn:outgoing>IN02_Flow40</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="IN02_E2_G3" name="Vale buscar evidência nova antes de responder?"><bpmn:incoming>IN02_Flow40</bpmn:incoming><bpmn:outgoing>IN02_Flow24</bpmn:outgoing><bpmn:outgoing>IN02_Flow25</bpmn:outgoing><bpmn:outgoing>IN02_Flow27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IN02_E2_T4" name="Coletar a evidência que falta na fonte pública"><bpmn:documentation>Etapa 2: Buscar a evidência e avaliar se é confiável. Executor: Agente da Inteligência (Inteligência · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN02_Flow25</bpmn:incoming><bpmn:outgoing>IN02_Flow26</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="IN02_E2_T5" name="Pedir o dado que falta na jornada de dados"><bpmn:documentation>Etapa 2: Buscar a evidência e avaliar se é confiável. Executor: Automação da Inteligência (Inteligência · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN02_Flow27</bpmn:incoming><bpmn:outgoing>IN02_Flow28</bpmn:outgoing></bpmn:scriptTask>
