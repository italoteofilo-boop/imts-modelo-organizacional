        <bpmn:flowNodeRef>IN02_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN02_E1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN02_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN02_E1_T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN02_E1_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN02_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN02_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN02_E2_T2</bpmn:flowNodeRef>
