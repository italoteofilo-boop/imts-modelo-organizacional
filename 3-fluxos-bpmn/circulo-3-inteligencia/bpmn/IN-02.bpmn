    <bpmn:exclusiveGateway id="IN02_M5"><bpmn:incoming>IN02_Flow31</bpmn:incoming><bpmn:incoming>IN02_Flow33</bpmn:incoming><bpmn:outgoing>IN02_Flow42</bpmn:outgoing></bpmn:exclusiveGateway>
