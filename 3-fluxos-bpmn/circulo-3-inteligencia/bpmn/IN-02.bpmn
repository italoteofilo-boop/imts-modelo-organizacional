    <bpmn:startEvent id="IN02_S1" name="Pergunta de decisão recebida"><bpmn:outgoing>IN02_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IN02_S1_def" /></bpmn:startEvent>
    <bpmn:scriptTask id="IN02_E1_T1" name="Registrar a pergunta, quem decide, a decisão apoiada, o risco e o prazo"><bpmn:documentation>Etapa 1: Receber a pergunta, confirmar o que se quer saber e procurar resposta já registrada. Executor: Automação da Inteligência (Inteligência · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN02_Flow1</bpmn:incoming><bpmn:outgoing>IN02_Flow2</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="IN02_E1_T2" name="Reescrever a pergunta de forma respondível e confirmar com quem perguntou"><bpmn:documentation>Etapa 1: Receber a pergunta, confirmar o que se quer saber e procurar resposta já registrada. Executor: Agente da Inteligência (Inteligência · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN02_Flow2</bpmn:incoming><bpmn:outgoing>IN02_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IN02_E1_G1" name="A pergunta cabe à Inteligência e pode ser respondida no prazo?"><bpmn:incoming>IN02_Flow3</bpmn:incoming><bpmn:outgoing>IN02_Flow4</bpmn:outgoing><bpmn:outgoing>IN02_Flow7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IN02_E1_T3" name="Confirmar a recusa da pergunta e indicar quem pode responder"><bpmn:documentation>Etapa 1: Receber a pergunta, confirmar o que se quer saber e procurar resposta já registrada. Executor: Pessoa da Inteligência (Inteligência · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN02_Flow4</bpmn:incoming><bpmn:outgoing>IN02_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="IN02_E1_T4" name="Devolver a pergunta com o motivo"><bpmn:documentation>Etapa 1: Receber a pergunta, confirmar o que se quer saber e procurar resposta já registrada. Executor: Automação da Inteligência (Inteligência · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN02_Flow5</bpmn:incoming><bpmn:outgoing>IN02_Flow6</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IN02_F2" name="Pergunta devolvida sem resposta"><bpmn:incoming>IN02_Flow6</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="IN02_E1_G2" name="A pergunta vem de portão ou de caso de empresa, ou pode trazer dado pessoal ou sigiloso?"><bpmn:incoming>IN02_Flow7</bpmn:incoming><bpmn:outgoing>IN02_Flow8</bpmn:outgoing><bpmn:outgoing>IN02_Flow9</bpmn:outgoing><bpmn:outgoing>IN02_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="IN02_E1_T5" name="Classificar a pergunta e a resposta e limitar quem pode vê-las"><bpmn:documentation>Etapa 1: Receber a pergunta, confirmar o que se quer saber e procurar resposta já registrada. Executor: Pessoa da Inteligência (Inteligência · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN02_Flow8</bpmn:incoming><bpmn:outgoing>IN02_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="IN02_E1_T6" name="Classificar a pergunta sob confidencialidade e limitar quem pode vê-la"><bpmn:documentation>Etapa 1: Receber a pergunta, confirmar o que se quer saber e procurar resposta já registrada. Executor: Pessoa da Inteligência (Inteligência · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN02_Flow9</bpmn:incoming><bpmn:outgoing>IN02_Flow10</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="IN02_E1_T7" name="Conferir o que pode ser respondido e quem pode ver a resposta"><bpmn:documentation>Etapa 1: Receber a pergunta, confirmar o que se quer saber e procurar resposta já registrada. Executor: Outro círculo (Governança). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN02_Flow10</bpmn:incoming><bpmn:outgoing>IN02_Flow13</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="IN02_M1"><bpmn:incoming>IN02_Flow11</bpmn:incoming><bpmn:incoming>IN02_Flow12</bpmn:incoming><bpmn:incoming>IN02_Flow13</bpmn:incoming><bpmn:outgoing>IN02_Flow38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="IN02_E1_T8" name="Procurar resposta já registrada que quem pergunta pode ver e conferir se continua válida"><bpmn:documentation>Etapa 1: Receber a pergunta, confirmar o que se quer saber e procurar resposta já registrada. Executor: Agente da Inteligência (Inteligência · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>IN02_Flow38</bpmn:incoming><bpmn:outgoing>IN02_Flow14</bpmn:outgoing></bpmn:serviceTask>
