  </bpmn:collaboration>
  <bpmn:process id="Process_IN08" name="Aprender com as lições e os resultados e recomendar melhorias" isExecutable="false">
    <bpmn:documentation>Fazer com que cada lição de aposta, caso, piloto, projeto, cliente ou revisão seja registrada só com o que pode ser dito, cruzada com os indicadores e transformada em recomendação com evidência, entregue a quem pode agir; e conferir se a melhoria aceita foi feita e deu resultado.</bpmn:documentation>
