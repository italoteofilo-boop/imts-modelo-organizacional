  <bpmn:category id="Category_IN08">
    <bpmn:categoryValue id="CV_IN08_E1" value="1. Registrar cada lição com contexto, causa e evidência" />
    <bpmn:categoryValue id="CV_IN08_E2" value="2. Cruzar lições, indicadores e uso das bases e escolher o que recomendar" />
    <bpmn:categoryValue id="CV_IN08_E3" value="3. Entregar cada recomendação ao dono e registrar a resposta" />
    <bpmn:categoryValue id="CV_IN08_E4" value="4. Conferir se a melhoria aceita foi feita e deu resultado" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_IN08">
    <bpmn:participant id="Participant_IN08" name="IN-08 · Aprender com as lições e os resultados e recomendar melhorias" processRef="Process_IN08" />
    <bpmn:group id="Group_IN08_E1" categoryValueRef="CV_IN08_E1" />
