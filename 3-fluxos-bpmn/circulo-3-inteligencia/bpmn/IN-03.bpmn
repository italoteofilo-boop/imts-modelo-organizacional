    <bpmn:userTask id="IN03_E3_T3" name="Tratar o erro com o dono do dado"><bpmn:documentation>Etapa 3: Validar e corrigir o dado pelas regras de qualidade. Executor: Pessoa da Inteligência (Inteligência · pessoa). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN03_Flow35</bpmn:incoming><bpmn:outgoing>IN03_Flow36</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="IN03_E3_G2" name="O dado ficou dentro da regra de qualidade?"><bpmn:incoming>IN03_Flow36</bpmn:incoming><bpmn:outgoing>IN03_Flow37</bpmn:outgoing><bpmn:outgoing>IN03_Flow38</bpmn:outgoing><bpmn:outgoing>IN03_Flow40</bpmn:outgoing></bpmn:exclusiveGateway>
