        <bpmn:flowNodeRef>IN03_M7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_E5_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_F1</bpmn:flowNodeRef>
