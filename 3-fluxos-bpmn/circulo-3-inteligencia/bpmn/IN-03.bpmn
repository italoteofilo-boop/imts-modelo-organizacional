    <bpmn:task id="IN03_E2_T1" name="Conectar a fonte e guardar o dado bruto com o acesso da classificação"><bpmn:documentation>Etapa 2: Conectar a fonte e receber o dado bruto. Executor: Outro círculo (Integração). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN03_Flow58</bpmn:incoming><bpmn:outgoing>IN03_Flow26</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="IN03_E2_T2" name="Conferir o dado recebido com a ficha"><bpmn:documentation>Etapa 2: Conectar a fonte e receber o dado bruto. Executor: Agente da Inteligência (Inteligência · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN03_Flow26</bpmn:incoming><bpmn:outgoing>IN03_Flow27</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="IN03_E2_G1" name="O dado recebido corresponde à ficha?"><bpmn:incoming>IN03_Flow27</bpmn:incoming><bpmn:outgoing>IN03_Flow28</bpmn:outgoing><bpmn:outgoing>IN03_Flow29</bpmn:outgoing><bpmn:outgoing>IN03_Flow30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="IN03_E2_T3" name="Registrar a falta de fonte e avisar quem pediu"><bpmn:documentation>Etapa 2: Conectar a fonte e receber o dado bruto. Executor: Automação da Inteligência (Inteligência · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN03_Flow30</bpmn:incoming><bpmn:outgoing>IN03_Flow31</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="IN03_F6" name="Pedido de dado encerrado por falta de fonte"><bpmn:incoming>IN03_Flow31</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="IN03_M5"><bpmn:incoming>IN03_Flow6</bpmn:incoming><bpmn:incoming>IN03_Flow28</bpmn:incoming><bpmn:outgoing>IN03_Flow59</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="IN03_E3_T1" name="Aplicar as regras de qualidade: completo, único, consistente, atual, válido e exato"><bpmn:documentation>Etapa 3: Validar e corrigir o dado pelas regras de qualidade. Executor: Automação da Inteligência (Inteligência · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN03_Flow59</bpmn:incoming><bpmn:outgoing>IN03_Flow32</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:scriptTask id="IN03_E3_T2" name="Corrigir pelas regras da ficha o que elas resolvem e marcar o que sobra"><bpmn:documentation>Etapa 3: Validar e corrigir o dado pelas regras de qualidade. Executor: Automação da Inteligência (Inteligência · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>IN03_Flow32</bpmn:incoming><bpmn:outgoing>IN03_Flow33</bpmn:outgoing></bpmn:scriptTask>
