        <bpmn:flowNodeRef>IN03_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_E3_G2</bpmn:flowNodeRef>
