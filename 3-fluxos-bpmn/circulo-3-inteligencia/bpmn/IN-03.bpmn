        <bpmn:flowNodeRef>IN03_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_E5_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IN03_INP" name="Inteligência · pessoa">
        <bpmn:flowNodeRef>IN03_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_E1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_E1_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_E1_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN03_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IN03_INA" name="Inteligência · agente">
