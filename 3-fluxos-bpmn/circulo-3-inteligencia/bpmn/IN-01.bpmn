        <bpmn:flowNodeRef>IN01_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_E1_T5</bpmn:flowNodeRef>
