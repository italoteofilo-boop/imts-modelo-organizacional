    <bpmn:startEvent id="IN01_S1" name="Perguntas ou hipóteses novas recebidas"><bpmn:outgoing>IN01_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="IN01_S1_def" /></bpmn:startEvent>
