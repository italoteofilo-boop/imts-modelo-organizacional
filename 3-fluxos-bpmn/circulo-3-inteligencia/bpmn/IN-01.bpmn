        <bpmn:flowNodeRef>IN01_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_E3_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_E4_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_E4_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IN01_INA" name="Inteligência · agente">
        <bpmn:flowNodeRef>IN01_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>IN01_M3</bpmn:flowNodeRef>
