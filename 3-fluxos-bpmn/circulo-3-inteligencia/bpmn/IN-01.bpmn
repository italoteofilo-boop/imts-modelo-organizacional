    <bpmn:exclusiveGateway id="IN01_E3_G2" name="A análise traz algo novo para quem decide?"><bpmn:incoming>IN01_Flow44</bpmn:incoming><bpmn:outgoing>IN01_Flow23</bpmn:outgoing><bpmn:outgoing>IN01_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
