    <bpmn:exclusiveGateway id="IN01_M1"><bpmn:incoming>IN01_Flow1</bpmn:incoming><bpmn:incoming>IN01_Flow2</bpmn:incoming><bpmn:incoming>IN01_Flow3</bpmn:incoming><bpmn:outgoing>IN01_Flow41</bpmn:outgoing></bpmn:exclusiveGateway>
