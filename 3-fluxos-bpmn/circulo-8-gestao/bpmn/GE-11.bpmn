<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE11" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE11">
    <bpmn:categoryValue id="CV_GE11_E1" value="1. Planejar a pauta" />
    <bpmn:categoryValue id="CV_GE11_E2" value="2. Produzir o conteúdo" />
    <bpmn:categoryValue id="CV_GE11_E3" value="3. Publicar nos canais internos" />
    <bpmn:categoryValue id="CV_GE11_E4" value="4. Medir e registrar" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE11">
    <bpmn:participant id="Participant_GE11" name="GE-11 · Planejar e publicar a comunicação interna" processRef="Process_GE11" />
    <bpmn:group id="Group_GE11_E1" categoryValueRef="CV_GE11_E1" />
    <bpmn:group id="Group_GE11_E2" categoryValueRef="CV_GE11_E2" />
    <bpmn:group id="Group_GE11_E3" categoryValueRef="CV_GE11_E3" />
    <bpmn:group id="Group_GE11_E4" categoryValueRef="CV_GE11_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GE11" name="Planejar e publicar a comunicação interna" isExecutable="false">
    <bpmn:documentation>Manter as pessoas informadas e alinhadas, com uma só voz: cada mudança na identidade, nos padrões e na estratégia, cada alvo, correção, mudança no portfólio e conteúdo externo relevante entrar na pauta; cada conteúdo ser redigido na voz e na marca vigentes, conferido, validado pela Governança quando sensível e aprovado; os materiais vencidos saírem dos canais; e o alcance e o entendimento serem medidos. A Identidade define a voz e as mensagens; a Gestão comunica para dentro; Relações, para fora.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GE11">
      <bpmn:lane id="Lane_GE11_GOV" name="Governança">
        <bpmn:flowNodeRef>GE11_E2_T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE11_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE11_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E2_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E2_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E2_T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE11_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE11_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E4_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE11_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE11_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE11_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE11_S1" name="Ciclo da comunicação interna iniciado"><bpmn:outgoing>GE11_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="GE11_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE11_S2" name="Fato ou mudança a comunicar recebido"><bpmn:outgoing>GE11_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GE11_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GE11_M1"><bpmn:incoming>GE11_Flow1</bpmn:incoming><bpmn:incoming>GE11_Flow2</bpmn:incoming><bpmn:outgoing>GE11_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GE11_E1_T1" name="Propor a pauta e o calendário a partir dos fatos"><bpmn:documentation>Etapa 1: Planejar a pauta. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow22</bpmn:incoming><bpmn:outgoing>GE11_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE11_E1_T2" name="Decidir pauta, público, canal e o que é sensível"><bpmn:documentation>Etapa 1: Planejar a pauta. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow3</bpmn:incoming><bpmn:outgoing>GE11_Flow4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="GE11_E2_T1" name="Redigir o conteúdo na voz do Ecossistema"><bpmn:documentation>Etapa 2: Produzir o conteúdo. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow4</bpmn:incoming><bpmn:outgoing>GE11_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GE11_E2_T2" name="Conferir o conteúdo com o guia de voz, as mensagens e a marca vigente"><bpmn:documentation>Etapa 2: Produzir o conteúdo. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow5</bpmn:incoming><bpmn:outgoing>GE11_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GE11_E2_G1" name="O conteúdo está conforme os padrões?"><bpmn:incoming>GE11_Flow6</bpmn:incoming><bpmn:outgoing>GE11_Flow7</bpmn:outgoing><bpmn:outgoing>GE11_Flow8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE11_E2_T3" name="Corrigir o conteúdo reprovado"><bpmn:documentation>Etapa 2: Produzir o conteúdo. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow7</bpmn:incoming><bpmn:outgoing>GE11_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE11_M2"><bpmn:incoming>GE11_Flow8</bpmn:incoming><bpmn:incoming>GE11_Flow9</bpmn:incoming><bpmn:outgoing>GE11_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE11_E2_G2" name="Há caso não coberto pelos padrões?"><bpmn:incoming>GE11_Flow23</bpmn:incoming><bpmn:outgoing>GE11_Flow10</bpmn:outgoing><bpmn:outgoing>GE11_Flow12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE11_E2_T4" name="Consultar a Identidade sobre o caso não coberto"><bpmn:documentation>Etapa 2: Produzir o conteúdo. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow10</bpmn:incoming><bpmn:outgoing>GE11_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:receiveTask id="GE11_E2_T5" name="Receber a resposta da Identidade e ajustar o conteúdo"><bpmn:documentation>Etapa 2: Produzir o conteúdo. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow11</bpmn:incoming><bpmn:outgoing>GE11_Flow13</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:exclusiveGateway id="GE11_M3"><bpmn:incoming>GE11_Flow12</bpmn:incoming><bpmn:incoming>GE11_Flow13</bpmn:incoming><bpmn:outgoing>GE11_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE11_E2_G3" name="O conteúdo é sensível?"><bpmn:incoming>GE11_Flow24</bpmn:incoming><bpmn:outgoing>GE11_Flow14</bpmn:outgoing><bpmn:outgoing>GE11_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="GE11_E2_T6" name="Validar o conteúdo sensível"><bpmn:documentation>Etapa 2: Produzir o conteúdo. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow14</bpmn:incoming><bpmn:outgoing>GE11_Flow16</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="GE11_M4"><bpmn:incoming>GE11_Flow15</bpmn:incoming><bpmn:incoming>GE11_Flow16</bpmn:incoming><bpmn:outgoing>GE11_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE11_E2_T7" name="Aprovar o conteúdo"><bpmn:documentation>Etapa 2: Produzir o conteúdo. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow25</bpmn:incoming><bpmn:outgoing>GE11_Flow17</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GE11_E3_T1" name="Publicar nos canais internos"><bpmn:documentation>Etapa 3: Publicar nos canais internos. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow17</bpmn:incoming><bpmn:outgoing>GE11_Flow18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="GE11_E3_T2" name="Retirar dos canais internos os materiais vencidos ou de marca retirada"><bpmn:documentation>Etapa 3: Publicar nos canais internos. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow18</bpmn:incoming><bpmn:outgoing>GE11_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE11_E4_T1" name="Medir alcance e entendimento"><bpmn:documentation>Etapa 4: Medir e registrar. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow19</bpmn:incoming><bpmn:outgoing>GE11_Flow20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="GE11_E4_T2" name="Registrar a medição para o próximo ciclo"><bpmn:documentation>Etapa 4: Medir e registrar. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE11_Flow20</bpmn:incoming><bpmn:outgoing>GE11_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GE11_F1" name="Comunicação interna publicada e medida"><bpmn:incoming>GE11_Flow21</bpmn:incoming></bpmn:endEvent>
