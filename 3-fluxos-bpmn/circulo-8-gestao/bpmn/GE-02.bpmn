<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE02" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE02">
    <bpmn:categoryValue id="CV_GE02_E1" value="1. Reunir os resultados do período contra os alvos" />
    <bpmn:categoryValue id="CV_GE02_E2" value="2. Conduzir o ritual e registrar as decisões" />
    <bpmn:categoryValue id="CV_GE02_E3" value="3. Cobrar as ações até concluir" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE02">
    <bpmn:participant id="Participant_GE02" name="GE-02 · Rodar o ritual de acompanhamento dos alvos e cobrar as ações" processRef="Process_GE02" />
    <bpmn:group id="Group_GE02_E1" categoryValueRef="CV_GE02_E1" />
    <bpmn:group id="Group_GE02_E2" categoryValueRef="CV_GE02_E2" />
    <bpmn:group id="Group_GE02_E3" categoryValueRef="CV_GE02_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GE02" name="Rodar o ritual de acompanhamento dos alvos e cobrar as ações" isExecutable="false">
    <bpmn:documentation>Fazer cada período ter os resultados reunidos contra os alvos, com a execução do orçamento, os desvios e as causas prováveis; cada desvio ser discutido com o dono no ritual e ter uma ação com dono e prazo, decidida na alçada; cada pedido de plano de correção e cada correção publicada pela Estratégia entrar na pauta; e cada ação ser cobrada até concluir, com o atraso levado ao executivo. A Gestão roda o ritual; os donos decidem as ações; a Estratégia decide a correção de rumo.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GE02">
      <bpmn:lane id="Lane_GE02_EST" name="Estratégia">
        <bpmn:flowNodeRef>GE02_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE02_LCI" name="Líder do círculo">
        <bpmn:flowNodeRef>GE02_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE02_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GE02_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE02_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE02_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_E2_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE02_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE02_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE02_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE02_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE02_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE02_S1" name="Período do ritual de acompanhamento iniciado"><bpmn:outgoing>GE02_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="GE02_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE02_S2" name="Pedido de plano de correção recebido"><bpmn:outgoing>GE02_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GE02_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GE02_M1"><bpmn:incoming>GE02_Flow1</bpmn:incoming><bpmn:incoming>GE02_Flow2</bpmn:incoming><bpmn:outgoing>GE02_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE02_E1_T1" name="Reunir indicadores, execução do orçamento, iniciativas e desvios do período"><bpmn:documentation>Etapa 1: Reunir os resultados do período contra os alvos. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE02_Flow17</bpmn:incoming><bpmn:outgoing>GE02_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE02_E1_T2" name="Apontar os desvios, as causas prováveis e os donos"><bpmn:documentation>Etapa 1: Reunir os resultados do período contra os alvos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE02_Flow3</bpmn:incoming><bpmn:outgoing>GE02_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="GE02_E2_T1" name="Incluir na pauta os pedidos de plano de correção e as correções publicadas"><bpmn:documentation>Etapa 2: Conduzir o ritual e registrar as decisões. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE02_Flow4</bpmn:incoming><bpmn:outgoing>GE02_Flow5</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="GE02_E2_T2" name="Conduzir o ritual com os donos dos alvos"><bpmn:documentation>Etapa 2: Conduzir o ritual e registrar as decisões. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE02_Flow5</bpmn:incoming><bpmn:outgoing>GE02_Flow6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE02_E2_T3" name="Apresentar os desvios e propor as ações"><bpmn:documentation>Etapa 2: Conduzir o ritual e registrar as decisões. Executor: Pessoa de fora do círculo (Líder do círculo). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE02_Flow6</bpmn:incoming><bpmn:outgoing>GE02_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE02_E2_G1" name="A ação cabe na alçada do líder do círculo?"><bpmn:incoming>GE02_Flow7</bpmn:incoming><bpmn:outgoing>GE02_Flow8</bpmn:outgoing><bpmn:outgoing>GE02_Flow9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE02_E2_T4" name="Decidir a ação na sua alçada"><bpmn:documentation>Etapa 2: Conduzir o ritual e registrar as decisões. Executor: Pessoa de fora do círculo (Líder do círculo). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE02_Flow8</bpmn:incoming><bpmn:outgoing>GE02_Flow10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE02_E2_T5" name="Decidir a ação acima da alçada do líder"><bpmn:documentation>Etapa 2: Conduzir o ritual e registrar as decisões. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE02_Flow9</bpmn:incoming><bpmn:outgoing>GE02_Flow11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE02_M2"><bpmn:incoming>GE02_Flow10</bpmn:incoming><bpmn:incoming>GE02_Flow11</bpmn:incoming><bpmn:outgoing>GE02_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE02_E2_T6" name="Registrar desvios, decisões, donos e prazos"><bpmn:documentation>Etapa 2: Conduzir o ritual e registrar as decisões. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE02_Flow18</bpmn:incoming><bpmn:outgoing>GE02_Flow12</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="GE02_E3_T1" name="Lembrar cada dono e acompanhar o prazo das ações"><bpmn:documentation>Etapa 3: Cobrar as ações até concluir. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GE02_Flow12</bpmn:incoming><bpmn:outgoing>GE02_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE02_E3_G1" name="A ação foi concluída no prazo?"><bpmn:incoming>GE02_Flow13</bpmn:incoming><bpmn:outgoing>GE02_Flow14</bpmn:outgoing><bpmn:outgoing>GE02_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE02_E3_T2" name="Levar o atraso ao próximo ritual e ao executivo"><bpmn:documentation>Etapa 3: Cobrar as ações até concluir. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GE02_Flow15</bpmn:incoming><bpmn:outgoing>GE02_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE02_M3"><bpmn:incoming>GE02_Flow14</bpmn:incoming><bpmn:incoming>GE02_Flow16</bpmn:incoming><bpmn:outgoing>GE02_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="GE02_F1" name="Ritual realizado e ações acompanhadas"><bpmn:incoming>GE02_Flow19</bpmn:incoming></bpmn:endEvent>
