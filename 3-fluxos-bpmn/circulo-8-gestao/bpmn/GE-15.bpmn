<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE15" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE15">
    <bpmn:categoryValue id="CV_GE15_E1" value="1. Manter o plano de contas e os centros de custo" />
    <bpmn:categoryValue id="CV_GE15_E2" value="2. Planejar os tributos do grupo e as operações entre as empresas" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE15">
    <bpmn:participant id="Participant_GE15" name="GE-15 · Manter a estrutura contábil e o plano tributário do grupo: plano de contas, centros de custo e operações entre as empresas" processRef="Process_GE15" />
    <bpmn:group id="Group_GE15_E1" categoryValueRef="CV_GE15_E1" />
    <bpmn:group id="Group_GE15_E2" categoryValueRef="CV_GE15_E2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GE15" name="Manter a estrutura contábil e o plano tributário do grupo: plano de contas, centros de custo e operações entre as empresas" isExecutable="false">
    <bpmn:documentation>Fazer o grupo ter um plano de contas comum, com as contas de cada empresa, e centros de custo por empresa, círculo e projeto, conferidos pela assessoria contábil; e um plano tributário do grupo, com o regime de cada empresa, as operações entre as empresas e as regras de preço entre elas, simulado pela Gestão, recomendado pela assessoria tributária, conferido pela Governança e decidido pelo executivo ou, quando muda o regime ou a estrutura, pelos sócios. A Gestão mantém; a assessoria recomenda; a Governança confere; o executivo ou os sócios decidem.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GE15">
      <bpmn:lane id="Lane_GE15_GOV" name="Governança">
        <bpmn:flowNodeRef>GE15_E2_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE15_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GE15_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE15_SOC" name="Sócios">
        <bpmn:flowNodeRef>GE15_E2_T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE15_ASS" name="Assessoria externa">
        <bpmn:flowNodeRef>GE15_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE15_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE15_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE15_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE15_E2_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE15_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE15_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE15_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE15_E2_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE15_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE15_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE15_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE15_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE15_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE15_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE15_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE15_S1" name="Empresa, projeto ou operação entre empresas criado ou mudado"><bpmn:outgoing>GE15_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GE15_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE15_S2" name="Revisão anual da estrutura contábil e tributária iniciada"><bpmn:outgoing>GE15_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="GE15_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GE15_M1"><bpmn:incoming>GE15_Flow1</bpmn:incoming><bpmn:incoming>GE15_Flow2</bpmn:incoming><bpmn:outgoing>GE15_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GE15_E1_T1" name="Manter o plano de contas comum, com as contas de cada empresa"><bpmn:documentation>Etapa 1: Manter o plano de contas e os centros de custo. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE15_Flow15</bpmn:incoming><bpmn:outgoing>GE15_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="GE15_E1_T2" name="Abrir e encerrar os centros de custo por empresa, círculo e projeto"><bpmn:documentation>Etapa 1: Manter o plano de contas e os centros de custo. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE15_Flow3</bpmn:incoming><bpmn:outgoing>GE15_Flow4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="GE15_E1_T3" name="Conferir o plano de contas e os centros de custo"><bpmn:documentation>Etapa 1: Manter o plano de contas e os centros de custo. Executor: Assessoria externa (Assessoria externa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE15_Flow4</bpmn:incoming><bpmn:outgoing>GE15_Flow5</bpmn:outgoing></bpmn:task>
    <bpmn:serviceTask id="GE15_E2_T1" name="Simular o regime e os tributos de cada empresa e das operações entre elas"><bpmn:documentation>Etapa 2: Planejar os tributos do grupo e as operações entre as empresas. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE15_Flow5</bpmn:incoming><bpmn:outgoing>GE15_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="GE15_E2_T2" name="Recomendar o regime, as operações entre empresas e os preços entre elas"><bpmn:documentation>Etapa 2: Planejar os tributos do grupo e as operações entre as empresas. Executor: Assessoria externa (Assessoria externa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE15_Flow6</bpmn:incoming><bpmn:outgoing>GE15_Flow7</bpmn:outgoing></bpmn:task>
    <bpmn:task id="GE15_E2_T3" name="Conferir a recomendação com as regras e o risco"><bpmn:documentation>Etapa 2: Planejar os tributos do grupo e as operações entre as empresas. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE15_Flow7</bpmn:incoming><bpmn:outgoing>GE15_Flow8</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="GE15_E2_T4" name="Preparar a proposta de plano tributário para quem decide"><bpmn:documentation>Etapa 2: Planejar os tributos do grupo e as operações entre as empresas. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE15_Flow8</bpmn:incoming><bpmn:outgoing>GE15_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE15_E2_G1" name="A mudança altera o regime de uma empresa ou a estrutura do grupo?"><bpmn:incoming>GE15_Flow9</bpmn:incoming><bpmn:outgoing>GE15_Flow10</bpmn:outgoing><bpmn:outgoing>GE15_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE15_E2_T5" name="Aprovar o plano tributário na alçada do executivo"><bpmn:documentation>Etapa 2: Planejar os tributos do grupo e as operações entre as empresas. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE15_Flow10</bpmn:incoming><bpmn:outgoing>GE15_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="GE15_E2_T6" name="Decidir o plano tributário do grupo"><bpmn:documentation>Etapa 2: Planejar os tributos do grupo e as operações entre as empresas. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE15_Flow11</bpmn:incoming><bpmn:outgoing>GE15_Flow13</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="GE15_M2"><bpmn:incoming>GE15_Flow12</bpmn:incoming><bpmn:incoming>GE15_Flow13</bpmn:incoming><bpmn:outgoing>GE15_Flow16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE15_E2_T7" name="Registrar o plano tributário e as regras das operações entre empresas"><bpmn:documentation>Etapa 2: Planejar os tributos do grupo e as operações entre as empresas. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE15_Flow16</bpmn:incoming><bpmn:outgoing>GE15_Flow14</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GE15_F1" name="Estrutura contábil e plano tributário do grupo vigentes"><bpmn:incoming>GE15_Flow14</bpmn:incoming></bpmn:endEvent>
