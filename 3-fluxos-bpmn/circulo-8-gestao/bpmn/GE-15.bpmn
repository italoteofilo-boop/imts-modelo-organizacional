    <bpmn:sequenceFlow id="GE15_Flow9" sourceRef="GE15_E2_T4" targetRef="GE15_E2_G1" />
    <bpmn:sequenceFlow id="GE15_Flow10" name="Não" sourceRef="GE15_E2_G1" targetRef="GE15_E2_T5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GE15_Flow11" name="Sim" sourceRef="GE15_E2_G1" targetRef="GE15_E2_T6"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GE15_Flow12" sourceRef="GE15_E2_T5" targetRef="GE15_M2" />
    <bpmn:sequenceFlow id="GE15_Flow13" sourceRef="GE15_E2_T6" targetRef="GE15_M2" />
    <bpmn:sequenceFlow id="GE15_Flow14" sourceRef="GE15_E2_T7" targetRef="GE15_F1" />
    <bpmn:sequenceFlow id="GE15_Flow15" sourceRef="GE15_M1" targetRef="GE15_E1_T1" />
    <bpmn:sequenceFlow id="GE15_Flow16" sourceRef="GE15_M2" targetRef="GE15_E2_T7" />
  </bpmn:process>
