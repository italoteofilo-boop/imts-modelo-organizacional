    <bpmn:scriptTask id="GE03_E3_T1" name="Conciliar os recebimentos com as faturas"><bpmn:documentation>Etapa 3: Receber e cobrar. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow43</bpmn:incoming><bpmn:outgoing>GE03_Flow24</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE03_E3_G1" name="A fatura foi paga no vencimento?"><bpmn:incoming>GE03_Flow24</bpmn:incoming><bpmn:outgoing>GE03_Flow25</bpmn:outgoing><bpmn:outgoing>GE03_Flow26</bpmn:outgoing><bpmn:outgoing>GE03_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE03_E3_T2" name="Avisar Operações da retomada das entregas do cliente que quitou o atraso"><bpmn:documentation>Etapa 3: Receber e cobrar. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow26</bpmn:incoming><bpmn:outgoing>GE03_Flow27</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE03_E3_T3" name="Cobrar o cliente pelos canais combinados"><bpmn:documentation>Etapa 3: Receber e cobrar. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow28</bpmn:incoming><bpmn:outgoing>GE03_Flow29</bpmn:outgoing></bpmn:serviceTask>
