      </bpmn:lane>
      <bpmn:lane id="Lane_GE03_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE03_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E3_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE03_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE03_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E2_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E4_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE03_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE03_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_M1</bpmn:flowNodeRef>
