        <bpmn:flowNodeRef>GE03_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E2_G2</bpmn:flowNodeRef>
