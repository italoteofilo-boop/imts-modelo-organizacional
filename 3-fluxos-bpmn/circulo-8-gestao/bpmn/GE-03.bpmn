    <bpmn:startEvent id="GE03_S1" name="Contrato, oferta ou cliente novo, mudado ou encerrado recebido"><bpmn:outgoing>GE03_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GE03_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE03_S2" name="Entregas confirmadas para faturar recebidas"><bpmn:outgoing>GE03_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GE03_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE03_S3" name="Vencimento de fatura"><bpmn:outgoing>GE03_Flow3</bpmn:outgoing><bpmn:timerEventDefinition id="GE03_S3_def" /></bpmn:startEvent>
