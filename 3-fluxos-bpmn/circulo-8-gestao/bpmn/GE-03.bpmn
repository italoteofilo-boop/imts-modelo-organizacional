    <bpmn:exclusiveGateway id="GE03_E2_G1" name="Há crédito ou reembolso aprovado para o cliente?"><bpmn:incoming>GE03_Flow40</bpmn:incoming><bpmn:outgoing>GE03_Flow11</bpmn:outgoing><bpmn:outgoing>GE03_Flow12</bpmn:outgoing><bpmn:outgoing>GE03_Flow14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE03_E2_T1" name="Lançar o crédito na próxima fatura"><bpmn:documentation>Etapa 2: Calcular e emitir a fatura. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow11</bpmn:incoming><bpmn:outgoing>GE03_Flow15</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="GE03_E2_T2" name="Aprovar o pagamento do reembolso na alçada"><bpmn:documentation>Etapa 2: Calcular e emitir a fatura. Executor: Pessoa de fora do círculo (Líder do círculo). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow12</bpmn:incoming><bpmn:outgoing>GE03_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GE03_E2_T3" name="Pagar o reembolso ao cliente e registrar"><bpmn:documentation>Etapa 2: Calcular e emitir a fatura. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow13</bpmn:incoming><bpmn:outgoing>GE03_Flow16</bpmn:outgoing></bpmn:scriptTask>
