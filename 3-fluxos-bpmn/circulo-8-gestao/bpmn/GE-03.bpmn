    <bpmn:serviceTask id="GE03_E2_T3" name="Calcular a fatura pelas entregas confirmadas, os níveis de serviço e os créditos"><bpmn:documentation>Etapa 2: Calcular e emitir a fatura. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow34</bpmn:incoming><bpmn:outgoing>GE03_Flow16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GE03_E2_G2" name="A fatura foge do padrão ou tem glosa ou ajuste?"><bpmn:incoming>GE03_Flow16</bpmn:incoming><bpmn:outgoing>GE03_Flow17</bpmn:outgoing><bpmn:outgoing>GE03_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE03_E2_T4" name="Conferir e aprovar a fatura fora do padrão"><bpmn:documentation>Etapa 2: Calcular e emitir a fatura. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow17</bpmn:incoming><bpmn:outgoing>GE03_Flow19</bpmn:outgoing></bpmn:userTask>
