        <bpmn:flowNodeRef>GE03_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_M4</bpmn:flowNodeRef>
