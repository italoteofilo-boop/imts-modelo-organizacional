    <bpmn:exclusiveGateway id="GE03_E1_G1" name="O que iniciou o trabalho?"><bpmn:incoming>GE03_Flow39</bpmn:incoming><bpmn:outgoing>GE03_Flow4</bpmn:outgoing><bpmn:outgoing>GE03_Flow5</bpmn:outgoing><bpmn:outgoing>GE03_Flow6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE03_E1_T1" name="Cadastrar ou atualizar cliente, contrato, preços, calendário de cobrança e divisão da receita"><bpmn:documentation>Etapa 1: Cadastrar o cliente e as condições de cobrança. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE03_Flow6</bpmn:incoming><bpmn:outgoing>GE03_Flow7</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE03_E1_T2" name="Conferir o cadastro contra o contrato, a tabela e a ata"><bpmn:documentation>Etapa 1: Cadastrar o cliente e as condições de cobrança. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE03_Flow7</bpmn:incoming><bpmn:outgoing>GE03_Flow8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GE03_E1_G2" name="Há entregas confirmadas a faturar agora?"><bpmn:incoming>GE03_Flow8</bpmn:incoming><bpmn:outgoing>GE03_Flow9</bpmn:outgoing><bpmn:outgoing>GE03_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="GE03_F2" name="Cadastro de cobrança atualizado, sem fatura a emitir agora"><bpmn:incoming>GE03_Flow9</bpmn:incoming></bpmn:endEvent>
