    <bpmn:exclusiveGateway id="GE03_E2_G2" name="A fatura foge do padrão ou tem glosa ou ajuste?"><bpmn:incoming>GE03_Flow17</bpmn:incoming><bpmn:outgoing>GE03_Flow18</bpmn:outgoing><bpmn:outgoing>GE03_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
