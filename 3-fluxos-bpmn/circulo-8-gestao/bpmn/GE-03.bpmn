    <bpmn:scriptTask id="GE03_E2_T6" name="Emitir a fatura e os documentos fiscais e enviá-los ao cliente"><bpmn:documentation>Etapa 2: Calcular e emitir a fatura. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow42</bpmn:incoming><bpmn:outgoing>GE03_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE03_E2_G3" name="O pagamento já foi recebido na emissão?"><bpmn:incoming>GE03_Flow21</bpmn:incoming><bpmn:outgoing>GE03_Flow22</bpmn:outgoing><bpmn:outgoing>GE03_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
