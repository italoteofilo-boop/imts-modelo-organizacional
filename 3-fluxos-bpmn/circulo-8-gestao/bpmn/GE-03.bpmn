        <bpmn:flowNodeRef>GE03_E4_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE03_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE03_S3</bpmn:flowNodeRef>
