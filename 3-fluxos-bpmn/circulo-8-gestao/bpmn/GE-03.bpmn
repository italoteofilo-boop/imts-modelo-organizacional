        <bpmn:flowNodeRef>GE03_M6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE03_F1</bpmn:flowNodeRef>
      </bpmn:lane>
