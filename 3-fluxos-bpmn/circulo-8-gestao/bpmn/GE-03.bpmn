    <bpmn:scriptTask id="GE03_E3_T1" name="Conciliar os recebimentos com as faturas"><bpmn:documentation>Etapa 3: Receber e cobrar. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow36</bpmn:incoming><bpmn:outgoing>GE03_Flow23</bpmn:outgoing></bpmn:scriptTask>
