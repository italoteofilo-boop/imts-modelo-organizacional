    <bpmn:exclusiveGateway id="GE03_E3_G2" name="O atraso passa do limite da política de cobrança?"><bpmn:incoming>GE03_Flow26</bpmn:incoming><bpmn:outgoing>GE03_Flow27</bpmn:outgoing><bpmn:outgoing>GE03_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE03_E3_T3" name="Decidir a negociação ou a cobrança do atraso, ouvido o executivo"><bpmn:documentation>Etapa 3: Receber e cobrar. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE03_Flow28</bpmn:incoming><bpmn:outgoing>GE03_Flow29</bpmn:outgoing></bpmn:userTask>
