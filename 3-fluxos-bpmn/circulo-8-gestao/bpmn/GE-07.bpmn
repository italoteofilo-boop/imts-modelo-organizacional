    <bpmn:exclusiveGateway id="GE07_E1_G2" name="O que é pedido?"><bpmn:incoming>GE07_Flow32</bpmn:incoming><bpmn:outgoing>GE07_Flow8</bpmn:outgoing><bpmn:outgoing>GE07_Flow9</bpmn:outgoing><bpmn:outgoing>GE07_Flow11</bpmn:outgoing><bpmn:outgoing>GE07_Flow13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE07_E1_T4" name="Cadastrar as pessoas da empresa adquirida conforme o mandato"><bpmn:documentation>Etapa 1: Abrir a vaga ou decidir a movimentação. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE07_Flow9</bpmn:incoming><bpmn:outgoing>GE07_Flow10</bpmn:outgoing></bpmn:scriptTask>
