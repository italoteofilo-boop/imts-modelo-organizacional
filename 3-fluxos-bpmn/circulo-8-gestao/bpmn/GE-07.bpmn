        <bpmn:flowNodeRef>GE07_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE07_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE07_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE07_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE07_S1" name="Vaga, movimentação ou desligamento pedido pelo líder"><bpmn:outgoing>GE07_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GE07_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE07_S2" name="Plano de capacidade, mandato ou recurso liberado recebido"><bpmn:outgoing>GE07_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GE07_S2_def" /></bpmn:startEvent>
