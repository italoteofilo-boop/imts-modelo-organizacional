        <bpmn:flowNodeRef>GE07_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE07_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE07_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE07_E4_T1</bpmn:flowNodeRef>
