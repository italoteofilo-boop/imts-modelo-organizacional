    <bpmn:exclusiveGateway id="GE07_E1_G1" name="O pedido passa da alçada da Gestão?"><bpmn:incoming>GE07_Flow4</bpmn:incoming><bpmn:outgoing>GE07_Flow5</bpmn:outgoing><bpmn:outgoing>GE07_Flow6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE07_E1_T3" name="Decidir o pedido acima da alçada da Gestão"><bpmn:documentation>Etapa 1: Abrir a vaga ou decidir a movimentação. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE07_Flow5</bpmn:incoming><bpmn:outgoing>GE07_Flow7</bpmn:outgoing></bpmn:userTask>
