<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE09" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE09">
    <bpmn:categoryValue id="CV_GE09_E1" value="1. Avaliar o desempenho e decidir a remuneração na política" />
    <bpmn:categoryValue id="CV_GE09_E2" value="2. Ligar o propósito ao papel e desenvolver as pessoas" />
    <bpmn:categoryValue id="CV_GE09_E3" value="3. Medir a cultura e o engajamento" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE09">
    <bpmn:participant id="Participant_GE09" name="GE-09 · Avaliar e desenvolver as pessoas e medir a cultura" processRef="Process_GE09" />
    <bpmn:group id="Group_GE09_E1" categoryValueRef="CV_GE09_E1" />
    <bpmn:group id="Group_GE09_E2" categoryValueRef="CV_GE09_E2" />
