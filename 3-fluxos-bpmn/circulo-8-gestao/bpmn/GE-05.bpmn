    <bpmn:serviceTask id="GE05_E2_T1" name="Fechar a contabilidade do período por empresa e consolidar"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow6</bpmn:incoming><bpmn:outgoing>GE05_Flow7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GE05_E2_T2" name="Emitir o balancete, a DRE e o balanço de cada empresa e o consolidado"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow7</bpmn:incoming><bpmn:outgoing>GE05_Flow8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GE05_E2_T3" name="Apurar os impostos do período e preparar as obrigações fiscais"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow8</bpmn:incoming><bpmn:outgoing>GE05_Flow9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE05_E2_T4" name="Conferir o fechamento e os impostos"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow9</bpmn:incoming><bpmn:outgoing>GE05_Flow10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE05_E2_T5" name="Aprovar o fechamento e o recolhimento dos impostos"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Pessoa de fora do círculo (Líder do círculo). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow10</bpmn:incoming><bpmn:outgoing>GE05_Flow11</bpmn:outgoing></bpmn:userTask>
