<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE05" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE05">
    <bpmn:categoryValue id="CV_GE05_E1" value="1. Registrar e conciliar o movimento e projetar o caixa" />
    <bpmn:categoryValue id="CV_GE05_E2" value="2. Fechar as contas, apurar o resultado e os impostos" />
    <bpmn:categoryValue id="CV_GE05_E3" value="3. Executar aportes, distribuição e mudanças de contas" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE05">
    <bpmn:participant id="Participant_GE05" name="GE-05 · Gerir o caixa, fechar as contas e os impostos e prestar contas" processRef="Process_GE05" />
    <bpmn:group id="Group_GE05_E1" categoryValueRef="CV_GE05_E1" />
    <bpmn:group id="Group_GE05_E2" categoryValueRef="CV_GE05_E2" />
    <bpmn:group id="Group_GE05_E3" categoryValueRef="CV_GE05_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GE05" name="Gerir o caixa, fechar as contas e os impostos e prestar contas" isExecutable="false">
    <bpmn:documentation>Fazer cada recebimento e pagamento ser registrado e conciliado; o caixa ser projetado com a previsão de receita, os compromissos e o orçamento e informado à Estratégia; cada período ser fechado por empresa e consolidado, com os impostos apurados e as obrigações entregues, o resultado, os custos e margens e a execução do orçamento publicados; e cada aporte, distribuição ou mudança de contas decidido pelos sócios ou pelo mandato ser executado na alçada. A Gestão registra, fecha e executa; os sócios decidem; a Governança recebe as demonstrações para prestar contas.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GE05">
      <bpmn:lane id="Lane_GE05_EST" name="Estratégia">
        <bpmn:flowNodeRef>GE05_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE05_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GE05_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE05_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE05_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE05_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE05_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE05_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE05_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE05_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE05_S1" name="Fechamento do período iniciado"><bpmn:outgoing>GE05_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="GE05_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE05_S2" name="Decisão de alocação, de destino do resultado ou mandato recebido"><bpmn:outgoing>GE05_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GE05_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GE05_M1"><bpmn:incoming>GE05_Flow1</bpmn:incoming><bpmn:incoming>GE05_Flow2</bpmn:incoming><bpmn:outgoing>GE05_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE05_E1_G1" name="O que iniciou o trabalho?"><bpmn:incoming>GE05_Flow20</bpmn:incoming><bpmn:outgoing>GE05_Flow3</bpmn:outgoing><bpmn:outgoing>GE05_Flow4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE05_E1_T1" name="Registrar e conciliar contas, recebimentos e pagamentos"><bpmn:documentation>Etapa 1: Registrar e conciliar o movimento e projetar o caixa. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE05_Flow4</bpmn:incoming><bpmn:outgoing>GE05_Flow5</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE05_E1_T2" name="Projetar o caixa com a previsão de receita, os compromissos e o orçamento"><bpmn:documentation>Etapa 1: Registrar e conciliar o movimento e projetar o caixa. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE05_Flow5</bpmn:incoming><bpmn:outgoing>GE05_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GE05_E2_T1" name="Fechar a contabilidade do período por empresa e consolidar"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow6</bpmn:incoming><bpmn:outgoing>GE05_Flow7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GE05_E2_T2" name="Apurar os impostos do período e preparar as obrigações fiscais"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow7</bpmn:incoming><bpmn:outgoing>GE05_Flow8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE05_E2_T3" name="Conferir e aprovar o fechamento e os impostos"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow8</bpmn:incoming><bpmn:outgoing>GE05_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GE05_E2_T4" name="Recolher os impostos e entregar as obrigações"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow9</bpmn:incoming><bpmn:outgoing>GE05_Flow10</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE05_E2_T5" name="Apurar o resultado, os custos e margens e a execução do orçamento"><bpmn:documentation>Etapa 2: Fechar as contas, apurar o resultado e os impostos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE05_Flow10</bpmn:incoming><bpmn:outgoing>GE05_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GE05_E2_G1" name="Há aporte, distribuição ou mudança de contas a executar?"><bpmn:incoming>GE05_Flow11</bpmn:incoming><bpmn:outgoing>GE05_Flow12</bpmn:outgoing><bpmn:outgoing>GE05_Flow13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="GE05_F2" name="Período fechado e informado, sem execução pendente"><bpmn:incoming>GE05_Flow12</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GE05_M2"><bpmn:incoming>GE05_Flow3</bpmn:incoming><bpmn:incoming>GE05_Flow13</bpmn:incoming><bpmn:outgoing>GE05_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GE05_E3_T1" name="Preparar a execução do aporte, da distribuição ou da mudança de contas da empresa"><bpmn:documentation>Etapa 3: Executar aportes, distribuição e mudanças de contas. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE05_Flow21</bpmn:incoming><bpmn:outgoing>GE05_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE05_E3_T2" name="Conferir a execução com a decisão e a alçada"><bpmn:documentation>Etapa 3: Executar aportes, distribuição e mudanças de contas. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE05_Flow14</bpmn:incoming><bpmn:outgoing>GE05_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE05_E3_G1" name="A execução passa da alçada da Gestão?"><bpmn:incoming>GE05_Flow15</bpmn:incoming><bpmn:outgoing>GE05_Flow16</bpmn:outgoing><bpmn:outgoing>GE05_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE05_E3_T3" name="Autorizar a execução acima da alçada da Gestão"><bpmn:documentation>Etapa 3: Executar aportes, distribuição e mudanças de contas. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE05_Flow16</bpmn:incoming><bpmn:outgoing>GE05_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE05_M3"><bpmn:incoming>GE05_Flow17</bpmn:incoming><bpmn:incoming>GE05_Flow18</bpmn:incoming><bpmn:outgoing>GE05_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE05_E3_T4" name="Executar e registrar a movimentação"><bpmn:documentation>Etapa 3: Executar aportes, distribuição e mudanças de contas. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GE05_Flow22</bpmn:incoming><bpmn:outgoing>GE05_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GE05_F1" name="Aportes, distribuição ou mudanças de contas executados e registrados"><bpmn:incoming>GE05_Flow19</bpmn:incoming></bpmn:endEvent>
