<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE13" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE13">
    <bpmn:categoryValue id="CV_GE13_E1" value="1. Apurar a folha do período" />
    <bpmn:categoryValue id="CV_GE13_E2" value="2. Aprovar e pagar a folha" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE13">
    <bpmn:participant id="Participant_GE13" name="GE-13 · Calcular e pagar a folha e os encargos" processRef="Process_GE13" />
    <bpmn:group id="Group_GE13_E1" categoryValueRef="CV_GE13_E1" />
    <bpmn:group id="Group_GE13_E2" categoryValueRef="CV_GE13_E2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GE13" name="Calcular e pagar a folha e os encargos" isExecutable="false">
    <bpmn:documentation>Fazer cada folha ter o ponto, as variáveis, as comissões de quem vende sobre a receita recebida, os reconhecimentos e as mudanças de remuneração do período apurados a partir dos registros de pessoas, conferida pela Gestão, aprovada pelo executivo ou, nos círculos do IMTS.OS, pelo Administrador, paga no prazo e com os encargos recolhidos. A Gestão apura, confere e paga; quem aprova é outra pessoa.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GE13">
      <bpmn:lane id="Lane_GE13_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GE13_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE13_ADM" name="Administrador do IMTS.OS">
        <bpmn:flowNodeRef>GE13_E2_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE13_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE13_E2_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE13_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE13_E1_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE13_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE13_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE13_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE13_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE13_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE13_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE13_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE13_S1" name="Período da folha iniciado"><bpmn:outgoing>GE13_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="GE13_S1_def" /></bpmn:startEvent>
    <bpmn:scriptTask id="GE13_E1_T1" name="Reunir o ponto, as mudanças de pessoas, as receitas recebidas e os reconhecimentos"><bpmn:documentation>Etapa 1: Apurar a folha do período. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE13_Flow1</bpmn:incoming><bpmn:outgoing>GE13_Flow2</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE13_E1_T2" name="Apurar salários, variáveis, comissões sobre a receita recebida e reconhecimentos"><bpmn:documentation>Etapa 1: Apurar a folha do período. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE13_Flow2</bpmn:incoming><bpmn:outgoing>GE13_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE13_E2_T1" name="Conferir a folha"><bpmn:documentation>Etapa 2: Aprovar e pagar a folha. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE13_Flow3</bpmn:incoming><bpmn:outgoing>GE13_Flow4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE13_E2_G1" name="De quem é a folha?"><bpmn:incoming>GE13_Flow4</bpmn:incoming><bpmn:outgoing>GE13_Flow5</bpmn:outgoing><bpmn:outgoing>GE13_Flow6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE13_E2_T2" name="Aprovar a folha da empresa"><bpmn:documentation>Etapa 2: Aprovar e pagar a folha. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE13_Flow5</bpmn:incoming><bpmn:outgoing>GE13_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE13_E2_T3" name="Aprovar a folha dos círculos"><bpmn:documentation>Etapa 2: Aprovar e pagar a folha. Executor: Pessoa de fora do círculo (Administrador do IMTS.OS). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE13_Flow6</bpmn:incoming><bpmn:outgoing>GE13_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE13_M1"><bpmn:incoming>GE13_Flow7</bpmn:incoming><bpmn:incoming>GE13_Flow8</bpmn:incoming><bpmn:outgoing>GE13_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE13_E2_T4" name="Pagar a folha, os acertos rescisórios no prazo da lei (CLT, art. 477, § 6º) e recolher os encargos"><bpmn:documentation>Etapa 2: Aprovar e pagar a folha. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE13_Flow10</bpmn:incoming><bpmn:outgoing>GE13_Flow9</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GE13_F1" name="Folha paga e encargos recolhidos"><bpmn:incoming>GE13_Flow9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="GE13_Flow1" sourceRef="GE13_S1" targetRef="GE13_E1_T1" />
    <bpmn:sequenceFlow id="GE13_Flow2" sourceRef="GE13_E1_T1" targetRef="GE13_E1_T2" />
    <bpmn:sequenceFlow id="GE13_Flow3" sourceRef="GE13_E1_T2" targetRef="GE13_E2_T1" />
    <bpmn:sequenceFlow id="GE13_Flow4" sourceRef="GE13_E2_T1" targetRef="GE13_E2_G1" />
    <bpmn:sequenceFlow id="GE13_Flow5" name="De uma empresa" sourceRef="GE13_E2_G1" targetRef="GE13_E2_T2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">De uma empresa</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GE13_Flow6" name="Dos círculos do IMTS.OS" sourceRef="GE13_E2_G1" targetRef="GE13_E2_T3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Dos círculos do IMTS.OS</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GE13_Flow7" sourceRef="GE13_E2_T2" targetRef="GE13_M1" />
    <bpmn:sequenceFlow id="GE13_Flow8" sourceRef="GE13_E2_T3" targetRef="GE13_M1" />
    <bpmn:sequenceFlow id="GE13_Flow9" sourceRef="GE13_E2_T4" targetRef="GE13_F1" />
    <bpmn:sequenceFlow id="GE13_Flow10" sourceRef="GE13_M1" targetRef="GE13_E2_T4" />
  </bpmn:process>
