<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE04" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE04">
    <bpmn:categoryValue id="CV_GE04_E1" value="1. Receber e conferir o pedido de compra" />
    <bpmn:categoryValue id="CV_GE04_E2" value="2. Escolher o fornecedor e emitir o pedido" />
    <bpmn:categoryValue id="CV_GE04_E3" value="3. Receber o que foi comprado" />
    <bpmn:categoryValue id="CV_GE04_E4" value="4. Avaliar o fornecedor e cobrar as falhas" />
    <bpmn:categoryValue id="CV_GE04_E5" value="5. Conferir a fatura e pagar" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE04">
    <bpmn:participant id="Participant_GE04" name="GE-04 · Comprar e pagar: do pedido de compra ao fornecedor e ao parceiro pagos" processRef="Process_GE04" />
    <bpmn:group id="Group_GE04_E1" categoryValueRef="CV_GE04_E1" />
    <bpmn:group id="Group_GE04_E2" categoryValueRef="CV_GE04_E2" />
    <bpmn:group id="Group_GE04_E3" categoryValueRef="CV_GE04_E3" />
