<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE01" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE01">
    <bpmn:categoryValue id="CV_GE01_E1" value="1. Desdobrar o orçamento aprovado e conferir os planos" />
    <bpmn:categoryValue id="CV_GE01_E2" value="2. Decidir pedidos de recurso, liberações e devoluções" />
    <bpmn:categoryValue id="CV_GE01_E3" value="3. Publicar o orçamento vigente" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE01">
    <bpmn:participant id="Participant_GE01" name="GE-01 · Desdobrar o orçamento aprovado e controlar as mudanças de recurso" processRef="Process_GE01" />
    <bpmn:group id="Group_GE01_E1" categoryValueRef="CV_GE01_E1" />
    <bpmn:group id="Group_GE01_E2" categoryValueRef="CV_GE01_E2" />
    <bpmn:group id="Group_GE01_E3" categoryValueRef="CV_GE01_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GE01" name="Desdobrar o orçamento aprovado e controlar as mudanças de recurso" isExecutable="false">
    <bpmn:documentation>Fazer o orçamento aprovado pelos sócios ser desdobrado por empresa, círculo, oferta, aposta e conta, com um dono por linha; os planos de demanda, de vendas, de capacidade e de lançamento caberem nele ou terem a diferença apontada; cada pedido de recurso, liberação, congelamento ou devolução ser decidido na alçada, pela Gestão ou, acima dela, pelo executivo; e o orçamento vigente ser publicado a quem executa. Os sócios aprovam; a Gestão desdobra e controla; a realocação entre empresas fica na revisão do portfólio da Estratégia.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GE01">
      <bpmn:lane id="Lane_GE01_EST" name="Estratégia">
        <bpmn:flowNodeRef>GE01_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE01_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GE01_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE01_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE01_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E2_G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE01_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE01_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE01_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE01_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E2_T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE01_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE01_S1" name="Alvos e orçamento aprovados pelos sócios"><bpmn:outgoing>GE01_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GE01_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE01_S2" name="Pedido de recurso, liberação ou devolução recebido"><bpmn:outgoing>GE01_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GE01_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GE01_M1"><bpmn:incoming>GE01_Flow1</bpmn:incoming><bpmn:incoming>GE01_Flow2</bpmn:incoming><bpmn:outgoing>GE01_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE01_E1_G1" name="O que iniciou o trabalho?"><bpmn:incoming>GE01_Flow24</bpmn:incoming><bpmn:outgoing>GE01_Flow3</bpmn:outgoing><bpmn:outgoing>GE01_Flow4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GE01_E1_T1" name="Desdobrar o orçamento por empresa, círculo, oferta, aposta e conta, com um dono por linha"><bpmn:documentation>Etapa 1: Desdobrar o orçamento aprovado e conferir os planos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow4</bpmn:incoming><bpmn:outgoing>GE01_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GE01_E1_T2" name="Conferir os planos de demanda, vendas, capacidade e lançamento com o orçamento"><bpmn:documentation>Etapa 1: Desdobrar o orçamento aprovado e conferir os planos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow5</bpmn:incoming><bpmn:outgoing>GE01_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE01_E1_T3" name="Fechar o orçamento desdobrado e apontar a cada dono o que não coube"><bpmn:documentation>Etapa 1: Desdobrar o orçamento aprovado e conferir os planos. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow6</bpmn:incoming><bpmn:outgoing>GE01_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE01_E1_G2" name="Há pedido de recurso em aberto para decidir agora?"><bpmn:incoming>GE01_Flow7</bpmn:incoming><bpmn:outgoing>GE01_Flow8</bpmn:outgoing><bpmn:outgoing>GE01_Flow9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE01_M2"><bpmn:incoming>GE01_Flow3</bpmn:incoming><bpmn:incoming>GE01_Flow9</bpmn:incoming><bpmn:outgoing>GE01_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE01_E2_T1" name="Registrar o pedido, a liberação ou a decisão e a linha do orçamento afetada"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow25</bpmn:incoming><bpmn:outgoing>GE01_Flow10</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE01_E2_T2" name="Calcular o efeito no orçamento e no caixa"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow10</bpmn:incoming><bpmn:outgoing>GE01_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE01_E2_T3" name="Conferir o efeito e a alçada do pedido"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow11</bpmn:incoming><bpmn:outgoing>GE01_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE01_E2_G1" name="Quem decide o pedido?"><bpmn:incoming>GE01_Flow12</bpmn:incoming><bpmn:outgoing>GE01_Flow13</bpmn:outgoing><bpmn:outgoing>GE01_Flow14</bpmn:outgoing><bpmn:outgoing>GE01_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE01_E2_T4" name="Decidir o pedido dentro da alçada da Gestão"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow13</bpmn:incoming><bpmn:outgoing>GE01_Flow16</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE01_E2_T5" name="Decidir o pedido acima da alçada da Gestão"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow14</bpmn:incoming><bpmn:outgoing>GE01_Flow17</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GE01_E2_T6" name="Registrar o pedido para a revisão do portfólio e avisar quem pediu"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow15</bpmn:incoming><bpmn:outgoing>GE01_Flow18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE01_M3"><bpmn:incoming>GE01_Flow16</bpmn:incoming><bpmn:incoming>GE01_Flow17</bpmn:incoming><bpmn:incoming>GE01_Flow18</bpmn:incoming><bpmn:outgoing>GE01_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE01_E2_G2" name="O pedido foi atendido?"><bpmn:incoming>GE01_Flow26</bpmn:incoming><bpmn:outgoing>GE01_Flow19</bpmn:outgoing><bpmn:outgoing>GE01_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE01_E2_T7" name="Ajustar o orçamento"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow19</bpmn:incoming><bpmn:outgoing>GE01_Flow20</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE01_M4"><bpmn:incoming>GE01_Flow20</bpmn:incoming><bpmn:incoming>GE01_Flow21</bpmn:incoming><bpmn:outgoing>GE01_Flow27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE01_E2_T8" name="Responder a quem pediu, com o motivo"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow27</bpmn:incoming><bpmn:outgoing>GE01_Flow22</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE01_M5"><bpmn:incoming>GE01_Flow8</bpmn:incoming><bpmn:incoming>GE01_Flow22</bpmn:incoming><bpmn:outgoing>GE01_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE01_E3_T1" name="Publicar o orçamento vigente a cada dono e aos registros de compra e de pagamento"><bpmn:documentation>Etapa 3: Publicar o orçamento vigente. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GE01_Flow28</bpmn:incoming><bpmn:outgoing>GE01_Flow23</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GE01_F1" name="Orçamento vigente publicado"><bpmn:incoming>GE01_Flow23</bpmn:incoming></bpmn:endEvent>
