    <bpmn:exclusiveGateway id="GE01_E1_G1" name="O que iniciou o trabalho?"><bpmn:incoming>GE01_Flow28</bpmn:incoming><bpmn:outgoing>GE01_Flow3</bpmn:outgoing><bpmn:outgoing>GE01_Flow4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GE01_E1_T1" name="Desdobrar o orçamento por empresa, círculo, oferta, aposta e conta, com um dono por linha"><bpmn:documentation>Etapa 1: Desdobrar o orçamento aprovado e conferir os planos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow4</bpmn:incoming><bpmn:outgoing>GE01_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GE01_E1_T2" name="Conferir os planos de demanda, vendas, capacidade e lançamento com o orçamento"><bpmn:documentation>Etapa 1: Desdobrar o orçamento aprovado e conferir os planos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow5</bpmn:incoming><bpmn:outgoing>GE01_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE01_E1_T3" name="Fechar o orçamento desdobrado e apontar a cada dono o que não coube"><bpmn:documentation>Etapa 1: Desdobrar o orçamento aprovado e conferir os planos. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow6</bpmn:incoming><bpmn:outgoing>GE01_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE01_E1_G2" name="Há pedido de recurso em aberto para decidir agora?"><bpmn:incoming>GE01_Flow7</bpmn:incoming><bpmn:outgoing>GE01_Flow8</bpmn:outgoing><bpmn:outgoing>GE01_Flow9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE01_M2"><bpmn:incoming>GE01_Flow3</bpmn:incoming><bpmn:incoming>GE01_Flow9</bpmn:incoming><bpmn:outgoing>GE01_Flow29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE01_E2_T1" name="Registrar o pedido, a liberação ou a decisão e a linha do orçamento afetada"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow29</bpmn:incoming><bpmn:outgoing>GE01_Flow10</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE01_E2_T2" name="Calcular o efeito no orçamento e no caixa"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow10</bpmn:incoming><bpmn:outgoing>GE01_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE01_E2_T3" name="Conferir o efeito e a alçada do pedido"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow11</bpmn:incoming><bpmn:outgoing>GE01_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE01_E2_G1" name="Quem decide o pedido?"><bpmn:incoming>GE01_Flow12</bpmn:incoming><bpmn:outgoing>GE01_Flow13</bpmn:outgoing><bpmn:outgoing>GE01_Flow14</bpmn:outgoing><bpmn:outgoing>GE01_Flow15</bpmn:outgoing><bpmn:outgoing>GE01_Flow16</bpmn:outgoing><bpmn:outgoing>GE01_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE01_E2_T4" name="Decidir o pedido dentro da alçada da Gestão"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow13</bpmn:incoming><bpmn:outgoing>GE01_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE01_E2_T5" name="Decidir o pedido acima da alçada da Gestão"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow14</bpmn:incoming><bpmn:outgoing>GE01_Flow19</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE01_E2_T6" name="Decidir o pedido de recurso dos círculos acima da alçada da Gestão"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Pessoa de fora do círculo (Administrador do IMTS.OS). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow15</bpmn:incoming><bpmn:outgoing>GE01_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE01_E2_T7" name="Decidir o aumento do total do orçamento aprovado"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow16</bpmn:incoming><bpmn:outgoing>GE01_Flow21</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GE01_E2_T8" name="Registrar o pedido para a revisão do portfólio e avisar quem pediu"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow17</bpmn:incoming><bpmn:outgoing>GE01_Flow22</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE01_M3"><bpmn:incoming>GE01_Flow18</bpmn:incoming><bpmn:incoming>GE01_Flow19</bpmn:incoming><bpmn:incoming>GE01_Flow20</bpmn:incoming><bpmn:incoming>GE01_Flow21</bpmn:incoming><bpmn:incoming>GE01_Flow22</bpmn:incoming><bpmn:outgoing>GE01_Flow30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE01_E2_G2" name="O pedido foi atendido?"><bpmn:incoming>GE01_Flow30</bpmn:incoming><bpmn:outgoing>GE01_Flow23</bpmn:outgoing><bpmn:outgoing>GE01_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE01_E2_T9" name="Ajustar o orçamento"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow23</bpmn:incoming><bpmn:outgoing>GE01_Flow24</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE01_M4"><bpmn:incoming>GE01_Flow24</bpmn:incoming><bpmn:incoming>GE01_Flow25</bpmn:incoming><bpmn:outgoing>GE01_Flow31</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE01_E2_T10" name="Responder a quem pediu, com o motivo"><bpmn:documentation>Etapa 2: Decidir pedidos de recurso, liberações e devoluções. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE01_Flow31</bpmn:incoming><bpmn:outgoing>GE01_Flow26</bpmn:outgoing></bpmn:scriptTask>
