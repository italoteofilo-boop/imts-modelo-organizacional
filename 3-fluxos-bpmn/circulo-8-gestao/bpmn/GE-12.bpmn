<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE12" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE12">
    <bpmn:categoryValue id="CV_GE12_E1" value="1. Avaliar e atender o pedido" />
    <bpmn:categoryValue id="CV_GE12_E2" value="2. Registrar e manter os ativos e fazer o inventário" />
    <bpmn:categoryValue id="CV_GE12_E3" value="3. Baixar o ativo" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE12">
    <bpmn:participant id="Participant_GE12" name="GE-12 · Gerir os ativos, os espaços e os serviços administrativos" processRef="Process_GE12" />
    <bpmn:group id="Group_GE12_E1" categoryValueRef="CV_GE12_E1" />
    <bpmn:group id="Group_GE12_E2" categoryValueRef="CV_GE12_E2" />
    <bpmn:group id="Group_GE12_E3" categoryValueRef="CV_GE12_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GE12" name="Gerir os ativos, os espaços e os serviços administrativos" isExecutable="false">
    <bpmn:documentation>Fazer cada pedido de ativo, de espaço ou de serviço administrativo ser atendido pela melhor opção (comprar, alugar, remanejar ativo ocioso ou recusar), decidida pela Gestão dentro do orçamento; cada ativo ser registrado com o responsável e a depreciação, mantido e inventariado; e cada ativo ocioso, perdido ou no fim da vida ser baixado (vendido, doado, reciclado ou descartado), com os dados guardados nele eliminados. A Gestão decide e controla; a compra segue a jornada de compras.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GE12">
      <bpmn:lane id="Lane_GE12_SOL" name="Solicitante">
        <bpmn:flowNodeRef>GE12_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE12_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE12_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE12_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE12_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE12_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE12_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E1_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE12_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE12_S1" name="Pedido de ativo, de espaço ou de serviço administrativo recebido"><bpmn:outgoing>GE12_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GE12_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE12_S2" name="Ciclo de manutenção e inventário iniciado"><bpmn:outgoing>GE12_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="GE12_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GE12_M1"><bpmn:incoming>GE12_Flow1</bpmn:incoming><bpmn:incoming>GE12_Flow2</bpmn:incoming><bpmn:outgoing>GE12_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE12_E1_G1" name="O que iniciou o trabalho?"><bpmn:incoming>GE12_Flow20</bpmn:incoming><bpmn:outgoing>GE12_Flow3</bpmn:outgoing><bpmn:outgoing>GE12_Flow4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GE12_E1_T1" name="Avaliar o pedido: comprar, alugar, remanejar ativo ocioso ou recusar"><bpmn:documentation>Etapa 1: Avaliar e atender o pedido. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE12_Flow4</bpmn:incoming><bpmn:outgoing>GE12_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE12_E1_T2" name="Decidir o atendimento do pedido"><bpmn:documentation>Etapa 1: Avaliar e atender o pedido. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE12_Flow5</bpmn:incoming><bpmn:outgoing>GE12_Flow6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE12_E1_G2" name="O atendimento pede compra ou contrato?"><bpmn:incoming>GE12_Flow6</bpmn:incoming><bpmn:outgoing>GE12_Flow7</bpmn:outgoing><bpmn:outgoing>GE12_Flow8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE12_E1_T3" name="Pedir a compra ou o contrato pela jornada de compras"><bpmn:documentation>Etapa 1: Avaliar e atender o pedido. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE12_Flow7</bpmn:incoming><bpmn:outgoing>GE12_Flow9</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE12_M2"><bpmn:incoming>GE12_Flow8</bpmn:incoming><bpmn:incoming>GE12_Flow9</bpmn:incoming><bpmn:outgoing>GE12_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GE12_E1_G3" name="O atendimento cria ou muda um ativo?"><bpmn:incoming>GE12_Flow21</bpmn:incoming><bpmn:outgoing>GE12_Flow10</bpmn:outgoing><bpmn:outgoing>GE12_Flow12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE12_E1_T4" name="Responder a quem pediu"><bpmn:documentation>Etapa 1: Avaliar e atender o pedido. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE12_Flow10</bpmn:incoming><bpmn:outgoing>GE12_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GE12_F2" name="Pedido atendido ou recusado, sem ativo a registrar"><bpmn:incoming>GE12_Flow11</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GE12_M3"><bpmn:incoming>GE12_Flow3</bpmn:incoming><bpmn:incoming>GE12_Flow12</bpmn:incoming><bpmn:outgoing>GE12_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE12_E2_T1" name="Registrar o ativo, o responsável e a depreciação"><bpmn:documentation>Etapa 2: Registrar e manter os ativos e fazer o inventário. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE12_Flow22</bpmn:incoming><bpmn:outgoing>GE12_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE12_E2_T2" name="Programar e acompanhar a manutenção"><bpmn:documentation>Etapa 2: Registrar e manter os ativos e fazer o inventário. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE12_Flow13</bpmn:incoming><bpmn:outgoing>GE12_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GE12_E2_T3" name="Conferir o inventário e apontar ativo ocioso, perdido ou a baixar"><bpmn:documentation>Etapa 2: Registrar e manter os ativos e fazer o inventário. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE12_Flow14</bpmn:incoming><bpmn:outgoing>GE12_Flow15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GE12_E3_G1" name="Há ativo a baixar?"><bpmn:incoming>GE12_Flow15</bpmn:incoming><bpmn:outgoing>GE12_Flow16</bpmn:outgoing><bpmn:outgoing>GE12_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE12_E3_T1" name="Decidir vender, doar, reciclar ou descartar o ativo"><bpmn:documentation>Etapa 3: Baixar o ativo. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE12_Flow17</bpmn:incoming><bpmn:outgoing>GE12_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GE12_E3_T2" name="Eliminar os dados guardados no ativo e executar a baixa"><bpmn:documentation>Etapa 3: Baixar o ativo. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE12_Flow18</bpmn:incoming><bpmn:outgoing>GE12_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE12_M4"><bpmn:incoming>GE12_Flow16</bpmn:incoming><bpmn:incoming>GE12_Flow19</bpmn:incoming><bpmn:outgoing>GE12_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="GE12_F1" name="Ativo atendido, registrado, mantido ou baixado"><bpmn:incoming>GE12_Flow23</bpmn:incoming></bpmn:endEvent>
