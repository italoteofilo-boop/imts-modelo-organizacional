<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE14" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE14">
    <bpmn:categoryValue id="CV_GE14_E1" value="1. Levantar o débito e as opções" />
    <bpmn:categoryValue id="CV_GE14_E2" value="2. Decidir o caminho e formalizar" />
    <bpmn:categoryValue id="CV_GE14_E3" value="3. Pagar as parcelas e acompanhar as condições" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE14">
    <bpmn:participant id="Participant_GE14" name="GE-14 · Gerir as dívidas tributárias: parcelamentos, transações, negociações e renegociações" processRef="Process_GE14" />
    <bpmn:group id="Group_GE14_E1" categoryValueRef="CV_GE14_E1" />
    <bpmn:group id="Group_GE14_E2" categoryValueRef="CV_GE14_E2" />
    <bpmn:group id="Group_GE14_E3" categoryValueRef="CV_GE14_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GE14" name="Gerir as dívidas tributárias: parcelamentos, transações, negociações e renegociações" isExecutable="false">
    <bpmn:documentation>Fazer cada débito tributário, autuação ou intimação ser registrado com a origem, o valor atualizado e o efeito na certidão; ter as opções levantadas (pagar, parcelar, transacionar ou contestar) com o efeito no caixa e a opinião da assessoria tributária; ter o caminho decidido na alçada (o executivo; acima dela, os sócios); e cada parcelamento ou transação ser pago em dia e acompanhado, com o risco de perder as condições levado a renegociação. A Gestão levanta, propõe e paga; a assessoria opina e defende; o executivo ou os sócios decidem.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GE14">
      <bpmn:lane id="Lane_GE14_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GE14_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E3_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE14_SOC" name="Sócios">
        <bpmn:flowNodeRef>GE14_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE14_ASS" name="Assessoria externa">
        <bpmn:flowNodeRef>GE14_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE14_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE14_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE14_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE14_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE14_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE14_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE14_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE14_S1" name="Débito tributário, autuação ou intimação identificado"><bpmn:outgoing>GE14_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GE14_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE14_S2" name="Revisão periódica do passivo tributário iniciada"><bpmn:outgoing>GE14_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="GE14_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GE14_M1"><bpmn:incoming>GE14_Flow1</bpmn:incoming><bpmn:incoming>GE14_Flow2</bpmn:incoming><bpmn:outgoing>GE14_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE14_E1_T1" name="Registrar o débito, a origem, o valor atualizado e o efeito na certidão"><bpmn:documentation>Etapa 1: Levantar o débito e as opções. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE14_Flow22</bpmn:incoming><bpmn:outgoing>GE14_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE14_E1_T2" name="Levantar as opções de pagar, parcelar, transacionar ou contestar, com o efeito no caixa"><bpmn:documentation>Etapa 1: Levantar o débito e as opções. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE14_Flow3</bpmn:incoming><bpmn:outgoing>GE14_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="GE14_E1_T3" name="Opinar sobre a procedência do débito e as opções"><bpmn:documentation>Etapa 1: Levantar o débito e as opções. Executor: Assessoria externa (Assessoria externa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE14_Flow4</bpmn:incoming><bpmn:outgoing>GE14_Flow5</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="GE14_E2_T1" name="Propor o caminho com o custo, o efeito no caixa e o efeito na certidão"><bpmn:documentation>Etapa 2: Decidir o caminho e formalizar. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GE14_Flow5</bpmn:incoming><bpmn:outgoing>GE14_Flow6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE14_E2_G1" name="Qual caminho foi proposto?"><bpmn:incoming>GE14_Flow6</bpmn:incoming><bpmn:outgoing>GE14_Flow7</bpmn:outgoing><bpmn:outgoing>GE14_Flow8</bpmn:outgoing><bpmn:outgoing>GE14_Flow9</bpmn:outgoing><bpmn:outgoing>GE14_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE14_E2_T2" name="Aprovar o pagamento do débito"><bpmn:documentation>Etapa 2: Decidir o caminho e formalizar. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GE14_Flow7</bpmn:incoming><bpmn:outgoing>GE14_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE14_E2_T3" name="Decidir o parcelamento ou a transação"><bpmn:documentation>Etapa 2: Decidir o caminho e formalizar. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GE14_Flow8</bpmn:incoming><bpmn:outgoing>GE14_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="GE14_E2_T4" name="Decidir o parcelamento ou a transação pelos sócios"><bpmn:documentation>Etapa 2: Decidir o caminho e formalizar. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GE14_Flow9</bpmn:incoming><bpmn:outgoing>GE14_Flow14</bpmn:outgoing></bpmn:manualTask>
    <bpmn:task id="GE14_E2_T5" name="Entregar o débito à defesa da assessoria tributária"><bpmn:documentation>Etapa 2: Decidir o caminho e formalizar. Executor: Assessoria externa (Assessoria externa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GE14_Flow10</bpmn:incoming><bpmn:outgoing>GE14_Flow11</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="GE14_F2" name="Débito contestado e entregue à defesa"><bpmn:incoming>GE14_Flow11</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GE14_M2"><bpmn:incoming>GE14_Flow12</bpmn:incoming><bpmn:incoming>GE14_Flow13</bpmn:incoming><bpmn:incoming>GE14_Flow14</bpmn:incoming><bpmn:outgoing>GE14_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE14_E2_T6" name="Formalizar o pagamento, o parcelamento ou a transação e registrar as condições"><bpmn:documentation>Etapa 2: Decidir o caminho e formalizar. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GE14_Flow23</bpmn:incoming><bpmn:outgoing>GE14_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GE14_E3_T1" name="Programar e pagar a quitação ou as parcelas e registrá-las"><bpmn:documentation>Etapa 3: Pagar as parcelas e acompanhar as condições. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE14_Flow15</bpmn:incoming><bpmn:outgoing>GE14_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE14_E3_T2" name="Acompanhar as condições do parcelamento ou da transação e o risco de perdê-las"><bpmn:documentation>Etapa 3: Pagar as parcelas e acompanhar as condições. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE14_Flow16</bpmn:incoming><bpmn:outgoing>GE14_Flow17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GE14_E3_G1" name="Há risco de perder o parcelamento ou a transação?"><bpmn:incoming>GE14_Flow17</bpmn:incoming><bpmn:outgoing>GE14_Flow18</bpmn:outgoing><bpmn:outgoing>GE14_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE14_E3_T3" name="Propor a renegociação ou a regularização ao executivo"><bpmn:documentation>Etapa 3: Pagar as parcelas e acompanhar as condições. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE14_Flow19</bpmn:incoming><bpmn:outgoing>GE14_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE14_E3_T4" name="Decidir a renegociação ou a regularização"><bpmn:documentation>Etapa 3: Pagar as parcelas e acompanhar as condições. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE14_Flow20</bpmn:incoming><bpmn:outgoing>GE14_Flow21</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE14_M3"><bpmn:incoming>GE14_Flow18</bpmn:incoming><bpmn:incoming>GE14_Flow21</bpmn:incoming><bpmn:outgoing>GE14_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="GE14_F1" name="Débito pago, parcelado ou transacionado e acompanhado"><bpmn:incoming>GE14_Flow24</bpmn:incoming></bpmn:endEvent>
