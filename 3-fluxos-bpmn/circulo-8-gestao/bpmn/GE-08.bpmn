<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GE08" targetNamespace="urn:imts:modelo:circulo8-gestao" exporter="Ecossistema IMTS - fonte única do Círculo 8" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GE08">
    <bpmn:categoryValue id="CV_GE08_E1" value="1. Preparar a trilha de integração" />
    <bpmn:categoryValue id="CV_GE08_E2" value="2. Apresentar propósito, valores e comportamentos" />
    <bpmn:categoryValue id="CV_GE08_E3" value="3. Conectar a pessoa à comunidade" />
    <bpmn:categoryValue id="CV_GE08_E4" value="4. Verificar a integração e registrar" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GE08">
    <bpmn:participant id="Participant_GE08" name="GE-08 · Integrar pessoas novas à cultura" processRef="Process_GE08" />
    <bpmn:group id="Group_GE08_E1" categoryValueRef="CV_GE08_E1" />
    <bpmn:group id="Group_GE08_E2" categoryValueRef="CV_GE08_E2" />
    <bpmn:group id="Group_GE08_E3" categoryValueRef="CV_GE08_E3" />
    <bpmn:group id="Group_GE08_E4" categoryValueRef="CV_GE08_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GE08" name="Integrar pessoas novas à cultura" isExecutable="false">
    <bpmn:documentation>Fazer cada pessoa nova, ou que mudou de papel, e cada pessoa de empresa adquirida entender o propósito, os valores e os comportamentos esperados, e sentir-se parte, antes de responder sozinha pelo seu papel: trilha montada pelo papel, conduzida com o líder, vínculos iniciais e verificação de entendimento e de pertencimento, com reforço combinado quando falta. A Identidade define o kit; a Gestão integra; o líder acompanha.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GE08">
      <bpmn:lane id="Lane_GE08_LID" name="Líder da equipe">
        <bpmn:flowNodeRef>GE08_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_E4_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE08_PES" name="Pessoa">
        <bpmn:flowNodeRef>GE08_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE08_GEP" name="Gestão · pessoa">
        <bpmn:flowNodeRef>GE08_E4_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE08_GEA" name="Gestão · agente">
        <bpmn:flowNodeRef>GE08_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_E4_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GE08_GER" name="Gestão · automação">
        <bpmn:flowNodeRef>GE08_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_E4_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_E4_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GE08_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GE08_S1" name="Pessoa contratada ou com papel novo"><bpmn:outgoing>GE08_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GE08_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GE08_S2" name="Pessoas de empresa adquirida recebidas"><bpmn:outgoing>GE08_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GE08_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GE08_M1"><bpmn:incoming>GE08_Flow1</bpmn:incoming><bpmn:incoming>GE08_Flow2</bpmn:incoming><bpmn:outgoing>GE08_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE08_E1_T1" name="Abrir a integração e agendar os marcos"><bpmn:documentation>Etapa 1: Preparar a trilha de integração. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE08_Flow18</bpmn:incoming><bpmn:outgoing>GE08_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GE08_E1_T2" name="Montar a trilha conforme o papel"><bpmn:documentation>Etapa 1: Preparar a trilha de integração. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GE08_Flow3</bpmn:incoming><bpmn:outgoing>GE08_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GE08_M2"><bpmn:incoming>GE08_Flow4</bpmn:incoming><bpmn:incoming>GE08_Flow13</bpmn:incoming><bpmn:outgoing>GE08_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GE08_E2_T1" name="Conduzir a trilha e tirar dúvidas"><bpmn:documentation>Etapa 2: Apresentar propósito, valores e comportamentos. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>GE08_Flow19</bpmn:incoming><bpmn:outgoing>GE08_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE08_E2_T2" name="Conversar sobre como os valores aparecem no dia a dia da função"><bpmn:documentation>Etapa 2: Apresentar propósito, valores e comportamentos. Executor: Pessoa de fora do círculo (Líder da equipe). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>GE08_Flow5</bpmn:incoming><bpmn:outgoing>GE08_Flow6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE08_E2_T3" name="Concluir a trilha"><bpmn:documentation>Etapa 2: Apresentar propósito, valores e comportamentos. Executor: Pessoa de fora do círculo (Pessoa). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>GE08_Flow6</bpmn:incoming><bpmn:outgoing>GE08_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE08_E3_T1" name="Indicar um padrinho ou uma madrinha"><bpmn:documentation>Etapa 3: Conectar a pessoa à comunidade. Executor: Pessoa de fora do círculo (Líder da equipe). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>GE08_Flow7</bpmn:incoming><bpmn:outgoing>GE08_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GE08_E3_T2" name="Participar do primeiro ritual"><bpmn:documentation>Etapa 3: Conectar a pessoa à comunidade. Executor: Pessoa de fora do círculo (Pessoa). Modo da etapa: Assistido; risco baixo.</bpmn:documentation><bpmn:incoming>GE08_Flow8</bpmn:incoming><bpmn:outgoing>GE08_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="GE08_E4_T1" name="Aplicar a verificação de entendimento e de pertencimento"><bpmn:documentation>Etapa 4: Verificar a integração e registrar. Executor: Agente da Gestão (Gestão · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE08_Flow9</bpmn:incoming><bpmn:outgoing>GE08_Flow10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GE08_E4_T2" name="Confirmar os comportamentos observados"><bpmn:documentation>Etapa 4: Verificar a integração e registrar. Executor: Pessoa de fora do círculo (Líder da equipe). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE08_Flow10</bpmn:incoming><bpmn:outgoing>GE08_Flow11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GE08_E4_G1" name="A pessoa se integrou?"><bpmn:incoming>GE08_Flow11</bpmn:incoming><bpmn:outgoing>GE08_Flow12</bpmn:outgoing><bpmn:outgoing>GE08_Flow14</bpmn:outgoing><bpmn:outgoing>GE08_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GE08_E4_T3" name="Combinar o reforço com o líder"><bpmn:documentation>Etapa 4: Verificar a integração e registrar. Executor: Pessoa da Gestão (Gestão · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE08_Flow12</bpmn:incoming><bpmn:outgoing>GE08_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GE08_E4_T4" name="Abrir na GE-07 o pedido de mudança de papel ou de desligamento, para a decisão na alçada"><bpmn:documentation>Etapa 4: Verificar a integração e registrar. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE08_Flow14</bpmn:incoming><bpmn:outgoing>GE08_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GE08_M3"><bpmn:incoming>GE08_Flow15</bpmn:incoming><bpmn:incoming>GE08_Flow16</bpmn:incoming><bpmn:outgoing>GE08_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GE08_E4_T5" name="Registrar a conclusão, avisar o líder e enviar os dados agregados à pesquisa"><bpmn:documentation>Etapa 4: Verificar a integração e registrar. Executor: Automação da Gestão (Gestão · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GE08_Flow20</bpmn:incoming><bpmn:outgoing>GE08_Flow17</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GE08_F1" name="Integração cultural concluída e registrada"><bpmn:incoming>GE08_Flow17</bpmn:incoming></bpmn:endEvent>
