    <bpmn:scriptTask id="NE01_E1_T1" name="Registrar o que abriu o trabalho e as ofertas afetadas"><bpmn:documentation>Etapa 1: Reunir as ofertas, o preço-base e o desempenho de preço. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE01_Flow39</bpmn:incoming><bpmn:outgoing>NE01_Flow6</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="NE01_E1_G1" name="O que abriu o trabalho?"><bpmn:incoming>NE01_Flow6</bpmn:incoming><bpmn:outgoing>NE01_Flow7</bpmn:outgoing><bpmn:outgoing>NE01_Flow9</bpmn:outgoing><bpmn:outgoing>NE01_Flow11</bpmn:outgoing><bpmn:outgoing>NE01_Flow13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE01_E1_T2" name="Bloquear novas propostas da oferta, sem mudar a tabela publicada nem avisar fora"><bpmn:documentation>Etapa 1: Reunir as ofertas, o preço-base e o desempenho de preço. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE01_Flow7</bpmn:incoming><bpmn:outgoing>NE01_Flow8</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="NE01_F2" name="Venda da oferta bloqueada, à espera da data de saída"><bpmn:incoming>NE01_Flow8</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="NE01_E1_T3" name="Marcar na tabela a oferta que não pode mais ser vendida, com a data"><bpmn:documentation>Etapa 1: Reunir as ofertas, o preço-base e o desempenho de preço. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE01_Flow9</bpmn:incoming><bpmn:outgoing>NE01_Flow10</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="NE01_E1_T4" name="Listar o material de venda afetado e retirá-lo de uso"><bpmn:documentation>Etapa 1: Reunir as ofertas, o preço-base e o desempenho de preço. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE01_Flow11</bpmn:incoming><bpmn:outgoing>NE01_Flow12</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="NE01_E1_T5" name="Comparar o preço-base, o preço praticado, os descontos dados e as perdas por preço"><bpmn:documentation>Etapa 1: Reunir as ofertas, o preço-base e o desempenho de preço. Executor: Agente de Negócios (Negócios · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE01_Flow13</bpmn:incoming><bpmn:outgoing>NE01_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="NE01_E2_T1" name="Propor preço de tabela, descontos, condições de pagamento e faixa de desconto por oferta"><bpmn:documentation>Etapa 2: Decidir o preço de tabela e a política comercial. Executor: Agente de Negócios (Negócios · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE01_Flow14</bpmn:incoming><bpmn:outgoing>NE01_Flow15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:businessRuleTask id="NE01_E2_T2" name="Conferir a proposta com o preço-base e com as alçadas vigentes"><bpmn:documentation>Etapa 2: Decidir o preço de tabela e a política comercial. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE01_Flow15</bpmn:incoming><bpmn:outgoing>NE01_Flow16</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="NE01_E2_G1" name="Algum preço de tabela fica abaixo do preço-base?"><bpmn:incoming>NE01_Flow16</bpmn:incoming><bpmn:outgoing>NE01_Flow17</bpmn:outgoing><bpmn:outgoing>NE01_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE01_E2_T3" name="Pedir à Inteligência a revisão do preço-base, com a evidência de mercado e de perdas"><bpmn:documentation>Etapa 2: Decidir o preço de tabela e a política comercial. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE01_Flow17</bpmn:incoming><bpmn:outgoing>NE01_Flow18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="NE01_E2_T4" name="Manter a oferta afetada no preço vigente até a resposta"><bpmn:documentation>Etapa 2: Decidir o preço de tabela e a política comercial. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE01_Flow18</bpmn:incoming><bpmn:outgoing>NE01_Flow20</bpmn:outgoing></bpmn:userTask>
