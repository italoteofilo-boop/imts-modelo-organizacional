    <bpmn:userTask id="NE01_E2_T5" name="Opinar sobre o preço e a política comercial da empresa"><bpmn:documentation>Etapa 2: Decidir o preço de tabela e a política comercial. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE01_Flow21</bpmn:incoming><bpmn:outgoing>NE01_Flow22</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="NE01_E2_T6" name="Conferir a margem e o efeito no caixa das condições de pagamento"><bpmn:documentation>Etapa 2: Decidir o preço de tabela e a política comercial. Executor: Outro círculo (Gestão). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE01_Flow23</bpmn:incoming><bpmn:outgoing>NE01_Flow24</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="NE01_E2_PJ1"><bpmn:incoming>NE01_Flow22</bpmn:incoming><bpmn:incoming>NE01_Flow24</bpmn:incoming><bpmn:outgoing>NE01_Flow25</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="NE01_E2_T7" name="Decidir a tabela de preços e a política comercial, ouvidos o executivo e a Gestão"><bpmn:documentation>Etapa 2: Decidir o preço de tabela e a política comercial. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE01_Flow25</bpmn:incoming><bpmn:outgoing>NE01_Flow26</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="NE01_E2_G2" name="A política muda a faixa de desconto de quem vende ou uma condição dos modelos de contrato?"><bpmn:incoming>NE01_Flow26</bpmn:incoming><bpmn:outgoing>NE01_Flow27</bpmn:outgoing><bpmn:outgoing>NE01_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="NE01_E2_T8" name="Aprovar a faixa de desconto e as condições na tabela de alçadas e nos modelos"><bpmn:documentation>Etapa 2: Decidir o preço de tabela e a política comercial. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE01_Flow27</bpmn:incoming><bpmn:outgoing>NE01_Flow29</bpmn:outgoing></bpmn:task>
