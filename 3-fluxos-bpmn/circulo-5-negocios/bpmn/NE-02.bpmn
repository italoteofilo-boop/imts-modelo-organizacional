<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NE02" targetNamespace="urn:imts:modelo:circulo5-negocios" exporter="Ecossistema IMTS - fonte única do Círculo 5" exporterVersion="2026-10-01">
  <bpmn:category id="Category_NE02">
    <bpmn:categoryValue id="CV_NE02_E1" value="1. Reunir alvos, demanda, funil e carteira" />
    <bpmn:categoryValue id="CV_NE02_E2" value="2. Decidir os alvos de venda, os clientes-chave e a previsão" />
    <bpmn:categoryValue id="CV_NE02_E3" value="3. Publicar o plano de vendas e a previsão" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_NE02">
    <bpmn:participant id="Participant_NE02" name="NE-02 · Planejar as vendas do ciclo e prever a receita" processRef="Process_NE02" />
    <bpmn:group id="Group_NE02_E1" categoryValueRef="CV_NE02_E1" />
    <bpmn:group id="Group_NE02_E2" categoryValueRef="CV_NE02_E2" />
    <bpmn:group id="Group_NE02_E3" categoryValueRef="CV_NE02_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_NE02" name="Planejar as vendas do ciclo e prever a receita" isExecutable="false">
    <bpmn:documentation>Ter, a cada ciclo, os alvos de venda de cada empresa por oferta e canal, desdobrados dos alvos do ciclo, os clientes-chave com o plano de conta de cada um, e uma previsão de receita e de vendas atualizada a cada período a partir do funil, das propostas, dos contratos, das atas e das renovações, entregue a quem precisa dela para o orçamento, o caixa, a capacidade e a implantação. Negócios decide o desdobramento e a previsão, ouvido o executivo; o desvio contra os alvos vai ao executivo e à Gestão.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_NE02">
      <bpmn:lane id="Lane_NE02_EST" name="Estratégia">
        <bpmn:flowNodeRef>NE02_S3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE02_OPE" name="Operações">
        <bpmn:flowNodeRef>NE02_E2_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE02_ITG" name="Integração">
        <bpmn:flowNodeRef>NE02_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E2_PJ1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE02_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>NE02_E2_PS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE02_NEP" name="Negócios · pessoa">
        <bpmn:flowNodeRef>NE02_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E2_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE02_NEA" name="Negócios · agente">
        <bpmn:flowNodeRef>NE02_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E2_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE02_NER" name="Negócios · automação">
        <bpmn:flowNodeRef>NE02_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E2_T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE02_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NE02_S1" name="Ciclo de vendas iniciado"><bpmn:outgoing>NE02_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="NE02_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="NE02_S2" name="Período de previsão encerrado"><bpmn:outgoing>NE02_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="NE02_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="NE02_S3" name="Alvos do ciclo publicados"><bpmn:outgoing>NE02_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="NE02_S3_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="NE02_M1"><bpmn:incoming>NE02_Flow1</bpmn:incoming><bpmn:incoming>NE02_Flow2</bpmn:incoming><bpmn:incoming>NE02_Flow3</bpmn:incoming><bpmn:outgoing>NE02_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE02_E1_T1" name="Reunir alvos, plano de demanda, funil, propostas, contratos, atas e vencimentos do período"><bpmn:documentation>Etapa 1: Reunir alvos, demanda, funil e carteira. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE02_Flow23</bpmn:incoming><bpmn:outgoing>NE02_Flow4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="NE02_E1_T2" name="Calcular a previsão de receita e de vendas por empresa, oferta, canal e período"><bpmn:documentation>Etapa 1: Reunir alvos, demanda, funil e carteira. Executor: Agente de Negócios (Negócios · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE02_Flow4</bpmn:incoming><bpmn:outgoing>NE02_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="NE02_E1_T3" name="Comparar a previsão com os alvos e apontar desvios e lacunas que afetam a venda"><bpmn:documentation>Etapa 1: Reunir alvos, demanda, funil e carteira. Executor: Agente de Negócios (Negócios · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE02_Flow5</bpmn:incoming><bpmn:outgoing>NE02_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="NE02_E2_T1" name="Propor o desdobramento dos alvos de venda por oferta e canal e as ações para os desvios"><bpmn:documentation>Etapa 2: Decidir os alvos de venda, os clientes-chave e a previsão. Executor: Agente de Negócios (Negócios · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE02_Flow6</bpmn:incoming><bpmn:outgoing>NE02_Flow7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="NE02_E2_PS1"><bpmn:incoming>NE02_Flow7</bpmn:incoming><bpmn:outgoing>NE02_Flow8</bpmn:outgoing><bpmn:outgoing>NE02_Flow10</bpmn:outgoing><bpmn:outgoing>NE02_Flow12</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="NE02_E2_T2" name="Opinar sobre os alvos de venda e a previsão da empresa"><bpmn:documentation>Etapa 2: Decidir os alvos de venda, os clientes-chave e a previsão. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE02_Flow8</bpmn:incoming><bpmn:outgoing>NE02_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="NE02_E2_T3" name="Confirmar a capacidade de entrega para o volume previsto"><bpmn:documentation>Etapa 2: Decidir os alvos de venda, os clientes-chave e a previsão. Executor: Outro círculo (Operações). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE02_Flow10</bpmn:incoming><bpmn:outgoing>NE02_Flow11</bpmn:outgoing></bpmn:task>
    <bpmn:task id="NE02_E2_T4" name="Confirmar a capacidade de implantação para o volume previsto"><bpmn:documentation>Etapa 2: Decidir os alvos de venda, os clientes-chave e a previsão. Executor: Outro círculo (Integração). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE02_Flow12</bpmn:incoming><bpmn:outgoing>NE02_Flow13</bpmn:outgoing></bpmn:task>
    <bpmn:parallelGateway id="NE02_E2_PJ1"><bpmn:incoming>NE02_Flow9</bpmn:incoming><bpmn:incoming>NE02_Flow11</bpmn:incoming><bpmn:incoming>NE02_Flow13</bpmn:incoming><bpmn:outgoing>NE02_Flow14</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="NE02_E2_T5" name="Decidir os alvos de venda e a previsão, ouvido o executivo"><bpmn:documentation>Etapa 2: Decidir os alvos de venda, os clientes-chave e a previsão. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE02_Flow14</bpmn:incoming><bpmn:outgoing>NE02_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="NE02_E2_T6" name="Escolher os clientes-chave e definir o plano de conta de cada um"><bpmn:documentation>Etapa 2: Decidir os alvos de venda, os clientes-chave e a previsão. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE02_Flow15</bpmn:incoming><bpmn:outgoing>NE02_Flow16</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="NE02_E2_T7" name="Incluir no plano as correções das lacunas de execução e de percepção que cabem a Negócios"><bpmn:documentation>Etapa 2: Decidir os alvos de venda, os clientes-chave e a previsão. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE02_Flow16</bpmn:incoming><bpmn:outgoing>NE02_Flow17</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="NE02_E2_G1" name="A previsão fica abaixo dos alvos do ciclo?"><bpmn:incoming>NE02_Flow17</bpmn:incoming><bpmn:outgoing>NE02_Flow18</bpmn:outgoing><bpmn:outgoing>NE02_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE02_E2_T8" name="Apontar o desvio ao executivo e à Gestão, com as ações de recuperação"><bpmn:documentation>Etapa 2: Decidir os alvos de venda, os clientes-chave e a previsão. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE02_Flow19</bpmn:incoming><bpmn:outgoing>NE02_Flow20</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="NE02_M2"><bpmn:incoming>NE02_Flow18</bpmn:incoming><bpmn:incoming>NE02_Flow20</bpmn:incoming><bpmn:outgoing>NE02_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE02_E3_T1" name="Publicar o plano de vendas do ciclo, os planos de conta e a previsão com versão e data"><bpmn:documentation>Etapa 3: Publicar o plano de vendas e a previsão. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>NE02_Flow24</bpmn:incoming><bpmn:outgoing>NE02_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="NE02_E3_T2" name="Avisar quem vende, o executivo, a Gestão, Operações e a Integração"><bpmn:documentation>Etapa 3: Publicar o plano de vendas e a previsão. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>NE02_Flow21</bpmn:incoming><bpmn:outgoing>NE02_Flow22</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="NE02_F1" name="Plano de vendas e previsão publicados"><bpmn:incoming>NE02_Flow22</bpmn:incoming></bpmn:endEvent>
