<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NE07" targetNamespace="urn:imts:modelo:circulo5-negocios" exporter="Ecossistema IMTS - fonte única do Círculo 5" exporterVersion="2026-10-01">
  <bpmn:category id="Category_NE07">
    <bpmn:categoryValue id="CV_NE07_E1" value="1. Receber a oportunidade do parceiro ou de outra empresa" />
    <bpmn:categoryValue id="CV_NE07_E2" value="2. Montar a oferta conjunta e combinar a divisão" />
    <bpmn:categoryValue id="CV_NE07_E3" value="3. Medir a venda com parceiros e conjunta e rever o que mudar" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_NE07">
    <bpmn:participant id="Participant_NE07" name="NE-07 · Vender com parceiros e em oferta conjunta entre as empresas" processRef="Process_NE07" />
    <bpmn:group id="Group_NE07_E1" categoryValueRef="CV_NE07_E1" />
    <bpmn:group id="Group_NE07_E2" categoryValueRef="CV_NE07_E2" />
    <bpmn:group id="Group_NE07_E3" categoryValueRef="CV_NE07_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_NE07" name="Vender com parceiros e em oferta conjunta entre as empresas" isExecutable="false">
    <bpmn:documentation>Fazer a oportunidade trazida por um parceiro de venda ativo ser conferida com o critério combinado com Relações e com o funil e, aceita, chegar à proposta sem conflito; montar com outra empresa do Ecossistema a oferta conjunta quando o cliente de uma tem um problema que a outra resolve, com a divisão de receita e de responsabilidade decidida pelos executivos das duas empresas (exceção à regra de que o executivo opina, porque mexe no resultado de duas empresas) e formalizada pela Governança antes da proposta; e medir a venda com parceiros e conjunta. Relações forma, ativa e acompanha o parceiro; Negócios vende com ele.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_NE07">
      <bpmn:lane id="Lane_NE07_PRC" name="Parceiro">
        <bpmn:flowNodeRef>NE07_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE07_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>NE07_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE07_GES" name="Gestão">
        <bpmn:flowNodeRef>NE07_E2_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE07_GOV" name="Governança">
        <bpmn:flowNodeRef>NE07_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE07_NEP" name="Negócios · pessoa">
        <bpmn:flowNodeRef>NE07_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE07_NEA" name="Negócios · agente">
        <bpmn:flowNodeRef>NE07_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE07_NER" name="Negócios · automação">
        <bpmn:flowNodeRef>NE07_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E1_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_F3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_F4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE07_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="NE07_S1" name="Oportunidade indicada por parceiro de venda"><bpmn:outgoing>NE07_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="NE07_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="NE07_S2" name="Oportunidade cruzada entre empresas apontada"><bpmn:outgoing>NE07_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="NE07_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="NE07_S3" name="Revisão da venda com parceiros iniciada"><bpmn:outgoing>NE07_Flow3</bpmn:outgoing><bpmn:timerEventDefinition id="NE07_S3_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="NE07_M1"><bpmn:incoming>NE07_Flow1</bpmn:incoming><bpmn:incoming>NE07_Flow2</bpmn:incoming><bpmn:incoming>NE07_Flow3</bpmn:incoming><bpmn:outgoing>NE07_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE07_E1_T1" name="Registrar a oportunidade, quem indicou e o que abriu o trabalho"><bpmn:documentation>Etapa 1: Receber a oportunidade do parceiro ou de outra empresa. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE07_Flow28</bpmn:incoming><bpmn:outgoing>NE07_Flow4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="NE07_E1_G1" name="O que abriu o trabalho?"><bpmn:incoming>NE07_Flow4</bpmn:incoming><bpmn:outgoing>NE07_Flow5</bpmn:outgoing><bpmn:outgoing>NE07_Flow6</bpmn:outgoing><bpmn:outgoing>NE07_Flow7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="NE07_E1_T2" name="Conferir a oportunidade com o critério, o funil e a base, e se o parceiro está ativo"><bpmn:documentation>Etapa 1: Receber a oportunidade do parceiro ou de outra empresa. Executor: Agente de Negócios (Negócios · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE07_Flow7</bpmn:incoming><bpmn:outgoing>NE07_Flow8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="NE07_E1_T3" name="Decidir se a oportunidade do parceiro segue para a proposta"><bpmn:documentation>Etapa 1: Receber a oportunidade do parceiro ou de outra empresa. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE07_Flow8</bpmn:incoming><bpmn:outgoing>NE07_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="NE07_E1_G2" name="A oportunidade é nova, atende ao critério e o parceiro está ativo?"><bpmn:incoming>NE07_Flow9</bpmn:incoming><bpmn:outgoing>NE07_Flow10</bpmn:outgoing><bpmn:outgoing>NE07_Flow12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE07_E1_T4" name="Passar a oportunidade do parceiro à proposta, com a regra de remuneração do parceiro"><bpmn:documentation>Etapa 1: Receber a oportunidade do parceiro ou de outra empresa. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE07_Flow10</bpmn:incoming><bpmn:outgoing>NE07_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="NE07_E1_T5" name="Responder ao parceiro com o motivo"><bpmn:documentation>Etapa 1: Receber a oportunidade do parceiro ou de outra empresa. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE07_Flow12</bpmn:incoming><bpmn:outgoing>NE07_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="NE07_F2" name="Oportunidade do parceiro recusada, com o motivo"><bpmn:incoming>NE07_Flow13</bpmn:incoming></bpmn:endEvent>
    <bpmn:manualTask id="NE07_E2_T1" name="Desenhar com a outra empresa o escopo, quem entrega o quê e quem fala com o cliente"><bpmn:documentation>Etapa 2: Montar a oferta conjunta e combinar a divisão. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>NE07_Flow5</bpmn:incoming><bpmn:outgoing>NE07_Flow14</bpmn:outgoing></bpmn:manualTask>
    <bpmn:serviceTask id="NE07_E2_T2" name="Calcular o preço conjunto e propor a divisão de receita e de responsabilidade"><bpmn:documentation>Etapa 2: Montar a oferta conjunta e combinar a divisão. Executor: Agente de Negócios (Negócios · agente). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>NE07_Flow14</bpmn:incoming><bpmn:outgoing>NE07_Flow15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="NE07_E2_T3" name="Conferir o efeito da divisão no resultado de cada empresa"><bpmn:documentation>Etapa 2: Montar a oferta conjunta e combinar a divisão. Executor: Outro círculo (Gestão). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>NE07_Flow15</bpmn:incoming><bpmn:outgoing>NE07_Flow16</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="NE07_E2_T4" name="Decidir a divisão de receita e de responsabilidade entre as empresas"><bpmn:documentation>Etapa 2: Montar a oferta conjunta e combinar a divisão. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>NE07_Flow16</bpmn:incoming><bpmn:outgoing>NE07_Flow17</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="NE07_E2_G1" name="Os executivos das duas empresas chegaram a acordo?"><bpmn:incoming>NE07_Flow17</bpmn:incoming><bpmn:outgoing>NE07_Flow18</bpmn:outgoing><bpmn:outgoing>NE07_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="NE07_E2_T5" name="Formalizar o acordo entre as empresas: divisão de receita, responsabilidade e rateio"><bpmn:documentation>Etapa 2: Montar a oferta conjunta e combinar a divisão. Executor: Outro círculo (Governança). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>NE07_Flow18</bpmn:incoming><bpmn:outgoing>NE07_Flow19</bpmn:outgoing></bpmn:callActivity>
    <bpmn:scriptTask id="NE07_E2_T6" name="Passar a oferta conjunta à proposta, com quem conduz a venda em cada empresa"><bpmn:documentation>Etapa 2: Montar a oferta conjunta e combinar a divisão. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>NE07_Flow19</bpmn:incoming><bpmn:outgoing>NE07_Flow20</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="NE07_M2"><bpmn:incoming>NE07_Flow11</bpmn:incoming><bpmn:incoming>NE07_Flow20</bpmn:incoming><bpmn:outgoing>NE07_Flow29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="NE07_F3" name="Oportunidade passada à proposta"><bpmn:incoming>NE07_Flow29</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="NE07_E2_T7" name="Registrar o motivo e devolver a oportunidade à empresa de origem"><bpmn:documentation>Etapa 2: Montar a oferta conjunta e combinar a divisão. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>NE07_Flow21</bpmn:incoming><bpmn:outgoing>NE07_Flow22</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="NE07_F4" name="Oferta conjunta sem acordo, com o motivo"><bpmn:incoming>NE07_Flow22</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="NE07_E3_T1" name="Medir oportunidades, propostas, contratos e receita por parceiro e por oferta conjunta"><bpmn:documentation>Etapa 3: Medir a venda com parceiros e conjunta e rever o que mudar. Executor: Agente de Negócios (Negócios · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE07_Flow6</bpmn:incoming><bpmn:outgoing>NE07_Flow23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="NE07_E3_T2" name="Concluir o que manter, mudar ou encerrar na venda com cada parceiro"><bpmn:documentation>Etapa 3: Medir a venda com parceiros e conjunta e rever o que mudar. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE07_Flow23</bpmn:incoming><bpmn:outgoing>NE07_Flow24</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="NE07_E3_G1" name="A venda com algum parceiro pede encerrar a parceria?"><bpmn:incoming>NE07_Flow24</bpmn:incoming><bpmn:outgoing>NE07_Flow25</bpmn:outgoing><bpmn:outgoing>NE07_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE07_E3_T3" name="Pedir a Relações o encerramento da parceria de venda, com a evidência"><bpmn:documentation>Etapa 3: Medir a venda com parceiros e conjunta e rever o que mudar. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>NE07_Flow26</bpmn:incoming><bpmn:outgoing>NE07_Flow27</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="NE07_M3"><bpmn:incoming>NE07_Flow25</bpmn:incoming><bpmn:incoming>NE07_Flow27</bpmn:incoming><bpmn:outgoing>NE07_Flow30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="NE07_F1" name="Venda com parceiros e conjunta avaliada"><bpmn:incoming>NE07_Flow30</bpmn:incoming></bpmn:endEvent>
