        <bpmn:flowNodeRef>NE04_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE04_E3_T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE04_SOC" name="Sócios">
        <bpmn:flowNodeRef>NE04_E1_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE04_E3_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE04_NEP" name="Negócios · pessoa">
        <bpmn:flowNodeRef>NE04_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE04_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE04_E1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE04_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE04_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE04_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE04_M3</bpmn:flowNodeRef>
