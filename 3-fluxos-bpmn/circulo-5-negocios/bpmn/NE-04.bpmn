    <bpmn:startEvent id="NE04_S1" name="Proposta aceita ou em negociação recebida"><bpmn:outgoing>NE04_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="NE04_S1_def" /></bpmn:startEvent>
