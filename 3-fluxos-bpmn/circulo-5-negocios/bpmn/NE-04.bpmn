        <bpmn:flowNodeRef>NE04_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NE04_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_NE04_NER" name="Negócios · automação">
