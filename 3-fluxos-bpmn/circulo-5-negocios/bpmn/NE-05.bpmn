<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_NE05" targetNamespace="urn:imts:modelo:circulo5-negocios" exporter="Ecossistema IMTS - fonte única do Círculo 5" exporterVersion="2026-10-01">
  <bpmn:category id="Category_NE05">
    <bpmn:categoryValue id="CV_NE05_E1" value="1. Analisar o edital e decidir participar" />
    <bpmn:categoryValue id="CV_NE05_E2" value="2. Montar a proposta e os documentos de habilitação" />
    <bpmn:categoryValue id="CV_NE05_E3" value="3. Disputar e acompanhar o julgamento, a habilitação e os recursos" />
    <bpmn:categoryValue id="CV_NE05_E4" value="4. Assinar o contrato ou a ata e responder às adesões" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_NE05">
    <bpmn:participant id="Participant_NE05" name="NE-05 · Disputar licitações e contratar com o setor público" processRef="Process_NE05" />
    <bpmn:group id="Group_NE05_E1" categoryValueRef="CV_NE05_E1" />
    <bpmn:group id="Group_NE05_E2" categoryValueRef="CV_NE05_E2" />
    <bpmn:group id="Group_NE05_E3" categoryValueRef="CV_NE05_E3" />
    <bpmn:group id="Group_NE05_E4" categoryValueRef="CV_NE05_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_NE05" name="Disputar licitações e contratar com o setor público" isExecutable="false">
    <bpmn:documentation>Decidir em cada edital se a empresa participa, montar a proposta e os documentos de habilitação nas regras do edital, disputar, acompanhar o julgamento, a habilitação, os recursos e a homologação e, ganhando, assinar o contrato ou a ata de registro de preços; responder ao pedido de cotação para pesquisa de preços; e responder ao órgão não participante que pede para aderir à ata. Negócios decide participar e recorrer, ouvidos o executivo e a Governança; a Governança confere a habilitação e conduz esclarecimentos, impugnações, recursos e contrarrazões; o executivo assina. Prazos e regras de impugnação, recurso, convocação e adesão seguem a lei e o edital e não foram conferidos neste desenho.</bpmn:documentation>
