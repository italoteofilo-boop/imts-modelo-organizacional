    <bpmn:exclusiveGateway id="NE06_E2_G4" name="Qual é o resultado com o cliente?"><bpmn:incoming>NE06_Flow70</bpmn:incoming><bpmn:outgoing>NE06_Flow35</bpmn:outgoing><bpmn:outgoing>NE06_Flow36</bpmn:outgoing></bpmn:exclusiveGateway>
