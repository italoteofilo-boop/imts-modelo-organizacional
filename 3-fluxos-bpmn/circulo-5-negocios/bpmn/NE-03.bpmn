    <bpmn:startEvent id="NE03_S1" name="Oportunidade qualificada recebida"><bpmn:outgoing>NE03_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="NE03_S1_def" /></bpmn:startEvent>
