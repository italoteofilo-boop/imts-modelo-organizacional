    <bpmn:scriptTask id="NE03_E1_T2" name="Registrar quem conduz a venda, indicado na NE-07"><bpmn:documentation>Etapa 1: Receber a oportunidade e decidir o aceite. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow8</bpmn:incoming><bpmn:outgoing>NE03_Flow9</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="NE03_E1_T3" name="Retomar a oportunidade com a mudança pedida ou com a resposta recebida"><bpmn:documentation>Etapa 1: Receber a oportunidade e decidir o aceite. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow10</bpmn:incoming><bpmn:outgoing>NE03_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="NE03_E1_T4" name="Passar o contato a Relações para qualificar, com o que o cliente pediu"><bpmn:documentation>Etapa 1: Receber a oportunidade e decidir o aceite. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow12</bpmn:incoming><bpmn:outgoing>NE03_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="NE03_F4" name="Contato passado a Relações para qualificar"><bpmn:incoming>NE03_Flow13</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="NE03_E1_T5" name="Levar o pedido à jornada de contas e contratos"><bpmn:documentation>Etapa 1: Receber a oportunidade e decidir o aceite. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow14</bpmn:incoming><bpmn:outgoing>NE03_Flow15</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="NE03_F5" name="Pedido levado à jornada de contas e contratos"><bpmn:incoming>NE03_Flow15</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="NE03_E1_T6" name="Levar o edital ou o pedido de cotação à jornada de licitações"><bpmn:documentation>Etapa 1: Receber a oportunidade e decidir o aceite. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow16</bpmn:incoming><bpmn:outgoing>NE03_Flow17</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="NE03_F6" name="Edital levado à jornada de licitações"><bpmn:incoming>NE03_Flow17</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="NE03_E1_T7" name="Conferir a oportunidade com o critério combinado, o plano de vendas e as ofertas vendáveis"><bpmn:documentation>Etapa 1: Receber a oportunidade e decidir o aceite. Executor: Agente de Negócios (Negócios · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow18</bpmn:incoming><bpmn:outgoing>NE03_Flow19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="NE03_E1_T8" name="Decidir o aceite ou a devolução, com o motivo, no prazo combinado"><bpmn:documentation>Etapa 1: Receber a oportunidade e decidir o aceite. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow19</bpmn:incoming><bpmn:outgoing>NE03_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="NE03_E1_G2" name="Negócios aceita a oportunidade?"><bpmn:incoming>NE03_Flow20</bpmn:incoming><bpmn:outgoing>NE03_Flow21</bpmn:outgoing><bpmn:outgoing>NE03_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE03_E1_T9" name="Devolver a oportunidade a Relações, com o motivo"><bpmn:documentation>Etapa 1: Receber a oportunidade e decidir o aceite. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow21</bpmn:incoming><bpmn:outgoing>NE03_Flow22</bpmn:outgoing></bpmn:scriptTask>
