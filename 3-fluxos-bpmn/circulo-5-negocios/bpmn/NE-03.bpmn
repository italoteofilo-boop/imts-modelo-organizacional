    <bpmn:scriptTask id="NE03_E2_T3" name="Levar o ajuste à Inteligência ou a oferta nova à Estratégia, com a necessidade do cliente"><bpmn:documentation>Etapa 2: Entender a necessidade e desenhar a solução. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow27</bpmn:incoming><bpmn:outgoing>NE03_Flow28</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:manualTask id="NE03_E2_T4" name="Avisar o cliente do caminho e do prazo da resposta"><bpmn:documentation>Etapa 2: Entender a necessidade e desenhar a solução. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow28</bpmn:incoming><bpmn:outgoing>NE03_Flow29</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="NE03_F3" name="Escopo fora do catálogo levado à Inteligência ou à Estratégia"><bpmn:incoming>NE03_Flow29</bpmn:incoming></bpmn:endEvent>
    <bpmn:parallelGateway id="NE03_E2_PS1"><bpmn:incoming>NE03_Flow30</bpmn:incoming><bpmn:outgoing>NE03_Flow31</bpmn:outgoing><bpmn:outgoing>NE03_Flow33</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:task id="NE03_E2_T5" name="Confirmar que consegue entregar o escopo no prazo pedido"><bpmn:documentation>Etapa 2: Entender a necessidade e desenhar a solução. Executor: Outro círculo (Operações). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow31</bpmn:incoming><bpmn:outgoing>NE03_Flow32</bpmn:outgoing></bpmn:task>
    <bpmn:task id="NE03_E2_T6" name="Confirmar o que a implantação pede: sistemas, prazos e pessoas"><bpmn:documentation>Etapa 2: Entender a necessidade e desenhar a solução. Executor: Outro círculo (Integração). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow33</bpmn:incoming><bpmn:outgoing>NE03_Flow34</bpmn:outgoing></bpmn:task>
