    <bpmn:userTask id="NE03_E2_T7" name="Decidir o escopo da solução, com o que Operações e a Integração confirmaram"><bpmn:documentation>Etapa 2: Entender a necessidade e desenhar a solução. Executor: Pessoa de Negócios (Negócios · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow35</bpmn:incoming><bpmn:outgoing>NE03_Flow36</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="NE03_E2_G2" name="Operações e a Integração conseguem entregar o escopo?"><bpmn:incoming>NE03_Flow36</bpmn:incoming><bpmn:outgoing>NE03_Flow37</bpmn:outgoing><bpmn:outgoing>NE03_Flow38</bpmn:outgoing><bpmn:outgoing>NE03_Flow39</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="NE03_E2_T8" name="Registrar a perda por falta de escopo entregável e avisar o cliente"><bpmn:documentation>Etapa 2: Entender a necessidade e desenhar a solução. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow39</bpmn:incoming><bpmn:outgoing>NE03_Flow40</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:businessRuleTask id="NE03_E3_T1" name="Calcular o preço pela tabela e pela política comercial"><bpmn:documentation>Etapa 3: Precificar e redigir a proposta. Executor: Automação de Negócios (Negócios · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>NE03_Flow37</bpmn:incoming><bpmn:outgoing>NE03_Flow41</bpmn:outgoing></bpmn:businessRuleTask>
