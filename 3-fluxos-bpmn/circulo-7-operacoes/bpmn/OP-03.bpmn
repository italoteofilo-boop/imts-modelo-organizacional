<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OP03" targetNamespace="urn:imts:modelo:circulo7-operacoes" exporter="Ecossistema IMTS - fonte única do Círculo 7" exporterVersion="2026-10-01">
  <bpmn:category id="Category_OP03">
    <bpmn:categoryValue id="CV_OP03_E1" value="1. Receber e classificar o contato do cliente" />
    <bpmn:categoryValue id="CV_OP03_E2" value="2. Resolver e responder ao cliente" />
    <bpmn:categoryValue id="CV_OP03_E3" value="3. Registrar o atendimento e o que ele ensina" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_OP03">
    <bpmn:participant id="Participant_OP03" name="OP-03 · Atender o cliente: pedidos, dúvidas e problemas, do contato à solução" processRef="Process_OP03" />
    <bpmn:group id="Group_OP03_E1" categoryValueRef="CV_OP03_E1" />
    <bpmn:group id="Group_OP03_E2" categoryValueRef="CV_OP03_E2" />
    <bpmn:group id="Group_OP03_E3" categoryValueRef="CV_OP03_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OP03" name="Atender o cliente: pedidos, dúvidas e problemas, do contato à solução" isExecutable="false">
    <bpmn:documentation>Fazer cada contato de cliente ser registrado, classificado pelo nível de serviço que vale, resolvido pela base de conhecimento ou por pessoa e respondido; cada problema de tecnologia ir à Integração; cada caso sem padrão ir à Identidade e cada dúvida sobre a oferta em uso à Inteligência; cada reclamação, e cada caso que não se resolve, ir ao tratamento de reclamações; cada pedido comercial ir a Negócios; e cada atendimento deixar registro e o conteúdo que faltou. Operações atende; Negócios trata o pedido comercial.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_OP03">
      <bpmn:lane id="Lane_OP03_CLI" name="Cliente">
        <bpmn:flowNodeRef>OP03_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP03_NEG" name="Negócios">
        <bpmn:flowNodeRef>OP03_E1_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP03_OPP" name="Operações · pessoa">
        <bpmn:flowNodeRef>OP03_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP03_OPA" name="Operações · agente">
        <bpmn:flowNodeRef>OP03_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_G4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP03_OPR" name="Operações · automação">
        <bpmn:flowNodeRef>OP03_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_F3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP03_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OP03_S1" name="Pedido, dúvida ou problema do cliente recebido"><bpmn:outgoing>OP03_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="OP03_S1_def" /></bpmn:startEvent>
    <bpmn:scriptTask id="OP03_E1_T1" name="Registrar o contato, o cliente, o contrato e o canal"><bpmn:documentation>Etapa 1: Receber e classificar o contato do cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP03_Flow1</bpmn:incoming><bpmn:outgoing>OP03_Flow2</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="OP03_E1_T2" name="Classificar o tipo, a urgência e o nível de serviço que vale"><bpmn:documentation>Etapa 1: Receber e classificar o contato do cliente. Executor: Agente de Operações (Operações · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP03_Flow2</bpmn:incoming><bpmn:outgoing>OP03_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OP03_E1_G1" name="O que o cliente pede?"><bpmn:incoming>OP03_Flow3</bpmn:incoming><bpmn:outgoing>OP03_Flow4</bpmn:outgoing><bpmn:outgoing>OP03_Flow5</bpmn:outgoing><bpmn:outgoing>OP03_Flow7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP03_E1_T3" name="Abrir a reclamação no tratamento de reclamações"><bpmn:documentation>Etapa 1: Receber e classificar o contato do cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP03_Flow5</bpmn:incoming><bpmn:outgoing>OP03_Flow6</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="OP03_E1_T4" name="Receber o pedido comercial do cliente e tratá-lo na proposta ou no contrato"><bpmn:documentation>Etapa 1: Receber e classificar o contato do cliente. Executor: Outro círculo (Negócios). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP03_Flow7</bpmn:incoming><bpmn:outgoing>OP03_Flow8</bpmn:outgoing></bpmn:task>
    <bpmn:endEvent id="OP03_F3" name="Pedido comercial passado a Negócios"><bpmn:incoming>OP03_Flow8</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="OP03_E2_G1" name="O problema é de tecnologia?"><bpmn:incoming>OP03_Flow4</bpmn:incoming><bpmn:outgoing>OP03_Flow9</bpmn:outgoing><bpmn:outgoing>OP03_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP03_E2_T1" name="Abrir o pedido ou o incidente na Integração e acompanhar até a solução"><bpmn:documentation>Etapa 2: Resolver e responder ao cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP03_Flow9</bpmn:incoming><bpmn:outgoing>OP03_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="OP03_M1"><bpmn:incoming>OP03_Flow10</bpmn:incoming><bpmn:incoming>OP03_Flow11</bpmn:incoming><bpmn:outgoing>OP03_Flow27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="OP03_E2_G2" name="Falta padrão ou regra para responder?"><bpmn:incoming>OP03_Flow27</bpmn:incoming><bpmn:outgoing>OP03_Flow12</bpmn:outgoing><bpmn:outgoing>OP03_Flow13</bpmn:outgoing><bpmn:outgoing>OP03_Flow14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP03_E2_T2" name="Consultar a Identidade sobre o caso não coberto"><bpmn:documentation>Etapa 2: Resolver e responder ao cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP03_Flow12</bpmn:incoming><bpmn:outgoing>OP03_Flow15</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="OP03_E2_T3" name="Pedir à Inteligência a resposta sobre a oferta em uso"><bpmn:documentation>Etapa 2: Resolver e responder ao cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP03_Flow13</bpmn:incoming><bpmn:outgoing>OP03_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="OP03_M2"><bpmn:incoming>OP03_Flow14</bpmn:incoming><bpmn:incoming>OP03_Flow15</bpmn:incoming><bpmn:incoming>OP03_Flow16</bpmn:incoming><bpmn:outgoing>OP03_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OP03_E2_T4" name="Responder o que a base de conhecimento e as respostas recebidas cobrem"><bpmn:documentation>Etapa 2: Resolver e responder ao cliente. Executor: Agente de Operações (Operações · agente). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP03_Flow28</bpmn:incoming><bpmn:outgoing>OP03_Flow17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OP03_E2_G3" name="A resposta resolveu?"><bpmn:incoming>OP03_Flow17</bpmn:incoming><bpmn:outgoing>OP03_Flow18</bpmn:outgoing><bpmn:outgoing>OP03_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="OP03_E2_T5" name="Analisar e resolver o caso que o agente não resolve"><bpmn:documentation>Etapa 2: Resolver e responder ao cliente. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP03_Flow18</bpmn:incoming><bpmn:outgoing>OP03_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP03_M3"><bpmn:incoming>OP03_Flow19</bpmn:incoming><bpmn:incoming>OP03_Flow20</bpmn:incoming><bpmn:outgoing>OP03_Flow29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="OP03_E2_G4" name="O caso foi resolvido?"><bpmn:incoming>OP03_Flow29</bpmn:incoming><bpmn:outgoing>OP03_Flow21</bpmn:outgoing><bpmn:outgoing>OP03_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP03_E2_T6" name="Abrir a reclamação pelo caso não resolvido"><bpmn:documentation>Etapa 2: Resolver e responder ao cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP03_Flow21</bpmn:incoming><bpmn:outgoing>OP03_Flow22</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="OP03_M4"><bpmn:incoming>OP03_Flow6</bpmn:incoming><bpmn:incoming>OP03_Flow22</bpmn:incoming><bpmn:outgoing>OP03_Flow30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="OP03_F2" name="Reclamação passada ao tratamento de reclamações"><bpmn:incoming>OP03_Flow30</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="OP03_E2_T7" name="Responder ao cliente e confirmar que resolveu"><bpmn:documentation>Etapa 2: Resolver e responder ao cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP03_Flow23</bpmn:incoming><bpmn:outgoing>OP03_Flow24</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="OP03_E3_T1" name="Registrar o atendimento, o tempo, a causa e a avaliação do cliente"><bpmn:documentation>Etapa 3: Registrar o atendimento e o que ele ensina. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP03_Flow24</bpmn:incoming><bpmn:outgoing>OP03_Flow25</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="OP03_E3_T2" name="Apontar sinais de ampliação e de risco de perda e o conteúdo que faltou na base"><bpmn:documentation>Etapa 3: Registrar o atendimento e o que ele ensina. Executor: Agente de Operações (Operações · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP03_Flow25</bpmn:incoming><bpmn:outgoing>OP03_Flow26</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="OP03_F1" name="Contato resolvido, respondido e registrado"><bpmn:incoming>OP03_Flow26</bpmn:incoming></bpmn:endEvent>
