    <bpmn:sequenceFlow id="OP01_Flow12" name="Sim" sourceRef="OP01_E3_G1" targetRef="OP01_E3_T1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="OP01_Flow13" name="Não" sourceRef="OP01_E3_G1" targetRef="OP01_M3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="OP01_Flow14" sourceRef="OP01_E3_T1" targetRef="OP01_M3" />
    <bpmn:sequenceFlow id="OP01_Flow15" sourceRef="OP01_E3_T2" targetRef="OP01_E3_T3" />
    <bpmn:sequenceFlow id="OP01_Flow16" sourceRef="OP01_E3_T3" targetRef="OP01_F1" />
