    <bpmn:sequenceFlow id="OP01_Flow9" name="Sim" sourceRef="OP01_E2_G1" targetRef="OP01_M2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression></bpmn:sequenceFlow>
