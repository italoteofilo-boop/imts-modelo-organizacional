        <bpmn:flowNodeRef>OP04_E4_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP04_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OP04_S1" name="Reclamação aberta no atendimento ou na entrega"><bpmn:outgoing>OP04_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="OP04_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="OP04_S2" name="Reclamação ou incidente recebido de outro canal"><bpmn:outgoing>OP04_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="OP04_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="OP04_M1"><bpmn:incoming>OP04_Flow1</bpmn:incoming><bpmn:incoming>OP04_Flow2</bpmn:incoming><bpmn:outgoing>OP04_Flow37</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP04_E1_T1" name="Registrar a reclamação ou o incidente, o cliente, o contrato e o prazo de resposta"><bpmn:documentation>Etapa 1: Receber e classificar a reclamação. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow37</bpmn:incoming><bpmn:outgoing>OP04_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="OP04_E1_T2" name="Classificar a gravidade, o risco legal e quem deve resolver"><bpmn:documentation>Etapa 1: Receber e classificar a reclamação. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow3</bpmn:incoming><bpmn:outgoing>OP04_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="OP04_E1_T3" name="Conferir a classificação de gravidade e de risco legal"><bpmn:documentation>Etapa 1: Receber e classificar a reclamação. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow4</bpmn:incoming><bpmn:outgoing>OP04_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP04_E1_G1" name="Há risco à saúde ou à segurança, ou dever de comunicar a autoridade?"><bpmn:incoming>OP04_Flow5</bpmn:incoming><bpmn:outgoing>OP04_Flow6</bpmn:outgoing><bpmn:outgoing>OP04_Flow7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="OP04_E1_T4" name="Avaliar o risco e o dever de comunicar a autoridade"><bpmn:documentation>Etapa 1: Receber e classificar a reclamação. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow6</bpmn:incoming><bpmn:outgoing>OP04_Flow8</bpmn:outgoing></bpmn:task>
