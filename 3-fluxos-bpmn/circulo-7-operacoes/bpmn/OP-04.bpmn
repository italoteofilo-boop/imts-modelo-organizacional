    <bpmn:exclusiveGateway id="OP04_E2_G2" name="A reclamação procede?"><bpmn:incoming>OP04_Flow40</bpmn:incoming><bpmn:outgoing>OP04_Flow17</bpmn:outgoing><bpmn:outgoing>OP04_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP04_E2_T6" name="Responder ao cliente por escrito com o motivo da improcedência"><bpmn:documentation>Etapa 2: Investigar e decidir a solução. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow18</bpmn:incoming><bpmn:outgoing>OP04_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="OP04_E3_T1" name="Aplicar a solução: refazer ou corrigir a entrega, ou pedir o crédito ou o reembolso"><bpmn:documentation>Etapa 3: Aplicar a solução e confirmar com o cliente. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow17</bpmn:incoming><bpmn:outgoing>OP04_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="OP04_E3_T2" name="Responder ao cliente por escrito com a solução"><bpmn:documentation>Etapa 3: Aplicar a solução e confirmar com o cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow20</bpmn:incoming><bpmn:outgoing>OP04_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="OP04_E3_G1" name="O cliente aceitou a solução?"><bpmn:incoming>OP04_Flow21</bpmn:incoming><bpmn:outgoing>OP04_Flow22</bpmn:outgoing><bpmn:outgoing>OP04_Flow23</bpmn:outgoing><bpmn:outgoing>OP04_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OP04_E3_T3" name="Registrar a objeção do cliente e rever a solução"><bpmn:documentation>Etapa 3: Aplicar a solução e confirmar com o cliente. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow23</bpmn:incoming><bpmn:outgoing>OP04_Flow24</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="OP04_E3_T4" name="Encerrar a reclamação e informar ao cliente onde mais pode recorrer"><bpmn:documentation>Etapa 3: Aplicar a solução e confirmar com o cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow25</bpmn:incoming><bpmn:outgoing>OP04_Flow26</bpmn:outgoing></bpmn:scriptTask>
