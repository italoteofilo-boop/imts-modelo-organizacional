    <bpmn:serviceTask id="OP04_E2_T1" name="Investigar o fato e achar a causa provável"><bpmn:documentation>Etapa 2: Investigar e decidir a solução. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow39</bpmn:incoming><bpmn:outgoing>OP04_Flow10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="OP04_E2_T2" name="Propor a solução e, se o cliente é consumidor, as alternativas da lei"><bpmn:documentation>Etapa 2: Investigar e decidir a solução. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow10</bpmn:incoming><bpmn:outgoing>OP04_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="OP04_E2_T3" name="Conferir a solução proposta e a alçada que ela pede"><bpmn:documentation>Etapa 2: Investigar e decidir a solução. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow11</bpmn:incoming><bpmn:outgoing>OP04_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP04_E2_G1" name="A solução cabe na alçada de Operações?"><bpmn:incoming>OP04_Flow12</bpmn:incoming><bpmn:outgoing>OP04_Flow13</bpmn:outgoing><bpmn:outgoing>OP04_Flow14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="OP04_E2_T4" name="Decidir a solução da reclamação"><bpmn:documentation>Etapa 2: Investigar e decidir a solução. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow13</bpmn:incoming><bpmn:outgoing>OP04_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="OP04_E2_T5" name="Decidir a solução acima da alçada de Operações"><bpmn:documentation>Etapa 2: Investigar e decidir a solução. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP04_Flow14</bpmn:incoming><bpmn:outgoing>OP04_Flow16</bpmn:outgoing></bpmn:userTask>
