<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OP02" targetNamespace="urn:imts:modelo:circulo7-operacoes" exporter="Ecossistema IMTS - fonte única do Círculo 7" exporterVersion="2026-10-01">
  <bpmn:category id="Category_OP02">
    <bpmn:categoryValue id="CV_OP02_E1" value="1. Assumir o cliente e planejar a entrega" />
    <bpmn:categoryValue id="CV_OP02_E2" value="2. Executar as entregas do ciclo" />
    <bpmn:categoryValue id="CV_OP02_E3" value="3. Confirmar a entrega com o cliente e passar a faturar" />
    <bpmn:categoryValue id="CV_OP02_E4" value="4. Registrar o ciclo e apontar o que ensina" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_OP02">
    <bpmn:participant id="Participant_OP02" name="OP-02 · Entregar o serviço a cada cliente, ciclo a ciclo" processRef="Process_OP02" />
    <bpmn:group id="Group_OP02_E1" categoryValueRef="CV_OP02_E1" />
    <bpmn:group id="Group_OP02_E2" categoryValueRef="CV_OP02_E2" />
    <bpmn:group id="Group_OP02_E3" categoryValueRef="CV_OP02_E3" />
    <bpmn:group id="Group_OP02_E4" categoryValueRef="CV_OP02_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OP02" name="Entregar o serviço a cada cliente, ciclo a ciclo" isExecutable="false">
    <bpmn:documentation>Fazer cada cliente implantado ter um plano de entrega com escopo, nível de serviço, equipe, agentes e contatos; cada entrega feita pelo método da oferta, conferida contra o escopo e o padrão e aceita pelo cliente; cada ciclo confirmado conforme o contrato, com a medição dos níveis de serviço, e passado à Gestão para faturar; cada impasse sobre a entrega virar reclamação tratada; e cada plano de recuperação de Relações virar ajuste do plano de entrega. Operações entrega; o cliente aceita; a Gestão fatura.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_OP02">
      <bpmn:lane id="Lane_OP02_ITG" name="Integração">
        <bpmn:flowNodeRef>OP02_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP02_REL" name="Relações">
        <bpmn:flowNodeRef>OP02_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP02_CLI" name="Cliente">
        <bpmn:flowNodeRef>OP02_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP02_OPP" name="Operações · pessoa">
        <bpmn:flowNodeRef>OP02_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E2_PJ1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP02_OPA" name="Operações · agente">
        <bpmn:flowNodeRef>OP02_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E2_PS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E4_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP02_OPR" name="Operações · automação">
        <bpmn:flowNodeRef>OP02_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP02_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OP02_S1" name="Cliente implantado recebido"><bpmn:outgoing>OP02_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="OP02_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="OP02_S2" name="Plano de recuperação do cliente recebido"><bpmn:outgoing>OP02_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="OP02_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="OP02_S3" name="Ciclo de entrega do cliente iniciado"><bpmn:outgoing>OP02_Flow3</bpmn:outgoing><bpmn:timerEventDefinition id="OP02_S3_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="OP02_M1"><bpmn:incoming>OP02_Flow1</bpmn:incoming><bpmn:incoming>OP02_Flow2</bpmn:incoming><bpmn:incoming>OP02_Flow3</bpmn:incoming><bpmn:outgoing>OP02_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="OP02_E1_G1" name="O que iniciou a entrega?"><bpmn:incoming>OP02_Flow28</bpmn:incoming><bpmn:outgoing>OP02_Flow4</bpmn:outgoing><bpmn:outgoing>OP02_Flow5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OP02_E1_T1" name="Conferir o escopo vendido, os termos e o nível de serviço do contrato"><bpmn:documentation>Etapa 1: Assumir o cliente e planejar a entrega. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow5</bpmn:incoming><bpmn:outgoing>OP02_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="OP02_E1_T2" name="Montar ou ajustar o plano de entrega: entregas, nível de serviço, equipe, agentes e contatos"><bpmn:documentation>Etapa 1: Assumir o cliente e planejar a entrega. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow6</bpmn:incoming><bpmn:outgoing>OP02_Flow7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="OP02_E1_T3" name="Aprovar o plano de entrega e designar o responsável pelo cliente"><bpmn:documentation>Etapa 1: Assumir o cliente e planejar a entrega. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow7</bpmn:incoming><bpmn:outgoing>OP02_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP02_M2"><bpmn:incoming>OP02_Flow4</bpmn:incoming><bpmn:incoming>OP02_Flow8</bpmn:incoming><bpmn:incoming>OP02_Flow18</bpmn:incoming><bpmn:incoming>OP02_Flow21</bpmn:incoming><bpmn:outgoing>OP02_Flow29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OP02_E2_T1" name="Programar as entregas do ciclo e alocar pessoas, agentes e parceiros"><bpmn:documentation>Etapa 2: Executar as entregas do ciclo. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow29</bpmn:incoming><bpmn:outgoing>OP02_Flow9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="OP02_E2_PS1"><bpmn:incoming>OP02_Flow9</bpmn:incoming><bpmn:outgoing>OP02_Flow10</bpmn:outgoing><bpmn:outgoing>OP02_Flow12</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="OP02_E2_T2" name="Executar as entregas feitas por agentes e automações"><bpmn:documentation>Etapa 2: Executar as entregas do ciclo. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow10</bpmn:incoming><bpmn:outgoing>OP02_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="OP02_E2_T3" name="Executar as entregas feitas por pessoas"><bpmn:documentation>Etapa 2: Executar as entregas do ciclo. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow12</bpmn:incoming><bpmn:outgoing>OP02_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:parallelGateway id="OP02_E2_PJ1"><bpmn:incoming>OP02_Flow11</bpmn:incoming><bpmn:incoming>OP02_Flow13</bpmn:incoming><bpmn:outgoing>OP02_Flow14</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:serviceTask id="OP02_E2_T4" name="Conferir cada entrega contra o escopo e o padrão de qualidade"><bpmn:documentation>Etapa 2: Executar as entregas do ciclo. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow14</bpmn:incoming><bpmn:outgoing>OP02_Flow15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OP02_E2_G1" name="A entrega passou na conferência?"><bpmn:incoming>OP02_Flow15</bpmn:incoming><bpmn:outgoing>OP02_Flow16</bpmn:outgoing><bpmn:outgoing>OP02_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="OP02_E2_T5" name="Corrigir a entrega e registrar a não conformidade"><bpmn:documentation>Etapa 2: Executar as entregas do ciclo. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow17</bpmn:incoming><bpmn:outgoing>OP02_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="OP02_E3_T1" name="Aceitar as entregas do ciclo"><bpmn:documentation>Etapa 3: Confirmar a entrega com o cliente e passar a faturar. Executor: Pessoa de fora do círculo (Cliente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow16</bpmn:incoming><bpmn:outgoing>OP02_Flow19</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP02_E3_G1" name="O cliente aceitou as entregas?"><bpmn:incoming>OP02_Flow19</bpmn:incoming><bpmn:outgoing>OP02_Flow20</bpmn:outgoing><bpmn:outgoing>OP02_Flow22</bpmn:outgoing><bpmn:outgoing>OP02_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OP02_E3_T2" name="Registrar o motivo da recusa e replanejar a entrega"><bpmn:documentation>Etapa 3: Confirmar a entrega com o cliente e passar a faturar. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow20</bpmn:incoming><bpmn:outgoing>OP02_Flow21</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="OP02_E3_T3" name="Abrir a reclamação sobre a entrega não aceita"><bpmn:documentation>Etapa 3: Confirmar a entrega com o cliente e passar a faturar. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow22</bpmn:incoming><bpmn:outgoing>OP02_Flow23</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="OP02_E3_T4" name="Confirmar a entrega conforme os termos do contrato e medir os níveis de serviço do ciclo"><bpmn:documentation>Etapa 3: Confirmar a entrega com o cliente e passar a faturar. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP02_Flow24</bpmn:incoming><bpmn:outgoing>OP02_Flow25</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="OP02_M3"><bpmn:incoming>OP02_Flow23</bpmn:incoming><bpmn:incoming>OP02_Flow25</bpmn:incoming><bpmn:outgoing>OP02_Flow30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP02_E4_T1" name="Registrar entregas, prazos, não conformidades e esforço do ciclo"><bpmn:documentation>Etapa 4: Registrar o ciclo e apontar o que ensina. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP02_Flow30</bpmn:incoming><bpmn:outgoing>OP02_Flow26</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="OP02_E4_T2" name="Apontar a lição do ciclo e os sinais de ampliação ou de risco do cliente"><bpmn:documentation>Etapa 4: Registrar o ciclo e apontar o que ensina. Executor: Agente de Operações (Operações · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP02_Flow26</bpmn:incoming><bpmn:outgoing>OP02_Flow27</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="OP02_F1" name="Ciclo de entrega confirmado, passado a faturar e registrado"><bpmn:incoming>OP02_Flow27</bpmn:incoming></bpmn:endEvent>
