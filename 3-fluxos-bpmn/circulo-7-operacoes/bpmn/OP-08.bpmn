<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OP08" targetNamespace="urn:imts:modelo:circulo7-operacoes" exporter="Ecossistema IMTS - fonte única do Círculo 7" exporterVersion="2026-10-01">
  <bpmn:category id="Category_OP08">
    <bpmn:categoryValue id="CV_OP08_E1" value="1. Planejar o fim das entregas" />
    <bpmn:categoryValue id="CV_OP08_E2" value="2. Concluir as entregas e devolver o que é do cliente" />
    <bpmn:categoryValue id="CV_OP08_E3" value="3. Liberar os recursos e guardar o conhecimento" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_OP08">
    <bpmn:participant id="Participant_OP08" name="OP-08 · Encerrar as entregas no fim do contrato ou na saída da oferta ou da empresa" processRef="Process_OP08" />
    <bpmn:group id="Group_OP08_E1" categoryValueRef="CV_OP08_E1" />
    <bpmn:group id="Group_OP08_E2" categoryValueRef="CV_OP08_E2" />
    <bpmn:group id="Group_OP08_E3" categoryValueRef="CV_OP08_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OP08" name="Encerrar as entregas no fim do contrato ou na saída da oferta ou da empresa" isExecutable="false">
    <bpmn:documentation>Fazer cada contrato encerrado e cada saída de oferta ou de empresa virar um fim de entregas planejado: no fim do contrato, de imediato; na saída, preparado pelo plano de saída da Integração e executado na data confirmada pela Estratégia. As entregas são concluídas ou transferidas na transição combinada por Relações; o último ciclo é passado a faturar; os dados e materiais do cliente são devolvidos ou eliminados, com aprovação de pessoa, guardado só o que a lei ou o contrato mandam guardar; os recursos são liberados à Gestão; e a conclusão vai à Integração e as lições à Inteligência.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_OP08">
      <bpmn:lane id="Lane_OP08_NEG" name="Negócios">
        <bpmn:flowNodeRef>OP08_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP08_ITG" name="Integração">
        <bpmn:flowNodeRef>OP08_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP08_EST" name="Estratégia">
        <bpmn:flowNodeRef>OP08_S3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP08_CLI" name="Cliente">
        <bpmn:flowNodeRef>OP08_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP08_OPP" name="Operações · pessoa">
        <bpmn:flowNodeRef>OP08_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP08_OPA" name="Operações · agente">
        <bpmn:flowNodeRef>OP08_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E3_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP08_OPR" name="Operações · automação">
        <bpmn:flowNodeRef>OP08_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP08_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OP08_S1" name="Contrato encerrado recebido"><bpmn:outgoing>OP08_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="OP08_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="OP08_S2" name="Plano de saída de clientes e contratos recebido"><bpmn:outgoing>OP08_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="OP08_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="OP08_S3" name="Data de saída ou mandato recebido"><bpmn:outgoing>OP08_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="OP08_S3_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="OP08_M1"><bpmn:incoming>OP08_Flow1</bpmn:incoming><bpmn:incoming>OP08_Flow2</bpmn:incoming><bpmn:incoming>OP08_Flow3</bpmn:incoming><bpmn:outgoing>OP08_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="OP08_E1_G1" name="O que iniciou o encerramento?"><bpmn:incoming>OP08_Flow20</bpmn:incoming><bpmn:outgoing>OP08_Flow4</bpmn:outgoing><bpmn:outgoing>OP08_Flow6</bpmn:outgoing><bpmn:outgoing>OP08_Flow8</bpmn:outgoing><bpmn:outgoing>OP08_Flow9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OP08_E1_T1" name="Preparar o fim das entregas pelo plano e aguardar a data de saída"><bpmn:documentation>Etapa 1: Planejar o fim das entregas. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP08_Flow4</bpmn:incoming><bpmn:outgoing>OP08_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="OP08_E1_T2" name="Registrar a decisão e aguardar o plano de saída da Integração"><bpmn:documentation>Etapa 1: Planejar o fim das entregas. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP08_Flow6</bpmn:incoming><bpmn:outgoing>OP08_Flow7</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="OP08_M2"><bpmn:incoming>OP08_Flow5</bpmn:incoming><bpmn:incoming>OP08_Flow7</bpmn:incoming><bpmn:outgoing>OP08_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="OP08_F2" name="Fim das entregas preparado, à espera da data ou do plano de saída"><bpmn:incoming>OP08_Flow21</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="OP08_M3"><bpmn:incoming>OP08_Flow8</bpmn:incoming><bpmn:incoming>OP08_Flow9</bpmn:incoming><bpmn:outgoing>OP08_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OP08_E1_T3" name="Listar as entregas em curso, os compromissos e os dados e materiais do cliente"><bpmn:documentation>Etapa 1: Planejar o fim das entregas. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP08_Flow22</bpmn:incoming><bpmn:outgoing>OP08_Flow10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="OP08_E1_T4" name="Planejar o fim, a transição combinada e o destino de dados e materiais"><bpmn:documentation>Etapa 1: Planejar o fim das entregas. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP08_Flow10</bpmn:incoming><bpmn:outgoing>OP08_Flow11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="OP08_E2_T1" name="Concluir ou transferir as entregas em curso conforme o plano"><bpmn:documentation>Etapa 2: Concluir as entregas e devolver o que é do cliente. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>OP08_Flow11</bpmn:incoming><bpmn:outgoing>OP08_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="OP08_E2_T2" name="Aprovar o que devolver, o que eliminar e o que a lei ou o contrato mandam guardar"><bpmn:documentation>Etapa 2: Concluir as entregas e devolver o que é do cliente. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>OP08_Flow12</bpmn:incoming><bpmn:outgoing>OP08_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="OP08_E2_T3" name="Devolver ou eliminar os dados e materiais do cliente como aprovado"><bpmn:documentation>Etapa 2: Concluir as entregas e devolver o que é do cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>OP08_Flow13</bpmn:incoming><bpmn:outgoing>OP08_Flow14</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="OP08_E2_T4" name="Confirmar o fim das entregas"><bpmn:documentation>Etapa 2: Concluir as entregas e devolver o que é do cliente. Executor: Pessoa de fora do círculo (Cliente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>OP08_Flow14</bpmn:incoming><bpmn:outgoing>OP08_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="OP08_E3_T1" name="Passar o último ciclo a faturar"><bpmn:documentation>Etapa 3: Liberar os recursos e guardar o conhecimento. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP08_Flow15</bpmn:incoming><bpmn:outgoing>OP08_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="OP08_E3_T2" name="Registrar a liberação de pessoas, agentes, parceiros e ativos alocados ao cliente ou à oferta"><bpmn:documentation>Etapa 3: Liberar os recursos e guardar o conhecimento. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP08_Flow16</bpmn:incoming><bpmn:outgoing>OP08_Flow17</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="OP08_E3_T3" name="Arquivar os registros que devem ser guardados e atualizar os sistemas"><bpmn:documentation>Etapa 3: Liberar os recursos e guardar o conhecimento. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP08_Flow17</bpmn:incoming><bpmn:outgoing>OP08_Flow18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="OP08_E3_T4" name="Apontar as lições do encerramento"><bpmn:documentation>Etapa 3: Liberar os recursos e guardar o conhecimento. Executor: Agente de Operações (Operações · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP08_Flow18</bpmn:incoming><bpmn:outgoing>OP08_Flow19</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="OP08_F1" name="Entregas encerradas e recursos liberados"><bpmn:incoming>OP08_Flow19</bpmn:incoming></bpmn:endEvent>
