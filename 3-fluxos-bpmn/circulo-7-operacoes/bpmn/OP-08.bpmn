    <bpmn:sequenceFlow id="OP08_Flow9" name="Data de saída ou mandato, com o plano de saída já recebido" sourceRef="OP08_E1_G1" targetRef="OP08_M3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Data de saída ou mandato, com o plano de saída já recebido</bpmn:conditionExpression></bpmn:sequenceFlow>
