    <bpmn:scriptTask id="OP07_E3_T7" name="Registrar a decisão e o motivo"><bpmn:documentation>Etapa 3: Comunicar o risco e decidir o recall. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>OP07_Flow32</bpmn:incoming><bpmn:outgoing>OP07_Flow33</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="OP07_E4_T1" name="Acompanhar os produtos recolhidos e os clientes atendidos"><bpmn:documentation>Etapa 4: Acompanhar a eficácia do recall e encerrá-lo. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>OP07_Flow31</bpmn:incoming><bpmn:outgoing>OP07_Flow34</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="OP07_E4_T2" name="Enviar à autoridade os relatórios do recall"><bpmn:documentation>Etapa 4: Acompanhar a eficácia do recall e encerrá-lo. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>OP07_Flow34</bpmn:incoming><bpmn:outgoing>OP07_Flow35</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="OP07_E4_T3" name="Avaliar a eficácia e decidir o encerramento do recall"><bpmn:documentation>Etapa 4: Acompanhar a eficácia do recall e encerrá-lo. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>OP07_Flow35</bpmn:incoming><bpmn:outgoing>OP07_Flow36</bpmn:outgoing></bpmn:userTask>
