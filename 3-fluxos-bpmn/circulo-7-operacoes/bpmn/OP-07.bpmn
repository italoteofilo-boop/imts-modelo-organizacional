    <bpmn:serviceTask id="OP07_E3_T1" name="Avaliar a probabilidade e a consequência do risco e os lotes afetados"><bpmn:documentation>Etapa 3: Comunicar o risco e decidir o recall. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>OP07_Flow48</bpmn:incoming><bpmn:outgoing>OP07_Flow25</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="OP07_E3_T2" name="Comunicar o risco à autoridade competente"><bpmn:documentation>Etapa 3: Comunicar o risco e decidir o recall. Executor: Outro círculo (Governança). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>OP07_Flow25</bpmn:incoming><bpmn:outgoing>OP07_Flow26</bpmn:outgoing></bpmn:task>
    <bpmn:scriptTask id="OP07_E3_T3" name="Pedir a Relações a comunicação aos consumidores"><bpmn:documentation>Etapa 3: Comunicar o risco e decidir o recall. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>OP07_Flow26</bpmn:incoming><bpmn:outgoing>OP07_Flow27</bpmn:outgoing></bpmn:scriptTask>
