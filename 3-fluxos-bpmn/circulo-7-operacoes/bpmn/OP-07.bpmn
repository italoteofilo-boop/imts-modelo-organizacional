    <bpmn:scriptTask id="OP07_E1_T1" name="Registrar o pedido, o produto, o lote e a data de entrega"><bpmn:documentation>Etapa 1: Receber o pedido e avaliar o risco. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP07_Flow4</bpmn:incoming><bpmn:outgoing>OP07_Flow5</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="OP07_E1_T2" name="Triar o relato e apontar os sinais de risco à saúde ou à segurança"><bpmn:documentation>Etapa 1: Receber o pedido e avaliar o risco. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP07_Flow5</bpmn:incoming><bpmn:outgoing>OP07_Flow6</bpmn:outgoing></bpmn:serviceTask>
