    <bpmn:userTask id="OP07_E3_T5" name="Decidir o recall"><bpmn:documentation>Etapa 3: Comunicar o risco e decidir o recall. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>OP07_Flow28</bpmn:incoming><bpmn:outgoing>OP07_Flow29</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP07_E3_G1" name="O recall foi decidido?"><bpmn:incoming>OP07_Flow29</bpmn:incoming><bpmn:outgoing>OP07_Flow30</bpmn:outgoing><bpmn:outgoing>OP07_Flow32</bpmn:outgoing></bpmn:exclusiveGateway>
