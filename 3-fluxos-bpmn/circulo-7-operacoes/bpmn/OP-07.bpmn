    <bpmn:exclusiveGateway id="OP07_E1_G2" name="O defeito relatado pode pôr em risco a saúde ou a segurança?"><bpmn:incoming>OP07_Flow7</bpmn:incoming><bpmn:outgoing>OP07_Flow8</bpmn:outgoing><bpmn:outgoing>OP07_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP07_E1_T4" name="Levar o caso à avaliação de recall"><bpmn:documentation>Etapa 1: Receber o pedido e avaliar o risco. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP07_Flow8</bpmn:incoming><bpmn:outgoing>OP07_Flow9</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="OP07_E1_T5" name="Conferir o pedido contra os termos e os prazos legais, pelo tipo de vício: aparente ou oculto"><bpmn:documentation>Etapa 1: Receber o pedido e avaliar o risco. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP07_Flow10</bpmn:incoming><bpmn:outgoing>OP07_Flow11</bpmn:outgoing></bpmn:serviceTask>
