<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_OP06" targetNamespace="urn:imts:modelo:circulo7-operacoes" exporter="Ecossistema IMTS - fonte única do Círculo 7" exporterVersion="2026-10-01">
  <bpmn:category id="Category_OP06">
    <bpmn:categoryValue id="CV_OP06_E1" value="1. Prever a demanda e planejar materiais e produção" />
    <bpmn:categoryValue id="CV_OP06_E2" value="2. Pedir e receber os materiais e serviços" />
    <bpmn:categoryValue id="CV_OP06_E3" value="3. Produzir ou montar o produto e testá-lo" />
    <bpmn:categoryValue id="CV_OP06_E4" value="4. Guardar o produto e entregá-lo ao cliente" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_OP06">
    <bpmn:participant id="Participant_OP06" name="OP-06 · Abastecer e entregar o produto físico: demanda, materiais, produção, estoque e transporte" processRef="Process_OP06" />
    <bpmn:group id="Group_OP06_E1" categoryValueRef="CV_OP06_E1" />
    <bpmn:group id="Group_OP06_E2" categoryValueRef="CV_OP06_E2" />
    <bpmn:group id="Group_OP06_E3" categoryValueRef="CV_OP06_E3" />
    <bpmn:group id="Group_OP06_E4" categoryValueRef="CV_OP06_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_OP06" name="Abastecer e entregar o produto físico: demanda, materiais, produção, estoque e transporte" isExecutable="false">
    <bpmn:documentation>Onde a oferta tem produto físico, fazer a previsão de vendas e os contratos virarem plano de produção e de materiais; cada material ser pedido à Gestão, recebido e inspecionado, e o não conforme recusado e reposto; cada produto ser produzido ou montado, testado pelo procedimento padrão e registrado por lote; cada defeito com risco à saúde ou à segurança ir ao pós-venda; e cada pedido ser guardado, expedido, transportado, recebido pelo cliente e passado à Gestão para faturar. Operações planeja, produz e entrega; a Gestão compra.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_OP06">
      <bpmn:lane id="Lane_OP06_NEG" name="Negócios">
        <bpmn:flowNodeRef>OP06_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP06_GES" name="Gestão">
        <bpmn:flowNodeRef>OP06_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP06_CLI" name="Cliente">
        <bpmn:flowNodeRef>OP06_E4_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP06_OPP" name="Operações · pessoa">
        <bpmn:flowNodeRef>OP06_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E4_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP06_OPA" name="Operações · agente">
        <bpmn:flowNodeRef>OP06_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E4_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP06_OPR" name="Operações · automação">
        <bpmn:flowNodeRef>OP06_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E3_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_E4_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP06_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="OP06_S1" name="Ciclo de planejamento de suprimentos iniciado"><bpmn:outgoing>OP06_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="OP06_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="OP06_S2" name="Contrato com produto assinado"><bpmn:outgoing>OP06_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="OP06_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="OP06_M1"><bpmn:incoming>OP06_Flow1</bpmn:incoming><bpmn:incoming>OP06_Flow2</bpmn:incoming><bpmn:outgoing>OP06_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OP06_E1_T1" name="Montar a previsão de demanda por produto e conferir com a previsão de vendas e os contratos"><bpmn:documentation>Etapa 1: Prever a demanda e planejar materiais e produção. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow25</bpmn:incoming><bpmn:outgoing>OP06_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="OP06_E1_T2" name="Calcular a necessidade de materiais e a capacidade de produção e de estoque"><bpmn:documentation>Etapa 1: Prever a demanda e planejar materiais e produção. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow3</bpmn:incoming><bpmn:outgoing>OP06_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="OP06_E1_T3" name="Decidir o plano de produção e de materiais do ciclo"><bpmn:documentation>Etapa 1: Prever a demanda e planejar materiais e produção. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow4</bpmn:incoming><bpmn:outgoing>OP06_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP06_M2"><bpmn:incoming>OP06_Flow5</bpmn:incoming><bpmn:incoming>OP06_Flow11</bpmn:incoming><bpmn:outgoing>OP06_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP06_E2_T1" name="Pedir à Gestão a compra dos materiais e serviços do plano"><bpmn:documentation>Etapa 2: Pedir e receber os materiais e serviços. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow26</bpmn:incoming><bpmn:outgoing>OP06_Flow6</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:task id="OP06_E2_T2" name="Fazer a compra e informar a data de entrega"><bpmn:documentation>Etapa 2: Pedir e receber os materiais e serviços. Executor: Outro círculo (Gestão). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow6</bpmn:incoming><bpmn:outgoing>OP06_Flow7</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="OP06_E2_T3" name="Receber e inspecionar os materiais e guardá-los"><bpmn:documentation>Etapa 2: Pedir e receber os materiais e serviços. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow7</bpmn:incoming><bpmn:outgoing>OP06_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP06_E2_G1" name="O material recebido está conforme?"><bpmn:incoming>OP06_Flow8</bpmn:incoming><bpmn:outgoing>OP06_Flow9</bpmn:outgoing><bpmn:outgoing>OP06_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP06_E2_T4" name="Recusar o material, registrar a falha do fornecedor e pedir a reposição"><bpmn:documentation>Etapa 2: Pedir e receber os materiais e serviços. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow10</bpmn:incoming><bpmn:outgoing>OP06_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="OP06_M3"><bpmn:incoming>OP06_Flow9</bpmn:incoming><bpmn:incoming>OP06_Flow17</bpmn:incoming><bpmn:incoming>OP06_Flow19</bpmn:incoming><bpmn:outgoing>OP06_Flow27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP06_E3_T1" name="Programar a produção e liberar as ordens por lote"><bpmn:documentation>Etapa 3: Produzir ou montar o produto e testá-lo. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow27</bpmn:incoming><bpmn:outgoing>OP06_Flow12</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="OP06_E3_T2" name="Produzir ou montar o produto"><bpmn:documentation>Etapa 3: Produzir ou montar o produto e testá-lo. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow12</bpmn:incoming><bpmn:outgoing>OP06_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="OP06_E3_T3" name="Testar o produto pelo procedimento padrão e registrar o resultado"><bpmn:documentation>Etapa 3: Produzir ou montar o produto e testá-lo. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow13</bpmn:incoming><bpmn:outgoing>OP06_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OP06_E3_G1" name="O produto passou no teste?"><bpmn:incoming>OP06_Flow14</bpmn:incoming><bpmn:outgoing>OP06_Flow15</bpmn:outgoing><bpmn:outgoing>OP06_Flow16</bpmn:outgoing><bpmn:outgoing>OP06_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="OP06_E3_T4" name="Separar o item, refazer ou descartar e registrar a não conformidade"><bpmn:documentation>Etapa 3: Produzir ou montar o produto e testá-lo. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow16</bpmn:incoming><bpmn:outgoing>OP06_Flow17</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="OP06_E3_T5" name="Bloquear o lote e levar o defeito ao pós-venda"><bpmn:documentation>Etapa 3: Produzir ou montar o produto e testá-lo. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow18</bpmn:incoming><bpmn:outgoing>OP06_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="OP06_E4_T1" name="Guardar o produto e controlar o estoque"><bpmn:documentation>Etapa 4: Guardar o produto e entregá-lo ao cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow15</bpmn:incoming><bpmn:outgoing>OP06_Flow20</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="OP06_E4_T2" name="Preparar e expedir o pedido"><bpmn:documentation>Etapa 4: Guardar o produto e entregá-lo ao cliente. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow20</bpmn:incoming><bpmn:outgoing>OP06_Flow21</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="OP06_E4_T3" name="Acompanhar o transporte até a entrega"><bpmn:documentation>Etapa 4: Guardar o produto e entregá-lo ao cliente. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow21</bpmn:incoming><bpmn:outgoing>OP06_Flow22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="OP06_E4_T4" name="Confirmar o recebimento do produto"><bpmn:documentation>Etapa 4: Guardar o produto e entregá-lo ao cliente. Executor: Pessoa de fora do círculo (Cliente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow22</bpmn:incoming><bpmn:outgoing>OP06_Flow23</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="OP06_E4_T5" name="Registrar a entrega, o lote e o prazo cumprido e passar a faturar"><bpmn:documentation>Etapa 4: Guardar o produto e entregá-lo ao cliente. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP06_Flow23</bpmn:incoming><bpmn:outgoing>OP06_Flow24</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="OP06_F1" name="Produto entregue, passado a faturar e registrado"><bpmn:incoming>OP06_Flow24</bpmn:incoming></bpmn:endEvent>
