        <bpmn:flowNodeRef>OP05_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP05_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OP05_E4_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OP05_OPR" name="Operações · automação">
