    <bpmn:serviceTask id="OP05_E3_T1" name="Analisar a causa raiz da não conformidade ou da lacuna"><bpmn:documentation>Etapa 3: Achar a causa e decidir a ação corretiva. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP05_Flow32</bpmn:incoming><bpmn:outgoing>OP05_Flow17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="OP05_E3_T2" name="Propor a ação corretiva, com dono, prazo e ganho esperado"><bpmn:documentation>Etapa 3: Achar a causa e decidir a ação corretiva. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP05_Flow17</bpmn:incoming><bpmn:outgoing>OP05_Flow18</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="OP05_E3_T3" name="Decidir a ação corretiva"><bpmn:documentation>Etapa 3: Achar a causa e decidir a ação corretiva. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP05_Flow18</bpmn:incoming><bpmn:outgoing>OP05_Flow19</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP05_E3_G1" name="A ação pede capacidade, agente ou ajuste da oferta?"><bpmn:incoming>OP05_Flow19</bpmn:incoming><bpmn:outgoing>OP05_Flow20</bpmn:outgoing><bpmn:outgoing>OP05_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP05_E3_T4" name="Pedir a capacidade ou o agente à Integração, ou o ajuste da oferta à Inteligência"><bpmn:documentation>Etapa 3: Achar a causa e decidir a ação corretiva. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP05_Flow21</bpmn:incoming><bpmn:outgoing>OP05_Flow22</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="OP05_M4"><bpmn:incoming>OP05_Flow20</bpmn:incoming><bpmn:incoming>OP05_Flow22</bpmn:incoming><bpmn:outgoing>OP05_Flow33</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="OP05_E4_T1" name="Implantar a ação corretiva e treinar quem executa"><bpmn:documentation>Etapa 4: Implantar a ação e conferir o efeito. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP05_Flow33</bpmn:incoming><bpmn:outgoing>OP05_Flow23</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="OP05_E4_T2" name="Medir de novo e conferir se a causa foi eliminada"><bpmn:documentation>Etapa 4: Implantar a ação e conferir o efeito. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP05_Flow23</bpmn:incoming><bpmn:outgoing>OP05_Flow24</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OP05_E4_G1" name="A ação eliminou a causa?"><bpmn:incoming>OP05_Flow24</bpmn:incoming><bpmn:outgoing>OP05_Flow25</bpmn:outgoing><bpmn:outgoing>OP05_Flow27</bpmn:outgoing><bpmn:outgoing>OP05_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP05_E4_T3" name="Registrar a ação e o efeito conferido"><bpmn:documentation>Etapa 4: Implantar a ação e conferir o efeito. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP05_Flow25</bpmn:incoming><bpmn:outgoing>OP05_Flow26</bpmn:outgoing></bpmn:scriptTask>
