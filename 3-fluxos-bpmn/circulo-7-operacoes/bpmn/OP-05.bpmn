    <bpmn:exclusiveGateway id="OP05_E1_G1" name="O que iniciou o trabalho?"><bpmn:incoming>OP05_Flow30</bpmn:incoming><bpmn:outgoing>OP05_Flow4</bpmn:outgoing><bpmn:outgoing>OP05_Flow5</bpmn:outgoing><bpmn:outgoing>OP05_Flow6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="OP05_E1_T1" name="Traduzir os padrões de experiência e o método da oferta em procedimentos e níveis de serviço"><bpmn:documentation>Etapa 1: Definir os procedimentos e os níveis de serviço. Executor: Agente de Operações (Operações · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP05_Flow6</bpmn:incoming><bpmn:outgoing>OP05_Flow7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="OP05_E1_T2" name="Decidir os procedimentos e os níveis de serviço por oferta e por segmento de cliente"><bpmn:documentation>Etapa 1: Definir os procedimentos e os níveis de serviço. Executor: Pessoa de Operações (Operações · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP05_Flow7</bpmn:incoming><bpmn:outgoing>OP05_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="OP05_E1_G2" name="Algum padrão de experiência não pode ser cumprido pela operação?"><bpmn:incoming>OP05_Flow8</bpmn:incoming><bpmn:outgoing>OP05_Flow9</bpmn:outgoing><bpmn:outgoing>OP05_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP05_E1_T3" name="Apontar a Relações a lacuna, com a causa e o que seria preciso"><bpmn:documentation>Etapa 1: Definir os procedimentos e os níveis de serviço. Executor: Automação de Operações (Operações · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>OP05_Flow10</bpmn:incoming><bpmn:outgoing>OP05_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="OP05_M2"><bpmn:incoming>OP05_Flow4</bpmn:incoming><bpmn:incoming>OP05_Flow9</bpmn:incoming><bpmn:incoming>OP05_Flow11</bpmn:incoming><bpmn:outgoing>OP05_Flow31</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP05_E2_T1" name="Medir qualidade, prazos e níveis de serviço por oferta, cliente e equipe"><bpmn:documentation>Etapa 2: Medir a qualidade e o cumprimento dos níveis de serviço. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP05_Flow31</bpmn:incoming><bpmn:outgoing>OP05_Flow12</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="OP05_E2_T2" name="Comparar com os alvos e achar as não conformidades e as tendências"><bpmn:documentation>Etapa 2: Medir a qualidade e o cumprimento dos níveis de serviço. Executor: Agente de Operações (Operações · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP05_Flow12</bpmn:incoming><bpmn:outgoing>OP05_Flow13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="OP05_E2_G1" name="Há não conformidade ou tendência que pede ação?"><bpmn:incoming>OP05_Flow13</bpmn:incoming><bpmn:outgoing>OP05_Flow14</bpmn:outgoing><bpmn:outgoing>OP05_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="OP05_E2_T3" name="Registrar a medida do ciclo"><bpmn:documentation>Etapa 2: Medir a qualidade e o cumprimento dos níveis de serviço. Executor: Automação de Operações (Operações · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>OP05_Flow15</bpmn:incoming><bpmn:outgoing>OP05_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="OP05_F2" name="Qualidade dentro dos níveis de serviço, sem ação"><bpmn:incoming>OP05_Flow16</bpmn:incoming></bpmn:endEvent>
