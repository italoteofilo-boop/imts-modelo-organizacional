  <bpmn:category id="Category_OP05">
    <bpmn:categoryValue id="CV_OP05_E1" value="1. Definir os procedimentos e os níveis de serviço" />
    <bpmn:categoryValue id="CV_OP05_E2" value="2. Medir a qualidade e o cumprimento dos níveis de serviço" />
    <bpmn:categoryValue id="CV_OP05_E3" value="3. Achar a causa e decidir a ação corretiva" />
    <bpmn:categoryValue id="CV_OP05_E4" value="4. Implantar a ação e conferir o efeito" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_OP05">
    <bpmn:participant id="Participant_OP05" name="OP-05 · Garantir a qualidade e os níveis de serviço: padrões, medida e ação corretiva" processRef="Process_OP05" />
    <bpmn:group id="Group_OP05_E1" categoryValueRef="CV_OP05_E1" />
    <bpmn:group id="Group_OP05_E2" categoryValueRef="CV_OP05_E2" />
    <bpmn:group id="Group_OP05_E3" categoryValueRef="CV_OP05_E3" />
