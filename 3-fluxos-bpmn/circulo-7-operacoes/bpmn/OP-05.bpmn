    <bpmn:startEvent id="OP05_S1" name="Ciclo de avaliação da qualidade iniciado"><bpmn:outgoing>OP05_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="OP05_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="OP05_S2" name="Padrão, oferta ou método novo ou mudado recebido"><bpmn:outgoing>OP05_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="OP05_S2_def" /></bpmn:startEvent>
