    <bpmn:startEvent id="ES01_S1" name="Mudança relevante de cenário apontada"><bpmn:outgoing>ES01_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ES01_S1_def" /></bpmn:startEvent>
