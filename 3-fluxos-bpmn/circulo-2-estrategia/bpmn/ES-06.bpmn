        <bpmn:flowNodeRef>ES06_E3_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES06_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES06_E3_G3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES06_E4_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES06_ESA" name="Estratégia · agente">
        <bpmn:flowNodeRef>ES06_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES06_E2_T1</bpmn:flowNodeRef>
