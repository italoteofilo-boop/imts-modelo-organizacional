    <bpmn:exclusiveGateway id="ES06_E2_G2" name="Há correção a fazer?"><bpmn:incoming>ES06_Flow37</bpmn:incoming><bpmn:outgoing>ES06_Flow13</bpmn:outgoing><bpmn:outgoing>ES06_Flow14</bpmn:outgoing></bpmn:exclusiveGateway>
