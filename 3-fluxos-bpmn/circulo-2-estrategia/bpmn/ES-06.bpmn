    <bpmn:startEvent id="ES06_S1" name="Desvio grave apontado pelo ritual"><bpmn:outgoing>ES06_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ES06_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ES06_S2" name="Ciclo de revisão da estratégia iniciado"><bpmn:outgoing>ES06_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="ES06_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="ES06_M1"><bpmn:incoming>ES06_Flow1</bpmn:incoming><bpmn:incoming>ES06_Flow2</bpmn:incoming><bpmn:outgoing>ES06_Flow36</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ES06_E1_T1" name="Reunir no painel único os indicadores, os desvios do ritual e a situação das iniciativas"><bpmn:documentation>Etapa 1: Reunir os resultados contra os alvos e as hipóteses. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES06_Flow36</bpmn:incoming><bpmn:outgoing>ES06_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="ES06_E1_T2" name="Listar os desvios e os sinais que as comparações da Inteligência e da Gestão já apontam"><bpmn:documentation>Etapa 1: Reunir os resultados contra os alvos e as hipóteses. Executor: Agente da Estratégia (Estratégia · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES06_Flow3</bpmn:incoming><bpmn:outgoing>ES06_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ES06_E2_T1" name="Propor a causa de cada desvio: execução, recurso, alvo ou hipótese"><bpmn:documentation>Etapa 2: Separar falha de execução de hipótese errada. Executor: Agente da Estratégia (Estratégia · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES06_Flow4</bpmn:incoming><bpmn:outgoing>ES06_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="ES06_E2_T2" name="Enviar à Inteligência a pergunta sobre as causas propostas, com o risco e o prazo"><bpmn:documentation>Etapa 2: Separar falha de execução de hipótese errada. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES06_Flow5</bpmn:incoming><bpmn:outgoing>ES06_Flow6</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:receiveTask id="ES06_E2_T3" name="Receber a resposta da Inteligência sobre as causas, ou a pergunta devolvida"><bpmn:documentation>Etapa 2: Separar falha de execução de hipótese errada. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES06_Flow6</bpmn:incoming><bpmn:outgoing>ES06_Flow7</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:manualTask id="ES06_E2_T4" name="Discutir as causas com executivos e líderes dos círculos"><bpmn:documentation>Etapa 2: Separar falha de execução de hipótese errada. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES06_Flow7</bpmn:incoming><bpmn:outgoing>ES06_Flow8</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="ES06_E2_T5" name="Concluir a causa de cada desvio"><bpmn:documentation>Etapa 2: Separar falha de execução de hipótese errada. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES06_Flow8</bpmn:incoming><bpmn:outgoing>ES06_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ES06_E2_G1" name="Há contestação de indicador de alvo vigente?"><bpmn:incoming>ES06_Flow9</bpmn:incoming><bpmn:outgoing>ES06_Flow10</bpmn:outgoing><bpmn:outgoing>ES06_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ES06_E2_T6" name="Decidir a contestação do indicador de alvo: manter a ficha ou abrir a correção do alvo"><bpmn:documentation>Etapa 2: Separar falha de execução de hipótese errada. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES06_Flow10</bpmn:incoming><bpmn:outgoing>ES06_Flow12</bpmn:outgoing></bpmn:userTask>
