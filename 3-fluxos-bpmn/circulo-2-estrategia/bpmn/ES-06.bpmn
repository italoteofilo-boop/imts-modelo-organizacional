    <bpmn:exclusiveGateway id="ES06_E3_G3" name="Qual é a revisão de nível mais alto a abrir para os sócios?"><bpmn:incoming>ES06_Flow39</bpmn:incoming><bpmn:outgoing>ES06_Flow25</bpmn:outgoing><bpmn:outgoing>ES06_Flow26</bpmn:outgoing><bpmn:outgoing>ES06_Flow28</bpmn:outgoing><bpmn:outgoing>ES06_Flow30</bpmn:outgoing></bpmn:exclusiveGateway>
