        <bpmn:flowNodeRef>ES03_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES03_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES03_S3</bpmn:flowNodeRef>
