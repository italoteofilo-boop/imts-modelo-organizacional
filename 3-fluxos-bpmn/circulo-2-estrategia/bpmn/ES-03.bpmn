    <bpmn:exclusiveGateway id="ES03_E2_G2" name="Cada alvo proposto tem indicador com dado confiável?"><bpmn:incoming>ES03_Flow57</bpmn:incoming><bpmn:outgoing>ES03_Flow29</bpmn:outgoing><bpmn:outgoing>ES03_Flow30</bpmn:outgoing><bpmn:outgoing>ES03_Flow31</bpmn:outgoing></bpmn:exclusiveGateway>
