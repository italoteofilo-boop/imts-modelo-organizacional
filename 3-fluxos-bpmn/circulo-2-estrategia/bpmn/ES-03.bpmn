        <bpmn:flowNodeRef>ES03_E4_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES03_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>ES03_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES03_E2_PS1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES03_E2_T1</bpmn:flowNodeRef>
      </bpmn:lane>
