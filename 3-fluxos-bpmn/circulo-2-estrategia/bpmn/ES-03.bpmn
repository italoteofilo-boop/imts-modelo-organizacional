        <bpmn:flowNodeRef>ES03_E5_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES03_E5_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES03_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ES03_S1" name="Ciclo de alvos iniciado"><bpmn:outgoing>ES03_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="ES03_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ES03_S2" name="Nova estratégia publicada"><bpmn:outgoing>ES03_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="ES03_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ES03_S3" name="Portfólio de empresas atualizado"><bpmn:outgoing>ES03_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="ES03_S3_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ES03_S4" name="Alocação que muda alvos ou orçamento decidida"><bpmn:outgoing>ES03_Flow4</bpmn:outgoing><bpmn:messageEventDefinition id="ES03_S4_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ES03_S5" name="Novo desdobramento dos alvos decidido"><bpmn:outgoing>ES03_Flow5</bpmn:outgoing><bpmn:messageEventDefinition id="ES03_S5_def" /></bpmn:startEvent>
