      </bpmn:lane>
      <bpmn:lane id="Lane_ES03_IDE" name="Identidade">
        <bpmn:flowNodeRef>ES03_E1_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES03_E1_G3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES03_GES" name="Gestão">
        <bpmn:flowNodeRef>ES03_M6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES03_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES03_E5_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES03_ITG" name="Integração">
        <bpmn:flowNodeRef>ES03_E3_T2</bpmn:flowNodeRef>
