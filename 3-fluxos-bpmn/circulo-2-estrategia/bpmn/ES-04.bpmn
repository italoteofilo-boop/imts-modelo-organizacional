    <bpmn:scriptTask id="ES04_E1_T2" name="Reunir da carteira o dossiê, a decisão anterior e os recursos já aprovados"><bpmn:documentation>Etapa 1: Registrar a aposta e completar o dossiê. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES04_Flow11</bpmn:incoming><bpmn:outgoing>ES04_Flow12</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="ES04_E1_T3" name="Encaminhar à Inteligência o pedido sobre oferta em uso, para separar ajuste de revisão"><bpmn:documentation>Etapa 1: Registrar a aposta e completar o dossiê. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES04_Flow13</bpmn:incoming><bpmn:outgoing>ES04_Flow14</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="ES04_F6" name="Pedido sobre oferta em uso encaminhado à Inteligência"><bpmn:incoming>ES04_Flow14</bpmn:incoming></bpmn:endEvent>
