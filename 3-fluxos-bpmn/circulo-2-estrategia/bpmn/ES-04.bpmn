    <bpmn:scriptTask id="ES04_E1_T5" name="Devolver a aposta a quem propôs com o que falta"><bpmn:documentation>Etapa 1: Registrar a aposta e completar o dossiê. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES04_Flow18</bpmn:incoming><bpmn:outgoing>ES04_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ES04_M2"><bpmn:incoming>ES04_Flow12</bpmn:incoming><bpmn:incoming>ES04_Flow17</bpmn:incoming><bpmn:outgoing>ES04_Flow83</bpmn:outgoing></bpmn:exclusiveGateway>
