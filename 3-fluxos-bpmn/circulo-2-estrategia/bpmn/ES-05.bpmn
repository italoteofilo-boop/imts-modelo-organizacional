    <bpmn:scriptTask id="ES05_E1_T1" name="Enviar à Inteligência a pergunta de decisão do caso, com o risco e o prazo"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow106</bpmn:incoming><bpmn:outgoing>ES05_Flow4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:receiveTask id="ES05_E1_T2" name="Receber a resposta com evidência sobre o caso, ou a pergunta devolvida"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow4</bpmn:incoming><bpmn:outgoing>ES05_Flow5</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:serviceTask id="ES05_E1_T3" name="Montar o caso e os cenários, incluindo a alternativa de não mudar"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Agente da Estratégia (Estratégia · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow5</bpmn:incoming><bpmn:outgoing>ES05_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ES05_E1_T4" name="Conferir se o caso cabe na estratégia"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Agente da Estratégia (Estratégia · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow6</bpmn:incoming><bpmn:outgoing>ES05_Flow7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ES05_E1_T5" name="Concluir o caso com quem propôs"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow7</bpmn:incoming><bpmn:outgoing>ES05_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ES05_E1_G1" name="O caso se sustenta?"><bpmn:incoming>ES05_Flow8</bpmn:incoming><bpmn:outgoing>ES05_Flow9</bpmn:outgoing><bpmn:outgoing>ES05_Flow11</bpmn:outgoing><bpmn:outgoing>ES05_Flow14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ES05_E1_T6" name="Propor aos sócios arquivar o caso, com o motivo"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow9</bpmn:incoming><bpmn:outgoing>ES05_Flow10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="ES05_E1_T7" name="Redigir a lição do caso arquivado, sem dado sigiloso"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow11</bpmn:incoming><bpmn:outgoing>ES05_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="ES05_E1_T8" name="Arquivar o caso com o motivo e avisar quem propôs e, se nasceu de aposta, a carteira"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow12</bpmn:incoming><bpmn:outgoing>ES05_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="ES05_E1_T9" name="Conferir o caso com os critérios de decisão da identidade"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Agente da Estratégia (Estratégia · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow14</bpmn:incoming><bpmn:outgoing>ES05_Flow15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ES05_E1_G2" name="O caso é coerente com a identidade?"><bpmn:incoming>ES05_Flow15</bpmn:incoming><bpmn:outgoing>ES05_Flow16</bpmn:outgoing><bpmn:outgoing>ES05_Flow17</bpmn:outgoing><bpmn:outgoing>ES05_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="ES05_E1_T10" name="Julgar o caso de fronteira da empresa"><bpmn:documentation>Etapa 1: Montar o caso: por que criar, adquirir, vender ou encerrar. Executor: Outro círculo (Identidade). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES05_Flow18</bpmn:incoming><bpmn:outgoing>ES05_Flow19</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="ES05_E1_G3" name="A Identidade considera o caso coerente?"><bpmn:incoming>ES05_Flow19</bpmn:incoming><bpmn:outgoing>ES05_Flow20</bpmn:outgoing><bpmn:outgoing>ES05_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ES05_M2"><bpmn:incoming>ES05_Flow16</bpmn:incoming><bpmn:incoming>ES05_Flow20</bpmn:incoming><bpmn:outgoing>ES05_Flow107</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ES05_E2_G1" name="O caso é de aquisição ou de venda?"><bpmn:incoming>ES05_Flow107</bpmn:incoming><bpmn:outgoing>ES05_Flow22</bpmn:outgoing><bpmn:outgoing>ES05_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ES05_E2_T1" name="Propor os limites de preço e de condições da negociação"><bpmn:documentation>Etapa 2: Obter dos sócios a autorização para negociar, com limites. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>ES05_Flow23</bpmn:incoming><bpmn:outgoing>ES05_Flow24</bpmn:outgoing></bpmn:userTask>
    <bpmn:callActivity id="ES05_E2_T2" name="Levar aos sócios o pedido de autorização para negociar, com os limites propostos"><bpmn:documentation>Etapa 2: Obter dos sócios a autorização para negociar, com limites. Executor: Outro círculo (Governança). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>ES05_Flow24</bpmn:incoming><bpmn:outgoing>ES05_Flow25</bpmn:outgoing></bpmn:callActivity>
    <bpmn:manualTask id="ES05_E2_T3" name="Decidir a autorização para negociar e os limites de preço e de condições"><bpmn:documentation>Etapa 2: Obter dos sócios a autorização para negociar, com limites. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>ES05_Flow25</bpmn:incoming><bpmn:outgoing>ES05_Flow26</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ES05_E2_G2" name="Os sócios autorizaram a negociação?"><bpmn:incoming>ES05_Flow26</bpmn:incoming><bpmn:outgoing>ES05_Flow27</bpmn:outgoing><bpmn:outgoing>ES05_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
