    <bpmn:startEvent id="ES05_S1" name="Oportunidade de aquisição ou de venda recebida"><bpmn:outgoing>ES05_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ES05_S1_def" /></bpmn:startEvent>
