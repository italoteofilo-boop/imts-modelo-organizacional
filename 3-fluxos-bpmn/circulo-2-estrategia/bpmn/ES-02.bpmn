        <bpmn:flowNodeRef>ES02_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E2_T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES02_ESR" name="Estratégia · automação">
        <bpmn:flowNodeRef>ES02_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E4_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E4_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E4_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_M6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E4_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E4_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_M7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ES02_S1" name="Resultado do período fechado"><bpmn:outgoing>ES02_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ES02_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ES02_S2" name="Nova estratégia publicada"><bpmn:outgoing>ES02_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="ES02_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ES02_S3" name="Revisão do portfólio decidida"><bpmn:outgoing>ES02_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="ES02_S3_def" /></bpmn:startEvent>
