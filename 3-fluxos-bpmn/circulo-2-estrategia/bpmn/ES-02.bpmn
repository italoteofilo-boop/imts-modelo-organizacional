    <bpmn:serviceTask id="ES02_E2_T7" name="Conferir a proposta com os critérios de decisão da identidade"><bpmn:documentation>Etapa 2: Propor a alocação e o destino do resultado. Executor: Agente da Estratégia (Estratégia · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES02_Flow39</bpmn:incoming><bpmn:outgoing>ES02_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ES02_E2_G2" name="A proposta de alocação é coerente com a identidade?"><bpmn:incoming>ES02_Flow14</bpmn:incoming><bpmn:outgoing>ES02_Flow15</bpmn:outgoing><bpmn:outgoing>ES02_Flow16</bpmn:outgoing><bpmn:outgoing>ES02_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="ES02_E2_T8" name="Julgar o caso de fronteira da proposta de alocação"><bpmn:documentation>Etapa 2: Propor a alocação e o destino do resultado. Executor: Outro círculo (Identidade). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES02_Flow17</bpmn:incoming><bpmn:outgoing>ES02_Flow18</bpmn:outgoing></bpmn:callActivity>
    <bpmn:exclusiveGateway id="ES02_E2_G3" name="A Identidade considera a proposta de alocação coerente?"><bpmn:incoming>ES02_Flow18</bpmn:incoming><bpmn:outgoing>ES02_Flow19</bpmn:outgoing><bpmn:outgoing>ES02_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
