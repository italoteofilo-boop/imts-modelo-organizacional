    <bpmn:exclusiveGateway id="ES02_E4_G1" name="A alocação muda alvos ou orçamento, ou há desdobramento dos alvos à espera dela?"><bpmn:incoming>ES02_Flow29</bpmn:incoming><bpmn:outgoing>ES02_Flow30</bpmn:outgoing><bpmn:outgoing>ES02_Flow31</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ES02_E4_T4" name="Enviar a alocação decidida ao desdobramento dos alvos"><bpmn:documentation>Etapa 4: Comunicar a decisão e encaminhar a execução. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES02_Flow30</bpmn:incoming><bpmn:outgoing>ES02_Flow32</bpmn:outgoing></bpmn:scriptTask>
