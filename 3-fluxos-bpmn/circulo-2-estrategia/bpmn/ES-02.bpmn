    <bpmn:exclusiveGateway id="ES02_E4_G2" name="A decisão manda estudar a saída de empresa, oferta ou aposta?"><bpmn:incoming>ES02_Flow42</bpmn:incoming><bpmn:outgoing>ES02_Flow33</bpmn:outgoing><bpmn:outgoing>ES02_Flow34</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="ES02_E4_T5" name="Comunicar o estudo de saída ao executivo afetado"><bpmn:documentation>Etapa 4: Comunicar a decisão e encaminhar a execução. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES02_Flow34</bpmn:incoming><bpmn:outgoing>ES02_Flow35</bpmn:outgoing></bpmn:manualTask>
    <bpmn:scriptTask id="ES02_E4_T6" name="Abrir o estudo de saída: empresa na ES-05, oferta ou aposta na ES-04"><bpmn:documentation>Etapa 4: Comunicar a decisão e encaminhar a execução. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES02_Flow35</bpmn:incoming><bpmn:outgoing>ES02_Flow36</bpmn:outgoing></bpmn:scriptTask>
