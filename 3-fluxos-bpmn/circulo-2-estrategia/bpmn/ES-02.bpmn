<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ES02" targetNamespace="urn:imts:modelo:circulo2-estrategia" exporter="Ecossistema IMTS - fonte única do Círculo 2" exporterVersion="2026-10-01">
  <bpmn:category id="Category_ES02">
    <bpmn:categoryValue id="CV_ES02_E1" value="1. Ler o resultado e o uso de recursos de cada unidade do portfólio" />
    <bpmn:categoryValue id="CV_ES02_E2" value="2. Propor a alocação e o destino do resultado" />
    <bpmn:categoryValue id="CV_ES02_E3" value="3. Decidir a alocação com os sócios" />
    <bpmn:categoryValue id="CV_ES02_E4" value="4. Comunicar a decisão e encaminhar a execução" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ES02">
    <bpmn:participant id="Participant_ES02" name="ES-02 · Rever o portfólio e realocar recursos entre empresas, ofertas e apostas" processRef="Process_ES02" />
    <bpmn:group id="Group_ES02_E1" categoryValueRef="CV_ES02_E1" />
    <bpmn:group id="Group_ES02_E2" categoryValueRef="CV_ES02_E2" />
    <bpmn:group id="Group_ES02_E3" categoryValueRef="CV_ES02_E3" />
    <bpmn:group id="Group_ES02_E4" categoryValueRef="CV_ES02_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ES02" name="Rever o portfólio e realocar recursos entre empresas, ofertas e apostas" isExecutable="false">
    <bpmn:documentation>Decidir, a cada período, para onde vão dinheiro, pessoas e atenção: o que recebe mais, o que mantém, o que perde recursos e o que deve ter a saída estudada, e o destino do resultado de cada empresa. A proposta sobe sempre aos sócios, mesmo quando é manter a alocação.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ES02">
      <bpmn:lane id="Lane_ES02_GES" name="Gestão">
        <bpmn:flowNodeRef>ES02_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES02_ASS" name="Assessoria externa">
        <bpmn:flowNodeRef>ES02_E2_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES02_IDE" name="Identidade">
        <bpmn:flowNodeRef>ES02_E2_T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E2_G3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES02_GOV" name="Governança">
        <bpmn:flowNodeRef>ES02_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES02_SOC" name="Sócios">
        <bpmn:flowNodeRef>ES02_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES02_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>ES02_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES02_ESP" name="Estratégia · pessoa">
        <bpmn:flowNodeRef>ES02_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E2_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ES02_E4_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ES02_ESA" name="Estratégia · agente">
