    <bpmn:callActivity id="ES02_E3_T1" name="Levar a proposta de alocação à decisão dos sócios"><bpmn:documentation>Etapa 3: Decidir a alocação com os sócios. Executor: Outro círculo (Governança). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>ES02_Flow40</bpmn:incoming><bpmn:outgoing>ES02_Flow21</bpmn:outgoing></bpmn:callActivity>
    <bpmn:manualTask id="ES02_E3_T2" name="Decidir a alocação e o destino do resultado"><bpmn:documentation>Etapa 3: Decidir a alocação com os sócios. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>ES02_Flow21</bpmn:incoming><bpmn:outgoing>ES02_Flow22</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ES02_E3_G1" name="Alocação aprovada?"><bpmn:incoming>ES02_Flow22</bpmn:incoming><bpmn:outgoing>ES02_Flow23</bpmn:outgoing><bpmn:outgoing>ES02_Flow24</bpmn:outgoing><bpmn:outgoing>ES02_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ES02_E3_T3" name="Registrar a decisão dos sócios de manter a alocação atual e o destino do resultado"><bpmn:documentation>Etapa 3: Decidir a alocação com os sócios. Executor: Automação da Estratégia (Estratégia · automação). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>ES02_Flow25</bpmn:incoming><bpmn:outgoing>ES02_Flow26</bpmn:outgoing></bpmn:scriptTask>
