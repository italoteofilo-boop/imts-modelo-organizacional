    <bpmn:serviceTask id="ES02_E1_T1" name="Comparar resultado e recursos usados com o papel de cada unidade no portfólio-alvo"><bpmn:documentation>Etapa 1: Ler o resultado e o uso de recursos de cada unidade do portfólio. Executor: Agente da Estratégia (Estratégia · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES02_Flow37</bpmn:incoming><bpmn:outgoing>ES02_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="ES02_E1_T2" name="Interpretar a leitura com cada executivo"><bpmn:documentation>Etapa 1: Ler o resultado e o uso de recursos de cada unidade do portfólio. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ES02_Flow4</bpmn:incoming><bpmn:outgoing>ES02_Flow5</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ES02_M2"><bpmn:incoming>ES02_Flow5</bpmn:incoming><bpmn:incoming>ES02_Flow16</bpmn:incoming><bpmn:incoming>ES02_Flow20</bpmn:incoming><bpmn:incoming>ES02_Flow24</bpmn:incoming><bpmn:outgoing>ES02_Flow38</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ES02_E2_T1" name="Classificar cada unidade: semear, nutrir, podar ou colher"><bpmn:documentation>Etapa 2: Propor a alocação e o destino do resultado. Executor: Agente da Estratégia (Estratégia · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES02_Flow38</bpmn:incoming><bpmn:outgoing>ES02_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ES02_E2_T2" name="Simular realocações de dinheiro, pessoas e capacidade dos círculos"><bpmn:documentation>Etapa 2: Propor a alocação e o destino do resultado. Executor: Agente da Estratégia (Estratégia · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES02_Flow6</bpmn:incoming><bpmn:outgoing>ES02_Flow7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:task id="ES02_E2_T3" name="Avaliar os efeitos societários, fiscais e contábeis das alternativas"><bpmn:documentation>Etapa 2: Propor a alocação e o destino do resultado. Executor: Assessoria externa (Assessoria externa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES02_Flow7</bpmn:incoming><bpmn:outgoing>ES02_Flow8</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="ES02_E2_T4" name="Montar a proposta de alocação e de destino do resultado, mesmo quando é manter a atual"><bpmn:documentation>Etapa 2: Propor a alocação e o destino do resultado. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES02_Flow8</bpmn:incoming><bpmn:outgoing>ES02_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ES02_E2_G1" name="A proposta muda o papel de alguma empresa, oferta ou aposta?"><bpmn:incoming>ES02_Flow9</bpmn:incoming><bpmn:outgoing>ES02_Flow10</bpmn:outgoing><bpmn:outgoing>ES02_Flow12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ES02_E2_T5" name="Opinar sobre a mudança de papel da sua empresa, oferta ou aposta"><bpmn:documentation>Etapa 2: Propor a alocação e o destino do resultado. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES02_Flow10</bpmn:incoming><bpmn:outgoing>ES02_Flow11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="ES02_E2_T6" name="Decidir a mudança de papel a propor, ouvido o executivo afetado"><bpmn:documentation>Etapa 2: Propor a alocação e o destino do resultado. Executor: Pessoa da Estratégia (Estratégia · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ES02_Flow11</bpmn:incoming><bpmn:outgoing>ES02_Flow13</bpmn:outgoing></bpmn:userTask>
