<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO05" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO05">
    <bpmn:categoryValue id="CV_GO05_E1" value="1. Revisar o contrato" />
    <bpmn:categoryValue id="CV_GO05_E2" value="2. Guardar o contrato e registrar as obrigações" />
    <bpmn:categoryValue id="CV_GO05_E3" value="3. Acompanhar vencimentos e obrigações" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO05">
    <bpmn:participant id="Participant_GO05" name="GO-05 · Revisar os contratos, guardá-los e acompanhar prazos e obrigações" processRef="Process_GO05" />
    <bpmn:group id="Group_GO05_E1" categoryValueRef="CV_GO05_E1" />
    <bpmn:group id="Group_GO05_E2" categoryValueRef="CV_GO05_E2" />
    <bpmn:group id="Group_GO05_E3" categoryValueRef="CV_GO05_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GO05" name="Revisar os contratos, guardá-los e acompanhar prazos e obrigações" isExecutable="false">
    <bpmn:documentation>Fazer cada contrato de cliente, de fornecedor, de tecnologia, de parceria, de oferta conjunta e de compra ou venda de empresa ser comparado com o modelo, ter a cláusula fora dele e o risco revisados e os poderes de quem assina conferidos; ser guardado com partes, prazos, valores e obrigações registrados; e ter cada vencimento e obrigação avisados ao dono com antecedência, com o vencimento sem decisão levado ao executivo. A frente dona origina e negocia o contrato; a Governança revisa, guarda e acompanha.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GO05">
      <bpmn:lane id="Lane_GO05_SOL" name="Solicitante">
        <bpmn:flowNodeRef>GO05_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO05_SOC" name="Sócios">
        <bpmn:flowNodeRef>GO05_E1_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO05_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GO05_E3_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO05_GOP" name="Governança · pessoa">
        <bpmn:flowNodeRef>GO05_E1_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E1_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO05_GOA" name="Governança · agente">
        <bpmn:flowNodeRef>GO05_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E1_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO05_GOR" name="Governança · automação">
        <bpmn:flowNodeRef>GO05_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_E3_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO05_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GO05_S1" name="Contrato para revisar ou guardar recebido"><bpmn:outgoing>GO05_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GO05_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GO05_S2" name="Vencimento ou obrigação de contrato próximo"><bpmn:outgoing>GO05_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="GO05_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GO05_M1"><bpmn:incoming>GO05_Flow1</bpmn:incoming><bpmn:incoming>GO05_Flow2</bpmn:incoming><bpmn:outgoing>GO05_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GO05_E1_G1" name="O que iniciou o trabalho?"><bpmn:incoming>GO05_Flow26</bpmn:incoming><bpmn:outgoing>GO05_Flow3</bpmn:outgoing><bpmn:outgoing>GO05_Flow4</bpmn:outgoing><bpmn:outgoing>GO05_Flow5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GO05_E1_T1" name="Comparar o contrato com o modelo e apontar as cláusulas fora dele"><bpmn:documentation>Etapa 1: Revisar o contrato. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow5</bpmn:incoming><bpmn:outgoing>GO05_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GO05_E1_G2" name="Há cláusula fora do modelo ou risco relevante?"><bpmn:incoming>GO05_Flow6</bpmn:incoming><bpmn:outgoing>GO05_Flow7</bpmn:outgoing><bpmn:outgoing>GO05_Flow8</bpmn:outgoing><bpmn:outgoing>GO05_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO05_E1_T2" name="Revisar a cláusula e o risco e propor a redação"><bpmn:documentation>Etapa 1: Revisar o contrato. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow7</bpmn:incoming><bpmn:outgoing>GO05_Flow11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GO05_E1_T3" name="Revisar a cláusula e o risco e levar a proposta aos sócios"><bpmn:documentation>Etapa 1: Revisar o contrato. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow8</bpmn:incoming><bpmn:outgoing>GO05_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GO05_E1_T4" name="Decidir a cláusula que vai aos sócios pela regra dos contratos"><bpmn:documentation>Etapa 1: Revisar o contrato. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow9</bpmn:incoming><bpmn:outgoing>GO05_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO05_M2"><bpmn:incoming>GO05_Flow10</bpmn:incoming><bpmn:incoming>GO05_Flow11</bpmn:incoming><bpmn:incoming>GO05_Flow12</bpmn:incoming><bpmn:outgoing>GO05_Flow27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GO05_E1_T5" name="Conferir os poderes de quem assina"><bpmn:documentation>Etapa 1: Revisar o contrato. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow27</bpmn:incoming><bpmn:outgoing>GO05_Flow13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO05_E1_T6" name="Liberar o contrato para assinatura ou para a guarda"><bpmn:documentation>Etapa 1: Revisar o contrato. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow13</bpmn:incoming><bpmn:outgoing>GO05_Flow14</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO05_M3"><bpmn:incoming>GO05_Flow3</bpmn:incoming><bpmn:incoming>GO05_Flow14</bpmn:incoming><bpmn:outgoing>GO05_Flow28</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:receiveTask id="GO05_E2_T1" name="Receber o contrato assinado"><bpmn:documentation>Etapa 2: Guardar o contrato e registrar as obrigações. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO05_Flow28</bpmn:incoming><bpmn:outgoing>GO05_Flow15</bpmn:outgoing></bpmn:receiveTask>
    <bpmn:scriptTask id="GO05_E2_T2" name="Guardar o contrato assinado e registrar partes, prazos, valores e obrigações"><bpmn:documentation>Etapa 2: Guardar o contrato e registrar as obrigações. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO05_Flow15</bpmn:incoming><bpmn:outgoing>GO05_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO05_E2_G1" name="Há prazo ou obrigação a acompanhar agora?"><bpmn:incoming>GO05_Flow16</bpmn:incoming><bpmn:outgoing>GO05_Flow17</bpmn:outgoing><bpmn:outgoing>GO05_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="GO05_F2" name="Contrato guardado, com as obrigações registradas"><bpmn:incoming>GO05_Flow17</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GO05_M4"><bpmn:incoming>GO05_Flow4</bpmn:incoming><bpmn:incoming>GO05_Flow18</bpmn:incoming><bpmn:outgoing>GO05_Flow29</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO05_E3_T1" name="Avisar o dono do contrato do vencimento ou da obrigação, com antecedência"><bpmn:documentation>Etapa 3: Acompanhar vencimentos e obrigações. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow29</bpmn:incoming><bpmn:outgoing>GO05_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="GO05_E3_T2" name="Conferir o cumprimento ou a decisão de renovar ou encerrar"><bpmn:documentation>Etapa 3: Acompanhar vencimentos e obrigações. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow19</bpmn:incoming><bpmn:outgoing>GO05_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO05_E3_G1" name="O dono cumpriu ou decidiu?"><bpmn:incoming>GO05_Flow20</bpmn:incoming><bpmn:outgoing>GO05_Flow21</bpmn:outgoing><bpmn:outgoing>GO05_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO05_E3_T3" name="Levar ao executivo o vencimento sem decisão"><bpmn:documentation>Etapa 3: Acompanhar vencimentos e obrigações. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow21</bpmn:incoming><bpmn:outgoing>GO05_Flow22</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="GO05_E3_T4" name="Decidir renovar ou encerrar o contrato vencido sem decisão do dono"><bpmn:documentation>Etapa 3: Acompanhar vencimentos e obrigações. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow22</bpmn:incoming><bpmn:outgoing>GO05_Flow24</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO05_M5"><bpmn:incoming>GO05_Flow23</bpmn:incoming><bpmn:incoming>GO05_Flow24</bpmn:incoming><bpmn:outgoing>GO05_Flow30</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO05_E3_T5" name="Registrar o cumprimento ou a decisão"><bpmn:documentation>Etapa 3: Acompanhar vencimentos e obrigações. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO05_Flow30</bpmn:incoming><bpmn:outgoing>GO05_Flow25</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO05_F1" name="Vencimento ou obrigação de contrato acompanhado"><bpmn:incoming>GO05_Flow25</bpmn:incoming></bpmn:endEvent>
