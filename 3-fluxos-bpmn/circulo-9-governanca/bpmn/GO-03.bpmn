<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO03" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO03">
    <bpmn:categoryValue id="CV_GO03_E1" value="1. Identificar e avaliar os riscos" />
    <bpmn:categoryValue id="CV_GO03_E2" value="2. Testar os controles e a conformidade" />
    <bpmn:categoryValue id="CV_GO03_E3" value="3. Relatar os riscos e a conformidade" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO03">
    <bpmn:participant id="Participant_GO03" name="GO-03 · Gerir os riscos, a conformidade e os controles internos" processRef="Process_GO03" />
    <bpmn:group id="Group_GO03_E1" categoryValueRef="CV_GO03_E1" />
    <bpmn:group id="Group_GO03_E2" categoryValueRef="CV_GO03_E2" />
    <bpmn:group id="Group_GO03_E3" categoryValueRef="CV_GO03_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GO03" name="Gerir os riscos, a conformidade e os controles internos" isExecutable="false">
    <bpmn:documentation>Fazer os riscos de cada círculo, empresa, oferta, contrato e agente serem reunidos, avaliados pela matriz e tratados por decisão; os controles internos e a conformidade serem testados; cada falha de controle ou não conformidade virar plano de remediação com dono e prazo e, quando a causa pede, regra nova ou revista; e o relatório de riscos e conformidade ir aos sócios e à Estratégia. A Governança avalia, testa e relata; os donos tratam os riscos e remediam.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GO03">
      <bpmn:lane id="Lane_GO03_GOP" name="Governança · pessoa">
        <bpmn:flowNodeRef>GO03_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E2_G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO03_GOA" name="Governança · agente">
        <bpmn:flowNodeRef>GO03_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO03_GOR" name="Governança · automação">
        <bpmn:flowNodeRef>GO03_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO03_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GO03_S1" name="Ciclo de riscos e conformidade iniciado"><bpmn:outgoing>GO03_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="GO03_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GO03_S2" name="Risco, falha de controle ou mudança relevante recebida"><bpmn:outgoing>GO03_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GO03_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GO03_M1"><bpmn:incoming>GO03_Flow1</bpmn:incoming><bpmn:incoming>GO03_Flow2</bpmn:incoming><bpmn:outgoing>GO03_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO03_E1_T1" name="Reunir os riscos de cada círculo, empresa, oferta, contrato e agente"><bpmn:documentation>Etapa 1: Identificar e avaliar os riscos. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO03_Flow17</bpmn:incoming><bpmn:outgoing>GO03_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GO03_E1_T2" name="Avaliar probabilidade, impacto e controles de cada risco pela matriz"><bpmn:documentation>Etapa 1: Identificar e avaliar os riscos. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO03_Flow3</bpmn:incoming><bpmn:outgoing>GO03_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO03_E1_T3" name="Decidir o tratamento de cada risco: aceitar, mitigar, transferir ou evitar, com o dono"><bpmn:documentation>Etapa 1: Identificar e avaliar os riscos. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO03_Flow4</bpmn:incoming><bpmn:outgoing>GO03_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="GO03_E2_T1" name="Testar os controles internos e a conformidade com a lei e as regras"><bpmn:documentation>Etapa 2: Testar os controles e a conformidade. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO03_Flow5</bpmn:incoming><bpmn:outgoing>GO03_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO03_E2_T2" name="Conferir os achados dos testes com os donos"><bpmn:documentation>Etapa 2: Testar os controles e a conformidade. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO03_Flow6</bpmn:incoming><bpmn:outgoing>GO03_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="GO03_E2_T3" name="Testar uma amostra dos indicadores publicados contra a fonte"><bpmn:documentation>Etapa 2: Testar os controles e a conformidade. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO03_Flow7</bpmn:incoming><bpmn:outgoing>GO03_Flow8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GO03_E2_G1" name="Há falha de controle ou não conformidade?"><bpmn:incoming>GO03_Flow8</bpmn:incoming><bpmn:outgoing>GO03_Flow9</bpmn:outgoing><bpmn:outgoing>GO03_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO03_E2_T4" name="Montar o plano de remediação com o dono, o prazo e a causa"><bpmn:documentation>Etapa 2: Testar os controles e a conformidade. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO03_Flow9</bpmn:incoming><bpmn:outgoing>GO03_Flow11</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO03_M2"><bpmn:incoming>GO03_Flow10</bpmn:incoming><bpmn:incoming>GO03_Flow11</bpmn:incoming><bpmn:outgoing>GO03_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GO03_E2_G2" name="A causa pede regra nova ou revista?"><bpmn:incoming>GO03_Flow18</bpmn:incoming><bpmn:outgoing>GO03_Flow12</bpmn:outgoing><bpmn:outgoing>GO03_Flow13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO03_E2_T5" name="Abrir a revisão da regra"><bpmn:documentation>Etapa 2: Testar os controles e a conformidade. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO03_Flow12</bpmn:incoming><bpmn:outgoing>GO03_Flow14</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO03_M3"><bpmn:incoming>GO03_Flow13</bpmn:incoming><bpmn:incoming>GO03_Flow14</bpmn:incoming><bpmn:outgoing>GO03_Flow19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GO03_E3_T1" name="Consolidar o relatório de riscos, conformidade e remediações"><bpmn:documentation>Etapa 3: Relatar os riscos e a conformidade. Executor: Agente da Governança (Governança · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO03_Flow19</bpmn:incoming><bpmn:outgoing>GO03_Flow15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="GO03_E3_T2" name="Publicar o relatório aos sócios e à Estratégia"><bpmn:documentation>Etapa 3: Relatar os riscos e a conformidade. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO03_Flow15</bpmn:incoming><bpmn:outgoing>GO03_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO03_F1" name="Relatório de riscos e conformidade publicado"><bpmn:incoming>GO03_Flow16</bpmn:incoming></bpmn:endEvent>
