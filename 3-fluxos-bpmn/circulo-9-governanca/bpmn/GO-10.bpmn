<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO10" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO10">
    <bpmn:categoryValue id="CV_GO10_E1" value="1. Definir os temas e os indicadores" />
    <bpmn:categoryValue id="CV_GO10_E2" value="2. Coletar e analisar os dados" />
    <bpmn:categoryValue id="CV_GO10_E3" value="3. Redigir o relato, validá-lo e publicá-lo" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO10">
    <bpmn:participant id="Participant_GO10" name="GO-10 · Apurar e publicar o relato anual de impacto" processRef="Process_GO10" />
    <bpmn:group id="Group_GO10_E1" categoryValueRef="CV_GO10_E1" />
    <bpmn:group id="Group_GO10_E2" categoryValueRef="CV_GO10_E2" />
    <bpmn:group id="Group_GO10_E3" categoryValueRef="CV_GO10_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GO10" name="Apurar e publicar o relato anual de impacto" isExecutable="false">
    <bpmn:documentation>Fazer que, a cada ano, os temas e os indicadores de impacto sejam escolhidos pela definição da Identidade; os dados sejam coletados no catálogo de dados e analisados com avanços e lacunas; e o relato seja redigido na voz do Ecossistema, validado com os dados e o risco jurídico, aprovado pelos sócios e publicado. A Identidade define o que conta como impacto; a Governança apura e publica.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GO10">
      <bpmn:lane id="Lane_GO10_SOC" name="Sócios">
        <bpmn:flowNodeRef>GO10_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO10_GOP" name="Governança · pessoa">
        <bpmn:flowNodeRef>GO10_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO10_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO10_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO10_GOA" name="Governança · agente">
        <bpmn:flowNodeRef>GO10_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO10_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO10_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO10_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO10_GOR" name="Governança · automação">
        <bpmn:flowNodeRef>GO10_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO10_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO10_E3_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO10_E3_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO10_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GO10_S1" name="Ciclo anual do relato de impacto iniciado"><bpmn:outgoing>GO10_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="GO10_S1_def" /></bpmn:startEvent>
    <bpmn:serviceTask id="GO10_E1_T1" name="Propor os temas e os indicadores de impacto do ano pela definição"><bpmn:documentation>Etapa 1: Definir os temas e os indicadores. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO10_Flow1</bpmn:incoming><bpmn:outgoing>GO10_Flow2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO10_E1_T2" name="Decidir os temas e os indicadores"><bpmn:documentation>Etapa 1: Definir os temas e os indicadores. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO10_Flow2</bpmn:incoming><bpmn:outgoing>GO10_Flow3</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GO10_E2_T1" name="Coletar os dados dos indicadores no catálogo de dados"><bpmn:documentation>Etapa 2: Coletar e analisar os dados. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO10_Flow3</bpmn:incoming><bpmn:outgoing>GO10_Flow4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GO10_E2_T2" name="Analisar o impacto e apontar avanços e lacunas"><bpmn:documentation>Etapa 2: Coletar e analisar os dados. Executor: Agente da Governança (Governança · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO10_Flow4</bpmn:incoming><bpmn:outgoing>GO10_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GO10_M1"><bpmn:incoming>GO10_Flow5</bpmn:incoming><bpmn:incoming>GO10_Flow10</bpmn:incoming><bpmn:outgoing>GO10_Flow13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GO10_E3_T1" name="Redigir o relato na voz do Ecossistema"><bpmn:documentation>Etapa 3: Redigir o relato, validá-lo e publicá-lo. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO10_Flow13</bpmn:incoming><bpmn:outgoing>GO10_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO10_E3_T2" name="Validar o relato com os dados e o risco jurídico"><bpmn:documentation>Etapa 3: Redigir o relato, validá-lo e publicá-lo. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO10_Flow6</bpmn:incoming><bpmn:outgoing>GO10_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GO10_E3_T3" name="Aprovar o relato"><bpmn:documentation>Etapa 3: Redigir o relato, validá-lo e publicá-lo. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO10_Flow7</bpmn:incoming><bpmn:outgoing>GO10_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO10_E3_G1" name="Os sócios aprovaram o relato?"><bpmn:incoming>GO10_Flow8</bpmn:incoming><bpmn:outgoing>GO10_Flow9</bpmn:outgoing><bpmn:outgoing>GO10_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO10_E3_T4" name="Registrar os ajustes pedidos pelos sócios"><bpmn:documentation>Etapa 3: Redigir o relato, validá-lo e publicá-lo. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO10_Flow9</bpmn:incoming><bpmn:outgoing>GO10_Flow10</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="GO10_E3_T5" name="Publicar o relato"><bpmn:documentation>Etapa 3: Redigir o relato, validá-lo e publicá-lo. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO10_Flow11</bpmn:incoming><bpmn:outgoing>GO10_Flow12</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO10_F1" name="Relato de impacto publicado"><bpmn:incoming>GO10_Flow12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="GO10_Flow1" sourceRef="GO10_S1" targetRef="GO10_E1_T1" />
    <bpmn:sequenceFlow id="GO10_Flow2" sourceRef="GO10_E1_T1" targetRef="GO10_E1_T2" />
    <bpmn:sequenceFlow id="GO10_Flow3" sourceRef="GO10_E1_T2" targetRef="GO10_E2_T1" />
    <bpmn:sequenceFlow id="GO10_Flow4" sourceRef="GO10_E2_T1" targetRef="GO10_E2_T2" />
    <bpmn:sequenceFlow id="GO10_Flow5" sourceRef="GO10_E2_T2" targetRef="GO10_M1" />
    <bpmn:sequenceFlow id="GO10_Flow6" sourceRef="GO10_E3_T1" targetRef="GO10_E3_T2" />
    <bpmn:sequenceFlow id="GO10_Flow7" sourceRef="GO10_E3_T2" targetRef="GO10_E3_T3" />
    <bpmn:sequenceFlow id="GO10_Flow8" sourceRef="GO10_E3_T3" targetRef="GO10_E3_G1" />
    <bpmn:sequenceFlow id="GO10_Flow9" name="Não, com ajustes" sourceRef="GO10_E3_G1" targetRef="GO10_E3_T4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não, com ajustes</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO10_Flow10" sourceRef="GO10_E3_T4" targetRef="GO10_M1" />
    <bpmn:sequenceFlow id="GO10_Flow11" name="Sim" sourceRef="GO10_E3_G1" targetRef="GO10_E3_T5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO10_Flow12" sourceRef="GO10_E3_T5" targetRef="GO10_F1" />
    <bpmn:sequenceFlow id="GO10_Flow13" sourceRef="GO10_M1" targetRef="GO10_E3_T1" />
  </bpmn:process>
