    <bpmn:sequenceFlow id="GO04_Flow5" sourceRef="GO04_E2_T1" targetRef="GO04_E2_T2" />
    <bpmn:sequenceFlow id="GO04_Flow6" sourceRef="GO04_E2_T2" targetRef="GO04_E2_G1" />
    <bpmn:sequenceFlow id="GO04_Flow7" name="Não, com exigência" sourceRef="GO04_E2_G1" targetRef="GO04_E2_T3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não, com exigência</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO04_Flow8" name="Não, indeferido" sourceRef="GO04_E2_G1" targetRef="GO04_E2_T4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não, indeferido</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO04_Flow9" sourceRef="GO04_E2_T4" targetRef="GO04_E2_T5" />
    <bpmn:sequenceFlow id="GO04_Flow10" sourceRef="GO04_E2_T5" targetRef="GO04_E2_T6" />
    <bpmn:sequenceFlow id="GO04_Flow11" sourceRef="GO04_E2_T6" targetRef="GO04_F2" />
    <bpmn:sequenceFlow id="GO04_Flow12" name="Sim" sourceRef="GO04_E2_G1" targetRef="GO04_M2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO04_Flow13" sourceRef="GO04_E2_T3" targetRef="GO04_M2" />
    <bpmn:sequenceFlow id="GO04_Flow14" sourceRef="GO04_E2_T7" targetRef="GO04_F1" />
    <bpmn:sequenceFlow id="GO04_Flow15" sourceRef="GO04_M1" targetRef="GO04_E1_T1" />
    <bpmn:sequenceFlow id="GO04_Flow16" sourceRef="GO04_M2" targetRef="GO04_E2_T7" />
  </bpmn:process>
