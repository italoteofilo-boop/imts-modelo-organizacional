<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO04" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO04">
    <bpmn:categoryValue id="CV_GO04_E1" value="1. Manter o calendário de obrigações" />
    <bpmn:categoryValue id="CV_GO04_E2" value="2. Cumprir a obrigação" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO04">
    <bpmn:participant id="Participant_GO04" name="GO-04 · Manter em dia as obrigações legais: registros, certidões, marcas, procurações e seguros" processRef="Process_GO04" />
    <bpmn:group id="Group_GO04_E1" categoryValueRef="CV_GO04_E1" />
    <bpmn:group id="Group_GO04_E2" categoryValueRef="CV_GO04_E2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GO04" name="Manter em dia as obrigações legais: registros, certidões, marcas, procurações e seguros" isExecutable="false">
    <bpmn:documentation>Fazer cada licença, certidão, registro de empresa e de marca, procuração e seguro estar no calendário com o prazo; cada obrigação ser cumprida antes de vencer, com as exigências do órgão atendidas e o indeferimento levado ao executivo; e as certidões e os documentos de habilitação estarem em dia para Negócios. A Governança mantém e cumpre; a Identidade decide a marca.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GO04">
      <bpmn:lane id="Lane_GO04_SOL" name="Solicitante">
        <bpmn:flowNodeRef>GO04_S2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO04_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GO04_E2_T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO04_GOP" name="Governança · pessoa">
        <bpmn:flowNodeRef>GO04_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_E2_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO04_GOA" name="Governança · agente">
        <bpmn:flowNodeRef>GO04_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_E2_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO04_GOR" name="Governança · automação">
        <bpmn:flowNodeRef>GO04_S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_E2_T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO04_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GO04_S1" name="Prazo de obrigação legal próximo"><bpmn:outgoing>GO04_Flow1</bpmn:outgoing><bpmn:timerEventDefinition id="GO04_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GO04_S2" name="Registro, documento ou certidão pedido"><bpmn:outgoing>GO04_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GO04_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GO04_M1"><bpmn:incoming>GO04_Flow1</bpmn:incoming><bpmn:incoming>GO04_Flow2</bpmn:incoming><bpmn:outgoing>GO04_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO04_E1_T1" name="Registrar licenças, certidões, registros, marcas, procurações e seguros com o prazo"><bpmn:documentation>Etapa 1: Manter o calendário de obrigações. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO04_Flow15</bpmn:incoming><bpmn:outgoing>GO04_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GO04_E1_T2" name="Apontar o que vence, o que falta e o que o mandato ou a marca retirada pedem"><bpmn:documentation>Etapa 1: Manter o calendário de obrigações. Executor: Agente da Governança (Governança · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO04_Flow3</bpmn:incoming><bpmn:outgoing>GO04_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GO04_E2_T1" name="Preparar o pedido, a renovação, a transferência ou a baixa"><bpmn:documentation>Etapa 2: Cumprir a obrigação. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO04_Flow4</bpmn:incoming><bpmn:outgoing>GO04_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO04_E2_T2" name="Conferir e protocolar no órgão"><bpmn:documentation>Etapa 2: Cumprir a obrigação. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO04_Flow5</bpmn:incoming><bpmn:outgoing>GO04_Flow6</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO04_E2_G1" name="O órgão deferiu?"><bpmn:incoming>GO04_Flow6</bpmn:incoming><bpmn:outgoing>GO04_Flow7</bpmn:outgoing><bpmn:outgoing>GO04_Flow8</bpmn:outgoing><bpmn:outgoing>GO04_Flow12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO04_E2_T3" name="Cumprir a exigência do órgão e protocolar de novo"><bpmn:documentation>Etapa 2: Cumprir a obrigação. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO04_Flow7</bpmn:incoming><bpmn:outgoing>GO04_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GO04_E2_T4" name="Levar o indeferimento ao executivo, com as opções e o efeito na habilitação"><bpmn:documentation>Etapa 2: Cumprir a obrigação. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO04_Flow8</bpmn:incoming><bpmn:outgoing>GO04_Flow9</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="GO04_E2_T5" name="Decidir o caminho da obrigação indeferida: recorrer, refazer ou aceitar o efeito"><bpmn:documentation>Etapa 2: Cumprir a obrigação. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO04_Flow9</bpmn:incoming><bpmn:outgoing>GO04_Flow10</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GO04_E2_T6" name="Registrar a decisão do executivo e o novo prazo, se houver"><bpmn:documentation>Etapa 2: Cumprir a obrigação. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO04_Flow10</bpmn:incoming><bpmn:outgoing>GO04_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO04_F2" name="Obrigação indeferida, com a decisão do executivo registrada"><bpmn:incoming>GO04_Flow11</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GO04_M2"><bpmn:incoming>GO04_Flow12</bpmn:incoming><bpmn:incoming>GO04_Flow13</bpmn:incoming><bpmn:outgoing>GO04_Flow16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO04_E2_T7" name="Registrar o documento e o novo prazo"><bpmn:documentation>Etapa 2: Cumprir a obrigação. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO04_Flow16</bpmn:incoming><bpmn:outgoing>GO04_Flow14</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO04_F1" name="Obrigação cumprida e registrada"><bpmn:incoming>GO04_Flow14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="GO04_Flow1" sourceRef="GO04_S1" targetRef="GO04_M1" />
