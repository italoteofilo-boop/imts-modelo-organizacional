<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO09" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO09">
    <bpmn:categoryValue id="CV_GO09_E1" value="1. Receber e classificar o relato ou o incidente" />
    <bpmn:categoryValue id="CV_GO09_E2" value="2. Apurar o relato e decidir a medida" />
    <bpmn:categoryValue id="CV_GO09_E3" value="3. Comunicar à autoridade" />
    <bpmn:categoryValue id="CV_GO09_E4" value="4. Registrar e levar a causa à conformidade" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO09">
    <bpmn:participant id="Participant_GO09" name="GO-09 · Receber relatos, apurar com independência e comunicar às autoridades" processRef="Process_GO09" />
    <bpmn:group id="Group_GO09_E1" categoryValueRef="CV_GO09_E1" />
    <bpmn:group id="Group_GO09_E2" categoryValueRef="CV_GO09_E2" />
    <bpmn:group id="Group_GO09_E3" categoryValueRef="CV_GO09_E3" />
    <bpmn:group id="Group_GO09_E4" categoryValueRef="CV_GO09_E4" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GO09" name="Receber relatos, apurar com independência e comunicar às autoridades" isExecutable="false">
    <bpmn:documentation>Fazer cada relato de conduta, fraude ou descumprimento ser registrado com a identidade de quem relata protegida, classificado e apurado com independência, com a medida decidida com o executivo ou, se ele, a Governança ou um sócio estiver envolvido, pelos sócios não envolvidos; cada incidente ou risco que a lei manda comunicar ser comunicado à autoridade competente pela Governança, salvo o do recall, que a Governança já comunica dentro da OP-07 e aqui só registra; e cada causa ir à conformidade. A Governança recebe, apura e comunica; os donos corrigem.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GO09">
      <bpmn:lane id="Lane_GO09_SOL" name="Solicitante">
        <bpmn:flowNodeRef>GO09_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO09_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GO09_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO09_SOC" name="Sócios">
        <bpmn:flowNodeRef>GO09_E2_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO09_GOP" name="Governança · pessoa">
        <bpmn:flowNodeRef>GO09_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E2_G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO09_GOA" name="Governança · agente">
        <bpmn:flowNodeRef>GO09_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E3_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO09_GOR" name="Governança · automação">
        <bpmn:flowNodeRef>GO09_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E4_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E4_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_M5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO09_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GO09_S1" name="Relato recebido no canal"><bpmn:outgoing>GO09_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GO09_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GO09_S2" name="Incidente ou risco a comunicar à autoridade recebido"><bpmn:outgoing>GO09_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="GO09_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GO09_M1"><bpmn:incoming>GO09_Flow1</bpmn:incoming><bpmn:incoming>GO09_Flow2</bpmn:incoming><bpmn:outgoing>GO09_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO09_E1_T1" name="Registrar o relato ou o incidente, protegendo a identidade de quem relata"><bpmn:documentation>Etapa 1: Receber e classificar o relato ou o incidente. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO09_Flow22</bpmn:incoming><bpmn:outgoing>GO09_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GO09_E1_T2" name="Propor a classificação: gravidade e dever de comunicar à autoridade"><bpmn:documentation>Etapa 1: Receber e classificar o relato ou o incidente. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO09_Flow3</bpmn:incoming><bpmn:outgoing>GO09_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO09_E1_T3" name="Confirmar a classificação"><bpmn:documentation>Etapa 1: Receber e classificar o relato ou o incidente. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO09_Flow4</bpmn:incoming><bpmn:outgoing>GO09_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO09_E1_G1" name="O que é preciso fazer?"><bpmn:incoming>GO09_Flow5</bpmn:incoming><bpmn:outgoing>GO09_Flow6</bpmn:outgoing><bpmn:outgoing>GO09_Flow7</bpmn:outgoing><bpmn:outgoing>GO09_Flow8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO09_E2_T1" name="Apurar os fatos com independência"><bpmn:documentation>Etapa 2: Apurar o relato e decidir a medida. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GO09_Flow6</bpmn:incoming><bpmn:outgoing>GO09_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO09_E2_G1" name="Quem está envolvido no relato?"><bpmn:incoming>GO09_Flow9</bpmn:incoming><bpmn:outgoing>GO09_Flow10</bpmn:outgoing><bpmn:outgoing>GO09_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO09_E2_T2" name="Decidir a medida e a correção da causa"><bpmn:documentation>Etapa 2: Apurar o relato e decidir a medida. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GO09_Flow10</bpmn:incoming><bpmn:outgoing>GO09_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GO09_E2_T3" name="Decidir a medida e a correção da causa pelos sócios não envolvidos"><bpmn:documentation>Etapa 2: Apurar o relato e decidir a medida. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GO09_Flow11</bpmn:incoming><bpmn:outgoing>GO09_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO09_M2"><bpmn:incoming>GO09_Flow12</bpmn:incoming><bpmn:incoming>GO09_Flow13</bpmn:incoming><bpmn:outgoing>GO09_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GO09_E2_G2" name="Há dever de comunicar à autoridade?"><bpmn:incoming>GO09_Flow23</bpmn:incoming><bpmn:outgoing>GO09_Flow14</bpmn:outgoing><bpmn:outgoing>GO09_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GO09_M3"><bpmn:incoming>GO09_Flow7</bpmn:incoming><bpmn:incoming>GO09_Flow15</bpmn:incoming><bpmn:outgoing>GO09_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="GO09_E3_T1" name="Preparar a comunicação à autoridade competente e, no incidente com dados pessoais, ao titular"><bpmn:documentation>Etapa 3: Comunicar à autoridade. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO09_Flow24</bpmn:incoming><bpmn:outgoing>GO09_Flow16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO09_E3_T2" name="Conferir e enviar a comunicação no prazo"><bpmn:documentation>Etapa 3: Comunicar à autoridade. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO09_Flow16</bpmn:incoming><bpmn:outgoing>GO09_Flow17</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO09_M4"><bpmn:incoming>GO09_Flow8</bpmn:incoming><bpmn:incoming>GO09_Flow14</bpmn:incoming><bpmn:incoming>GO09_Flow17</bpmn:incoming><bpmn:outgoing>GO09_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO09_E4_T1" name="Registrar o relato, a medida, a comunicação e a causa"><bpmn:documentation>Etapa 4: Registrar e levar a causa à conformidade. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO09_Flow25</bpmn:incoming><bpmn:outgoing>GO09_Flow18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO09_E4_G1" name="Há quem relatou e possa receber resposta?"><bpmn:incoming>GO09_Flow18</bpmn:incoming><bpmn:outgoing>GO09_Flow19</bpmn:outgoing><bpmn:outgoing>GO09_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO09_E4_T2" name="Responder a quem relatou"><bpmn:documentation>Etapa 4: Registrar e levar a causa à conformidade. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO09_Flow19</bpmn:incoming><bpmn:outgoing>GO09_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO09_M5"><bpmn:incoming>GO09_Flow20</bpmn:incoming><bpmn:incoming>GO09_Flow21</bpmn:incoming><bpmn:outgoing>GO09_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="GO09_F1" name="Relato tratado ou autoridade comunicada, e registrado"><bpmn:incoming>GO09_Flow26</bpmn:incoming></bpmn:endEvent>
