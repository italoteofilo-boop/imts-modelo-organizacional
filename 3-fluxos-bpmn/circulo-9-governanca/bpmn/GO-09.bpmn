    <bpmn:serviceTask id="GO09_E4_T1" name="Preparar a comunicação à autoridade competente e, no incidente com dados pessoais, ao titular"><bpmn:documentation>Etapa 4: Comunicar à autoridade. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO09_Flow31</bpmn:incoming><bpmn:outgoing>GO09_Flow23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO09_E4_T2" name="Conferir e enviar a comunicação no prazo"><bpmn:documentation>Etapa 4: Comunicar à autoridade. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO09_Flow23</bpmn:incoming><bpmn:outgoing>GO09_Flow24</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO09_M4"><bpmn:incoming>GO09_Flow11</bpmn:incoming><bpmn:incoming>GO09_Flow17</bpmn:incoming><bpmn:incoming>GO09_Flow22</bpmn:incoming><bpmn:incoming>GO09_Flow24</bpmn:incoming><bpmn:outgoing>GO09_Flow32</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO09_E5_T1" name="Registrar o relato, a medida, a comunicação e a causa"><bpmn:documentation>Etapa 5: Registrar e levar a causa à conformidade. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO09_Flow32</bpmn:incoming><bpmn:outgoing>GO09_Flow25</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO09_E5_G1" name="Há quem relatou e possa receber resposta?"><bpmn:incoming>GO09_Flow25</bpmn:incoming><bpmn:outgoing>GO09_Flow26</bpmn:outgoing><bpmn:outgoing>GO09_Flow27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO09_E5_T2" name="Responder a quem relatou"><bpmn:documentation>Etapa 5: Registrar e levar a causa à conformidade. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO09_Flow26</bpmn:incoming><bpmn:outgoing>GO09_Flow28</bpmn:outgoing></bpmn:scriptTask>
