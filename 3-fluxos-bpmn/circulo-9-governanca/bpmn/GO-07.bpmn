<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO07" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO07">
    <bpmn:categoryValue id="CV_GO07_E1" value="1. Receber o pedido e localizar os dados" />
    <bpmn:categoryValue id="CV_GO07_E2" value="2. Decidir a resposta ao titular" />
    <bpmn:categoryValue id="CV_GO07_E3" value="3. Conferir o cumprimento e responder ao titular" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO07">
    <bpmn:participant id="Participant_GO07" name="GO-07 · Responder aos titulares de dados pessoais" processRef="Process_GO07" />
    <bpmn:group id="Group_GO07_E1" categoryValueRef="CV_GO07_E1" />
    <bpmn:group id="Group_GO07_E2" categoryValueRef="CV_GO07_E2" />
    <bpmn:group id="Group_GO07_E3" categoryValueRef="CV_GO07_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GO07" name="Responder aos titulares de dados pessoais" isExecutable="false">
    <bpmn:documentation>Fazer cada pedido de titular de dados ser registrado, com a identidade do titular confirmada antes de qualquer resposta; os dados dele serem localizados no catálogo de dados, com quem os guarda; a resposta ser decidida pela Governança, no papel de encarregada, pelos direitos e pelas bases legais da LGPD, com os motivos informados quando o pedido não procede no todo ou em parte; a execução ser pedida a quem guarda os dados (Relações, na base de relacionamento, e os demais círculos); e o titular receber a resposta depois de conferido o cumprimento. A Governança decide; quem guarda o dado executa.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GO07">
      <bpmn:lane id="Lane_GO07_SOL" name="Solicitante">
        <bpmn:flowNodeRef>GO07_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO07_GOP" name="Governança · pessoa">
        <bpmn:flowNodeRef>GO07_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_E2_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO07_GOA" name="Governança · agente">
        <bpmn:flowNodeRef>GO07_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_E2_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO07_GOR" name="Governança · automação">
        <bpmn:flowNodeRef>GO07_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO07_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GO07_S1" name="Pedido de titular recebido"><bpmn:outgoing>GO07_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GO07_S1_def" /></bpmn:startEvent>
    <bpmn:scriptTask id="GO07_E1_T1" name="Registrar o pedido, avisar o recebimento e anotar o prazo"><bpmn:documentation>Etapa 1: Receber o pedido e localizar os dados. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO07_Flow1</bpmn:incoming><bpmn:outgoing>GO07_Flow2</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO07_E1_G1" name="A identidade do titular foi confirmada?"><bpmn:incoming>GO07_Flow2</bpmn:incoming><bpmn:outgoing>GO07_Flow3</bpmn:outgoing><bpmn:outgoing>GO07_Flow5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO07_E1_T2" name="Pedir ao titular a confirmação da identidade"><bpmn:documentation>Etapa 1: Receber o pedido e localizar os dados. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO07_Flow3</bpmn:incoming><bpmn:outgoing>GO07_Flow4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO07_F2" name="Pedido parado, à espera da confirmação da identidade"><bpmn:incoming>GO07_Flow4</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="GO07_E1_T3" name="Localizar os dados do titular no catálogo de dados e quem os guarda"><bpmn:documentation>Etapa 1: Receber o pedido e localizar os dados. Executor: Agente da Governança (Governança · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO07_Flow5</bpmn:incoming><bpmn:outgoing>GO07_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GO07_E2_T1" name="Propor a resposta pelos direitos do titular e pelas bases legais do tratamento"><bpmn:documentation>Etapa 2: Decidir a resposta ao titular. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO07_Flow6</bpmn:incoming><bpmn:outgoing>GO07_Flow7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO07_E2_T2" name="Decidir a resposta como encarregada"><bpmn:documentation>Etapa 2: Decidir a resposta ao titular. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO07_Flow7</bpmn:incoming><bpmn:outgoing>GO07_Flow8</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO07_E2_G1" name="O pedido procede?"><bpmn:incoming>GO07_Flow8</bpmn:incoming><bpmn:outgoing>GO07_Flow9</bpmn:outgoing><bpmn:outgoing>GO07_Flow10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO07_E2_T3" name="Pedir a execução a quem guarda os dados"><bpmn:documentation>Etapa 2: Decidir a resposta ao titular. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO07_Flow9</bpmn:incoming><bpmn:outgoing>GO07_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO07_M1"><bpmn:incoming>GO07_Flow10</bpmn:incoming><bpmn:incoming>GO07_Flow11</bpmn:incoming><bpmn:outgoing>GO07_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GO07_E3_G1" name="Há execução a conferir?"><bpmn:incoming>GO07_Flow17</bpmn:incoming><bpmn:outgoing>GO07_Flow12</bpmn:outgoing><bpmn:outgoing>GO07_Flow13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO07_E3_T1" name="Conferir o cumprimento e o prazo e cobrar quem atrasou"><bpmn:documentation>Etapa 3: Conferir o cumprimento e responder ao titular. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO07_Flow12</bpmn:incoming><bpmn:outgoing>GO07_Flow14</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO07_M2"><bpmn:incoming>GO07_Flow13</bpmn:incoming><bpmn:incoming>GO07_Flow14</bpmn:incoming><bpmn:outgoing>GO07_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO07_E3_T2" name="Responder ao titular, com os motivos do que não procede"><bpmn:documentation>Etapa 3: Conferir o cumprimento e responder ao titular. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO07_Flow18</bpmn:incoming><bpmn:outgoing>GO07_Flow15</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="GO07_E3_T3" name="Registrar o pedido, a resposta e o cumprimento"><bpmn:documentation>Etapa 3: Conferir o cumprimento e responder ao titular. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO07_Flow15</bpmn:incoming><bpmn:outgoing>GO07_Flow16</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO07_F1" name="Pedido de titular respondido e registrado"><bpmn:incoming>GO07_Flow16</bpmn:incoming></bpmn:endEvent>
