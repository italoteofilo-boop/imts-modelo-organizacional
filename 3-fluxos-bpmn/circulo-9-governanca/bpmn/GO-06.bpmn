<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO06" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO06">
    <bpmn:categoryValue id="CV_GO06_E1" value="1. Sortear a amostra" />
    <bpmn:categoryValue id="CV_GO06_E2" value="2. Comparar as entregas com os padrões e a alçada" />
    <bpmn:categoryValue id="CV_GO06_E3" value="3. Julgar os casos e achar a causa" />
    <bpmn:categoryValue id="CV_GO06_E4" value="4. Auditar a Governança por assessoria externa" />
    <bpmn:categoryValue id="CV_GO06_E5" value="5. Publicar o resultado da auditoria" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO06">
    <bpmn:participant id="Participant_GO06" name="GO-06 · Auditar se as entregas de pessoas e agentes seguem a identidade e a alçada" processRef="Process_GO06" />
    <bpmn:group id="Group_GO06_E1" categoryValueRef="CV_GO06_E1" />
    <bpmn:group id="Group_GO06_E2" categoryValueRef="CV_GO06_E2" />
    <bpmn:group id="Group_GO06_E3" categoryValueRef="CV_GO06_E3" />
