    <bpmn:scriptTask id="GO06_E1_T3" name="Registrar a amostra e entregá-la à Inteligência"><bpmn:documentation>Etapa 1: Sortear a amostra. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO06_Flow6</bpmn:incoming><bpmn:outgoing>GO06_Flow7</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GO06_E2_T1" name="Comparar cada entrega com os critérios, os casos de teste e a alçada"><bpmn:documentation>Etapa 2: Comparar as entregas com os padrões e a alçada. Executor: Agente da Governança (Governança · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO06_Flow7</bpmn:incoming><bpmn:outgoing>GO06_Flow8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GO06_E2_T2" name="Separar conformes, não conformes e casos de fronteira"><bpmn:documentation>Etapa 2: Comparar as entregas com os padrões e a alçada. Executor: Agente da Governança (Governança · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO06_Flow8</bpmn:incoming><bpmn:outgoing>GO06_Flow9</bpmn:outgoing></bpmn:serviceTask>
