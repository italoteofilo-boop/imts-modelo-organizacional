<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO01" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO01">
    <bpmn:categoryValue id="CV_GO01_E1" value="1. Receber o pedido e levantar o que vale" />
    <bpmn:categoryValue id="CV_GO01_E2" value="2. Redigir e decidir a regra" />
    <bpmn:categoryValue id="CV_GO01_E3" value="3. Publicar as regras vigentes" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO01">
    <bpmn:participant id="Participant_GO01" name="GO-01 · Manter as regras, as políticas e as alçadas de pessoas e agentes" processRef="Process_GO01" />
    <bpmn:group id="Group_GO01_E1" categoryValueRef="CV_GO01_E1" />
    <bpmn:group id="Group_GO01_E2" categoryValueRef="CV_GO01_E2" />
    <bpmn:group id="Group_GO01_E3" categoryValueRef="CV_GO01_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GO01" name="Manter as regras, as políticas e as alçadas de pessoas e agentes" isExecutable="false">
    <bpmn:documentation>Fazer cada regra, política, alçada de pessoa ou de agente, regra de sigilo e de dados pessoais, regra de guarda, critério de rateio e modelo de proposta e de contrato nascer de um pedido, de uma decisão dos sócios ou de uma causa achada pela conformidade; ser redigida ouvidos os donos e, no rateio, a Estratégia; ser decidida pela Governança, dentro da sua alçada, ou pelos sócios; e ser publicada, versionada, a quem a usa. A Governança redige e publica; os sócios decidem as regras gerais e as alçadas dos executivos.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GO01">
      <bpmn:lane id="Lane_GO01_SOL" name="Solicitante">
        <bpmn:flowNodeRef>GO01_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO01_SOC" name="Sócios">
        <bpmn:flowNodeRef>GO01_E2_T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO01_EST" name="Estratégia">
        <bpmn:flowNodeRef>GO01_E2_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO01_GOP" name="Governança · pessoa">
        <bpmn:flowNodeRef>GO01_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E2_T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E2_G2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO01_GOA" name="Governança · agente">
        <bpmn:flowNodeRef>GO01_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E2_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO01_GOR" name="Governança · automação">
        <bpmn:flowNodeRef>GO01_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E2_T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO01_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GO01_S1" name="Regra, alçada, critério ou modelo pedido"><bpmn:outgoing>GO01_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GO01_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GO01_S2" name="Revisão periódica das regras iniciada"><bpmn:outgoing>GO01_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="GO01_S2_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GO01_S3" name="Decisão dos sócios ou causa da conformidade recebida"><bpmn:outgoing>GO01_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="GO01_S3_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GO01_M1"><bpmn:incoming>GO01_Flow1</bpmn:incoming><bpmn:incoming>GO01_Flow2</bpmn:incoming><bpmn:incoming>GO01_Flow3</bpmn:incoming><bpmn:outgoing>GO01_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO01_E1_T1" name="Registrar o pedido e as regras, as alçadas e os modelos afetados"><bpmn:documentation>Etapa 1: Receber o pedido e levantar o que vale. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO01_Flow21</bpmn:incoming><bpmn:outgoing>GO01_Flow4</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GO01_E1_T2" name="Levantar a lei, os contratos e as decisões dos sócios que valem"><bpmn:documentation>Etapa 1: Receber o pedido e levantar o que vale. Executor: Agente da Governança (Governança · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO01_Flow4</bpmn:incoming><bpmn:outgoing>GO01_Flow5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="GO01_E2_T1" name="Redigir a regra, a alçada, o critério ou o modelo, ouvidos os donos"><bpmn:documentation>Etapa 2: Redigir e decidir a regra. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO01_Flow5</bpmn:incoming><bpmn:outgoing>GO01_Flow6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO01_E2_T2" name="Revisar a redação e o risco jurídico"><bpmn:documentation>Etapa 2: Redigir e decidir a regra. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO01_Flow6</bpmn:incoming><bpmn:outgoing>GO01_Flow7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO01_E2_G1" name="Quem decide, pela lista de matérias aprovada pelos sócios?"><bpmn:incoming>GO01_Flow7</bpmn:incoming><bpmn:outgoing>GO01_Flow8</bpmn:outgoing><bpmn:outgoing>GO01_Flow9</bpmn:outgoing><bpmn:outgoing>GO01_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO01_E2_T3" name="Decidir a regra dentro da alçada da Governança"><bpmn:documentation>Etapa 2: Redigir e decidir a regra. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO01_Flow8</bpmn:incoming><bpmn:outgoing>GO01_Flow13</bpmn:outgoing></bpmn:userTask>
    <bpmn:task id="GO01_E2_T4" name="Definir o critério de rateio com a Governança"><bpmn:documentation>Etapa 2: Redigir e decidir a regra. Executor: Outro círculo (Estratégia). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO01_Flow9</bpmn:incoming><bpmn:outgoing>GO01_Flow10</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="GO01_E2_T5" name="Decidir o critério de rateio"><bpmn:documentation>Etapa 2: Redigir e decidir a regra. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO01_Flow10</bpmn:incoming><bpmn:outgoing>GO01_Flow14</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GO01_E2_T6" name="Levar a regra à decisão dos sócios"><bpmn:documentation>Etapa 2: Redigir e decidir a regra. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO01_Flow11</bpmn:incoming><bpmn:outgoing>GO01_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GO01_E2_T7" name="Decidir a regra"><bpmn:documentation>Etapa 2: Redigir e decidir a regra. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO01_Flow12</bpmn:incoming><bpmn:outgoing>GO01_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO01_M2"><bpmn:incoming>GO01_Flow13</bpmn:incoming><bpmn:incoming>GO01_Flow14</bpmn:incoming><bpmn:incoming>GO01_Flow15</bpmn:incoming><bpmn:outgoing>GO01_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GO01_E2_G2" name="A regra foi aprovada?"><bpmn:incoming>GO01_Flow22</bpmn:incoming><bpmn:outgoing>GO01_Flow16</bpmn:outgoing><bpmn:outgoing>GO01_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO01_E2_T8" name="Manter a regra vigente e avisar quem pediu, com o motivo"><bpmn:documentation>Etapa 2: Redigir e decidir a regra. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO01_Flow17</bpmn:incoming><bpmn:outgoing>GO01_Flow18</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO01_F2" name="Regra mantida, com o motivo avisado a quem pediu"><bpmn:incoming>GO01_Flow18</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="GO01_E3_T1" name="Versionar e publicar as regras, as alçadas, os critérios e os modelos"><bpmn:documentation>Etapa 3: Publicar as regras vigentes. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO01_Flow16</bpmn:incoming><bpmn:outgoing>GO01_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:scriptTask id="GO01_E3_T2" name="Avisar os donos do que mudou"><bpmn:documentation>Etapa 3: Publicar as regras vigentes. Executor: Automação da Governança (Governança · automação). Modo da etapa: Autômato; risco baixo.</bpmn:documentation><bpmn:incoming>GO01_Flow19</bpmn:incoming><bpmn:outgoing>GO01_Flow20</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO01_F1" name="Regras vigentes publicadas"><bpmn:incoming>GO01_Flow20</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="GO01_Flow1" sourceRef="GO01_S1" targetRef="GO01_M1" />
    <bpmn:sequenceFlow id="GO01_Flow2" sourceRef="GO01_S2" targetRef="GO01_M1" />
