    <bpmn:sequenceFlow id="GO01_Flow7" sourceRef="GO01_E2_T2" targetRef="GO01_E2_G1" />
    <bpmn:sequenceFlow id="GO01_Flow8" name="A Governança: regra que aplica regra geral aprovada, modelo de proposta ou de contrato, sigilo, dados e guarda, alçada de pessoas de outro círculo, matriz no apetite ou amostra" sourceRef="GO01_E2_G1" targetRef="GO01_E2_T3"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">A Governança: regra que aplica regra geral aprovada, modelo de proposta ou de contrato, sigilo, dados e guarda, alçada de pessoas de outro círculo, matriz no apetite ou amostra</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO01_Flow9" name="A Governança, com a Estratégia: critério de rateio" sourceRef="GO01_E2_G1" targetRef="GO01_E2_T4"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">A Governança, com a Estratégia: critério de rateio</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO01_Flow10" sourceRef="GO01_E2_T4" targetRef="GO01_E2_T5" />
    <bpmn:sequenceFlow id="GO01_Flow11" name="Os sócios: regra geral, alçada dos executivos, exceção, alçada da Governança ou das pessoas da Governança, limites dos agentes" sourceRef="GO01_E2_G1" targetRef="GO01_E2_T6"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Os sócios: regra geral, alçada dos executivos, exceção, alçada da Governança ou das pessoas da Governança, limites dos agentes</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO01_Flow12" sourceRef="GO01_E2_T6" targetRef="GO01_E2_T7" />
