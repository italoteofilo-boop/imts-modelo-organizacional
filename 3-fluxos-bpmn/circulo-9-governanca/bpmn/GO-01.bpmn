    <bpmn:sequenceFlow id="GO01_Flow15" sourceRef="GO01_E2_T7" targetRef="GO01_M2" />
    <bpmn:sequenceFlow id="GO01_Flow16" name="Sim" sourceRef="GO01_E2_G2" targetRef="GO01_E3_T1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Sim</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO01_Flow17" name="Não" sourceRef="GO01_E2_G2" targetRef="GO01_E2_T8"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Não</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="GO01_Flow18" sourceRef="GO01_E2_T8" targetRef="GO01_F2" />
    <bpmn:sequenceFlow id="GO01_Flow19" sourceRef="GO01_E3_T1" targetRef="GO01_E3_T2" />
