<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO02" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO02">
    <bpmn:categoryValue id="CV_GO02_E1" value="1. Montar a pauta e preparar as matérias" />
    <bpmn:categoryValue id="CV_GO02_E2" value="2. Registrar as decisões dos sócios" />
    <bpmn:categoryValue id="CV_GO02_E3" value="3. Cumprir os atos societários e acompanhar as decisões" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO02">
    <bpmn:participant id="Participant_GO02" name="GO-02 · Secretariar as decisões dos sócios e cumprir os atos societários" processRef="Process_GO02" />
    <bpmn:group id="Group_GO02_E1" categoryValueRef="CV_GO02_E1" />
    <bpmn:group id="Group_GO02_E2" categoryValueRef="CV_GO02_E2" />
    <bpmn:group id="Group_GO02_E3" categoryValueRef="CV_GO02_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GO02" name="Secretariar as decisões dos sócios e cumprir os atos societários" isExecutable="false">
    <bpmn:documentation>Fazer cada matéria que vai aos sócios chegar completa e dentro das regras, numa pauta convocada; cada decisão ser registrada em ata, com votos, responsável e prazo; cada ato societário (constituição, alteração ou encerramento de empresa) ser registrado nos órgãos; e cada decisão ter o cumprimento acompanhado e cobrado. Os círculos levam as matérias; os sócios decidem; a Governança secretaria, registra e acompanha.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GO02">
      <bpmn:lane id="Lane_GO02_SOL" name="Solicitante">
        <bpmn:flowNodeRef>GO02_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO02_SOC" name="Sócios">
        <bpmn:flowNodeRef>GO02_E2_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO02_GOP" name="Governança · pessoa">
        <bpmn:flowNodeRef>GO02_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E1_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO02_GOA" name="Governança · agente">
        <bpmn:flowNodeRef>GO02_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E3_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO02_GOR" name="Governança · automação">
        <bpmn:flowNodeRef>GO02_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_M4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_E3_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO02_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GO02_S1" name="Matéria para decisão dos sócios recebida"><bpmn:outgoing>GO02_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GO02_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="GO02_S2" name="Reunião dos sócios do calendário"><bpmn:outgoing>GO02_Flow2</bpmn:outgoing><bpmn:timerEventDefinition id="GO02_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="GO02_M1"><bpmn:incoming>GO02_Flow1</bpmn:incoming><bpmn:incoming>GO02_Flow2</bpmn:incoming><bpmn:outgoing>GO02_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO02_E1_T1" name="Registrar a matéria, quem a propõe e o prazo"><bpmn:documentation>Etapa 1: Montar a pauta e preparar as matérias. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO02_Flow21</bpmn:incoming><bpmn:outgoing>GO02_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GO02_E1_T2" name="Conferir se a matéria está completa e dentro das regras"><bpmn:documentation>Etapa 1: Montar a pauta e preparar as matérias. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO02_Flow3</bpmn:incoming><bpmn:outgoing>GO02_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GO02_E1_G1" name="A matéria está completa e dentro das regras?"><bpmn:incoming>GO02_Flow4</bpmn:incoming><bpmn:outgoing>GO02_Flow5</bpmn:outgoing><bpmn:outgoing>GO02_Flow7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO02_E1_T3" name="Decidir a devolução da matéria, com o que falta"><bpmn:documentation>Etapa 1: Montar a pauta e preparar as matérias. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO02_Flow5</bpmn:incoming><bpmn:outgoing>GO02_Flow6</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GO02_E1_T4" name="Devolver a matéria a quem propôs, com o que falta"><bpmn:documentation>Etapa 1: Montar a pauta e preparar as matérias. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO02_Flow6</bpmn:incoming><bpmn:outgoing>GO02_Flow8</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO02_M2"><bpmn:incoming>GO02_Flow7</bpmn:incoming><bpmn:incoming>GO02_Flow8</bpmn:incoming><bpmn:outgoing>GO02_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO02_E1_T5" name="Fechar a pauta e convocar os sócios"><bpmn:documentation>Etapa 1: Montar a pauta e preparar as matérias. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco baixo.</bpmn:documentation><bpmn:incoming>GO02_Flow22</bpmn:incoming><bpmn:outgoing>GO02_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO02_E2_G1" name="A decisão já foi tomada na jornada dona?"><bpmn:incoming>GO02_Flow9</bpmn:incoming><bpmn:outgoing>GO02_Flow10</bpmn:outgoing><bpmn:outgoing>GO02_Flow11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO02_E2_T1" name="Juntar a decisão já tomada ao livro de atas"><bpmn:documentation>Etapa 2: Registrar as decisões dos sócios. Executor: Automação da Governança (Governança · automação). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>GO02_Flow10</bpmn:incoming><bpmn:outgoing>GO02_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="GO02_E2_T2" name="Decidir as matérias da pauta"><bpmn:documentation>Etapa 2: Registrar as decisões dos sócios. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>GO02_Flow11</bpmn:incoming><bpmn:outgoing>GO02_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="GO02_E2_T3" name="Lavrar a ata com as decisões, os votos, os responsáveis e os prazos"><bpmn:documentation>Etapa 2: Registrar as decisões dos sócios. Executor: Agente da Governança (Governança · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>GO02_Flow12</bpmn:incoming><bpmn:outgoing>GO02_Flow14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GO02_M3"><bpmn:incoming>GO02_Flow13</bpmn:incoming><bpmn:incoming>GO02_Flow14</bpmn:incoming><bpmn:outgoing>GO02_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO02_E2_T4" name="Conferir a ata e colher as assinaturas"><bpmn:documentation>Etapa 2: Registrar as decisões dos sócios. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>GO02_Flow23</bpmn:incoming><bpmn:outgoing>GO02_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO02_E3_G1" name="A decisão pede ato societário fora de um mandato?"><bpmn:incoming>GO02_Flow15</bpmn:incoming><bpmn:outgoing>GO02_Flow16</bpmn:outgoing><bpmn:outgoing>GO02_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO02_E3_T1" name="Registrar a alteração societária nos órgãos"><bpmn:documentation>Etapa 3: Cumprir os atos societários e acompanhar as decisões. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO02_Flow16</bpmn:incoming><bpmn:outgoing>GO02_Flow18</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO02_M4"><bpmn:incoming>GO02_Flow17</bpmn:incoming><bpmn:incoming>GO02_Flow18</bpmn:incoming><bpmn:outgoing>GO02_Flow24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO02_E3_T2" name="Acompanhar o cumprimento de cada decisão e cobrar o responsável"><bpmn:documentation>Etapa 3: Cumprir os atos societários e acompanhar as decisões. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO02_Flow24</bpmn:incoming><bpmn:outgoing>GO02_Flow19</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:userTask id="GO02_E3_T3" name="Conferir o cumprimento e apontar aos sócios o que atrasou"><bpmn:documentation>Etapa 3: Cumprir os atos societários e acompanhar as decisões. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>GO02_Flow19</bpmn:incoming><bpmn:outgoing>GO02_Flow20</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="GO02_F1" name="Decisões registradas e cumprimento acompanhado"><bpmn:incoming>GO02_Flow20</bpmn:incoming></bpmn:endEvent>
