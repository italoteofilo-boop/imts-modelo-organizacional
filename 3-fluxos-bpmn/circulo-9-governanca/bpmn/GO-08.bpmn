    <bpmn:exclusiveGateway id="GO08_E2_G1" name="De quem é a crise?"><bpmn:incoming>GO08_Flow9</bpmn:incoming><bpmn:outgoing>GO08_Flow10</bpmn:outgoing><bpmn:outgoing>GO08_Flow11</bpmn:outgoing><bpmn:outgoing>GO08_Flow12</bpmn:outgoing></bpmn:exclusiveGateway>
