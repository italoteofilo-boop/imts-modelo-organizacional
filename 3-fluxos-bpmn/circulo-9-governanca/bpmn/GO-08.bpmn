    <bpmn:startEvent id="GO08_S1" name="Alerta de crise recebido"><bpmn:outgoing>GO08_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GO08_S1_def" /></bpmn:startEvent>
    <bpmn:scriptTask id="GO08_E1_T1" name="Convocar o comitê de crise pelo protocolo, com a Identidade"><bpmn:documentation>Etapa 1: Acionar o comitê e conferir os fatos. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow1</bpmn:incoming><bpmn:outgoing>GO08_Flow2</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GO08_E1_T2" name="Conferir os fatos, o risco jurídico e o dever de comunicar à autoridade"><bpmn:documentation>Etapa 1: Acionar o comitê e conferir os fatos. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow2</bpmn:incoming><bpmn:outgoing>GO08_Flow3</bpmn:outgoing></bpmn:serviceTask>
