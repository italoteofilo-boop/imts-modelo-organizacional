<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GO08" targetNamespace="urn:imts:modelo:circulo9-governanca" exporter="Ecossistema IMTS - fonte única do Círculo 9" exporterVersion="2026-10-01">
  <bpmn:category id="Category_GO08">
    <bpmn:categoryValue id="CV_GO08_E1" value="1. Acionar o comitê e conferir os fatos" />
    <bpmn:categoryValue id="CV_GO08_E2" value="2. Decidir a declaração, a posição e o porta-voz" />
    <bpmn:categoryValue id="CV_GO08_E3" value="3. Acompanhar a crise até encerrar e registrar as lições" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_GO08">
    <bpmn:participant id="Participant_GO08" name="GO-08 · Conduzir o comitê de crise, da declaração ao encerramento" processRef="Process_GO08" />
    <bpmn:group id="Group_GO08_E1" categoryValueRef="CV_GO08_E1" />
    <bpmn:group id="Group_GO08_E2" categoryValueRef="CV_GO08_E2" />
    <bpmn:group id="Group_GO08_E3" categoryValueRef="CV_GO08_E3" />
  </bpmn:collaboration>
  <bpmn:process id="Process_GO08" name="Conduzir o comitê de crise, da declaração ao encerramento" isExecutable="false">
    <bpmn:documentation>Fazer cada alerta de crise de Relações acionar o comitê pelo protocolo, com assento da Identidade; os fatos, o risco jurídico e o dever de comunicar à autoridade serem conferidos, e esse dever levado ao canal próprio; a crise ser declarada ou não, com a posição, o porta-voz e o que pode ser dito decididos pela Governança e aprovados pelo executivo, e a decisão avisada a Relações; a posição ser revista enquanto a crise durar e o encerramento decidido com o executivo; e as lições irem à Identidade e à conformidade. Relações monitora e comunica; a Governança, com o executivo, decide.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_GO08">
      <bpmn:lane id="Lane_GO08_REL" name="Relações">
        <bpmn:flowNodeRef>GO08_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO08_IDE" name="Identidade">
        <bpmn:flowNodeRef>GO08_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E2_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO08_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>GO08_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E3_T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO08_GOP" name="Governança · pessoa">
        <bpmn:flowNodeRef>GO08_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E2_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO08_GOA" name="Governança · agente">
        <bpmn:flowNodeRef>GO08_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E3_T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GO08_GOR" name="Governança · automação">
        <bpmn:flowNodeRef>GO08_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E1_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E2_T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_E2_T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_F2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GO08_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="GO08_S1" name="Alerta de crise recebido"><bpmn:outgoing>GO08_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="GO08_S1_def" /></bpmn:startEvent>
    <bpmn:scriptTask id="GO08_E1_T1" name="Convocar o comitê de crise pelo protocolo, com a Identidade"><bpmn:documentation>Etapa 1: Acionar o comitê e conferir os fatos. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow1</bpmn:incoming><bpmn:outgoing>GO08_Flow2</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="GO08_E1_T2" name="Conferir os fatos, o risco jurídico e o dever de comunicar à autoridade"><bpmn:documentation>Etapa 1: Acionar o comitê e conferir os fatos. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow2</bpmn:incoming><bpmn:outgoing>GO08_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="GO08_E1_T3" name="Avaliar o risco jurídico e o que pode ser dito"><bpmn:documentation>Etapa 1: Acionar o comitê e conferir os fatos. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow3</bpmn:incoming><bpmn:outgoing>GO08_Flow4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO08_E1_G1" name="Há dever de comunicar à autoridade?"><bpmn:incoming>GO08_Flow4</bpmn:incoming><bpmn:outgoing>GO08_Flow5</bpmn:outgoing><bpmn:outgoing>GO08_Flow6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO08_E1_T4" name="Abrir a comunicação à autoridade no canal próprio"><bpmn:documentation>Etapa 1: Acionar o comitê e conferir os fatos. Executor: Automação da Governança (Governança · automação). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow5</bpmn:incoming><bpmn:outgoing>GO08_Flow7</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO08_M1"><bpmn:incoming>GO08_Flow6</bpmn:incoming><bpmn:incoming>GO08_Flow7</bpmn:incoming><bpmn:outgoing>GO08_Flow21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:task id="GO08_E2_T1" name="Opinar sobre a posição pela identidade e pelo protocolo"><bpmn:documentation>Etapa 2: Decidir a declaração, a posição e o porta-voz. Executor: Outro círculo (Identidade). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow21</bpmn:incoming><bpmn:outgoing>GO08_Flow8</bpmn:outgoing></bpmn:task>
    <bpmn:userTask id="GO08_E2_T2" name="Propor a declaração, a posição, o porta-voz e o que pode ser dito"><bpmn:documentation>Etapa 2: Decidir a declaração, a posição e o porta-voz. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow8</bpmn:incoming><bpmn:outgoing>GO08_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GO08_E2_T3" name="Aprovar a decisão do comitê"><bpmn:documentation>Etapa 2: Decidir a declaração, a posição e o porta-voz. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow9</bpmn:incoming><bpmn:outgoing>GO08_Flow10</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="GO08_E2_T4" name="Avisar Relações da decisão do comitê"><bpmn:documentation>Etapa 2: Decidir a declaração, a posição e o porta-voz. Executor: Automação da Governança (Governança · automação). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow10</bpmn:incoming><bpmn:outgoing>GO08_Flow11</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="GO08_E2_G1" name="A crise foi declarada?"><bpmn:incoming>GO08_Flow11</bpmn:incoming><bpmn:outgoing>GO08_Flow12</bpmn:outgoing><bpmn:outgoing>GO08_Flow14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="GO08_E2_T5" name="Registrar o alerta e o motivo de não declarar"><bpmn:documentation>Etapa 2: Decidir a declaração, a posição e o porta-voz. Executor: Automação da Governança (Governança · automação). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow12</bpmn:incoming><bpmn:outgoing>GO08_Flow13</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="GO08_F2" name="Alerta sem crise declarada, registrado e avisado"><bpmn:incoming>GO08_Flow13</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="GO08_M2"><bpmn:incoming>GO08_Flow14</bpmn:incoming><bpmn:incoming>GO08_Flow17</bpmn:incoming><bpmn:outgoing>GO08_Flow22</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO08_E3_T1" name="Acompanhar a crise com o comitê"><bpmn:documentation>Etapa 3: Acompanhar a crise até encerrar e registrar as lições. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow22</bpmn:incoming><bpmn:outgoing>GO08_Flow15</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="GO08_E3_G1" name="A crise pode ser encerrada?"><bpmn:incoming>GO08_Flow15</bpmn:incoming><bpmn:outgoing>GO08_Flow16</bpmn:outgoing><bpmn:outgoing>GO08_Flow18</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="GO08_E3_T2" name="Rever a posição com o executivo e avisar Relações"><bpmn:documentation>Etapa 3: Acompanhar a crise até encerrar e registrar as lições. Executor: Pessoa da Governança (Governança · pessoa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow16</bpmn:incoming><bpmn:outgoing>GO08_Flow17</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="GO08_E3_T3" name="Aprovar o encerramento da crise"><bpmn:documentation>Etapa 3: Acompanhar a crise até encerrar e registrar as lições. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow18</bpmn:incoming><bpmn:outgoing>GO08_Flow19</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="GO08_E3_T4" name="Consolidar as lições e as causas"><bpmn:documentation>Etapa 3: Acompanhar a crise até encerrar e registrar as lições. Executor: Agente da Governança (Governança · agente). Modo da etapa: Copiloto; risco alto.</bpmn:documentation><bpmn:incoming>GO08_Flow19</bpmn:incoming><bpmn:outgoing>GO08_Flow20</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="GO08_F1" name="Crise encerrada e lições registradas"><bpmn:incoming>GO08_Flow20</bpmn:incoming></bpmn:endEvent>
