<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ID01" targetNamespace="urn:imts:modelo:circulo1-identidade" exporter="Ecossistema IMTS - fonte única do Círculo 1" exporterVersion="2026-10-01">
  <bpmn:category id="Category_ID01">
    <bpmn:categoryValue id="CV_ID01_E1" value="1. Reunir evidências" />
    <bpmn:categoryValue id="CV_ID01_E2" value="2. Redigir a proposta de declaração" />
    <bpmn:categoryValue id="CV_ID01_E3" value="3. Validar com líderes e executivos" />
    <bpmn:categoryValue id="CV_ID01_E4" value="4. Aprovar com os sócios" />
    <bpmn:categoryValue id="CV_ID01_E5" value="5. Publicar a versão e avisar quem depende dela" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID01">
    <bpmn:participant id="Participant_ID01" name="ID-01 · Definir e revisar propósito, visão, missão, princípios e valores" processRef="Process_ID01" />
    <bpmn:group id="Group_ID01_E1" categoryValueRef="CV_ID01_E1" />
    <bpmn:group id="Group_ID01_E2" categoryValueRef="CV_ID01_E2" />
    <bpmn:group id="Group_ID01_E3" categoryValueRef="CV_ID01_E3" />
    <bpmn:group id="Group_ID01_E4" categoryValueRef="CV_ID01_E4" />
    <bpmn:group id="Group_ID01_E5" categoryValueRef="CV_ID01_E5" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ID01" name="Definir e revisar propósito, visão, missão, princípios e valores" isExecutable="false">
    <bpmn:documentation>Manter uma declaração de identidade única, aprovada pelos sócios, que diga o que vale para todo o Ecossistema e o que é próprio de cada empresa.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_ID01">
      <bpmn:lane id="Lane_ID01_EST" name="Estratégia">
        <bpmn:flowNodeRef>ID01_S1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID01_SOC" name="Sócios">
        <bpmn:flowNodeRef>ID01_E4_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E4_G1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID01_GOV" name="Governança">
        <bpmn:flowNodeRef>ID01_E4_T1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID01_EXE" name="Executivo da empresa">
        <bpmn:flowNodeRef>ID01_E3_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID01_IDP" name="Identidade · pessoa">
        <bpmn:flowNodeRef>ID01_E1_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E1_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E1_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E2_T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E2_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E3_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E3_G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_M3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_F2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID01_IDA" name="Identidade · agente">
        <bpmn:flowNodeRef>ID01_M1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E1_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_M2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E2_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E3_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E5_T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ID01_IDR" name="Identidade · automação">
        <bpmn:flowNodeRef>ID01_S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E4_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E5_T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_E5_T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ID01_F1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="ID01_S1" name="Pedido de identidade para empresa nova recebido"><bpmn:outgoing>ID01_Flow1</bpmn:outgoing><bpmn:messageEventDefinition id="ID01_S1_def" /></bpmn:startEvent>
    <bpmn:startEvent id="ID01_S2" name="Revisão da declaração decidida"><bpmn:outgoing>ID01_Flow2</bpmn:outgoing><bpmn:messageEventDefinition id="ID01_S2_def" /></bpmn:startEvent>
    <bpmn:exclusiveGateway id="ID01_M1"><bpmn:incoming>ID01_Flow1</bpmn:incoming><bpmn:incoming>ID01_Flow2</bpmn:incoming><bpmn:outgoing>ID01_Flow25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID01_E1_T1" name="Consolidar evidências e apontar lacunas"><bpmn:documentation>Etapa 1: Reunir evidências. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID01_Flow25</bpmn:incoming><bpmn:outgoing>ID01_Flow3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="ID01_E1_T2" name="Entrevistar sócios, líderes e executivos"><bpmn:documentation>Etapa 1: Reunir evidências. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID01_Flow3</bpmn:incoming><bpmn:outgoing>ID01_Flow4</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="ID01_E1_T3" name="Definir o que precisa mudar na declaração"><bpmn:documentation>Etapa 1: Reunir evidências. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID01_Flow4</bpmn:incoming><bpmn:outgoing>ID01_Flow5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="ID01_E1_G1" name="Há mudança a propor?"><bpmn:incoming>ID01_Flow5</bpmn:incoming><bpmn:outgoing>ID01_Flow6</bpmn:outgoing><bpmn:outgoing>ID01_Flow7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ID01_M2"><bpmn:incoming>ID01_Flow6</bpmn:incoming><bpmn:incoming>ID01_Flow15</bpmn:incoming><bpmn:incoming>ID01_Flow19</bpmn:incoming><bpmn:outgoing>ID01_Flow26</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ID01_E2_T1" name="Propor redações alternativas"><bpmn:documentation>Etapa 2: Redigir a proposta de declaração. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID01_Flow26</bpmn:incoming><bpmn:outgoing>ID01_Flow8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID01_E2_T2" name="Escolher e ajustar a redação"><bpmn:documentation>Etapa 2: Redigir a proposta de declaração. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID01_Flow8</bpmn:incoming><bpmn:outgoing>ID01_Flow9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="ID01_E2_T3" name="Separar o que é do Ecossistema e o que é de cada empresa"><bpmn:documentation>Etapa 2: Redigir a proposta de declaração. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID01_Flow9</bpmn:incoming><bpmn:outgoing>ID01_Flow10</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="ID01_E3_T1" name="Conduzir a validação com líderes e executivos"><bpmn:documentation>Etapa 3: Validar com líderes e executivos. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID01_Flow10</bpmn:incoming><bpmn:outgoing>ID01_Flow11</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="ID01_E3_T2" name="Apontar objeções e ajustes"><bpmn:documentation>Etapa 3: Validar com líderes e executivos. Executor: Pessoa de fora do círculo (Executivo da empresa). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID01_Flow11</bpmn:incoming><bpmn:outgoing>ID01_Flow12</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="ID01_E3_T3" name="Consolidar objeções e ajustes"><bpmn:documentation>Etapa 3: Validar com líderes e executivos. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Assistido; risco médio.</bpmn:documentation><bpmn:incoming>ID01_Flow12</bpmn:incoming><bpmn:outgoing>ID01_Flow13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ID01_E3_G1" name="Há objeção que muda a proposta?"><bpmn:incoming>ID01_Flow13</bpmn:incoming><bpmn:outgoing>ID01_Flow14</bpmn:outgoing><bpmn:outgoing>ID01_Flow15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:callActivity id="ID01_E4_T1" name="Levar a proposta à decisão dos sócios"><bpmn:documentation>Etapa 4: Aprovar com os sócios. Executor: Outro círculo (Governança). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>ID01_Flow14</bpmn:incoming><bpmn:outgoing>ID01_Flow16</bpmn:outgoing></bpmn:callActivity>
    <bpmn:manualTask id="ID01_E4_T2" name="Decidir sobre a declaração"><bpmn:documentation>Etapa 4: Aprovar com os sócios. Executor: Pessoa de fora do círculo (Sócios). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>ID01_Flow16</bpmn:incoming><bpmn:outgoing>ID01_Flow17</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ID01_E4_G1" name="Declaração aprovada?"><bpmn:incoming>ID01_Flow17</bpmn:incoming><bpmn:outgoing>ID01_Flow18</bpmn:outgoing><bpmn:outgoing>ID01_Flow19</bpmn:outgoing><bpmn:outgoing>ID01_Flow20</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID01_E4_T3" name="Registrar a decisão dos sócios de manter a declaração atual"><bpmn:documentation>Etapa 4: Aprovar com os sócios. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Assistido; risco alto.</bpmn:documentation><bpmn:incoming>ID01_Flow20</bpmn:incoming><bpmn:outgoing>ID01_Flow21</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ID01_M3"><bpmn:incoming>ID01_Flow7</bpmn:incoming><bpmn:incoming>ID01_Flow21</bpmn:incoming><bpmn:outgoing>ID01_Flow27</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="ID01_F2" name="Revisão encerrada sem mudança"><bpmn:incoming>ID01_Flow27</bpmn:incoming></bpmn:endEvent>
    <bpmn:scriptTask id="ID01_E5_T1" name="Registrar a versão e a data de vigência"><bpmn:documentation>Etapa 5: Publicar a versão e avisar quem depende dela. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID01_Flow18</bpmn:incoming><bpmn:outgoing>ID01_Flow22</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="ID01_E5_T2" name="Listar padrões, marcas, mensagens e agentes afetados"><bpmn:documentation>Etapa 5: Publicar a versão e avisar quem depende dela. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID01_Flow22</bpmn:incoming><bpmn:outgoing>ID01_Flow23</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:scriptTask id="ID01_E5_T3" name="Avisar os donos afetados"><bpmn:documentation>Etapa 5: Publicar a versão e avisar quem depende dela. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID01_Flow23</bpmn:incoming><bpmn:outgoing>ID01_Flow24</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:endEvent id="ID01_F1" name="Declaração aprovada e publicada"><bpmn:incoming>ID01_Flow24</bpmn:incoming></bpmn:endEvent>
