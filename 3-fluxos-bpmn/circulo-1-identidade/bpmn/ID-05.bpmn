    <bpmn:serviceTask id="ID05_E2_T1" name="Calcular as lacunas entre visão, cultura e imagem"><bpmn:documentation>Etapa 2: Analisar as lacunas entre o declarado, o vivido e o percebido. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow22</bpmn:incoming><bpmn:outgoing>ID05_Flow8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="ID05_E2_T2" name="Calcular os indicadores de clareza e atualidade dos padrões"><bpmn:documentation>Etapa 2: Analisar as lacunas entre o declarado, o vivido e o percebido. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow8</bpmn:incoming><bpmn:outgoing>ID05_Flow9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="ID05_E2_T3" name="Interpretar e priorizar as lacunas"><bpmn:documentation>Etapa 2: Analisar as lacunas entre o declarado, o vivido e o percebido. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow9</bpmn:incoming><bpmn:outgoing>ID05_Flow10</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="ID05_E3_T1" name="Separar falha do padrão e falha de execução em cada lacuna"><bpmn:documentation>Etapa 3: Decidir o que rever. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow10</bpmn:incoming><bpmn:outgoing>ID05_Flow11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="ID05_E3_T2" name="Decidir com executivos e líderes dos círculos o que rever"><bpmn:documentation>Etapa 3: Decidir o que rever. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow11</bpmn:incoming><bpmn:outgoing>ID05_Flow12</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="ID05_E3_G1" name="Há falha de padrão a corrigir?"><bpmn:incoming>ID05_Flow12</bpmn:incoming><bpmn:outgoing>ID05_Flow13</bpmn:outgoing><bpmn:outgoing>ID05_Flow14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID05_E3_T3" name="Abrir a revisão na jornada dona do padrão"><bpmn:documentation>Etapa 3: Decidir o que rever. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow13</bpmn:incoming><bpmn:outgoing>ID05_Flow15</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ID05_M3"><bpmn:incoming>ID05_Flow14</bpmn:incoming><bpmn:incoming>ID05_Flow15</bpmn:incoming><bpmn:outgoing>ID05_Flow23</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="ID05_E3_G2" name="Há falha de execução a apontar?"><bpmn:incoming>ID05_Flow23</bpmn:incoming><bpmn:outgoing>ID05_Flow16</bpmn:outgoing><bpmn:outgoing>ID05_Flow17</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ID05_E3_T4" name="Apontar a lacuna ao círculo que executa"><bpmn:documentation>Etapa 3: Decidir o que rever. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Copiloto; risco médio.</bpmn:documentation><bpmn:incoming>ID05_Flow17</bpmn:incoming><bpmn:outgoing>ID05_Flow18</bpmn:outgoing></bpmn:scriptTask>
