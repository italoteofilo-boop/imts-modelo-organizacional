    <bpmn:scriptTask id="ID05_E1_T1" name="Reunir os resultados recebidos e conferir o que falta"><bpmn:documentation>Etapa 1: Reunir os resultados dos círculos que medem. Executor: Automação da Identidade (Identidade · automação). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow21</bpmn:incoming><bpmn:outgoing>ID05_Flow3</bpmn:outgoing></bpmn:scriptTask>
    <bpmn:serviceTask id="ID05_E1_T2" name="Consolidar os resultados por padrão avaliado"><bpmn:documentation>Etapa 1: Reunir os resultados dos círculos que medem. Executor: Agente da Identidade (Identidade · agente). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow3</bpmn:incoming><bpmn:outgoing>ID05_Flow4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="ID05_E1_G1" name="Falta dado de algum círculo?"><bpmn:incoming>ID05_Flow4</bpmn:incoming><bpmn:outgoing>ID05_Flow5</bpmn:outgoing><bpmn:outgoing>ID05_Flow6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="ID05_E1_T3" name="Cobrar o dado do círculo dono ou registrar a ressalva"><bpmn:documentation>Etapa 1: Reunir os resultados dos círculos que medem. Executor: Pessoa da Identidade (Identidade · pessoa). Modo da etapa: Autopiloto; risco baixo.</bpmn:documentation><bpmn:incoming>ID05_Flow6</bpmn:incoming><bpmn:outgoing>ID05_Flow7</bpmn:outgoing></bpmn:userTask>
