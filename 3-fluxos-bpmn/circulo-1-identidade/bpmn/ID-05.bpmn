  <bpmn:category id="Category_ID05">
    <bpmn:categoryValue id="CV_ID05_E1" value="1. Reunir os resultados dos círculos que medem" />
    <bpmn:categoryValue id="CV_ID05_E2" value="2. Analisar as lacunas entre o declarado, o vivido e o percebido" />
    <bpmn:categoryValue id="CV_ID05_E3" value="3. Decidir o que rever" />
    <bpmn:categoryValue id="CV_ID05_E4" value="4. Registrar a avaliação e devolver o resultado" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID05">
    <bpmn:participant id="Participant_ID05" name="ID-05 · Avaliar se os padrões de identidade funcionam e decidir o que rever" processRef="Process_ID05" />
