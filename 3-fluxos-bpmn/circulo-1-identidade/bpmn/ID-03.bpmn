    <bpmn:startEvent id="ID03_S3" name="Revisão de marca decidida"><bpmn:outgoing>ID03_Flow3</bpmn:outgoing><bpmn:messageEventDefinition id="ID03_S3_def" /></bpmn:startEvent>
