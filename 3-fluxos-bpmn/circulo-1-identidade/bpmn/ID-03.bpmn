<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ID03" targetNamespace="urn:imts:modelo:circulo1-identidade" exporter="Ecossistema IMTS - fonte única do Círculo 1" exporterVersion="2026-10-01">
  <bpmn:category id="Category_ID03">
    <bpmn:categoryValue id="CV_ID03_E1" value="1. Entender o pedido e pesquisar as marcas do portfólio e dos concorrentes" />
    <bpmn:categoryValue id="CV_ID03_E2" value="2. Decidir que marca o negócio terá: existente, própria, recebida, revista ou retirada" />
    <bpmn:categoryValue id="CV_ID03_E3" value="3. Definir a essência da marca e o nome" />
    <bpmn:categoryValue id="CV_ID03_E4" value="4. Desenhar a identidade visual e verbal" />
    <bpmn:categoryValue id="CV_ID03_E5" value="5. Proteger a marca" />
    <bpmn:categoryValue id="CV_ID03_E6" value="6. Montar o pacote de marca" />
    <bpmn:categoryValue id="CV_ID03_E7" value="7. Publicar e entregar a quem usa a marca" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID03">
    <bpmn:participant id="Participant_ID03" name="ID-03 · Criar ou rever e registrar a marca de uma empresa, oferta ou projeto" processRef="Process_ID03" />
    <bpmn:group id="Group_ID03_E1" categoryValueRef="CV_ID03_E1" />
