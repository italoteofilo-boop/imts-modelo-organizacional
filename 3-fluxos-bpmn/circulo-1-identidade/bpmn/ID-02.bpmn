  <bpmn:category id="Category_ID02">
    <bpmn:categoryValue id="CV_ID02_E1" value="1. Receber o pedido e decidir se ele pede padrão novo" />
    <bpmn:categoryValue id="CV_ID02_E2" value="2. Escrever os padrões em três frentes paralelas" />
    <bpmn:categoryValue id="CV_ID02_E3" value="3. Testar os padrões em casos reais" />
    <bpmn:categoryValue id="CV_ID02_E4" value="4. Publicar os padrões e entregar a cada círculo o que ele executa" />
  </bpmn:category>
  <bpmn:collaboration id="Collab_ID02">
